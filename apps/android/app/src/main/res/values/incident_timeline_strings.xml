<?xml version="1.0" encoding="utf-8"?>
<!--
  Surface-owned strings for the IncidentTimelinePage system surface
  (com/teslasync/system/IncidentTimelinePage.kt), the native port of
  web/src/features/system/pages/IncidentTimelinePage.tsx.

  The web page predates the i18n migration: it hard-codes its English copy
  (titles, badges, the timeline + add-update form, the resolve confirm dialog,
  toasts) rather than going through react-i18next, so the auto-generated
  translation_* catalog (web/src/i18n -> apps/shared/i18n -> values/strings.xml)
  carries no key for it. These keys provide that copy so the native surface
  resolves every visible string through stringResource (no English literals in
  Kotlin), using the same hand-authored *_strings.xml mechanism as
  incident_form_strings.xml / nav_strings.xml / settings_strings.xml. Values are
  verbatim from the web source.
-->
