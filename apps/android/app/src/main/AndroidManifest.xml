<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Runtime notification permission (Android 13+, P3/A6, ADR-009). On API < 33 it is granted at
         install time; on 33+ the app requests it at runtime (NotificationPermissionEffect). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility (Android 11+) so AppAuth can discover a browser / Custom Tabs provider
         for the OIDC authorize round-trip (P3/A4, ADR-008). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".TeslaSyncApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TeslaSync">

        <!-- Google Maps SDK key. Injected at build time from the MAPS_API_KEY manifest
             placeholder (see app/build.gradle.kts); empty in local/dev builds. The maps
             component library (components/maps) renders a blank base map without a valid key
             but still builds and runs. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TeslaSync">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links: App-Links over https plus the teslasync:// custom scheme. The route graph
                 (TeslaSyncNavHost) declares per-destination uriPatterns for every web path + alias;
                 these filters let the OS route matching URIs to the single Activity. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.teslasync.io" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="teslasync" android:host="app" />
            </intent-filter>
        </activity>

        <!-- OIDC authorize trampoline (P3/A4): drives the AppAuth Custom Tab and captures the
             redirect. Transparent + internal-only; the redirect itself returns through AppAuth's
             RedirectUriReceiverActivity, which the AAR registers for the appAuthRedirectScheme
             manifest placeholder (set in app/build.gradle.kts from the OIDC redirect URI). -->
        <activity
            android:name=".auth.AuthorizationActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- FCM background push transport (P3/A6, ADR-009). Firebase delivers token refreshes and
             messages to this service; it forwards them to the headless push pipeline. The default
             notification icon/color/channel are used by the system when a notification-style message
             arrives while the app is backgrounded. The default FirebaseApp is configured by the
             google-services resources provisioned in P5/H5-0001; until then the token surface no-ops. -->
        <service
            android:name=".messaging.TeslaSyncMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general" />

        <!-- Background notification-action handler (P3/A8): the "acknowledge" action broadcasts here to
             dismiss the notification without opening the app. Not exported — only this app's
             PendingIntents target it (explicit component), so no intent-filter is declared. -->
        <receiver
            android:name=".notifications.NotificationActionReceiver"
            android:exported="false" />

        <!-- Home-screen widgets (P3/A8, ADR-009/013). Each Glance receiver is the AppWidget provider
             the launcher binds to; refresh is driven by WorkManager (the providers set
             updatePeriodMillis=0), never by a held SSE stream. exported=true is required so the
             AppWidget framework can deliver APPWIDGET_UPDATE broadcasts. -->
        <receiver
            android:name=".widgets.VehicleStatusWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_vehicle_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_vehicle_status_info" />
        </receiver>

        <receiver
            android:name=".widgets.ChargingWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_charging_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_charging_info" />
        </receiver>

        <receiver
            android:name=".widgets.QuickStatsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quickstats_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_stats_info" />
        </receiver>

        <receiver
            android:name=".widgets.AlertsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_alerts_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_alerts_info" />
        </receiver>
    </application>

</manifest>
