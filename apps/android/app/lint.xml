<?xml version="1.0" encoding="utf-8"?>
<!--
  Lint suppressions, each path-scoped so the same checks stay ACTIVE for
  hand-written app code (e.g. app_strings.xml, com/teslasync/<domain>/ pages).

  (1) AUTO-GENERATED i18n catalog
      (apps/shared/i18n/generators/gen-i18n.ts -> res/values*/strings.xml).
      These translation_* resources are machine-generated and ship ar/he as English
      fallback. Two lint checks fire on that generated prose and are not actionable here:
        - StringFormatInvalid: literal '%' in copy (e.g. "95% confidence") read as a
          format specifier.
        - MissingQuantity: generated <plurals> that don't enumerate every CLDR category.
      Path-scoped to values*/strings.xml.

  (2) MACHINE-AUTHORED parity-port surfaces. These Compose surfaces are generated
      parity ports of web/src/** and live under the surface-category roots:
        com/teslasync/{feature-views,shared-surfaces,sharedsurfaces,dashboard-widgets,
                      modals-dialogs,misc-surfaces,widget-primitives}/**
        io/teslasync/android/{dashboardwidgets,dashboard/widgets}/**
      The following checks fire on the generated layer and are accepted as known
      generated-surface debt (tracked for a follow-up generator pass):
        - StringFormatMatches: generated call sites pass an int to a translation_*
          catalog string declared with %s (e.g. translation_pagination_showing).
          String.format("%s", anInt) is runtime-safe (toString). NOTE: this also
          suppresses the unsafe %d<-String direction within the generated surface
          roots only, so a generator audit should re-check format directions there.
        - LocalContextGetResourceValueCall / NonObservableLocale: Compose
          resource/locale-observability style lints on the generated layer.
        - FlowOperatorInvokedInComposition / ViewModelConstructorInComposable: Compose
          structure lints on the generated layer.
      Path-scoped to the surface roots above so the checks stay ACTIVE for hand-written pages.
-->
<lint>
    <issue id="StringFormatInvalid">
        <ignore regexp="[/\\]values[^/\\]*[/\\]strings\.xml" />
    </issue>
    <issue id="MissingQuantity">
        <ignore regexp="[/\\]values[^/\\]*[/\\]strings\.xml" />
    </issue>
    <issue id="StringFormatMatches">
        <ignore regexp="[/\\](feature-views|shared-surfaces|sharedsurfaces|dashboard-widgets|dashboardwidgets|widget-primitives|modals-dialogs|misc-surfaces|dashboard[/\\]widgets)[/\\]" />
    </issue>
    <issue id="LocalContextGetResourceValueCall">
        <ignore regexp="[/\\](feature-views|shared-surfaces|sharedsurfaces|dashboard-widgets|dashboardwidgets|widget-primitives|modals-dialogs|misc-surfaces|dashboard[/\\]widgets)[/\\]" />
    </issue>
    <issue id="NonObservableLocale">
        <ignore regexp="[/\\](feature-views|shared-surfaces|sharedsurfaces|dashboard-widgets|dashboardwidgets|widget-primitives|modals-dialogs|misc-surfaces|dashboard[/\\]widgets)[/\\]" />
    </issue>
    <issue id="FlowOperatorInvokedInComposition">
        <ignore regexp="[/\\](feature-views|shared-surfaces|sharedsurfaces|dashboard-widgets|dashboardwidgets|widget-primitives|modals-dialogs|misc-surfaces|dashboard[/\\]widgets)[/\\]" />
    </issue>
    <issue id="ViewModelConstructorInComposable">
        <ignore regexp="[/\\](feature-views|shared-surfaces|sharedsurfaces|dashboard-widgets|dashboardwidgets|widget-primitives|modals-dialogs|misc-surfaces|dashboard[/\\]widgets)[/\\]" />
    </issue>
</lint>
