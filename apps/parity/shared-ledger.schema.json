{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared program ledger (P1/S99)",
  "type": "object",
  "required": ["ledger", "generatedBy", "gate", "modules"],
  "properties": {
    "$schema": { "type": "string" },
    "ledger": { "type": "string" },
    "generatedBy": { "type": "string" },
    "generatedAt": { "type": "string" },
    "frozenContract": { "type": "string" },
    "gate": {
      "type": "object",
      "required": ["log", "status", "exit"],
      "properties": {
        "log": { "type": "string" },
        "status": { "enum": ["DONE", "BLOCKED"] },
        "exit": { "type": "integer" },
        "hostTests": { "type": "object" },
        "koverVerify": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "phase", "title", "status"],
        "properties": {
          "id": { "type": "string" },
          "phase": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["todo", "in_progress", "done", "blocked"] },
          "evidenceLog": { "type": "string" }
        }
      }
    }
  }
}
