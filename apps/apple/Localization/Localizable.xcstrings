    "translation.ai.settings.feature.learned-per-vehicle-anomaly-baselines.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in statistical model that computes per-signal mean, stddev, and p5/p95 from this vehicle's recent signal history (default 14 days, capped at 30) and proposes a learned anomaly envelope, falling back per-signal to the static safe-range envelope when fewer than 30 samples exist in the lookback window. Read-only: the trainer never writes to signal_log, never overwrites the deterministic safe-range table, and the Helix narration walks the user through the learned vs. static comparison via two typed tools (train_anomaly_baseline then query_anomaly_baseline). The deterministic Z-score detector + static safeRanges map at /anomaly-detection remain the canonical baseline when Helix is off."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in statistical model that computes per-signal mean, stddev, and p5/p95 from this vehicle's recent signal history (default 14 days, capped at 30) and proposes a learned anomaly envelope, falling back per-signal to the static safe-range envelope when fewer than 30 samples exist in the lookback window. Read-only: the trainer never writes to signal_log, never overwrites the deterministic safe-range table, and the Helix narration walks the user through the learned vs. static comparison via two typed tools (train_anomaly_baseline then query_anomaly_baseline). The deterministic Z-score detector + static safeRanges map at /anomaly-detection remain the canonical baseline when Helix is off."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in statistical model that computes per-signal mean, stddev, and p5/p95 from this vehicle's recent signal history (default 14 days, capped at 30) and proposes a learned anomaly envelope, falling back per-signal to the static safe-range envelope when fewer than 30 samples exist in the lookback window. Read-only: the trainer never writes to signal_log, never overwrites the deterministic safe-range table, and the Helix narration walks the user through the learned vs. static comparison via two typed tools (train_anomaly_baseline then query_anomaly_baseline). The deterministic Z-score detector + static safeRanges map at /anomaly-detection remain the canonical baseline when Helix is off."
          }
        }
      }
    },
