    "translation.ai.settings.feature.geofence-aware-automation-suggestions.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM that proposes a typed Automation graph DTO scoped to one of your existing geofences. Propose-only: Helix proposes a structured automation via two typed read-only tools (draft_automation_graph then validate_automation_graph) and you review the populated form and click Save through the canonical baseline POST /api/v1/automations write path. The geofence catalog (id + name + category — never coordinates) is injected so the LLM picks an existing place_id rather than hallucinating one. The deterministic AutomationBuilder form, trigger / condition / action editors, and Save button at /automations/builder remain the canonical baseline when Helix is off."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in LLM that proposes a typed Automation graph DTO scoped to one of your existing geofences. Propose-only: Helix proposes a structured automation via two typed read-only tools (draft_automation_graph then validate_automation_graph) and you review the populated form and click Save through the canonical baseline POST /api/v1/automations write path. The geofence catalog (id + name + category — never coordinates) is injected so the LLM picks an existing place_id rather than hallucinating one. The deterministic AutomationBuilder form, trigger / condition / action editors, and Save button at /automations/builder remain the canonical baseline when Helix is off."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM that proposes a typed Automation graph DTO scoped to one of your existing geofences. Propose-only: Helix proposes a structured automation via two typed read-only tools (draft_automation_graph then validate_automation_graph) and you review the populated form and click Save through the canonical baseline POST /api/v1/automations write path. The geofence catalog (id + name + category — never coordinates) is injected so the LLM picks an existing place_id rather than hallucinating one. The deterministic AutomationBuilder form, trigger / condition / action editors, and Save button at /automations/builder remain the canonical baseline when Helix is off."
          }
        }
      }
    },
