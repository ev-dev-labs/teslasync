    "translation.ai.settings.feature.cabin-temperature-impact-narrative.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM narrator that explains how outside ambient temperature affects this vehicle's driving efficiency — which temperature bucket runs most efficiently, the relative consumption gap between the best and worst bucket, and the 12-month seasonal trend (cold-weather dip vs mild-weather recovery) — grounded strictly in the same bucketed-efficiency aggregates and monthly seasonal trend the chart renders, and honest that the surface is a descriptive aggregate of recent drives rather than a forecast or regression model. The deterministic Temperature Impact page (bucketed-efficiency chart, monthly seasonal trend, summary metric cards, recent drives table) remains the canonical baseline when Helix is off."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in LLM narrator that explains how outside ambient temperature affects this vehicle's driving efficiency — which temperature bucket runs most efficiently, the relative consumption gap between the best and worst bucket, and the 12-month seasonal trend (cold-weather dip vs mild-weather recovery) — grounded strictly in the same bucketed-efficiency aggregates and monthly seasonal trend the chart renders, and honest that the surface is a descriptive aggregate of recent drives rather than a forecast or regression model. The deterministic Temperature Impact page (bucketed-efficiency chart, monthly seasonal trend, summary metric cards, recent drives table) remains the canonical baseline when Helix is off."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM narrator that explains how outside ambient temperature affects this vehicle's driving efficiency — which temperature bucket runs most efficiently, the relative consumption gap between the best and worst bucket, and the 12-month seasonal trend (cold-weather dip vs mild-weather recovery) — grounded strictly in the same bucketed-efficiency aggregates and monthly seasonal trend the chart renders, and honest that the surface is a descriptive aggregate of recent drives rather than a forecast or regression model. The deterministic Temperature Impact page (bucketed-efficiency chart, monthly seasonal trend, summary metric cards, recent drives table) remains the canonical baseline when Helix is off."
