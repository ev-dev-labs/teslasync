    "translation.redis.diagnostic.noTelemetry.bodyAbsent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This vehicle has no L1 entries on this pod. Either telemetry has never streamed for it, or this pod restarted before any telemetry arrived."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This vehicle has no L1 entries on this pod. Either telemetry has never streamed for it, or this pod restarted before any telemetry arrived."
