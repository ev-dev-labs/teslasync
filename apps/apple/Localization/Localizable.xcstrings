    "translation.ai.settings.feature.predictive-maintenance.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM advisor that narrates one in-scope vehicle's upcoming maintenance risks in a 3-6 sentence factual paragraph — which scheduled items are overdue, which are due soon, the recent service-record context, and whether the current mileage informs the recommendation or if time-based reasoning was used (when no recent odometer reading is available) — by routing through two read-only tools that quote the same deterministic maintenance envelope the operator can already inspect on the Maintenance page. The advisor never invents an item, never proposes a write, and never speculates about root cause beyond the deterministic envelope. Per-request scope binding rejects any cross-vehicle tool call to defend against prompt-injection exfiltration via user-authored service-record notes. VINs, coordinates, place names, IPs, and personal identifiers are redacted before the message reaches the provider. The deterministic threshold reminders, status badges, summary metric cards, upcoming items list, and Schedule Maintenance write controls on the Maintenance page remain the canonical baseline when Helix is off."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in LLM advisor that narrates one in-scope vehicle's upcoming maintenance risks in a 3-6 sentence factual paragraph — which scheduled items are overdue, which are due soon, the recent service-record context, and whether the current mileage informs the recommendation or if time-based reasoning was used (when no recent odometer reading is available) — by routing through two read-only tools that quote the same deterministic maintenance envelope the operator can already inspect on the Maintenance page. The advisor never invents an item, never proposes a write, and never speculates about root cause beyond the deterministic envelope. Per-request scope binding rejects any cross-vehicle tool call to defend against prompt-injection exfiltration via user-authored service-record notes. VINs, coordinates, place names, IPs, and personal identifiers are redacted before the message reaches the provider. The deterministic threshold reminders, status badges, summary metric cards, upcoming items list, and Schedule Maintenance write controls on the Maintenance page remain the canonical baseline when Helix is off."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM advisor that narrates one in-scope vehicle's upcoming maintenance risks in a 3-6 sentence factual paragraph — which scheduled items are overdue, which are due soon, the recent service-record context, and whether the current mileage informs the recommendation or if time-based reasoning was used (when no recent odometer reading is available) — by routing through two read-only tools that quote the same deterministic maintenance envelope the operator can already inspect on the Maintenance page. The advisor never invents an item, never proposes a write, and never speculates about root cause beyond the deterministic envelope. Per-request scope binding rejects any cross-vehicle tool call to defend against prompt-injection exfiltration via user-authored service-record notes. VINs, coordinates, place names, IPs, and personal identifiers are redacted before the message reaches the provider. The deterministic threshold reminders, status badges, summary metric cards, upcoming items list, and Schedule Maintenance write controls on the Maintenance page remain the canonical baseline when Helix is off."
          }
