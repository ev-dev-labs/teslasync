    "translation.ai.settings.feature.state-machine-debugger-narrator.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM narrator that summarizes one in-scope vehicle FSM transition trace into a 3-6 sentence factual paragraph — the total transition count, the per-FSM-name breakdown when more than one FSM is present, the dominant from→to edges, the flap count when greater than zero, and any unusual trigger string — by routing through two read-only tools that quote the same deterministic transition envelope the operator can already inspect manually in the transition table. The narrator never invents a transition and never speculates about root cause. Per-request scope binding rejects any cross-vehicle or cross-window tool call to defend against prompt-injection exfiltration via operator-readable trigger strings or FSM names. VINs, coordinates, place names, IPs, and personal identifiers are redacted before the message reaches the provider. The deterministic transition table, state diagram, FSM health panel, and timeline chart on the State Machine Debugger page remain the canonical baseline when Helix is off."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in LLM narrator that summarizes one in-scope vehicle FSM transition trace into a 3-6 sentence factual paragraph — the total transition count, the per-FSM-name breakdown when more than one FSM is present, the dominant from→to edges, the flap count when greater than zero, and any unusual trigger string — by routing through two read-only tools that quote the same deterministic transition envelope the operator can already inspect manually in the transition table. The narrator never invents a transition and never speculates about root cause. Per-request scope binding rejects any cross-vehicle or cross-window tool call to defend against prompt-injection exfiltration via operator-readable trigger strings or FSM names. VINs, coordinates, place names, IPs, and personal identifiers are redacted before the message reaches the provider. The deterministic transition table, state diagram, FSM health panel, and timeline chart on the State Machine Debugger page remain the canonical baseline when Helix is off."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM narrator that summarizes one in-scope vehicle FSM transition trace into a 3-6 sentence factual paragraph — the total transition count, the per-FSM-name breakdown when more than one FSM is present, the dominant from→to edges, the flap count when greater than zero, and any unusual trigger string — by routing through two read-only tools that quote the same deterministic transition envelope the operator can already inspect manually in the transition table. The narrator never invents a transition and never speculates about root cause. Per-request scope binding rejects any cross-vehicle or cross-window tool call to defend against prompt-injection exfiltration via operator-readable trigger strings or FSM names. VINs, coordinates, place names, IPs, and personal identifiers are redacted before the message reaches the provider. The deterministic transition table, state diagram, FSM health panel, and timeline chart on the State Machine Debugger page remain the canonical baseline when Helix is off."
          }
        }
      }
    },
