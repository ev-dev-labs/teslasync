    "translation.help.charging.avgPower": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Time-averaged charging power across the session. Always lower than peak when the session includes a taper or initial ramp."
          }
        },
