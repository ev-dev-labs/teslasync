    "translation.ai.settings.feature.nl-grafana-panel.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in Helix translator on the Grafana Panel Builder page (/power/grafana) that converts a natural-language data question into a typed Grafana panel JSON DRAFT (a single panel envelope — title, type, datasource, targets, grid_pos — against the curated install-wide panel-builder catalog of 8 panel types, 2 datasource types, and the same 5 tables nl-sql-playground exposes) by routing through two propose-only tools (draft_grafana_panel + validate_grafana_panel). The translator NEVER pushes the panel to Grafana — there is no apply or push tool; the per-request scope binding refuses any panel type, datasource type, or table outside the curated catalog; the postgres rawSql contract refuses anything other than a SELECT/WITH single statement. The user reviews the typed proposal in the AI side panel, clicks Apply to editor to copy the draft into the manual JSON editor, and clicks the canonical Copy to clipboard button to paste it into their existing Grafana dashboard. The deterministic manual JSON editor and curated panel-builder catalog viewer remain the canonical baseline when Helix is off."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in Helix translator on the Grafana Panel Builder page (/power/grafana) that converts a natural-language data question into a typed Grafana panel JSON DRAFT (a single panel envelope — title, type, datasource, targets, grid_pos — against the curated install-wide panel-builder catalog of 8 panel types, 2 datasource types, and the same 5 tables nl-sql-playground exposes) by routing through two propose-only tools (draft_grafana_panel + validate_grafana_panel). The translator NEVER pushes the panel to Grafana — there is no apply or push tool; the per-request scope binding refuses any panel type, datasource type, or table outside the curated catalog; the postgres rawSql contract refuses anything other than a SELECT/WITH single statement. The user reviews the typed proposal in the AI side panel, clicks Apply to editor to copy the draft into the manual JSON editor, and clicks the canonical Copy to clipboard button to paste it into their existing Grafana dashboard. The deterministic manual JSON editor and curated panel-builder catalog viewer remain the canonical baseline when Helix is off."
          }
        },
