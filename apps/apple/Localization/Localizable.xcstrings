    "translation.ai.settings.feature.log-trace-summarization.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM narrator that summarizes one in-scope window of redacted log events and trace spans into a 3-6 sentence factual paragraph — what level breakdown the window held, which message templates dominated, which trace operations ran (with mean latency), and any structural signals worth investigating — by routing through two read-only tools that quote the same deterministic envelope the operator can already inspect manually. The narrator never invents log lines and never speculates about root cause. Per-request scope binding rejects any cross-window tool call to defend against prompt-injection exfiltration via operator-authored log messages. The deterministic SSE-backed live log table, level / grep / vehicle filter controls, pause/resume, and copy-to-clipboard / download controls on the Live Logs page remain the canonical baseline when Helix is off."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in LLM narrator that summarizes one in-scope window of redacted log events and trace spans into a 3-6 sentence factual paragraph — what level breakdown the window held, which message templates dominated, which trace operations ran (with mean latency), and any structural signals worth investigating — by routing through two read-only tools that quote the same deterministic envelope the operator can already inspect manually. The narrator never invents log lines and never speculates about root cause. Per-request scope binding rejects any cross-window tool call to defend against prompt-injection exfiltration via operator-authored log messages. The deterministic SSE-backed live log table, level / grep / vehicle filter controls, pause/resume, and copy-to-clipboard / download controls on the Live Logs page remain the canonical baseline when Helix is off."
          }
        },
