    "translation.ai.settings.feature.incident-timeline-summarizer.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM summarizer that condenses one incident's chronological timeline into a 3-6 sentence factual summary — what happened, what investigation steps the operator took, and how it resolved — by routing through two read-only tools that quote the same deterministic envelope the canonical incident page renders. The narrator never invents updates and never speculates about root cause. Per-request scope binding rejects any cross-incident tool call to defend against prompt-injection exfiltration via operator-authored text. The deterministic incident timeline list, append-update form, and lifecycle controls on the per-incident page remain the canonical baseline when Helix is off."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in LLM summarizer that condenses one incident's chronological timeline into a 3-6 sentence factual summary — what happened, what investigation steps the operator took, and how it resolved — by routing through two read-only tools that quote the same deterministic envelope the canonical incident page renders. The narrator never invents updates and never speculates about root cause. Per-request scope binding rejects any cross-incident tool call to defend against prompt-injection exfiltration via operator-authored text. The deterministic incident timeline list, append-update form, and lifecycle controls on the per-incident page remain the canonical baseline when Helix is off."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM summarizer that condenses one incident's chronological timeline into a 3-6 sentence factual summary — what happened, what investigation steps the operator took, and how it resolved — by routing through two read-only tools that quote the same deterministic envelope the canonical incident page renders. The narrator never invents updates and never speculates about root cause. Per-request scope binding rejects any cross-incident tool call to defend against prompt-injection exfiltration via operator-authored text. The deterministic incident timeline list, append-update form, and lifecycle controls on the per-incident page remain the canonical baseline when Helix is off."
          }
