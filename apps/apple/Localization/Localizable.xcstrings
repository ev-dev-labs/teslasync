    "translation.redis.diagnostic.noTelemetry.bodyStale": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Last L1 entry was %1$@. The 7-day Redis TTL has likely expired. Wait for the next telemetry push or warm the cache from the cold-path reader."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last L1 entry was %1$@. The 7-day Redis TTL has likely expired. Wait for the next telemetry push or warm the cache from the cold-path reader."
