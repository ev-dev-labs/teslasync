    },
    "translation.help.signal.diff": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Server-side comparison between two snapshots. Unchanged signals are omitted from the result to reduce noise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server-side comparison between two snapshots. Unchanged signals are omitted from the result to reduce noise."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Server-side comparison between two snapshots. Unchanged signals are omitted from the result to reduce noise."
          }
        }
      }
    },
    "translation.help.signal.layers": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TeslaSync exposes three live-state layers: L1 — in-process signal store on the API pod that ingested the telemetry (lowest latency, scope-limited to that pod). L2 — Redis-backed shared cache of latest values, visible to every pod, used for cross-pod live reads and SSE fanout. log — TimescaleDB signal_log history, authoritative for analytics, charts, and point-in-time reconstruction."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeslaSync exposes three live-state layers: L1 — in-process signal store on the API pod that ingested the telemetry (lowest latency, scope-limited to that pod). L2 — Redis-backed shared cache of latest values, visible to every pod, used for cross-pod live reads and SSE fanout. log — TimescaleDB signal_log history, authoritative for analytics, charts, and point-in-time reconstruction."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TeslaSync exposes three live-state layers: L1 — in-process signal store on the API pod that ingested the telemetry (lowest latency, scope-limited to that pod). L2 — Redis-backed shared cache of latest values, visible to every pod, used for cross-pod live reads and SSE fanout. log — TimescaleDB signal_log history, authoritative for analytics, charts, and point-in-time reconstruction."
          }
        }
      }
    },
    "translation.help.signal.live": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Live mode streams real-time signal values via Server-Sent Events (SSE). The chart maintains a rolling 5-minute window throttled to 2 Hz updates."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live mode streams real-time signal values via Server-Sent Events (SSE). The chart maintains a rolling 5-minute window throttled to 2 Hz updates."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Live mode streams real-time signal values via Server-Sent Events (SSE). The chart maintains a rolling 5-minute window throttled to 2 Hz updates."
          }
        }
      }
    },
    "translation.help.signal.snapshot": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A snapshot is a point-in-time view of every signal value at a single timestamp. The diff falls back to signal_log within the last 30 days when the live layer doesn't have it."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A snapshot is a point-in-time view of every signal value at a single timestamp. The diff falls back to signal_log within the last 30 days when the live layer doesn't have it."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A snapshot is a point-in-time view of every signal value at a single timestamp. The diff falls back to signal_log within the last 30 days when the live layer doesn't have it."
          }
        }
      }
    },
    "translation.help.signal.sourceLayer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The layer that supplied this value: L1 (in-process), L2 (Redis), LOG (TimescaleDB history), or STALE (older than 2 minutes)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The layer that supplied this value: L1 (in-process), L2 (Redis), LOG (TimescaleDB history), or STALE (older than 2 minutes)."
