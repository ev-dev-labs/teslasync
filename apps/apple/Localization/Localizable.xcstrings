    "translation.ai.settings.feature.alert-tuning-suggestions.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM that reads an existing AlertRule plus the rule's recent 30-day firing history and proposes a typed lower-noise patch (threshold, cooldown, severity, trigger-mode) — for example, raising the battery-low threshold or lengthening the cooldown when the rule has been firing 23 times a week. Surfaces a descriptive replay of the recent firing window (how often the rule would have fired under the proposed thresholds), explicitly NOT a prediction, and never persists the patch — the user reviews the typed draft inside the AlertStudio editor and clicks the canonical Save button to apply. The deterministic AlertStudio editor (manual threshold + cooldown tuning, severity selector, trigger-mode toggle, fired-history table) remains the canonical baseline when Helix is off."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in LLM that reads an existing AlertRule plus the rule's recent 30-day firing history and proposes a typed lower-noise patch (threshold, cooldown, severity, trigger-mode) — for example, raising the battery-low threshold or lengthening the cooldown when the rule has been firing 23 times a week. Surfaces a descriptive replay of the recent firing window (how often the rule would have fired under the proposed thresholds), explicitly NOT a prediction, and never persists the patch — the user reviews the typed draft inside the AlertStudio editor and clicks the canonical Save button to apply. The deterministic AlertStudio editor (manual threshold + cooldown tuning, severity selector, trigger-mode toggle, fired-history table) remains the canonical baseline when Helix is off."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM that reads an existing AlertRule plus the rule's recent 30-day firing history and proposes a typed lower-noise patch (threshold, cooldown, severity, trigger-mode) — for example, raising the battery-low threshold or lengthening the cooldown when the rule has been firing 23 times a week. Surfaces a descriptive replay of the recent firing window (how often the rule would have fired under the proposed thresholds), explicitly NOT a prediction, and never persists the patch — the user reviews the typed draft inside the AlertStudio editor and clicks the canonical Save button to apply. The deterministic AlertStudio editor (manual threshold + cooldown tuning, severity selector, trigger-mode toggle, fired-history table) remains the canonical baseline when Helix is off."
          }
        }
      }
    },
