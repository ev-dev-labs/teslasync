    "translation.ai.settings.feature.nl-sql-playground.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in Helix translator on the SQL Playground page (/power/sql) that converts a natural-language question into a typed read-only SQL DRAFT (a single SELECT or WITH statement against the curated install-wide schema catalog of drives, charging_sessions, vehicles, alerts, and signal_log_view) by routing through two propose-only tools (draft_readonly_sql + validate_readonly_sql). The translator NEVER executes SQL — there is no apply or execute tool; the deny-by-default keyword scan refuses INSERT, UPDATE, DELETE, DROP, ALTER, CREATE, TRUNCATE, GRANT, REVOKE, VACUUM, COPY, CALL, DO, MERGE, and EXECUTE; the per-request scope binding refuses any table reference outside the curated catalog. The user reviews the typed proposal in the AI side panel, clicks Apply to editor to copy the draft into the manual SQL editor, and clicks the canonical Run button to execute. The deterministic manual SQL editor and curated catalog viewer remain the canonical baseline when Helix is off."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in Helix translator on the SQL Playground page (/power/sql) that converts a natural-language question into a typed read-only SQL DRAFT (a single SELECT or WITH statement against the curated install-wide schema catalog of drives, charging_sessions, vehicles, alerts, and signal_log_view) by routing through two propose-only tools (draft_readonly_sql + validate_readonly_sql). The translator NEVER executes SQL — there is no apply or execute tool; the deny-by-default keyword scan refuses INSERT, UPDATE, DELETE, DROP, ALTER, CREATE, TRUNCATE, GRANT, REVOKE, VACUUM, COPY, CALL, DO, MERGE, and EXECUTE; the per-request scope binding refuses any table reference outside the curated catalog. The user reviews the typed proposal in the AI side panel, clicks Apply to editor to copy the draft into the manual SQL editor, and clicks the canonical Run button to execute. The deterministic manual SQL editor and curated catalog viewer remain the canonical baseline when Helix is off."
          }
        },
