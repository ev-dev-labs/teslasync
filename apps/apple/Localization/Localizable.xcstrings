    },
    "translation.help.replay.battery": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "State-of-charge percentage at this point. Drops indicate energy use; rises indicate regen or DC-fast-charging during a drive."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "State-of-charge percentage at this point. Drops indicate energy use; rises indicate regen or DC-fast-charging during a drive."
