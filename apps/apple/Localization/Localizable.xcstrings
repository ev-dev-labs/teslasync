    "translation.ai.settings.feature.pii-redaction-shared-exports.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in Helix advisor that recommends which PII classes to redact from a shared export on the Exports page — the highly-recommended classes for the chosen export type (drives, charging, trips, analytics, backup, account) plus the optional classes that depend on your consent — by routing through two read-only tools that consult a STATIC catalog of PII classes keyed by export type. The advisor is catalog-based, not a per-row PII scan: Helix never reads the rows of your export and never reports PII it actually saw; it surfaces the catalog's recommendations plus the assumptions inherited from the catalog. Per-request scope binding rejects any cross-export-type tool call to defend against prompt-injection exfiltration. The deterministic export-jobs list, bulk-delete toolbar, and download links remain the canonical baseline when Helix is off."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in Helix advisor that recommends which PII classes to redact from a shared export on the Exports page — the highly-recommended classes for the chosen export type (drives, charging, trips, analytics, backup, account) plus the optional classes that depend on your consent — by routing through two read-only tools that consult a STATIC catalog of PII classes keyed by export type. The advisor is catalog-based, not a per-row PII scan: Helix never reads the rows of your export and never reports PII it actually saw; it surfaces the catalog's recommendations plus the assumptions inherited from the catalog. Per-request scope binding rejects any cross-export-type tool call to defend against prompt-injection exfiltration. The deterministic export-jobs list, bulk-delete toolbar, and download links remain the canonical baseline when Helix is off."
          }
        },
