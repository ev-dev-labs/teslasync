    "translation.ai.settings.feature.range-prediction-model.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in statistical model that computes per-bucket (temperature × speed) mean Wh/km from this vehicle's recent drives (default 14 days, capped at 30) and proposes a learned range envelope, falling back per-bucket to the deterministic linear projection when fewer than 5 qualifying drives exist in the lookback window. Read-only: the trainer never writes to drives, never overwrites the heuristic curve, and the Helix narration walks the user through the learned vs. heuristic comparison via two typed tools (train_range_model then query_range_prediction). The deterministic linear projection + heuristic Wh/km curve at /projected-range remain the canonical baseline when Helix is off."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in statistical model that computes per-bucket (temperature × speed) mean Wh/km from this vehicle's recent drives (default 14 days, capped at 30) and proposes a learned range envelope, falling back per-bucket to the deterministic linear projection when fewer than 5 qualifying drives exist in the lookback window. Read-only: the trainer never writes to drives, never overwrites the heuristic curve, and the Helix narration walks the user through the learned vs. heuristic comparison via two typed tools (train_range_model then query_range_prediction). The deterministic linear projection + heuristic Wh/km curve at /projected-range remain the canonical baseline when Helix is off."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in statistical model that computes per-bucket (temperature × speed) mean Wh/km from this vehicle's recent drives (default 14 days, capped at 30) and proposes a learned range envelope, falling back per-bucket to the deterministic linear projection when fewer than 5 qualifying drives exist in the lookback window. Read-only: the trainer never writes to drives, never overwrites the heuristic curve, and the Helix narration walks the user through the learned vs. heuristic comparison via two typed tools (train_range_model then query_range_prediction). The deterministic linear projection + heuristic Wh/km curve at /projected-range remain the canonical baseline when Helix is off."
          }
        }
      }
    },
