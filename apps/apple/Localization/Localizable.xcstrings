    "translation.ai.settings.feature.feedback-queue-triage.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM advisor that proposes a status, category, and priority label for one in-scope user feedback row — by quoting the same redacted envelope (id, category, title, body excerpt, page route, app version, status, created_at) that an operator can already inspect manually in the queue — and routes the proposal through a closed-enum validator before the UI surfaces it as a recommendation chip. The advisor NEVER writes to user_feedback; the existing manual triage controls (status dropdown, category badge, priority chip, save button) remain the sole write path. Per-request scope binding rejects any cross-row tool call to defend against prompt-injection exfiltration via user-authored feedback text. The deterministic feedback queue table, filter / sort / search controls, per-row expansion, and manual triage controls on the Admin Feedback Queue page remain the canonical baseline when Helix is off."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in LLM advisor that proposes a status, category, and priority label for one in-scope user feedback row — by quoting the same redacted envelope (id, category, title, body excerpt, page route, app version, status, created_at) that an operator can already inspect manually in the queue — and routes the proposal through a closed-enum validator before the UI surfaces it as a recommendation chip. The advisor NEVER writes to user_feedback; the existing manual triage controls (status dropdown, category badge, priority chip, save button) remain the sole write path. Per-request scope binding rejects any cross-row tool call to defend against prompt-injection exfiltration via user-authored feedback text. The deterministic feedback queue table, filter / sort / search controls, per-row expansion, and manual triage controls on the Admin Feedback Queue page remain the canonical baseline when Helix is off."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM advisor that proposes a status, category, and priority label for one in-scope user feedback row — by quoting the same redacted envelope (id, category, title, body excerpt, page route, app version, status, created_at) that an operator can already inspect manually in the queue — and routes the proposal through a closed-enum validator before the UI surfaces it as a recommendation chip. The advisor NEVER writes to user_feedback; the existing manual triage controls (status dropdown, category badge, priority chip, save button) remain the sole write path. Per-request scope binding rejects any cross-row tool call to defend against prompt-injection exfiltration via user-authored feedback text. The deterministic feedback queue table, filter / sort / search controls, per-row expansion, and manual triage controls on the Admin Feedback Queue page remain the canonical baseline when Helix is off."
          }
