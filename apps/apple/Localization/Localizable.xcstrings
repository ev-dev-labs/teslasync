          "stringUnit": {
            "state": "needs_review",
            "value": "The API server is configured to use Redis, but the connection failed. Check that the Redis pod is running, that network policies allow the API to reach it, and review API server logs for \"redis signal cache: GetAll failed\"."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API server is configured to use Redis, but the connection failed. Check that the Redis pod is running, that network policies allow the API to reach it, and review API server logs for \"redis signal cache: GetAll failed\"."
          }
        },
