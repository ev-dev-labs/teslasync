    "translation.tco.aiNarration.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ask Helix to walk through the deterministic operating-cost figures shown below — the EV charging spend, the equivalent gas cost, the cumulative savings, and the cost-per-kilometre comparison. The narrator quotes the same numbers the chart shows and is honest about the four limiting assumptions: operating cost only (no depreciation, resale, insurance, registration, or financing); a flat $50/month maintenance heuristic; equivalent gas cost estimated from charged energy not real-world distance; and gas-price / efficiency / electricity-rate defaults from your editable Settings."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Helix to walk through the deterministic operating-cost figures shown below — the EV charging spend, the equivalent gas cost, the cumulative savings, and the cost-per-kilometre comparison. The narrator quotes the same numbers the chart shows and is honest about the four limiting assumptions: operating cost only (no depreciation, resale, insurance, registration, or financing); a flat $50/month maintenance heuristic; equivalent gas cost estimated from charged energy not real-world distance; and gas-price / efficiency / electricity-rate defaults from your editable Settings."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ask Helix to walk through the deterministic operating-cost figures shown below — the EV charging spend, the equivalent gas cost, the cumulative savings, and the cost-per-kilometre comparison. The narrator quotes the same numbers the chart shows and is honest about the four limiting assumptions: operating cost only (no depreciation, resale, insurance, registration, or financing); a flat $50/month maintenance heuristic; equivalent gas cost estimated from charged energy not real-world distance; and gas-price / efficiency / electricity-rate defaults from your editable Settings."
          }
        }
      }
    },
