    "translation.safetySettings.rows.alertDigestMode.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "How alerts are batched. Instant delivers each alert as it fires; Hourly batches into one digest per hour; Daily batches into one digest per day."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How alerts are batched. Instant delivers each alert as it fires; Hourly batches into one digest per hour; Daily batches into one digest per day."
          }
        },
        "he": {
