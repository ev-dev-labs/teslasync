    "translation.ai.settings.feature.inbox-auto-categorization.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM that reads recent notification-log rows for the requested vehicle plus severity filter, buckets them into a closed taxonomy of nine categories (battery, charging, climate, tire, security, connectivity, maintenance, noise, other) using a deterministic substring mapper over the alert rule's signal name, and proposes which category buckets dominate the inbox over the recent window. Surfaces a descriptive count over the chosen window — explicitly NOT a forecast — and never assigns labels to rows; the user reviews the typed proposal inside the inbox panel and clicks Apply categories as filter to copy the proposed rule_id list into the existing URL-backed inbox filter. The deterministic inbox (manual severity / vehicle / rule_id filters, free-text search, day-grouped + threaded views, bulk actions) remains the canonical baseline when Helix is off."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in LLM that reads recent notification-log rows for the requested vehicle plus severity filter, buckets them into a closed taxonomy of nine categories (battery, charging, climate, tire, security, connectivity, maintenance, noise, other) using a deterministic substring mapper over the alert rule's signal name, and proposes which category buckets dominate the inbox over the recent window. Surfaces a descriptive count over the chosen window — explicitly NOT a forecast — and never assigns labels to rows; the user reviews the typed proposal inside the inbox panel and clicks Apply categories as filter to copy the proposed rule_id list into the existing URL-backed inbox filter. The deterministic inbox (manual severity / vehicle / rule_id filters, free-text search, day-grouped + threaded views, bulk actions) remains the canonical baseline when Helix is off."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM that reads recent notification-log rows for the requested vehicle plus severity filter, buckets them into a closed taxonomy of nine categories (battery, charging, climate, tire, security, connectivity, maintenance, noise, other) using a deterministic substring mapper over the alert rule's signal name, and proposes which category buckets dominate the inbox over the recent window. Surfaces a descriptive count over the chosen window — explicitly NOT a forecast — and never assigns labels to rows; the user reviews the typed proposal inside the inbox panel and clicks Apply categories as filter to copy the proposed rule_id list into the existing URL-backed inbox filter. The deterministic inbox (manual severity / vehicle / rule_id filters, free-text search, day-grouped + threaded views, bulk actions) remains the canonical baseline when Helix is off."
          }
        }
      }
    },
