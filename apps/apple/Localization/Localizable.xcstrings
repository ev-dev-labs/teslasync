    "translation.ai.settings.feature.signal-explorer-nl-filter.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM that translates a natural-language filter request (e.g. \"battery level for yesterday\") into a typed SignalFilter draft the Signal Explorer page can apply with one click. PROPOSE-ONLY: the LLM routes through two propose-only tools that enforce the same per-vehicle signal catalog and range/per-page enumerations the deterministic SignalSelector + RangePicker + PER_PAGE Select honour, and the user reviews the typed proposal in the Helix panel and clicks Apply to copy it into the form. The LLM never edits filter state directly. Per-request scope binding rejects any signal name not in the in-scope per-vehicle catalog and any vehicle_id mismatch to defend against prompt-injection. The deterministic SignalSelector, RangePicker, page-size Select, and Explore / Live buttons on /signals/explorer remain the canonical baseline when Helix is off."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in LLM that translates a natural-language filter request (e.g. \"battery level for yesterday\") into a typed SignalFilter draft the Signal Explorer page can apply with one click. PROPOSE-ONLY: the LLM routes through two propose-only tools that enforce the same per-vehicle signal catalog and range/per-page enumerations the deterministic SignalSelector + RangePicker + PER_PAGE Select honour, and the user reviews the typed proposal in the Helix panel and clicks Apply to copy it into the form. The LLM never edits filter state directly. Per-request scope binding rejects any signal name not in the in-scope per-vehicle catalog and any vehicle_id mismatch to defend against prompt-injection. The deterministic SignalSelector, RangePicker, page-size Select, and Explore / Live buttons on /signals/explorer remain the canonical baseline when Helix is off."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM that translates a natural-language filter request (e.g. \"battery level for yesterday\") into a typed SignalFilter draft the Signal Explorer page can apply with one click. PROPOSE-ONLY: the LLM routes through two propose-only tools that enforce the same per-vehicle signal catalog and range/per-page enumerations the deterministic SignalSelector + RangePicker + PER_PAGE Select honour, and the user reviews the typed proposal in the Helix panel and clicks Apply to copy it into the form. The LLM never edits filter state directly. Per-request scope binding rejects any signal name not in the in-scope per-vehicle catalog and any vehicle_id mismatch to defend against prompt-injection. The deterministic SignalSelector, RangePicker, page-size Select, and Explore / Live buttons on /signals/explorer remain the canonical baseline when Helix is off."
