    "translation.redis.diagnostic.mirrorBroken.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The in-process L1 store has %1$@ signals for this vehicle but Redis is empty. The async mirror goroutine in HybridLiveSignalStore.UpdateNonBlocking may be timing out or the Redis connection may be saturated. Check pod logs for \"live signal store: Redis mirror failed\"."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The in-process L1 store has %1$@ signals for this vehicle but Redis is empty. The async mirror goroutine in HybridLiveSignalStore.UpdateNonBlocking may be timing out or the Redis connection may be saturated. Check pod logs for \"live signal store: Redis mirror failed\"."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The in-process L1 store has %1$@ signals for this vehicle but Redis is empty. The async mirror goroutine in HybridLiveSignalStore.UpdateNonBlocking may be timing out or the Redis connection may be saturated. Check pod logs for \"live signal store: Redis mirror failed\"."
          }
        }
      }
    },
