    "translation.ai.settings.feature.mqtt-sse-inspector-explanations.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM narrator that summarizes one in-scope window of the MQTT broker, SSE hub, and background-job state into a 3-6 sentence factual paragraph — whether the broker is connected, how many vehicles are actively streaming, how many are stale, what aggregate signals-per-second the pipeline holds, how many SSE clients are subscribed, and whether the background jobs (signal_log writer, snapshot rollover, alert engine) ran recently — by routing through two read-only tools that quote the same deterministic broker-status envelope the operator can already inspect manually. The narrator never invents a stream state and never speculates about root cause. Per-request scope binding rejects any cross-window tool call to defend against prompt-injection exfiltration via broker topic strings. Broker hostnames, ports, SSE client identifiers, and VINs are redacted before the message reaches the provider. The deterministic broker-status snapshot panel, per-vehicle stream stats table, throughput chart, and topic-pattern badges on the MQTT Inspector page remain the canonical baseline when Helix is off."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in LLM narrator that summarizes one in-scope window of the MQTT broker, SSE hub, and background-job state into a 3-6 sentence factual paragraph — whether the broker is connected, how many vehicles are actively streaming, how many are stale, what aggregate signals-per-second the pipeline holds, how many SSE clients are subscribed, and whether the background jobs (signal_log writer, snapshot rollover, alert engine) ran recently — by routing through two read-only tools that quote the same deterministic broker-status envelope the operator can already inspect manually. The narrator never invents a stream state and never speculates about root cause. Per-request scope binding rejects any cross-window tool call to defend against prompt-injection exfiltration via broker topic strings. Broker hostnames, ports, SSE client identifiers, and VINs are redacted before the message reaches the provider. The deterministic broker-status snapshot panel, per-vehicle stream stats table, throughput chart, and topic-pattern badges on the MQTT Inspector page remain the canonical baseline when Helix is off."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opt-in LLM narrator that summarizes one in-scope window of the MQTT broker, SSE hub, and background-job state into a 3-6 sentence factual paragraph — whether the broker is connected, how many vehicles are actively streaming, how many are stale, what aggregate signals-per-second the pipeline holds, how many SSE clients are subscribed, and whether the background jobs (signal_log writer, snapshot rollover, alert engine) ran recently — by routing through two read-only tools that quote the same deterministic broker-status envelope the operator can already inspect manually. The narrator never invents a stream state and never speculates about root cause. Per-request scope binding rejects any cross-window tool call to defend against prompt-injection exfiltration via broker topic strings. Broker hostnames, ports, SSE client identifiers, and VINs are redacted before the message reaches the provider. The deterministic broker-status snapshot panel, per-vehicle stream stats table, throughput chart, and topic-pattern badges on the MQTT Inspector page remain the canonical baseline when Helix is off."
