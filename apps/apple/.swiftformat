# SwiftFormat — TeslaSync Apple app (run: `swiftformat --lint apps/apple`)
--swiftversion 6.0
--maxwidth 120
--disable environmentEntry
--exclude Frameworks,build,DerivedData

# Rule tweaks aligned with SwiftLint above.
--self remove
--importgrouping testable-bottom
--commas inline
--trimwhitespace always
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
