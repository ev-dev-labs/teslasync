/*
  BatteryGaugeWidget.strings
  TeslaSync — P4 dashboard widget · 0013 · BatteryGaugeWidget (Apple)

  The P1/S10 i18n catalog contribution for this surface. Every key the native
  `BatteryGaugeWidget` resolves (table "BatteryGaugeWidget") lives here with its
  web `t(key, default)` English value. These entries fold into the app
  `Localizable.xcstrings` master catalog at integration time; they are kept in a
  per-surface table so each parallel surface prompt owns its own strings without
  editing the shared catalog.

  The first group is the exact keys extracted from the web source
  (features/dashboard/widgets/BatteryGaugeWidget.tsx) — the gauge label, the
  charging caption, and the empty-state copy. The remaining keys back the
  native-only chrome (freshness chip, refresh/retry/loading/error/banner copy)
  and the VoiceOver template.
*/

/* --- Keys from the web source (parity) --- */
"widget.battery" = "Battery";
"widget.charging" = "Charging";
"widget.noBattery" = "No battery data";

/* --- Registry metadata (registry/battery.ts → "battery-gauge") --- */
"widget.battery.title" = "Battery Level";
"widget.battery.description" = "Battery percentage with radial gauge";

/* --- Native chrome: freshness + actions --- */
"widget.battery.live" = "Live";
"widget.battery.stale" = "Stale";
"widget.battery.offline" = "Offline";
"widget.battery.refresh" = "Refresh";
"widget.battery.retry" = "Retry";

/* --- Native chrome: states --- */
"widget.battery.loading" = "Loading battery level";
"widget.battery.emptyHint" = "Battery level appears here once the vehicle reports state.";
"widget.battery.errorTitle" = "Couldn't load battery level";
"widget.battery.staleBanner" = "Reconnecting — level may be stale";
"widget.battery.offlineBanner" = "Offline — showing last known level";

/* --- Accessibility (VoiceOver template) --- */
"widget.battery.a11y" = "Battery %1$@ percent";
