/*
  SentryEventLogWidget.strings
  TeslaSync — P4 dashboard widget · 0086 · SentryEventLogWidget (Apple)

  The P1/S10 i18n catalog contribution for this surface. Every key the native
  `SentryEventLogWidget` resolves (table "SentryEventLogWidget") lives here with its
  web English value. These entries fold into the app `Localizable.xcstrings` master
  catalog at integration time; they are kept in a per-surface table so each parallel
  surface prompt owns its own strings without editing the shared catalog.

  The first group holds the keys extracted verbatim from the web source
  (features/dashboard/widgets/SentryEventLogWidget.tsx): the widget title and the
  empty-feed message. The web `deriveEvent` titles + subtitle fragments are hardcoded
  literals in the web source; the native port routes them through this table (with the
  exact web English as the fallback value) so the Swift view holds no literals. The
  remaining keys back the native-only chrome (freshness chip, refresh/retry/empty/
  error copy, accessibility).
*/

/* --- Keys from the web source (parity) --- */
"widget.sentryEventLog" = "Sentry Event Log";
"widget.sentryEventLog.description" = "Recent sentry events with timestamps";
"widget.noSentryEvents" = "No security events recorded";

/* --- Event titles (web `deriveEvent` `title`) --- */
"widget.sentryDoorOpen" = "Door open: %@";
"widget.sentryActivated" = "Sentry Mode activated";
"widget.sentryDeactivated" = "Sentry Mode deactivated";
"widget.sentryLockedTitle" = "Vehicle locked";
"widget.sentryUnlockedTitle" = "Vehicle unlocked";
"widget.sentryUpdated" = "Security state updated";

/* --- Subtitle fragments (web `parts` join) --- */
"widget.sentryLocked" = "🔒 Locked";
"widget.sentryUnlocked" = "🔓 Unlocked";
"widget.sentryOn" = "🛡️ Sentry On";
"widget.sentryOff" = "Sentry Off";

/* --- Native chrome: freshness + actions --- */
"widget.open" = "Open";
"widget.sentryLive" = "Live";
"widget.sentryStale" = "Stale";
"widget.sentryOffline" = "Offline";
"widget.sentryRefresh" = "Refresh";
"widget.sentryRetry" = "Retry";

/* --- Native chrome: states --- */
