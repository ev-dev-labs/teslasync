/*
  BatteryDegradationForecastWidget.strings
  TeslaSync — P4 dashboard widget · 0011 · BatteryDegradationForecastWidget (Apple)

  The P1/S10 i18n catalog contribution for this surface. Every key the native
  BatteryDegradationForecastWidget resolves (table
