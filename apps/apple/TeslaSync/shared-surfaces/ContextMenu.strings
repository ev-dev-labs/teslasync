/*
  ContextMenu.strings
  TeslaSync — P4 shared surface · 0206 · ContextMenu (Apple)

  The P1/S10 i18n catalog contribution for this surface — the native peer of the one routed literal in
  `components/ui/ContextMenu.tsx` (`aria-label={t('contextMenu.menuLabel', 'Context menu')}`) plus the
  native accessibility additions. The native surface routes every string through the facade per the
  no-hardcoded-English rule.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept
  in a per-surface table ("ContextMenu") so each parallel surface prompt owns its own strings. In test /
  preview bundles `NSLocalizedString` returns the value below, keeping the labels deterministic.
*/

/* --- Web key (from components/ui/ContextMenu.tsx) --- */

/* The menu container's accessible name (web `t('contextMenu.menuLabel', 'Context menu')`). */
"contextMenu.menuLabel" = "Context menu";

/* --- Native a11y additions --- */

/* Friendly body shown when a menu is asked to render with no rows, so the surface never renders a blank
   box. The web silently refuses to open an empty menu. */
"contextMenu.empty" = "No actions";

/* The tap-outside-to-close backdrop's accessible name — the native peer of the web document
   `pointerdown`-to-close listener. */
"contextMenu.dismiss" = "Dismiss menu";

/* VoiceOver value announced for a destructive row — the web only tints the row red; the native surface
   also names the consequence. */
"contextMenu.destructive" = "Destructive";

/* VoiceOver value announced for a disabled row — the native peer of the web `aria-disabled`. */
"contextMenu.unavailable" = "Unavailable";
