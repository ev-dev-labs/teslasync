/*
  DateGroupedList.strings
  TeslaSync — P4 shared surface · 0080 · DateGroupedList (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/data-display/DateGroupedList.tsx) is anonymous — it resolves no strings, because the
  caller pre-formats every label it renders (the date label, the relative time, and the summary such
  as "2 drives · 6.2 mi"). The only keys here are therefore the native P4 chrome: the friendly
  empty-state copy (the web renders a blank container; P4 forbids a bare box) and the VoiceOver
  item-count fallback spoken when a group carries no caller summary (singular / plural so "1 item" is
  never voiced as "1 items"). These entries fold into the app `Localizable.xcstrings` master catalog
  at integration time; they are kept in a per-surface table ("DateGroupedList") so each parallel
  surface prompt owns its own strings.
*/

/* --- Empty state (native P4 leaf state — web collapses to a blank container) --- */
"dategroupedlist.empty.title" = "Nothing here yet";
"dategroupedlist.empty.message" = "Items will appear here, grouped by day, as they're recorded.";

/* --- VoiceOver item-count fallback (spoken when a group has no caller summary) --- */
"dategroupedlist.a11y.itemCount.one" = "%lld item";
"dategroupedlist.a11y.itemCount.other" = "%lld items";
