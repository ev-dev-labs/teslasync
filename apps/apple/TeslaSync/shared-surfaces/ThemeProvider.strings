/*
  ThemeProvider.strings
  TeslaSync — P4 shared surface · 0229 · ThemeProvider (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/ui/ThemeProvider.tsx) is a transparent context provider with no user-facing copy of its
  own — its only "strings" are the human display names baked into the `themes` / `modes` tables
  (`name: 'Neon Cyan'`, `name: 'Dark'`, …). Those names are mirrored verbatim below so a native theme
  picker built on this provider shows the same labels as the web settings page.

  The status + accessibility keys are native additions: the web provider hydrates from `/settings`
  silently, whereas the native surface exposes that lifecycle through `ThemeSyncStatusBadge`
  (loading / synced / local-only / stale / failed / offline) and gives every swatch a VoiceOver label.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are
  kept in a per-surface table ("ThemeProvider") so each parallel surface prompt owns its own strings.
*/

/* --- Colorway names (web `themes[*].name`, mirrored verbatim) --- */
"themeProvider.colorway.neonCyan" = "Neon Cyan";
"themeProvider.colorway.teslaRed" = "Tesla Red";
"themeProvider.colorway.matrixGreen" = "Matrix Green";
"themeProvider.colorway.royalPurple" = "Royal Purple";
"themeProvider.colorway.solarAmber" = "Solar Amber";
"themeProvider.colorway.custom" = "Custom";

/* --- Mode names (web `modes[*].name`, mirrored verbatim) --- */
"themeProvider.mode.dark" = "Dark";
"themeProvider.mode.light" = "Light";
"themeProvider.mode.oled" = "OLED Black";
"themeProvider.mode.midnight" = "Midnight Blue";
"themeProvider.mode.auto" = "Auto (System)";
"themeProvider.mode.sunset" = "Sunset";
"themeProvider.mode.nord" = "Nord";

/* --- Backend-sync status (native affordance over the web's silent /settings hydrate) --- */
"themeProvider.status.loading" = "Syncing theme…";
"themeProvider.status.synced" = "Theme synced";
"themeProvider.status.local" = "Using local theme";
"themeProvider.status.stale" = "Theme out of date — refreshing";
"themeProvider.status.failed" = "Couldn't sync theme";
"themeProvider.status.offline" = "Offline — using local theme";
"themeProvider.status.retry" = "Retry";
"themeProvider.status.a11y" = "Theme sync status: %@";
"themeProvider.status.retry.a11y" = "Retry theme sync";

/* --- Swatch accessibility --- */
"themeProvider.swatch.colorway.a11y" = "%@ colorway";
"themeProvider.swatch.mode.a11y" = "%@ mode";
