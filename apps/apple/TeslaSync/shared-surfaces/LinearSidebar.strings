"nav.vehicleCount" = "{{count}} vehicles";
"nav.staleCount" = "{{count}} stale rows";

/* --- Native-realized affordances (filter field + no-data empty state) --- */
"nav.filterPrompt" = "Filter";
"nav.empty" = "No navigation items.";

