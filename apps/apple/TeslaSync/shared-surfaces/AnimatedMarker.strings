/*
  AnimatedMarker.strings
  TeslaSync — P4 shared surface · 0184 · AnimatedMarker (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/maps/AnimatedMarker.tsx) is anonymous — it renders a leaflet `DivIcon` marker with no
  visible copy. These keys therefore cover the chrome the native surface introduces around the MapKit
  marker: the map / marker accessibility names, the P4 leaf connectivity axis (chip + banner), the
  marker info chip (coordinates + heading), and the loading / empty / error overlays (every state
  renders). These entries fold into the app `Localizable.xcstrings` master catalog at integration
  time; they are kept in a per-surface table ("AnimatedMarker") so each parallel surface prompt owns
  its own strings.
*/

/* --- Map + marker accessibility --- */
"animatedMarker.mapA11y" = "Vehicle position map";
"animatedMarker.markerA11y" = "Vehicle position";

/* --- Marker info chip (coordinates + heading) --- */
"animatedMarker.coordinates" = "Coordinates";
"animatedMarker.heading" = "Heading";

/* --- Loading / empty / error overlays (every state renders) --- */
"animatedMarker.loading" = "Locating…";
"animatedMarker.empty" = "No location";
"animatedMarker.emptyDetail" = "No position is available to show on the map yet.";
"animatedMarker.error" = "Couldn't load position";
"animatedMarker.errorDetail" = "We couldn't update the position. Showing the last known location.";

/* --- Shared actions --- */
"action.retry" = "Retry";

/* --- Freshness (P4 connectivity axis) --- */
"animatedMarker.live" = "Live";
"animatedMarker.stale" = "Stale";
"animatedMarker.offline" = "Offline";
"animatedMarker.staleA11y" = "Stale — tap refresh to update";
"animatedMarker.offlineA11y" = "Offline — showing the last known position";
"animatedMarker.refresh" = "Refresh";

/* --- Connectivity banner (P4 leaf state) --- */
"animatedMarker.staleBanner" = "Reconnecting — position may be stale";
"animatedMarker.offlineBanner" = "Offline — showing last known position";
