/*
  Lightbox.strings
  TeslaSync — P4 shared surface · 0219 · Lightbox (Apple)

  The P1/S10 i18n catalog contribution for this surface — the faithful mirror of the web `t(key, default)`
  calls in `components/ui/Lightbox.tsx`, plus the native additions a SwiftUI immersive viewer needs (the
  dialog / image / loading VoiceOver labels and the empty + error envelopes that keep the frame from ever
  going to an unexplained blank box). The web interpolation templates (`{{current}} / {{total}}`, `{{value}}%`)
  are kept verbatim — `LightboxStrings.interpolate` substitutes the `{{…}}` tokens, the native peer of i18next.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept in
  a per-surface table ("Lightbox") so each parallel surface prompt owns its own strings. In test / preview
  bundles `NSLocalizedString` returns the value below, keeping the labels deterministic.
*/

/* --- Web keys (mirrored verbatim from the source `t()` calls) --- */

/* Position readout "n / total" (web `lightbox.counter`). `{{current}}` is 1-based. */
"lightbox.counter" = "{{current}} / {{total}}";

/* Close-button accessibility label (web `lightbox.close`). */
"lightbox.close" = "Close image viewer";

/* Previous-image button accessibility label (web `lightbox.previous`). */
"lightbox.previous" = "Previous image";

/* Next-image button accessibility label (web `lightbox.next`). */
"lightbox.next" = "Next image";

/* Zoom-out button accessibility label (web `lightbox.zoomOut`). */
"lightbox.zoomOut" = "Zoom out";

/* Zoom-in button accessibility label (web `lightbox.zoomIn`). */
"lightbox.zoomIn" = "Zoom in";

/* Reset-zoom button accessibility label (web `lightbox.zoomReset`). */
"lightbox.zoomReset" = "Reset zoom";

/* Zoom percentage readout (web `lightbox.zoomPercent`). */
"lightbox.zoomPercent" = "{{value}}%";

/* --- Native additions (no web `t()` key exists; SwiftUI a11y + state envelopes) --- */

/* Dialog accessibility label (native peer of web `role="dialog"` + `aria-modal`). */
"lightbox.dialog" = "Image viewer";

/* VoiceOver label for an image whose `alt` is empty (decorative), so it is never announced silently. */
"lightbox.image" = "Image";

/* VoiceOver status announced while the current image decodes (native peer of the web skeleton overlay). */
"lightbox.loading" = "Loading image";

/* VoiceOver hint announced when the image is magnified — a drag pans (native HIG addition). */
"lightbox.panHint" = "Drag to pan";

/* Title of the empty state, shown when an open viewer has no images (web returns null; native never blank). */
"lightbox.empty.title" = "No images to show";

/* Supporting line of the empty state. */
"lightbox.empty.message" = "Images appear here when they become available.";

/* Title of the error envelope, shown when the current image fails to load (web `onError`). */
"lightbox.error.title" = "Image failed to load";

/* Supporting line of the error envelope (covers an offline fetch). */
"lightbox.error.message" = "Check your connection and try again.";

/* Retry button label inside the error envelope. */
"lightbox.error.retry" = "Try again";
