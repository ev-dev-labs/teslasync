/*
  VehicleHeroCard.strings
  TeslaSync — P4 shared surface · 0233 · VehicleHeroCard (Apple)

  The P1/S10 i18n catalog contribution for this surface — the native peer of the strings used by
  `web/src/components/vehicles/VehicleHeroCard.tsx`. The web component's `t()` keys are mirrored VERBATIM
  below (same key, same English fallback) so the native surface resolves the identical catalog entries:
    • vehicleHero.photo.alt        — the "{{name}} photo" image alt (interpolated with the display name)
    • vehicleHero.gauge.*          — the Battery / Range / Inside / Outside gauge labels
    • vehicleHero.stat.*           — the eight stat-card labels
    • vehicleHero.locked / .unlocked — the lock-state value words
    • common.on / common.off       — the sentry-state value words (shared keys, as in the web source)
    • vehicleHero.action.*         — the Details / Commands / Live Map action labels

  The remaining entries are the NATIVE chrome / accessibility additions for the P4 always-render leaf states
  (loading / empty / error / no-live-data) and the freshness axis (live / stale / offline) — the web renders
  nothing for those and has no loading / error / connectivity chrome, whereas the native HIG calls for a
  labelled state rather than a blank box.

  These fold into the app `Localizable.xcstrings` master catalog at integration time; kept in a per-surface
  table ("VehicleHeroCard") so each parallel surface prompt owns its own strings. In test / preview bundles
  `NSLocalizedString` returns the value below, keeping the labels deterministic.
*/

/* --- Web source keys (verbatim) --- */

/* The hero photo alt text (web `t('vehicleHero.photo.alt', '{{name}} photo', { name })`). */
"vehicleHero.photo.alt" = "{{name}} photo";

/* Gauge labels (web `t('vehicleHero.gauge.*', …)`). */
"vehicleHero.gauge.battery" = "Battery";
"vehicleHero.gauge.range" = "Range";
"vehicleHero.gauge.inside" = "Inside";
"vehicleHero.gauge.outside" = "Outside";

/* Stat-card labels (web `t('vehicleHero.stat.*', …)`). */
"vehicleHero.stat.insideTemp" = "Inside Temp";
"vehicleHero.stat.outsideTemp" = "Outside Temp";
"vehicleHero.stat.odometer" = "Odometer";
"vehicleHero.stat.range" = "Range";
"vehicleHero.stat.status" = "Status";
"vehicleHero.stat.sentry" = "Sentry";
"vehicleHero.stat.firmware" = "Firmware";
"vehicleHero.stat.power" = "Power";

/* Lock-state value words (web `t('vehicleHero.locked'/'unlocked', …)`). */
"vehicleHero.locked" = "Locked";
"vehicleHero.unlocked" = "Unlocked";

/* Sentry-state value words (web shared `t('common.on'/'common.off', …)`). */
"common.on" = "On";
"common.off" = "Off";

/* Action labels (web `t('vehicleHero.action.*', …)`). */
"vehicleHero.action.details" = "Details";
"vehicleHero.action.commands" = "Commands";
"vehicleHero.action.liveMap" = "Live Map";

/* --- Native chrome / a11y additions (no blank box — see the leaf states) --- */

/* VoiceOver label for the initial loading skeleton (web has no loading state). */
"vehicleHero.loadingA11y" = "Loading vehicle";

/* Empty state — no vehicle to show (web has no peer). */
"vehicleHero.empty.title" = "No vehicle";
"vehicleHero.empty.message" = "Select a vehicle to see its live status.";

/* Error tile shown when the vehicle / state read fails (web has no QueryError peer). */
"vehicleHero.errorTitle" = "Couldn't load vehicle";
"vehicleHero.retry" = "Retry";

/* No-live-data fallback shown when a vehicle has no live state (web hides the gauges + stats). */
"vehicleHero.noLiveData.title" = "No live data";
"vehicleHero.noLiveData.message" = "This vehicle hasn't reported live telemetry yet.";

/* Freshness chip labels — the live-state freshness axis. */
"vehicleHero.live" = "Live";
"vehicleHero.stale" = "Stale";
"vehicleHero.offline" = "Offline";

/* Expanded VoiceOver labels for the freshness chip (it is a refresh button). */
"vehicleHero.staleA11y" = "Stale — tap to refresh";
"vehicleHero.offlineA11y" = "Offline — showing the last value";

/* Connectivity banner messages (stale / offline). */
"vehicleHero.staleBanner" = "Showing data that may be out of date.";
"vehicleHero.offlineBanner" = "You're offline. Showing the last known values.";

/* Refresh action (banner + error tile). */
"vehicleHero.refresh" = "Refresh";

/* Accessibility label prefixes for the VIN line and the status badge. */
"vehicleHero.vinA11y" = "VIN";
"vehicleHero.statusA11y" = "Status";
