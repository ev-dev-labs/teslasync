/*
  RequiresAuth.strings
  TeslaSync — P4 shared surface · 0137 · RequiresAuth (Apple)

  The P1/S10 i18n catalog contribution for this surface. Every key the native `RequiresAuth` resolves
  (table "RequiresAuth") lives here with its web `t(key, default)` English value. These entries fold
  into the app `Localizable.xcstrings` master catalog at integration time; they are kept in a
  per-surface table so each parallel surface prompt owns its own strings without editing the shared
  catalog.

  The first group is the exact set of keys extracted from the web source
  (components/feedback/RequiresAuth.tsx). The second group backs the native chrome (the loading /
  error envelopes + the P4 freshness / cached-data copy) so the Swift sources hold no English literals.
*/

/* --- Keys from the web source (parity) --- */
"requiresAuth.title" = "{{feature}} requires authentication mode";
"requiresAuth.body" = "{{feature}} is only available when TeslaSync is configured behind an authentication provider (Authentik, Authelia, oauth2-proxy, Keycloak, or similar). Set FORWARD_AUTH_HEADER on the API service to enable it.";
"requiresAuth.bodyWithHint" = "{{feature}} is only available when TeslaSync is configured behind an authentication provider ({{provider}}). Set FORWARD_AUTH_HEADER on the API service to enable it.";

/* --- Native chrome: loading / error + retry --- */
"requiresAuth.loading" = "Checking access…";
"requiresAuth.errorTitle" = "Couldn't check access";
"requiresAuth.retry" = "Retry";

/* --- Native chrome: freshness chip (Live / Stale / Offline) --- */
"requiresAuth.live" = "Live";
"requiresAuth.stale" = "Stale";
"requiresAuth.offline" = "Offline";

/* --- Native chrome: connectivity banner (stale / offline) --- */
"requiresAuth.staleBanner" = "Reconnecting — this access mode may be out of date";
"requiresAuth.offlineBanner" = "Offline — showing the last known access mode";
