/*
  BottomTabBar.strings
  TeslaSync — P4 shared surface · 0165 · BottomTabBar (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web `components/layout/BottomTabBar.tsx` resolves
  every label through `t(key, default)`, so the six `nav.*` keys below are mirrored VERBATIM from the source
  (the nav aria-label + the five tab labels). The one extra entry — `bottomTabBar.empty` — is a native addition
  (the web `TABS` constant is never empty), the copy for the "never a blank box" empty-catalog leaf.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept in a
  per-surface table ("BottomTabBar") so each parallel surface prompt owns its own strings. In test / preview
  bundles `NSLocalizedString` returns the value below, keeping the labels deterministic.
*/

/* --- Web `t()` keys (mirrored verbatim from BottomTabBar.tsx) --- */

/* The bottom navigation region's accessibility label (web nav `aria-label`). */
"nav.quickNav" = "Quick navigation";

/* The Dashboard tab label (web tab path "/"). */
"nav.dashboard" = "Home";

/* The Drives tab label (web tab path "/drives"). */
"nav.drives" = "Drives";

/* The Charging tab label (web tab path "/charging"). */
"nav.charging" = "Charging";

/* The Battery tab label (web tab path "/battery"). */
"nav.battery" = "Battery";

/* The Map tab label (web tab path "/live"). */
"nav.liveMap" = "Map";

/* --- Native addition (no web key exists; the web TABS constant is never empty) --- */

/* The empty-catalog leaf copy, shown when a host passes no tabs so the bar is never a bare box. */
"bottomTabBar.empty" = "No destinations available";
