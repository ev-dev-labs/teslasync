/*
  Select.strings
  TeslaSync — P4 shared surface · 0225 · Select (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/ui/Select.tsx) resolves NONE of its own copy: its `label`, `error`,
  `hint`, and `prompt` arrive as already-localized props, it delegates the
  screen-reader "required" suffix to `<Label>` (the `form.required` key) and the
  help-trigger copy to `<HelpIcon>`. The only strings this native surface OWNS are
  the accessibility leaves the SwiftUI control needs and the web `<select>` does
  not: the empty-options copy (native "never a blank box" HIG peer), the spoken
  name for a label-less control, and the "required" suffix folded into the
  control's accessible name (the native peer of `aria-required`, which the web
  reads off the paired `<Label>` association rather than a key of its own).

  These entries fold into the app `Localizable.xcstrings` master catalog at
  integration time; they are kept in a per-surface table ("Select") so each
  parallel surface prompt owns its own strings without editing the shared catalog.
*/

/* --- Empty leaf (native "never a blank box"; web renders an empty <select>) --- */
"select.empty" = "No options available";

/* --- VoiceOver name for a control with no visible label --- */
"select.untitled" = "Select";

/* --- Screen-reader "required" suffix (native peer of `aria-required`) --- */
"select.required" = "required";
