/*
  MapTileLayer.strings
  TeslaSync — P4 shared surface · 0185 · MapTileLayer (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/maps/MapTileLayer.tsx) is anonymous — it renders a leaflet tile layer with no visible
  copy, and its tile attributions are intentionally NOT localised (brand names required verbatim by
  the providers' terms; the web marks them `i18n-ignore`). These keys therefore cover the chrome the
  native surface introduces around the MapKit base layer: the fullscreen control (web
  `MapFullscreenControl` / `FullscreenButton` default keys `common.fullscreen.*`), the base-map style
  switcher (web `MapLayerSwitcher`), the P4 leaf connectivity axis, the attribution control label, and
  the loading / empty / error overlays. These entries fold into the app `Localizable.xcstrings` master
  catalog at integration time; they are kept in a per-surface table ("MapTileLayer") so each parallel
  surface prompt owns its own strings.
*/

/* --- Fullscreen (web `FullscreenButton` default keys) --- */
"common.fullscreen.enter" = "Enter fullscreen";
"common.fullscreen.exit" = "Exit fullscreen";

/* --- Base-map style switcher (web `MapLayerSwitcher`) --- */
"mapTileLayer.styleSwitcher" = "Map style";
"mapTileLayer.style.dark" = "Dark";
"mapTileLayer.style.satellite" = "Satellite";
"mapTileLayer.style.streets" = "Streets";
"mapTileLayer.style.terrain" = "Terrain";

/* --- Tile providers (web `MapConfig.provider`) --- */
"mapTileLayer.provider.free" = "Open data";
"mapTileLayer.provider.azure" = "Azure Maps";
"mapTileLayer.provider.google" = "Google Maps";

/* --- Attribution control (web leaflet attribution) --- */
"mapTileLayer.attributionA11y" = "Map data";

/* --- Fullscreen sheet + map a11y --- */
"mapTileLayer.fullscreenTitle" = "Map";
"mapTileLayer.mapA11y" = "Map";

/* --- Loading / empty / error overlays (every state renders) --- */
"mapTileLayer.loading" = "Loading map…";
"mapTileLayer.empty" = "Map unavailable";
"mapTileLayer.emptyDetail" = "No map tiles are available right now.";
"mapTileLayer.error" = "Couldn't load map settings";
"mapTileLayer.errorDetail" = "Showing the default map.";

/* --- Shared actions --- */
"action.retry" = "Retry";

/* --- Freshness (P4 connectivity axis) --- */
"mapTileLayer.live" = "Live";
"mapTileLayer.stale" = "Stale";
"mapTileLayer.offline" = "Offline";
"mapTileLayer.staleA11y" = "Stale — tap refresh to update";
"mapTileLayer.offlineA11y" = "Offline — showing the last known map";
"mapTileLayer.refresh" = "Refresh";

/* --- Connectivity banner (P4 leaf state) --- */
"mapTileLayer.staleBanner" = "Reconnecting — map may be stale";
"mapTileLayer.offlineBanner" = "Offline — showing last known map";
