/*
  RouteDisplay.strings
  TeslaSync — P4 shared surface · 0101 · RouteDisplay (Apple)

  The P1/S10 i18n catalog contribution for this surface. Every key the native surface resolves
  (table "RouteDisplay") lives here with its web `t(key, default)` English value, taken verbatim from
  the web source `components/data-display/RouteDisplay.tsx`. These entries fold into the app
  `Localizable.xcstrings` master catalog at integration time; they are kept in a per-surface table so
  each parallel surface prompt owns its own strings without editing the shared catalog.

  The web source resolves exactly two strings — the dimmed fallback line and the round-trip suffix.
  The endpoint labels themselves (a resolved address, or a `📍 lat, lon` coordinate string) are data,
  not translatable prose, so they are intentionally not catalog keys.
*/

/* --- Fallback line (web `t('route.noLocationData', 'No location data')`) --- */
"route.noLocationData" = "No location data";

/* --- Round-trip suffix (web `t('route.roundTrip', 'round trip')`) --- */
"route.roundTrip" = "round trip";
