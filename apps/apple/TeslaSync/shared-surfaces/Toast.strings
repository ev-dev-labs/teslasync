/*
  Toast.strings
  TeslaSync — P4 shared surface · 0144 · Toast (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web Toast source carries one hardcoded
  literal — the dismiss control's `aria-label="Dismiss notification"` — which is reproduced here; the
  toast title / message are caller-supplied (already localized at the call site, exactly as on the web,
  where `useMutationToast` passes `t(key, fallback)` strings into `toast.success(...)`). The remaining
  entries are the native accessibility additions: the spoken severity word VoiceOver reads before the
  title (the web conveys severity implicitly through the ARIA role, which VoiceOver does not surface on
  its own), plus the default mutation-failure title (web `useMutationToast` `toast.common.error`).

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are
  kept in a per-surface table ("Toast") so each parallel surface prompt owns its own strings without
  editing the shared catalog.
*/

/* --- Dismiss control (web `aria-label="Dismiss notification"`) --- */
"toast.dismiss" = "Dismiss notification";

/* --- Spoken severity prefix (native a11y — the ARIA role's implicit severity, named for VoiceOver) --- */
"toast.severity.success" = "Success";
"toast.severity.error" = "Error";
"toast.severity.info" = "Information";
"toast.severity.warning" = "Warning";

/* --- Mutation bridge default failure title (web `useMutationToast` `toast.common.error`) --- */
"toast.common.error" = "Something went wrong";
