/*
  StickyCompactHero.strings
  TeslaSync — P4 shared surface · 0201 · StickyCompactHero (Apple)

  The P1/S10 i18n catalog contribution for this surface — the native peer of every literal the web source
  `components/status/StickyCompactHero.tsx` carries: the five short status headlines (web `SHORT_HEADLINE`)
  and the three `aria-label`s the web inlines (the "Status summary" region, the "Scroll to top of page"
  button, the "Refresh status" button), plus the native spoken "Refreshing" value. The native surface
  routes every string through the facade per the no-hardcoded-English rule, even where the web source
  inlined it. The remaining "sample" entries back the DEBUG-only inspector + previews; they are never
  shipped.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept
  in a per-surface table ("StickyCompactHero") so each parallel surface prompt owns its own strings. In
  test / preview bundles `NSLocalizedString` returns the value below, keeping the labels deterministic.
*/

/* --- Status headlines (web `SHORT_HEADLINE[status]`) --- */

/* Healthy — all systems operational (web `healthy`). */
"stickyCompactHero.status.healthy" = "All operational";

/* Degraded performance (web `degraded`). */
"stickyCompactHero.status.degraded" = "Degraded";

/* Service outage (web `unhealthy`). */
"stickyCompactHero.status.unhealthy" = "Outage";

/* Status unknown (web `unknown`). */
"stickyCompactHero.status.unknown" = "Status unknown";

/* Scheduled maintenance (web `maintenance`). */
"stickyCompactHero.status.maintenance" = "Maintenance";

/* --- Accessibility wording the web inlines as literals --- */

/* The sticky region label (web `role="region" aria-label="Status summary"`). */
"stickyCompactHero.region" = "Status summary";

/* The scroll-to-top button label (web `aria-label="Scroll to top of page"`). */
"stickyCompactHero.scrollToTop" = "Scroll to top of page";

/* The refresh button label (web `aria-label="Refresh status"`). */
"stickyCompactHero.refresh" = "Refresh status";

/* The refresh button's spoken value while a refresh is in flight (native peer of the web spinning glyph). */
"stickyCompactHero.refreshing" = "Refreshing";

