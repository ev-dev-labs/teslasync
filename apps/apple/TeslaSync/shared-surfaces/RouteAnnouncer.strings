/*
  RouteAnnouncer.strings
  TeslaSync — P4 shared surface · 0002 · RouteAnnouncer (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/a11y/RouteAnnouncer.tsx) is anonymous — it renders a single visually-hidden polite
  live region carrying `document.title` and extracts no `t()` keys — so every key here is native
  chrome: the inspector title, the live region name + role, the recent-navigation heading, the
  VoiceOver wording, and the P4 leaf freshness / loading / empty / error copy, so the Swift
  sources hold no English literals. These entries fold into the app `Localizable.xcstrings` master
  catalog at integration time; they are kept in a per-surface table ("RouteAnnouncer") so each
  parallel surface prompt owns its own strings without editing the shared catalog.
*/

/* --- Surface header --- */
"routeAnnouncer.title" = "Route announcements";
"routeAnnouncer.subtitle" = "The page title voiced to VoiceOver after each navigation";

/* --- Live region (the web polite live region) --- */
"routeAnnouncer.region.name" = "Live region";
"routeAnnouncer.region.role" = "Announced politely after navigation";
"routeAnnouncer.region.emptyValue" = "—";
"routeAnnouncer.region.emptyA11y" = "no page announced yet";

/* --- Recent navigations --- */
"routeAnnouncer.history.title" = "Recent navigations";
"routeAnnouncer.history.navigated" = "Navigated";

/* --- Loading / empty / error chrome --- */
"routeAnnouncer.loadingA11y" = "Loading route announcements";
"routeAnnouncer.empty" = "No navigations yet";
"routeAnnouncer.emptyMessage" = "The page title will be announced here after you move between pages.";
"routeAnnouncer.errorTitle" = "Couldn't load route announcements";
"routeAnnouncer.retry" = "Retry";

/* --- Freshness (P4 connectivity axis) --- */
"routeAnnouncer.live" = "Live";
"routeAnnouncer.stale" = "Stale";
"routeAnnouncer.offline" = "Offline";
"routeAnnouncer.staleA11y" = "Stale — tap to refresh";
"routeAnnouncer.offlineA11y" = "Offline — showing the last announced page";
