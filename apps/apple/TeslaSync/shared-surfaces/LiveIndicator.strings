/*
  LiveIndicator.strings
  TeslaSync — P4 shared surface · 0094 · LiveIndicator (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (web/src/components/data-display/LiveIndicator.tsx) makes four `t()` calls for the connection-state
  labels, and the pill variant's freshness stamp goes through `formatRelativeTime` (web/src/lib/
  dateFormat.ts), which hard-codes a few English relative phrases ("Just now", "{n}m ago",
  "{n}h ago"). Native code holds no English literals, so the four labels plus those relative phrases
  resolve through these keys. The `{{count}}` token mirrors the web i18next interpolation. These
  entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept
  in a per-surface table ("LiveIndicator") so each parallel surface prompt owns its own strings
  without editing the shared catalog.
*/

/* --- Connection-state labels (web t('live.*', …) calls) --- */
"live.connected" = "Live";
"live.reconnecting" = "Reconnecting…";
"live.disconnected" = "Offline";
"live.unknown" = "Unknown";

/* --- Freshness stamp (parity of formatRelativeTime in dateFormat.ts) --- */
"live.relative.justNow" = "Just now";
"live.relative.minutesAgo" = "{{count}}m ago";
"live.relative.hoursAgo" = "{{count}}h ago";
