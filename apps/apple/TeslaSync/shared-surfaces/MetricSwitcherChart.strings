/*
  MetricSwitcherChart.strings
  TeslaSync — P4 shared surface · 0072 · MetricSwitcherChart (Apple)

  The P1/S10 i18n catalog contribution for this surface. Every key the native surface resolves
  (table "MetricSwitcherChart") lives here with its English value. The caller-supplied props from the
  web source (`title`, `metric.label`, `emptyMessage`, `ariaLabel`) arrive already-localised from the
  call site, so they are not keyed here — only the surface-owned regions are (the empty / error /
  loading / freshness chrome and the chart's VoiceOver summary template). These entries fold into the
  app `Localizable.xcstrings` master catalog at integration time; they are kept in a per-surface table
  so each parallel surface prompt owns its own strings without editing the shared catalog.
*/

/* --- Empty state (web `<EmptyState message={emptyMessage} />`) --- */
"metricSwitcher.empty.title" = "No data";
"metricSwitcher.empty.message" = "No data available for this metric yet.";

/* --- Error state (the `QueryError` peer) --- */
"metricSwitcher.error.message" = "Couldn't load chart data.";
"metricSwitcher.error.retry" = "Retry";

/* --- Loading state (P4 leaf: parent fetch → skeleton) --- */
"metricSwitcher.loadingA11y" = "Loading chart data";

/* --- Freshness chip (P4 connectivity axis: stale / offline) --- */
"metricSwitcher.freshness.stale" = "Stale";
"metricSwitcher.freshness.staleA11y" = "Showing stale data — tap to refresh";
"metricSwitcher.freshness.offline" = "Offline";
"metricSwitcher.freshness.offlineA11y" = "Offline — showing the last known data";

/* --- Chart accessibility summary (min / max / latest, positional args) --- */
"metricSwitcher.a11y.summary" = "%1$@: minimum %2$@, maximum %3$@, latest %4$@";
