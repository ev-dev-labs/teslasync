/*
  AreaChartWrapper.strings
  TeslaSync — P4 shared surface · 0064 · AreaChartWrapper (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/charts/AreaChartWrapper.tsx) is anonymous + purely presentational — it has no t() calls
  of its own. Every key here is therefore native chrome: the P4 leaf states (loading / empty / error /
  freshness) the standalone surface adds so it is never a blank box, plus the VoiceOver scaffolding the
  colour-only web chart needs (the spoken per-series summary). These entries fold into the app
  Localizable.xcstrings master catalog at integration time; they are kept in a per-surface table
  ("AreaChartWrapper") so each parallel surface prompt owns its own strings.
*/

/* --- Accessibility (native peer of the colour-only web chart) --- */
"areaChart.a11y.chart" = "Area chart";
"areaChart.a11y.series" = "%1$@: latest %2$@, low %3$@, high %4$@";
"areaChart.a11y.seriesEmpty" = "%1$@: no data";

/* --- Empty state (native P4 leaf state — the web host hides the region when there is no data) --- */
"areaChart.empty.title" = "No data";
"areaChart.empty.message" = "There's nothing to chart yet.";

/* --- Error state (native P4 leaf state — QueryError peer) --- */
"areaChart.error.title" = "Couldn't load the chart";
"areaChart.error.message" = "Couldn't load the chart.";
"areaChart.error.retry" = "Retry";

/* --- Loading chrome (native P4 leaf state) --- */
"areaChart.loadingA11y" = "Loading chart";

/* --- Freshness (P4 connectivity axis) --- */
"areaChart.freshness.stale" = "Stale";
"areaChart.freshness.staleA11y" = "Stale — tap to refresh";
"areaChart.freshness.offline" = "Offline";
"areaChart.freshness.offlineA11y" = "Offline — showing the last known data";
