/*
  SmallMultiplesChart.strings
  TeslaSync — P4 shared surface · 0073 · SmallMultiplesChart (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/charts/SmallMultiplesChart.tsx) localizes only its empty-cell label
  (t('smallMultiples.noData', 'No data')); every other key here is native chrome: the P4 leaf states
  (loading / empty / error / freshness) the standalone surface adds so it is never a blank box, plus
  the VoiceOver scaffolding the colour-only web cell needs (the spoken series summary + the drill-in
  hint). These entries fold into the app Localizable.xcstrings master catalog at integration time;
  they are kept in a per-surface table ("SmallMultiplesChart") so each parallel surface prompt owns
  its own strings.
*/

/* --- Empty-cell label (THE web key — a series with no finite points in `data`) --- */
"smallMultiples.noData" = "No data";

/* --- Accessibility group + per-cell summary (native peer of the colour-only web cell) --- */
"smallMultiples.a11y.grid" = "Small multiples chart";
"smallMultiples.a11y.summary" = "Latest %1$@, low %2$@, high %3$@";
"smallMultiples.cell.openHint" = "Double tap to open this series";

/* --- Empty state (native P4 leaf state — web renders an empty grid for empty series) --- */
"smallMultiples.empty.title" = "No series";
"smallMultiples.empty.message" = "There are no series to chart yet.";

/* --- Error state (native P4 leaf state — QueryError peer) --- */
"smallMultiples.error.title" = "Couldn't load the chart";
"smallMultiples.error.message" = "Couldn't load the chart.";
"smallMultiples.error.retry" = "Retry";

/* --- Loading chrome (native P4 leaf state) --- */
"smallMultiples.loadingA11y" = "Loading chart";

/* --- Freshness (P4 connectivity axis) --- */
"smallMultiples.freshness.stale" = "Stale";
"smallMultiples.freshness.staleA11y" = "Stale — tap to refresh";
"smallMultiples.freshness.offline" = "Offline";
"smallMultiples.freshness.offlineA11y" = "Offline — showing the last known data";
