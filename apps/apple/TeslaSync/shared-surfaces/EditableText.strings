/*
  EditableText.strings
  TeslaSync — P4 shared surface · 0213 · EditableText (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source (components/ui/EditableText.tsx)
  resolves four `t()` keys — the built-in empty-input validation message, the post-save polite
  announcement, the save-failure fallback, and the in-flight spinner label — all mirrored verbatim below
  (the `{{label}}` interpolation in the announcement maps to a native `%@` format specifier). The
  surface's accessible name comes from the caller's `ariaLabel` prop, so it is not a static string here.
  The remaining keys are native P4 leaf chrome + accessibility additions (loading / error / retry / the
  empty "Not set" leaf / the edit hint / the freshness axis) so the Swift sources hold no English
  literals. These entries fold into the app `Localizable.xcstrings` master catalog at integration time;
  they are kept in a per-surface table ("EditableText") so each parallel surface prompt owns its own
  strings. In test / preview bundles `NSLocalizedString` returns the value below, keeping the labels
  deterministic.
*/

/* --- Web `t()` keys (mirrored verbatim from the source) --- */

/* Built-in validation message when the committed draft is empty (web editableText.error.empty). */
"editableText.error.empty" = "Value cannot be empty";

/* Polite announcement after a successful save; %@ is the field's accessible name (web {{label}} saved). */
"editableText.announce.saved" = "%@ saved";

/* Fallback inline error when a rejected save carries no message (web editableText.error.saveFailed). */
"editableText.error.saveFailed" = "Save failed";

/* Accessible label for the in-flight save spinner (web editableText.saving). */
"editableText.saving" = "Saving…";

/* --- Native P4 leaf + accessibility additions (no web key exists; the source never fetches) --- */

/* VoiceOver label for the initial-fetch skeleton. */
"editableText.loadingA11y" = "Loading the field";

/* Title of the feed-failure tile (QueryError peer). */
"editableText.errorTitle" = "Couldn't load the field";

/* Retry button label on the feed-failure tile. */
"editableText.retry" = "Retry";

/* The empty-display leaf shown when the value is empty and no prompt was supplied. */
"editableText.notSet" = "Not set";

/* VoiceOver hint on the display button — the action a tap performs. */
"editableText.editHint" = "Double-tap to edit";

/* --- Freshness (P4 connectivity axis) --- */
"editableText.live" = "Live";
"editableText.stale" = "Stale";
"editableText.offline" = "Offline";
"editableText.staleA11y" = "Stale — tap to refresh";
"editableText.offlineA11y" = "Offline — showing the last saved value";
