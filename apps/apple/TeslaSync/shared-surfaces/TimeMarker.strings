/*
  TimeMarker.strings
  TeslaSync — P4 shared surface · 0074 · TimeMarker (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/charts/TimeMarker.tsx) carries one piece of user-facing copy — the default marker label
  "Alert" — mirrored here as `timeMarker.label.default`. The severity names back the VoiceOver
  readout of the marker color (the web encodes severity only as a hex stroke; the native surface
  announces it for accessibility). The remaining entries back the DEBUG-only sample chart used by the
  previews + the view-composition tests; they are never shipped on a production chart, which supplies
  its own already-localized label.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they
  are kept in a per-surface table ("TimeMarker") so each parallel surface prompt owns its own strings.
*/

/* --- Marker copy (shipped) --- */
"timeMarker.label.default" = "Alert";

/* --- Severity names (VoiceOver readout of the marker color) --- */
"timeMarker.severity.info" = "Info";
"timeMarker.severity.warn" = "Warning";
"timeMarker.severity.critical" = "Critical";
"timeMarker.severity.success" = "Success";

/* --- Marker callout accessibility (shipped) --- */
"timeMarker.callout.aria" = "%@ marker: %@";

/* --- DEBUG sample chart (previews + tests only; not shipped) --- */
"timeMarker.sample.chart.aria" = "Battery level over time with alert marker";
"timeMarker.sample.marker.none" = "No alert marker";
"timeMarker.sample.marker.at" = "%@ alert marked";
"timeMarker.sample.axis.x" = "Time";
"timeMarker.sample.axis.y" = "Battery %";
"timeMarker.sample.series.withContext" = "Battery (alert context)";
"timeMarker.sample.series.noContext" = "Battery (no alert context)";
