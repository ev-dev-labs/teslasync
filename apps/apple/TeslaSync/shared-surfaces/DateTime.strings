/*
  DateTime.strings
  TeslaSync — P4 shared surface · 0084 · DateTime (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (web/src/components/data-display/format/DateTime.tsx) is anonymous — it makes no `t()` calls and
  wraps the pure helpers in web/src/lib/dateFormat.ts, which hold a few hardcoded English relative
  phrases ("Just now", "{n}m ago", "{n}h ago"). Native code holds no English literals, so those
  phrases plus the P4 leaf chrome (loading / empty placeholder a11y / freshness) + the VoiceOver
  strings resolve through these keys. The `{{count}}` token mirrors the web i18next interpolation.
  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they
  are kept in a per-surface table ("DateTime") so each parallel surface prompt owns its own strings
  without editing the shared catalog.
*/

/* --- Relative-time phrases (parity of formatRelativeTime in dateFormat.ts) --- */
"format.dateTime.relative.justNow" = "Just now";
"format.dateTime.relative.minutesAgo" = "{{count}}m ago";
"format.dateTime.relative.hoursAgo" = "{{count}}h ago";

/* --- Empty / loading chrome (P4 leaf contract) --- */
"format.dateTime.emptyA11y" = "No date";
"format.dateTime.loadingA11y" = "Loading time";

/* --- Freshness (P4 connectivity axis) --- */
"format.dateTime.live" = "Live";
"format.dateTime.stale" = "Stale";
"format.dateTime.offline" = "Offline";
"format.dateTime.staleA11y" = "Stale — tap to refresh";
"format.dateTime.offlineA11y" = "Offline — showing the last known time";
