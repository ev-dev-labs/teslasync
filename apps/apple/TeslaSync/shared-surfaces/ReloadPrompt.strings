/*
  ReloadPrompt.strings
  TeslaSync — P4 shared surface · 0136 · ReloadPrompt (Apple)

  The P1/S10 i18n catalog contribution for this surface. The keys mirror the web source
  (components/feedback/ReloadPrompt.tsx) one-for-one — the title, the interpolated countdown, the "Later"
  control, and the "Reload Now" control — plus the native P4 leaf chrome (loading / empty / error /
  freshness) so the Swift sources hold no English literals. The countdown value keeps the i18next
  `{{seconds}}` token verbatim so the interpolation is identical to the web. These entries fold into the
  app `Localizable.xcstrings` master catalog at integration time; they are kept in a per-surface table
  ("ReloadPrompt") so each parallel surface prompt owns its own strings without editing the shared
  catalog.
*/

/* --- Banner content (web `ReloadPrompt.tsx`) --- */
"pwa.newVersion" = "New version available";
"pwa.reloadingIn" = "Reloading in {{seconds}}s...";
"pwa.later" = "Later";
"pwa.reloadNow" = "Reload Now";

/* --- Loading / empty / error chrome (P4 leaf contract) --- */
"pwa.checkingA11y" = "Checking for updates";
"pwa.upToDate" = "You're up to date";
"pwa.upToDateMessage" = "You're running the latest version. We'll let you know the moment an update is ready.";
"pwa.errorTitle" = "Couldn't check for updates";
"pwa.retry" = "Retry";

/* --- Freshness (P4 connectivity axis) --- */
"pwa.live" = "Live";
"pwa.stale" = "Stale";
"pwa.offline" = "Offline";
"pwa.staleA11y" = "Stale — tap to check again";
"pwa.offlineA11y" = "Offline — update checks paused";
