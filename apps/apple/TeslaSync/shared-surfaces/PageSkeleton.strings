/*
  PageSkeleton.strings
  TeslaSync — P4 shared surface · 0132 · PageSkeleton (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (web/src/components/feedback/PageSkeleton.tsx) labels each loading region with a hardcoded English
  `aria-label` ("Loading page header", "Loading stat cards", "Loading chart", "Loading table"). Native
  code holds no English literals, so those four labels resolve through these keys and become the
  VoiceOver labels for the corresponding skeleton regions (the parity of the web `role="status"`
  loading announcements). These entries fold into the app `Localizable.xcstrings` master catalog at
  integration time; they are kept in a per-surface table ("PageSkeleton") so each parallel surface
  prompt owns its own strings without editing the shared catalog.
*/

/* --- Loading-region accessibility labels (parity of the web aria-label literals) --- */
"skeleton.pageHeader.label" = "Loading page header";
"skeleton.statGrid.label" = "Loading stat cards";
"skeleton.chart.label" = "Loading chart";
"skeleton.table.label" = "Loading table";
