/*
  ResourcesPanel.strings
  TeslaSync — P4 shared surface · 0198 · ResourcesPanel (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/status/ResourcesPanel.tsx) carries exactly one fixed string — the panel heading
  "Resources". The row `label`, `valueText`, and `metaText` are caller-supplied (already-localized)
  string props; the icon + bar are decorative.

  This surface mirrors the heading and ADDS, as Apple-HIG VoiceOver affordances the web omits, a friendly
  empty-state message (so the empty-rows case is never a blank box) and a localizable "usage" format that
  lets VoiceOver speak a bar's percent ("73 % used"). All keys live in the per-surface "ResourcesPanel"
  table and resolve through the P1/S10 facade (ResourcesPanelStrings) so the Swift sources hold no
  hardcoded prose; they fold into the app `Localizable.xcstrings` master catalog at integration time.
*/

/* --- Panel heading (native peer of the web <h3>Resources</h3>) --- */
"resourcesPanel.title" = "Resources";

/* --- Friendly empty state (DISCLOSED native HIG addition; web renders an empty container) --- */
"resourcesPanel.empty.message" = "No resources to report";

/* --- Spoken usage clause for a row with a bar (native peer of the web aria-valuenow). %d = percent --- */
"resourcesPanel.row.usage" = "%d%% used";

/* --- VoiceOver value separator joining value / sub-label / usage --- */
"resourcesPanel.row.accessibilityseparator" = ", ";
