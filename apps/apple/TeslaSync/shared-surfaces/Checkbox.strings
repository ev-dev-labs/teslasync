/*
  Checkbox.strings
  TeslaSync — P4 shared surface · 0204 · Checkbox (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/ui/Checkbox.tsx) renders NO translatable copy of its own: the visible `label` is supplied
  by the caller (an already-localized node), and the indicator draws only icons. There are therefore no
  source `t()` keys to reproduce.

  The keys below are native accessibility refinements over the web. The web indicator carries no
  accessible name when no label is given and exposes its checked state only through the visually-hidden
  input's `aria-checked`; the native surface always voices a name and a spoken checked / unchecked /
  mixed value. Each is resolved through the injected facade (with the English fallback below) so no
  user-facing English is hardcoded in Swift. The per-surface table name ("Checkbox") folds into the app
  Localizable.xcstrings master catalog at integration time; in test / preview bundles NSLocalizedString
  returns the value below, keeping the labels deterministic.
*/

/* VoiceOver name for a box that was given no visible label (native refinement; the web leaves an
   unlabeled checkbox unnamed). */
"checkbox.accessibility.unlabeled" = "Checkbox";

/* Spoken value when the box is checked (native peer of aria-checked=true). */
"checkbox.accessibility.checked" = "Checked";

/* Spoken value when the box is unchecked (native peer of aria-checked=false). */
"checkbox.accessibility.unchecked" = "Not checked";

/* Spoken value when the box is indeterminate (native peer of aria-checked="mixed"). */
"checkbox.accessibility.mixed" = "Mixed";
