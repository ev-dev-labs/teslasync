/*
  DataTable.strings
  TeslaSync — P4 shared surface · 0208 · DataTable (Apple)

  The P1/S10 i18n catalog contribution for this surface — every `t(key, default)` call in
  `web/src/components/ui/DataTable.tsx`, plus the native friendly-empty + retry additions for the states Apple
  renders. Resolved through DataTableStrings (NSLocalizedString tableName "DataTable") with the `{{col}}`
  interpolation handled by DataTableInterpolation. These entries fold into the app `Localizable.xcstrings`
  master catalog at integration time; they are kept in a per-surface table ("DataTable") so each parallel
  surface prompt owns its own strings. In test / preview bundles `NSLocalizedString` returns the value below,
  keeping the labels deterministic.
*/

/* --- Error fallback (web SectionErrorBoundary) --- */

/* The error-fallback title (web `t('errors.section.tableTitle', …)`). */
"errors.section.tableTitle" = "This table failed to render";

/* The retry affordance on the error fallback (native addition — the web boundary auto-retries on re-render). */
"table.error.retry" = "Try again";

/* --- Empty (web `emptyMessage` default) --- */

/* The default empty-body message (web `emptyMessage = 'No data'`). */
"table.empty.default" = "No data";

/* --- Selection (web `table.selection.*`) --- */

/* A row checkbox's accessible name when the row is selected. */
"table.selection.deselectRow" = "Deselect row";

/* A row checkbox's accessible name when the row is not selected. */
"table.selection.selectRow" = "Select row";

/* The select-all header checkbox when every row is selected. */
"table.selection.deselectAll" = "Deselect all rows";

/* The select-all header checkbox when not every row is selected. */
"table.selection.selectAll" = "Select all rows";

/* --- Expansion (web `table.expand.*`) --- */

/* An expand toggle's accessible name when the row is expanded. */
"table.expand.collapse" = "Collapse row";

/* An expand toggle's accessible name when the row is collapsed. */
"table.expand.expand" = "Expand row";

/* The expand-column header's accessible name (web the labelled expand `<th>`). */
"table.expand.column" = "Expand row";

/* --- Export (web `table.export.*`) --- */

/* The CSV export control's accessible name (web `aria-label`). */
"table.export.csv" = "Download table as CSV";

/* The CSV export control's visible label. */
"table.export.csvButton" = "Download CSV";

/* --- Resize (web `table.columns.resizeLabel`) --- */

/* A resize handle's accessible name; {{col}} is the column header. */
"table.columns.resizeLabel" = "Resize column {{col}}";
