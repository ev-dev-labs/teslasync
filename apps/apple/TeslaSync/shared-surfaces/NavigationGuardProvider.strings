/*
  NavigationGuardProvider.strings
  TeslaSync — P4 shared surface · 0128 · NavigationGuardProvider (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/feedback/NavigationGuardProvider.tsx) renders a warning
  `<ConfirmDialog>` whose copy comes from four `forms.*` keys — reproduced here
  VERBATIM so the native confirm flow matches the web one key-for-key and a
  shared catalog resolves identically across platforms. The remaining
  `navigationGuard.*` keys are the native chrome: the "Don't ask again" opt-out
  (web ConfirmDialog silence), the P4 leaf states (loading / idle / error), the
  freshness chip (connectivity axis), and the VoiceOver labels.

  These entries fold into the app `Localizable.xcstrings` master catalog at
  integration time; they are kept in a per-surface table ("NavigationGuardProvider")
  so each parallel surface prompt owns its own strings without editing the
  shared catalog.
*/

/* --- Confirm dialog (web `<ConfirmDialog>` props, forms.*) — VERBATIM web keys --- */
"forms.unsavedTitle" = "Unsaved changes";
"forms.unsavedWarning" = "You have unsaved changes. Discard them?";
"forms.discard" = "Discard changes";
"forms.keepEditing" = "Keep editing";

/* --- Silence opt-out (web ConfirmDialog "Don't ask again") --- */
"navigationGuard.dontAskAgain" = "Don't ask again";

/* --- Loading / idle / error chrome (P4 leaf contract) --- */
"navigationGuard.loadingA11y" = "Preparing confirmation";
"navigationGuard.idleTitle" = "No unsaved changes";
"navigationGuard.idleMessage" = "You can navigate freely — nothing needs confirming.";
"navigationGuard.errorTitle" = "Couldn't check unsaved changes";
"navigationGuard.retry" = "Retry";

/* --- Freshness (P4 connectivity axis) --- */
"navigationGuard.live" = "Live";
"navigationGuard.stale" = "Stale";
"navigationGuard.offline" = "Offline";
"navigationGuard.staleA11y" = "Stale — tap to refresh";
"navigationGuard.offlineA11y" = "Offline — guard state may be out of date";

/* --- VoiceOver labels --- */
"navigationGuard.warningA11y" = "Warning";
"navigationGuard.checkedA11y" = "checked";
"navigationGuard.uncheckedA11y" = "not checked";
"navigationGuard.backdropA11y" = "Dismiss — keep editing";
