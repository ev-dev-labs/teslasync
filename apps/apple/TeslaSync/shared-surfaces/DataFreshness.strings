/*
  DataFreshness.strings
  TeslaSync — P4 shared surface · 0079 · DataFreshness (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/data-display/DataFreshness.tsx) already calls `t(key, default)`; the keys + verbatim
  English defaults are lifted here so native code holds no hardcoded literals, plus the native state
  words (for the `Data freshness: {state}` VoiceOver label). These entries fold into the app
  `Localizable.xcstrings` master catalog at integration time; they are kept in a per-surface table
  ("DataFreshness") so each parallel surface prompt owns its own strings.

  The relative-time + time + state templates insert their value with a `%@` token (locale- and
  width-safe), reproducing the web `{{m}}` / `{{time}}` / `{{state}}` interpolation.
*/

/* --- Relative-time label (verbatim port of web `formatRelativeTime`) --- */
"freshness.justNow" = "just now";
"freshness.minutes" = "%@m ago";
"freshness.hours" = "%@h ago";
"freshness.days" = "%@d ago";
"freshness.weeks" = "%@w ago";

/* --- In-flight / error relative-time literals (web `relativeTime` ternary) --- */
"freshness.updating" = "updating…";
"freshness.error" = "error";

/* --- Tooltip (web `title`) --- */
"freshness.updatingTooltip" = "Updating…";
"freshness.lastUpdated" = "Last updated: %@";
"freshness.neverUpdated" = "Never updated";

/* --- Accessibility (web `aria-label`) --- */
"freshness.refresh" = "Refresh";
"a11y.dataFreshness" = "Data freshness: %@";

/* --- State words (the web interpolates the raw lowercase status into `aria-label`) --- */
"freshness.state.fresh" = "fresh";
"freshness.state.fetching" = "fetching";
"freshness.state.stale" = "stale";
"freshness.state.error" = "error";
