/*
  QueryError.strings
  TeslaSync — P4 shared surface · 0133 · QueryError (Apple)

  The P1/S10 i18n catalog contribution for this surface. The failure-mode keys mirror the web source
  (components/feedback/QueryError.tsx) one-for-one — the transient-waiting / 404 / 401·403 / 5xx /
  network·offline branches and their CTAs — plus the native P4 leaf chrome (loading / empty /
  freshness) so the Swift sources hold no English literals. These entries fold into the app
  Localizable.xcstrings master catalog at integration time; they are kept in a per-surface table
  ("QueryError") so each parallel surface prompt owns its own strings without editing the shared
  catalog.
*/

/* --- Transient waiting (web isTransientWaiting branch) --- */
"error.waiting.title" = "Waiting for upstream";
"error.waiting.message" = "We're pausing requests briefly. Data will refresh automatically.";

/* --- 404 not found (web FileQuestion branch) --- */
"error.notFound.thingDefault" = "Resource";
"error.notFound.title" = "{{thing}} not found";
"error.notFound.message" = "It may have been deleted or the link is wrong.";
"error.notFound.cta" = "Back to list";

/* --- 401 / 403 unauthorized (web Lock branch) --- */
"error.unauthorized.title" = "Sign in required";
"error.unauthorized.message" = "Your session has expired. Please sign in again.";
"error.unauthorized.cta" = "Sign in";

/* --- 5xx server error (web Server branch) --- */
"error.serverError.title" = "Server error";
"error.serverError.message" = "Something went wrong on our end. Please try again.";

/* --- Network / offline (web AlertCircle / WifiOff branch) --- */
"error.network.title" = "Can't reach server";
"error.network.message" = "Check your internet connection and try again.";
"error.network.offlineTitle" = "You're offline";
"error.network.offlineDetail" = "We'll retry automatically when your connection returns.";
"error.network.retryWhenOnline" = "Retry when online";

/* --- Shared retry CTA (web error.retry) --- */
"error.retry" = "Retry";

/* --- Loading / empty chrome (P4 leaf contract) --- */
"error.loadingA11y" = "Checking the request";
"error.empty" = "All clear";
"error.emptyMessage" = "The request succeeded. Any problems loading this data will appear here.";

/* --- Freshness (P4 connectivity axis) --- */
"error.freshness.live" = "Live";
"error.freshness.stale" = "Stale";
"error.freshness.offline" = "Offline";
"error.freshness.staleA11y" = "Stale — tap to refresh";
"error.freshness.offlineA11y" = "Offline — showing the last known status";
