/*
  Spinner.strings
  TeslaSync — P4 shared surface · 0140 · Spinner (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web `components/feedback/Spinner.tsx` resolves
  one localized string of its own — the accessibility-label fallback `'Loading'` used when no `label` prop is
  supplied (web `aria-label={label ?? 'Loading'}`) — so that single key is mirrored below. The `label` prop
  itself is a caller-supplied, already-localized string, so it owns no key here.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept
  in a per-surface table ("Spinner") so each parallel surface prompt owns its own strings. In test / preview
  bundles `NSLocalizedString` returns the value below, keeping the labels deterministic.
*/

/* Accessibility label announced for the loading mark when no caption label is supplied (web aria-label
   fallback ?? 'Loading'). */
"spinner.loading" = "Loading";
