/*
  ChartTooltip.strings
  TeslaSync — P4 shared surface · 0070 · ChartTooltip (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/charts/ChartTooltip.tsx) is anonymous — it renders a Recharts custom tooltip and
  extracts no `t()` keys — so every key here is native chrome: the inspector title + subtitle, the
  P4 leaf freshness / loading / empty / error copy, so the Swift sources hold no English literals.
  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they
  are kept in a per-surface table ("ChartTooltip") so each parallel surface prompt owns its own
  strings without editing the shared catalog.
*/

/* --- Surface header --- */
"chartTooltip.title" = "Chart readout";
"chartTooltip.subtitle" = "Values under the chart cursor";

/* --- Loading / empty / error chrome --- */
"chartTooltip.loadingA11y" = "Loading chart readout";
"chartTooltip.empty" = "No point selected";
"chartTooltip.emptyMessage" = "Hover or focus a point on the chart to see its values here.";
"chartTooltip.errorTitle" = "Couldn't load the readout";
"chartTooltip.retry" = "Retry";

/* --- Freshness (P4 connectivity axis) --- */
"chartTooltip.live" = "Live";
"chartTooltip.stale" = "Stale";
"chartTooltip.offline" = "Offline";
"chartTooltip.staleA11y" = "Stale — tap to refresh";
"chartTooltip.offlineA11y" = "Offline — showing the last readout";
