/*
  Range.strings
  TeslaSync — P4 shared surface · 0087 · Range (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/data-display/format/Range.tsx) renders its VALUE with no translatable copy: a
  locale-formatted number followed by the user's distance-unit symbol (`mi` / `km`, sourced from the
  `useUnits()` preference bag, not this component's copy) and, when the selected range is missing, the
  em-dash sentinel "—" (a symbol, not prose). The only translatable copy is the companion
  `useRangeLabel` label, which resolves `t('common.ratedRange', 'Rated Range')` /
  `t('common.idealRange', 'Ideal Range')` — reproduced here verbatim by key so the native catalog
  matches the source.

  The last key is a native accessibility refinement: the web renders a bare "—" with no `aria-label`,
  so VoiceOver would announce just the dash. The native empty branch voices this localized label
  instead. The per-surface table name ("Range") folds into the app `Localizable.xcstrings` master
  catalog at integration time.
*/

/* Companion `useRangeLabel` label for the rated-range preference (web `common.ratedRange`). */
"common.ratedRange" = "Rated Range";

/* Companion `useRangeLabel` label for the ideal-range preference (web `common.idealRange`). */
"common.idealRange" = "Ideal Range";

/* VoiceOver label for the empty branch (no preferred range available; visible text is "—"). */
"range.empty.accessibilityLabel" = "No range data";
