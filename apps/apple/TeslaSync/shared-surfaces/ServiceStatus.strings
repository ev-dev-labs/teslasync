/*
  ServiceStatus.strings
  TeslaSync — P4 shared surface · 0104 · ServiceStatus (Apple)

  The P1/S10 i18n catalog contribution for this surface. The keys mirror the web source
  (components/data-display/ServiceStatus.tsx): the offline banner copy (web `ServiceStatusBanner`)
  and the health rollup label (web ``title={`System: ${overall}`}``), plus the native P4 leaf chrome
  (freshness, loading / empty / error) and the subsystem-breakdown names, so the Swift sources hold
  no English literals. These entries fold into the app `Localizable.xcstrings` master catalog at
  integration time; they are kept in a per-surface table ("ServiceStatus") so each parallel surface
  prompt owns its own strings without editing the shared catalog.
*/

/* --- Health rollup (web `SystemHealthDot`, `System: {overall}`) --- */
"service.status.systemLabel" = "System: {status}";
"service.status.systemTitle" = "System status";
"service.status.level.healthy" = "Healthy";
"service.status.level.degraded" = "Degraded";
"service.status.level.down" = "Down";

/* --- Subsystem breakdown (web `SystemStatus.{database,tesla_api,mqtt,worker}`) --- */
"service.status.component.database" = "Database";
"service.status.component.teslaApi" = "Tesla API";
"service.status.component.mqtt" = "MQTT";
"service.status.component.worker" = "Worker";

/* --- Offline banner (web `ServiceStatusBanner`) --- */
"service.status.offline.title" = "You are offline";
"service.status.offline.message" = "Data may be stale. Reconnecting automatically…";

/* --- Loading / empty / error chrome (P4 leaf contract) --- */
"service.status.loadingA11y" = "Checking system status";
"service.status.empty" = "System status unavailable";
"service.status.emptyMessage" = "No system health data has been reported yet. It appears here once the backend responds.";
"service.status.errorTitle" = "Couldn't load system status";
"service.status.retry" = "Retry";

/* --- Freshness (P4 connectivity axis) --- */
"service.status.live" = "Live";
"service.status.stale" = "Stale";
"service.status.offline" = "Offline";
"service.status.staleA11y" = "Stale — tap to refresh";
"service.status.offlineA11y" = "Offline — showing the last known status";
