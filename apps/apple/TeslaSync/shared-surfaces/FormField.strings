/*
  FormField.strings
  TeslaSync — P4 shared surface · 0154 · FormField (Apple)

  The P1/S10 i18n catalog contribution for this surface. Every key the native
  `FormField` resolves (table "FormField") lives here with its web `t(key, default)`
  English value. These entries fold into the app `Localizable.xcstrings` master
  catalog at integration time; they are kept in a per-surface table so each parallel
  surface prompt owns its own strings without editing the shared catalog.

  The web wrapper (components/forms/FormField.tsx) renders its label / hint / error
  as already-localized props supplied by the caller (e.g. the documented example
  `label={t('alerts.signal', 'Signal')}`), so the only string the leaf itself owns is
  the required-state accessibility word (web `aria-label="required"`). The label key
  from the web example is included so callers and previews resolve it through the
  facade rather than hardcoding the English literal.
*/

/* --- Key from the web source example (parity) --- */
"alerts.signal" = "Signal";

/* --- Surface-owned accessibility string (web aria-label="required") --- */
"form.field.required" = "required";
