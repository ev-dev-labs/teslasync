/*
  LiveStaleDataBanner.strings
  TeslaSync — P4 shared surface · 0126 · LiveStaleDataBanner (Apple)

  The P1/S10 i18n catalog contribution for this surface. The keys mirror the web source
  (components/feedback/LiveStaleDataBanner.tsx) one-for-one — the banner title and the two-minute
  reassurance message (the only two `t()` calls the web component makes) — plus the native P4 leaf
  chrome (loading / healthy / error / connection chip). These entries fold into the app
  Localizable.xcstrings master catalog at integration time; they are kept in a per-surface table
  ("LiveStaleDataBanner") so each parallel surface prompt owns its own strings without editing the
  shared catalog.
*/

/* --- Banner copy (web `LiveStaleDataBanner.tsx`) --- */
"live.staleBanner.title" = "Live data unavailable";
"live.staleBanner.message" = "The live data connection has been offline for more than 2 minutes. Values on this page may be stale until the connection is restored.";

/* --- Loading / healthy / error chrome (P4 leaf contract) --- */
"live.staleBanner.loadingA11y" = "Checking the live data connection";
"live.staleBanner.healthy.title" = "Live data connected";
"live.staleBanner.healthy.message" = "You're receiving live data. This notice appears only when the live connection has been offline for more than two minutes.";
"live.staleBanner.errorTitle" = "Couldn't check the live connection";
"live.staleBanner.retry" = "Retry";

/* --- Connection chip (P4 status-reading axis) --- */
"live.staleBanner.chip.offline" = "Offline";
"live.staleBanner.chip.stale" = "Stale";
"live.staleBanner.offlineA11y" = "Live data offline — tap to try reconnecting";
"live.staleBanner.staleA11y" = "Live connection check is stale — tap to retry";
"live.staleBanner.staleNote" = "Reconnecting to live data.";
