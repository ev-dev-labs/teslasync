/*
  ChartHiddenSeriesContext.strings
  TeslaSync — P4 shared surface · 0067 · ChartHiddenSeriesContext (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/charts/ChartHiddenSeriesContext.tsx + hooks/useHiddenSeries.ts) is an anonymous,
  transparent coordination primitive — it carries no user-facing copy of its own (it only broadcasts a
  HiddenSeriesState and stores the hidden set in the URL). The shipped entries here back the reusable
  legend chip (ChartHiddenSeriesLegendChip — the native parity of a `<ChartLegend>` entry consuming the
  context): its VoiceOver visibility value and toggle hint. The remaining "sample" entries back the
  DEBUG-only sample chart used by the previews + the view-composition tests; they are never shipped.
  Production callers wrap their own already-localized legends.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are
  kept in a per-surface table ("ChartHiddenSeriesContext") so each parallel surface prompt owns its own
  strings.
*/

/* --- Legend chip (shipped; consumes the context) --- */
"chartHiddenSeries.legend.shown" = "Shown";
"chartHiddenSeries.legend.hidden" = "Hidden";
"chartHiddenSeries.legend.hint" = "Double tap to toggle this series";

/* --- DEBUG sample chart (previews + tests only; not shipped) --- */
"chartHiddenSeries.sample.axis.x" = "Week";
"chartHiddenSeries.sample.axis.y" = "Percent";
"chartHiddenSeries.sample.chart.aria" = "Battery health sample chart";
"chartHiddenSeries.sample.chart.value" = "%1$d of %2$d series shown";
"chartHiddenSeries.sample.standalone" = "No provider (toggling disabled)";
