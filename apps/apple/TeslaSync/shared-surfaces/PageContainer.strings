/*
  PageContainer.strings
  TeslaSync — P4 shared surface · 0171 · PageContainer (Apple)

  The P1/S10 i18n catalog contribution for this surface. The keys mirror the web sources the surface
  reproduces — `components/layout/PageContainer.tsx`, the freshness chip it composes
  (`components/data-display/DataFreshness.tsx`), and the copy-link button
  (`components/layout/CopyLinkButton.tsx`) — one-for-one. The freshness + copy-link entries reuse the
  web consumers' own `t()` keys (`freshness.*`, `a11y.dataFreshness`, `common.copyLink.*`) so the
  catalog stays consistent; the page-chrome keys (`page.*`) lift the web English literals (the centred
  spinner, the red error box's heading, the `No {title} found.` empty default) into keys so the Swift
  sources hold no hardcoded prose. These entries fold into the app `Localizable.xcstrings` master
  catalog at integration time; they are kept in a per-surface table ("PageContainer") so each parallel
  surface prompt owns its own strings without editing the shared catalog.

  The relative-age + freshness templates insert their value with a `%@` token (locale- + width-safe).
*/

/* --- Page chrome (web `PageContainer.tsx`) --- */
"page.loadingA11y" = "Loading";
"page.errorTitle" = "Something went wrong";
"page.retry" = "Retry";
"page.emptyDefault" = "No %@ found.";

/* --- Freshness chip (web `DataFreshness.tsx` `formatRelativeTime` + `STATUS_CONFIG`) --- */
"freshness.justNow" = "just now";
"freshness.minutes" = "%@m ago";
"freshness.hours" = "%@h ago";
"freshness.days" = "%@d ago";
"freshness.weeks" = "%@w ago";
"freshness.updating" = "updating…";
"freshness.offlineLabel" = "offline";
"freshness.refresh" = "Refresh";

/* --- Freshness status words (VoiceOver — the spoken band name) --- */
"freshness.status.fresh" = "Fresh";
"freshness.status.fetching" = "Updating";
"freshness.status.stale" = "Stale";
"freshness.status.offline" = "Offline";
"a11y.dataFreshness" = "Data freshness: %@";

/* --- Copy-link button (web `CopyLinkButton.tsx`) --- */
"common.copyLink.action" = "Copy link";
"common.copyLink.copied" = "Copied";
"common.copyLink.label" = "Copy link to this view";
