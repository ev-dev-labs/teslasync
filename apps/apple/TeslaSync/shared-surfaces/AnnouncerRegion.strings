/*
  AnnouncerRegion.strings
  TeslaSync — P4 shared surface · 0001 · AnnouncerRegion (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/a11y/AnnouncerRegion.tsx) is anonymous — it renders two visually-hidden live
  regions and extracts no `t()` keys — so every key here is native chrome: the inspector
  title, the two region names + roles, the recent-history heading, the VoiceOver wording,
  and the P4 leaf freshness / loading / empty / error copy, so the Swift sources hold no
  English literals. These entries fold into the app `Localizable.xcstrings` master catalog
  at integration time; they are kept in a per-surface table ("AnnouncerRegion") so each
  parallel surface prompt owns its own strings without editing the shared catalog.
*/

/* --- Surface header --- */
"announcer.title" = "Announcements";
"announcer.subtitle" = "Live screen-reader announcements voiced by the app";

/* --- Live regions (the web polite + assertive siblings) --- */
"announcer.region.polite" = "Polite";
"announcer.region.assertive" = "Assertive";
"announcer.region.politeRole" = "Waits for VoiceOver to finish";
"announcer.region.assertiveRole" = "Interrupts VoiceOver";
"announcer.region.emptyValue" = "—";
"announcer.region.emptyA11y" = "no announcement yet";

/* --- Recent history --- */
"announcer.history.title" = "Recent announcements";

/* --- Loading / empty / error chrome --- */
"announcer.loadingA11y" = "Loading announcements";
"announcer.empty" = "No announcements yet";
"announcer.emptyMessage" = "Screen-reader announcements will appear here as the app voices them.";
"announcer.errorTitle" = "Couldn't load announcements";
"announcer.retry" = "Retry";

/* --- Freshness (P4 connectivity axis) --- */
"announcer.live" = "Live";
"announcer.stale" = "Stale";
"announcer.offline" = "Offline";
"announcer.staleA11y" = "Stale — tap to refresh";
"announcer.offlineA11y" = "Offline — showing last known announcements";
