/*
  LiveTelemetrySegment.strings
  TeslaSync — P4 shared surface · 0180 · LiveTelemetrySegment (Apple)

  The P1/S10 i18n catalog contribution for this surface. The keys in the first block mirror the web
  source (components/layout/status-bar/LiveTelemetrySegment.tsx) one-for-one — the four connection-state
  short labels, the tooltip title + the "last message" clause, and the VoiceOver status label. The second
  block carries the compact age unit forms the web `ageSecondsLabel` hard-codes inline (`Xs` / `Xm` /
  `Xh`), routed through keys so the Swift sources hold no bare literals; the `{{count}}` token mirrors the
  web interpolation and shapes the digits for the locale. The last key is the native open-hint for
  VoiceOver (the segment is a link to the live signal explorer).

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are
  kept in a per-surface table ("LiveTelemetrySegment") so each parallel surface prompt owns its own
  strings without editing the shared catalog. In test / preview bundles `NSLocalizedString` returns the
  value below, keeping the labels deterministic.
*/

/* --- Web source keys (LiveTelemetrySegment.tsx) --- */
"statusBar.live.short" = "Live";
"statusBar.live.reconnecting" = "Reconnecting";
"statusBar.live.offline" = "Offline";
"statusBar.live.unknown" = "Idle";
"statusBar.live.tooltip" = "Live telemetry stream";
"statusBar.live.lastMessage" = "Last message {{age}} ago";
"statusBar.live.aria" = "Live telemetry status";

/* --- Compact age stamp (parity of ageSecondsLabel in LiveTelemetrySegment.tsx) --- */
"statusBar.live.age.seconds" = "{{count}}s";
"statusBar.live.age.minutes" = "{{count}}m";
"statusBar.live.age.hours" = "{{count}}h";

/* --- Native link hint (VoiceOver) --- */
"statusBar.live.openHint" = "Opens the live signal explorer";
