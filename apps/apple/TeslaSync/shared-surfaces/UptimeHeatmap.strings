/*
  UptimeHeatmap.strings
  TeslaSync — P4 shared surface · 0202 · UptimeHeatmap (Apple)

  The P1/S10 i18n catalog contribution for this surface. The keys mirror the web source
  (components/status/UptimeHeatmap.tsx) one-for-one: the default heading (web `Uptime — last N days`),
  the uptime caption suffix (web `{fmtPercent} uptime`), the five status labels (web `STATUS_LABEL`),
  the grid container label (web `aria-label="Daily status history"`), and each square's label (web
  `aria-label={`${date}: ${STATUS_LABEL[status]}`}`). It also adds the friendly empty state (a native
  HIG affordance the web — which renders a bare empty grid — omits). The composed strings are localizable
  FORMATS (`%d`, `%@`, `%1$@`/`%2$@`) so the word order + separators translate.

  All keys live in the per-surface "UptimeHeatmap" table and resolve through the P1/S10 facade
  (UptimeHeatmapStrings) so the Swift sources hold no hardcoded prose; they fold into the app
  `Localizable.xcstrings` master catalog at integration time.
*/

/* --- Heading (web `title ?? `Uptime — last ${days.length} days``) --- */
/* %d = number of days in the window */
"uptimeHeatmap.title" = "Uptime — last %d days";

/* --- Uptime caption (web `${fmtPercent(uptimePct, 2)} uptime`) --- */
/* %@ = the formatted percentage, e.g. "99.50%" */
"uptimeHeatmap.uptimeCaption" = "%@ uptime";

/* --- Status labels (web `STATUS_LABEL`) --- */
"uptimeHeatmap.status.healthy" = "Operational";
"uptimeHeatmap.status.degraded" = "Degraded";
"uptimeHeatmap.status.unhealthy" = "Outage";
"uptimeHeatmap.status.unknown" = "Unknown";
"uptimeHeatmap.status.maintenance" = "Maintenance";

/* --- Accessibility (web grid + per-square aria-labels) --- */
"uptimeHeatmap.gridAccessibility" = "Daily status history";
/* %1$@ = date, %2$@ = status label, e.g. "2026-06-11: Operational" */
"uptimeHeatmap.squareAccessibility" = "%1$@: %2$@";

/* --- Friendly empty state (native HIG affordance — never a blank box) --- */
"uptimeHeatmap.empty.title" = "No status history";
"uptimeHeatmap.empty.message" = "Daily status appears here once health history is recorded.";
