/*
  Breadcrumbs.strings
  TeslaSync — P4 shared surface · 0167 · Breadcrumbs (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source (components/layout/Breadcrumbs.tsx)
  renders no body copy of its own; its only user-facing strings are the two accessibility labels it
  resolves through `useTranslation`: the `<nav aria-label>` (`a11y.breadcrumb`) and the leading Home link's
  label (`a11y.breadcrumbHome`). Those two keys + English fallbacks are ported verbatim below (shipped).

  The remaining "sample" entries back the DEBUG-only inspector + scenarios the previews and the
  view-composition tests render; they are never shipped.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept
  in a per-surface table ("Breadcrumbs") so each parallel surface prompt owns its own strings.
*/

/* --- Accessibility labels (shipped — web a11y.breadcrumb / a11y.breadcrumbHome) --- */
"a11y.breadcrumb" = "Breadcrumb";
"a11y.breadcrumbHome" = "Dashboard";

/* --- DEBUG inspector scenario titles (previews + tests only; not shipped) --- */
"breadcrumbs.sample.scenario.rendered" = "Rendered trail (nested route)";
"breadcrumbs.sample.scenario.deep" = "Deep trail (regular width)";
"breadcrumbs.sample.scenario.collapsed" = "Collapsed trail (compact width)";
"breadcrumbs.sample.scenario.suppressed" = "Suppressed (top-level page)";
"breadcrumbs.sample.scenario.empty" = "Empty (no items)";

/* --- DEBUG inspector notes for the non-rendering branches (previews + tests only; not shipped) --- */
"breadcrumbs.sample.note.empty" = "No breadcrumb — empty trail";
"breadcrumbs.sample.note.suppressed" = "Single item — breadcrumb hidden (top-level page)";
