/*
  ElevationProfile.strings
  TeslaSync — P4 shared surface · 0071 · ElevationProfile (Apple)

  The P1/S10 i18n catalog contribution for this surface. Every key the native surface resolves
  (table "ElevationProfile") lives here with its English value. The web source resolves all of its copy
  through `useTranslation` (it takes no text props), so the surface owns every key — the four keys from
  the web source plus the surface-owned regions the P4 leaf contract requires (the metre / gain-loss
  labels, the VoiceOver summary, and the loading / error / freshness chrome).

  Web-source provenance (components/charts/ElevationProfile.tsx):
    • replay.elevation.title       — t('replay.elevation.title', 'Elevation Profile')
    • replay.elevation.aria        — empty-branch ariaLabel: 'Elevation profile chart — no data available yet'
    • replay.elevation.ariaPopulated — populated-branch ariaLabel: 'Elevation profile chart along the
                                       route, with total gain and loss in meters'. The web source keys
                                       BOTH aria strings under the single id `replay.elevation.aria`
                                       (differing only in fallback); to preserve both spoken labels for
                                       VoiceOver parity, the populated variant is keyed distinctly here.
    • replay.elevation.noData      — t('replay.elevation.noData', 'No elevation data available')
    • replay.elevation.label       — t('replay.elevation.label', 'Elevation') (the tooltip series label)

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are
  kept in a per-surface table so each parallel surface prompt owns its own strings.
*/

/* --- Title + ARIA (web source) --- */
"replay.elevation.title" = "Elevation Profile";
"replay.elevation.aria" = "Elevation profile chart — no data available yet";
"replay.elevation.ariaPopulated" = "Elevation profile chart along the route, with total gain and loss in meters";

/* --- Empty state (web `<EmptyState message={t('replay.elevation.noData')} />`) --- */
"replay.elevation.noData" = "No elevation data available";
"replay.elevation.empty.title" = "No elevation data";

/* --- Series + units (web tooltip label + `m` / distanceUnit axis labels) --- */
"replay.elevation.label" = "Elevation";
"replay.elevation.unit.m" = "m";

/* --- Gain / loss subtitle (web `↑ ${gain}m  ↓ ${loss}m`) --- */
"replay.elevation.gainLoss" = "↑ %1$@ m  ↓ %2$@ m";
"replay.elevation.gainLossA11y" = "Total ascent %1$@ metres, total descent %2$@ metres";

/* --- Chart accessibility summary (span / range / ascent / descent, positional args) --- */
"replay.elevation.a11y.summary" = "Elevation profile over %1$@ %2$@: from %3$@ to %4$@ metres, total ascent %5$@ metres, total descent %6$@ metres";

/* --- Loading state (P4 leaf: parent fetch → skeleton) --- */
"replay.elevation.loadingA11y" = "Loading elevation profile";

/* --- Error state (the `QueryError` peer) --- */
"replay.elevation.error.message" = "Couldn't load the elevation profile.";
"replay.elevation.error.retry" = "Retry";

/* --- Freshness chip (P4 connectivity axis: stale / offline) --- */
"replay.elevation.freshness.stale" = "Stale";
"replay.elevation.freshness.staleA11y" = "Showing stale data — tap to refresh";
"replay.elevation.freshness.offline" = "Offline";
"replay.elevation.freshness.offlineA11y" = "Offline — showing the last known data";
