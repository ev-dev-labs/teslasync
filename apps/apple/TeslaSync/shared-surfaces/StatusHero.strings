/*
  StatusHero.strings
  TeslaSync — P4 shared surface · 0199 · StatusHero (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/status/StatusHero.tsx) hard-codes its copy as English literals: the five per-status default
  headlines (the `STATUS_CONFIG[*].defaultHeadline` values) and the "Live" word. Native ships NO
  hardcoded prose, so those literals are lifted into the localizable keys below and resolved through the
  P1/S10 facade (StatusHeroStrings). The `headline` override, `subline`, and `cta.label` are
  caller-supplied (already-localized) string props, so they carry no key here.

  All keys live in the per-surface "StatusHero" table and fold into the app `Localizable.xcstrings` master
  catalog at integration time. In test / preview bundles `NSLocalizedString` returns the value below,
  keeping the default render deterministic and byte-identical to the web English copy.
*/

/* --- Per-status default headlines (web STATUS_CONFIG[*].defaultHeadline) --- */

/* healthy → green medallion. The resting "everything is fine" headline. */
"statusHero.headline.healthy" = "All systems operational";

/* degraded → amber medallion. Some subsystem is impaired but the service is up. */
"statusHero.headline.degraded" = "Degraded performance";

/* unhealthy → red medallion. A blocking outage. */
"statusHero.headline.unhealthy" = "Service outage";

/* unknown → zinc medallion. No health answer yet (the web's "no data" tier). */
"statusHero.headline.unknown" = "Status unknown";

/* maintenance → blue medallion. A planned maintenance window. */
"statusHero.headline.maintenance" = "Scheduled maintenance";

/* --- Live chip (web <span>Live</span> / LiveIndicator label) --- */

/* The "Live" word announced to VoiceOver when live updates are connected. */
"statusHero.live" = "Live";
