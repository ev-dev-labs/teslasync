/*
  ActiveFilterChips.strings
  TeslaSync — P4 shared surface · 0147 · ActiveFilterChips (Apple)

  The P1/S10 i18n catalog contribution for this surface — the native peers of the web `t(key, default)`
  keys in `components/forms/ActiveFilterChips.tsx`. Every key/fallback pair below is byte-identical to the
  web source so the strip reads the same on both platforms; the `{{count}}` / `{{label}}` tokens carry the
  i18next interpolation placeholders through verbatim (resolved by ActiveFilterChipsProjector.interpolate).

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept
  in a per-surface table ("ActiveFilterChips") so each parallel surface prompt owns its own strings. In
  test / preview bundles `NSLocalizedString` returns the value below, keeping the labels deterministic.
*/

/* --- Web `t()` keys (verbatim from components/forms/ActiveFilterChips.tsx) --- */

/* Group container aria-label (web `filters.activeLabel`). */
"filters.activeLabel" = "Active filters";

/* "Clear all" affordance (web `filters.clearAll`). */
"filters.clearAll" = "Clear all";

/* The "+N more" overflow trigger; {{count}} is the collapsed-chip count (web `filters.moreCount`). */
"filters.moreCount" = "+{{count}} more";

/* The overflow popover aria-label (web `filters.moreLabel`). */
"filters.moreLabel" = "Additional active filters";

/* One chip's remove-button aria-label; {{label}} is the chip's field name (web `filters.removeAria`). */
"filters.removeAria" = "Remove filter {{label}}";

/* Polite live-region announcement when one chip is removed (web `filters.removed`). */
"filters.removed" = "Filter removed";

/* Polite live-region announcement when every chip is cleared (web `filters.clearedAll`). */
"filters.clearedAll" = "All filters cleared";

/* --- Native a11y additions (no blank box — see the empty-group branch) --- */

/* Friendly body shown in the (kept) empty group when `hideWhenEmpty == false`, so the surface never
   renders a bare box. The web simply renders the empty group; the native HIG calls for a labelled
   placeholder. */
"activeFilterChips.empty" = "No active filters";
