/*
  HelpSegment.strings
  TeslaSync — P4 shared surface · 0179 · HelpSegment (Apple)

  The P1/S10 i18n catalog contribution for this surface. The seven keys below mirror the web source
  (components/layout/status-bar/HelpSegment.tsx) one-for-one — the tooltip + VoiceOver `aria-label` for each
  of the three affordances (keyboard shortcuts, take a tour, report bug), plus the shortcuts hint suffix
  shown at the wide breakpoint. The values are the verbatim web `t(key, default)` fallbacks. The `?` key cap
  next to the shortcuts icon is a fixed glyph (the keyboard hint), not localized copy, so it lives in the
  Swift sources (HelpSegmentSurface.shortcutKeyCap), exactly as the web hard-codes `<kbd>?</kbd>`.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept
  in a per-surface table ("HelpSegment") so each parallel surface prompt owns its own strings without
  editing the shared catalog. In test / preview bundles `NSLocalizedString` returns the value below, keeping
  the labels deterministic.
*/

/* --- Keyboard shortcuts affordance (web t('shortcuts.*')) --- */
"shortcuts.tooltip" = "Keyboard shortcuts";
"shortcuts.openAria" = "Open keyboard shortcuts";
"shortcuts.hintSuffix" = "for shortcuts";

/* --- Take a tour affordance (web t('tour.launcher.*')) --- */
"tour.launcher.openShort" = "Take a tour";
"tour.launcher.openAria" = "Open tour launcher";

/* --- Report bug affordance (web t('feedback.*')) --- */
"feedback.openShort" = "Report bug";
"feedback.openAria" = "Open feedback / bug report form";
