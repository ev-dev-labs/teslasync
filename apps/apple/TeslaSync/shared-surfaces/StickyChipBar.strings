/*
  StickyChipBar.strings
  TeslaSync — P4 shared surface · 0200 · StickyChipBar (Apple)

  The P1/S10 i18n catalog contribution for this surface — the native peer of the one literal in
  `components/status/StickyChipBar.tsx` (`aria-label="Jump to section"`, which the web hardcodes) plus the
  native accessibility additions. The native surface routes every string through the facade per the
  no-hardcoded-English rule, even where the web source inlined it.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept
  in a per-surface table ("StickyChipBar") so each parallel surface prompt owns its own strings. In test /
  preview bundles `NSLocalizedString` returns the value below, keeping the labels deterministic.
*/

/* --- Web literal (from components/status/StickyChipBar.tsx) --- */

/* The nav container label (web `aria-label="Jump to section"`). */
"stickyChipBar.ariaLabel" = "Jump to section";

/* --- Native a11y additions --- */

/* Friendly body shown when there are no chips, so the surface never renders a bare bar. The web renders an
   empty nav; the native HIG calls for a labelled empty view. */
"stickyChipBar.empty" = "No sections";

/* One chip's VoiceOver hint — clarifies that activating the pill scrolls to its section (the action behind
   the web `handleClick`). */
"stickyChipBar.chipHint" = "Jumps to section";
