/*
  PinButton.strings
  TeslaSync — P4 shared surface · 0222 · PinButton (Apple)

  The P1/S10 i18n catalog contribution for this surface — the native peers of the web `t(key, default)`
  keys in `components/ui/PinButton.tsx`. The three pin keys below are byte-identical to the web source so
  the affordance reads the same on both platforms; the remaining keys are the native additions for the P4
  states the web swallows (the cold-load / busy accessibility values and the gated freshness / error
  badge), so VoiceOver announces what the web conveys through its disabled flag + toast.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are
  kept in a per-surface table ("PinButton") so each parallel surface prompt owns its own strings. In test
  / preview bundles `NSLocalizedString` returns the value below, keeping the labels deterministic.
*/

/* --- Web `t()` keys (verbatim from components/ui/PinButton.tsx) --- */

/* Tooltip + aria-label when the row is NOT pinned; also the inline label (web `pin.pin`). */
"pin.pin" = "Pin";

/* Tooltip + aria-label when the row IS pinned (web `pin.unpin`). */
"pin.unpin" = "Unpin";

/* Inline label shown beside the glyph when the row is pinned + `showLabel` (web `pin.pinned`). */
"pin.pinned" = "Pinned";

/* --- Native P4 / a11y additions (states the web folds into the unpinned default + the toast) --- */

/* Accessibility value while the first pin fetch is in flight with no cached set (web renders unpinned). */
"pin.loading" = "Loading pins…";

/* Accessibility value while a pin / unpin mutation is in flight (web `toggle.isPending` → disabled). */
"pin.busy" = "Updating…";

/* VoiceOver "Retry" action title for the failed / stale badge (web `QueryError` retry affordance). */
"pin.status.retry" = "Retry";

/* Gated badge + accessibility value when the pin set is refreshing (the P4 stale axis). */
"pin.status.stale" = "Refreshing pinned items…";

/* Gated badge + accessibility value when offline — the cached pins stay applied (the P4 offline axis). */
"pin.status.offline" = "Offline — showing the last known pins";

/* Gated badge + accessibility value when the pin set failed to load (the P4 error axis). */
"pin.status.error" = "Couldn't load pinned items";
