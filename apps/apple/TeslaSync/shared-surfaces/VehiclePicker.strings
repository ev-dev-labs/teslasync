/*
  VehiclePicker.strings
  TeslaSync — P4 shared surface · 0183 · VehiclePicker (Apple)

  The P1/S10 i18n catalog contribution for this surface — the native peer of the strings used by
  `components/layout/VehiclePicker.tsx`. The web component's only `t()` key is mirrored VERBATIM below
  (same key, same English fallback) so the native surface resolves the identical catalog entry:
    • vehiclePicker.aria  — the "Select vehicle" accessible name of the picker

  The web hardcodes the `Vehicle ${id}` label fallback (no `t()` call); it is routed here through
  `vehiclePicker.fallback` so the native code holds no English literal while showing the same string.

  The remaining entries are the NATIVE chrome / accessibility additions for the P4 always-render leaf states
  (loading / empty / error) and the freshness axis (live / stale / offline), plus the pin / selection markers
  (the native peer of the web `📌` label prefix) — the web renders nothing for a 0/1-vehicle fleet and has no
  loading / error / connectivity chrome, whereas the native HIG calls for a labelled state rather than a blank
  box.

  These fold into the app `Localizable.xcstrings` master catalog at integration time; kept in a per-surface
  table ("VehiclePicker") so each parallel surface prompt owns its own strings. In test / preview bundles
  `NSLocalizedString` returns the value below, keeping the labels deterministic.
*/

/* --- Web source key (verbatim) --- */

/* The accessible name of the picker (web `t('vehiclePicker.aria', 'Select vehicle')`). */
"vehiclePicker.aria" = "Select vehicle";

/* The "Vehicle" word in the `Vehicle ${id}` label fallback (web hardcodes `\`Vehicle ${v.id}\``). */
"vehiclePicker.fallback" = "Vehicle";

/* --- Native chrome / a11y additions (no blank box — see the leaf states) --- */

/* The collapsed-selector placeholder shown when nothing is selected. */
"vehiclePicker.placeholder" = "Select vehicle";

/* VoiceOver label for the initial loading skeleton (web hides while loading). */
"vehiclePicker.loadingA11y" = "Loading vehicles";

/* The label shown when the fleet resolved empty (web returns null). */
"vehiclePicker.empty" = "No vehicles";

/* Title of the compact error tile shown when the fleet read fails (web has no QueryError peer). */
"vehiclePicker.errorTitle" = "Couldn't load vehicles";

/* Retry action on the error tile. */
"vehiclePicker.retry" = "Retry";

/* VoiceOver hint appended to a pinned row (the native peer of the web `📌` prefix). */
"vehiclePicker.pinnedA11y" = "Pinned";

/* VoiceOver hint appended to the currently-selected row. */
"vehiclePicker.selectedA11y" = "Selected";

/* Freshness chip label — the live fleet is fresh. */
"vehiclePicker.live" = "Live";

/* Freshness chip label — the fleet is older than the freshness window. */
"vehiclePicker.stale" = "Stale";

/* Freshness chip label — no connectivity; the cached fleet is shown. */
"vehiclePicker.offline" = "Offline";

/* Expanded VoiceOver label for the stale freshness chip (it is a refresh button). */
"vehiclePicker.staleA11y" = "Stale — tap to refresh";

/* Expanded VoiceOver label for the offline freshness chip. */
"vehiclePicker.offlineA11y" = "Offline — showing the last value";
