/*
  SwipeRow.strings
  TeslaSync — P4 shared surface · 0189 · SwipeRow (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (web/src/components/mobile/SwipeRow.tsx) is anonymous — it resolves NO `t()` keys of its own; the
  action labels arrive already-localized from the host (web `SwipeAction.label`), exactly as the
  native `SwipeAction.label` is host-supplied. Every key below is therefore native chrome the web
  pure render has no concept of: the generic-action + actions-available VoiceOver copy, the P4 leaf
  states (loading / empty), and the freshness chip + banner. Entries fold into the app
  `Localizable.xcstrings` master catalog at integration time; kept in a per-surface table ("SwipeRow")
  so each parallel surface prompt owns its own strings without editing the shared catalog.
*/

/* --- Accessibility (the hidden swipe gesture made operable) --- */
"swipeRow.action.generic" = "Action";
"swipeRow.actionsAvailable" = "Actions available";

/* --- P4 leaf contract — loading / empty --- */
"swipeRow.loadingA11y" = "Loading row";
"swipeRow.empty.title" = "Nothing here";
"swipeRow.empty.message" = "There is nothing to show in this list yet.";

/* --- Freshness (P4 connectivity axis) --- */
"swipeRow.live" = "Live";
"swipeRow.stale" = "Stale";
"swipeRow.offline" = "Offline";
"swipeRow.staleA11y" = "Stale — tap to refresh";
"swipeRow.offlineA11y" = "Offline — showing the last known row";
"swipeRow.staleBanner" = "Showing a slightly out-of-date row.";
"swipeRow.offlineBanner" = "You're offline — showing the last cached row.";
"swipeRow.refresh" = "Refresh";
