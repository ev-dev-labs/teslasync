/*
  SearchInput.strings
  TeslaSync — P4 shared surface · 0158 · SearchInput (Apple)

  The P1/S10 i18n catalog contribution for this surface. The first four entries mirror the web
  `components/forms/SearchInput.tsx` `t()` calls VERBATIM (same key, same English default), so the native
  field resolves identical copy: the clear-button label (`common.clear`), the recent-searches heading +
  listbox label (`search.history.title`), the per-row remove label (`search.history.removeAria`, whose web
  `{{query}}` interpolation becomes the `%@` placeholder), and the clear-all action (`search.history.clear`).

  The remaining entries are native a11y additions the web gets "for free" from the DOM: the field's
  VoiceOver label (the web `<input type="search">` exposes its role automatically), the combobox hint, the
  per-row select hint, and the "never a blank box" empty-history leaf (the web simply renders no popover
  when the scope has no entries).

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept
  in a per-surface table ("SearchInput") so each parallel surface prompt owns its own strings. In test /
  preview bundles `NSLocalizedString` returns the value below, keeping the labels deterministic.
*/

/* --- Web `t()` parity keys (verbatim from components/forms/SearchInput.tsx) --- */

/* Accessible label for the trailing clear button (web t('common.clear', 'Clear')). */
"common.clear" = "Clear";

/* Recent-searches dropdown heading + listbox label (web t('search.history.title', 'Recent searches')). */
"search.history.title" = "Recent searches";

/* Per-row remove label; %@ is the row's query (web t('search.history.removeAria', 'Remove "{{query}}" …')). */
"search.history.removeAria" = "Remove \"%@\" from search history";

/* Clear-all action label (web t('search.history.clear', 'Clear history')). */
"search.history.clear" = "Clear history";

/* --- Native a11y additions (no web t() key; the DOM supplies these to AT automatically) --- */

/* VoiceOver label for the search field itself. */
"searchInput.a11y.fieldLabel" = "Search";

/* VoiceOver hint for a history-enabled field (spoken peer of role="combobox" aria-autocomplete="list"). */
"searchInput.a11y.fieldHint" = "Recent searches appear when the field is empty.";

/* VoiceOver hint for a recent-search row — the action a tap performs. */
"searchInput.a11y.selectHint" = "Search for this term";

/* Title of the empty-history leaf, shown when a history dropdown has nothing to reveal. */
"searchInput.history.empty" = "No recent searches";

/* Supporting line of the empty-history leaf. */
"searchInput.history.emptyMessage" = "Searches you make appear here for quick access.";
