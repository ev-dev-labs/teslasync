/*
  TimeStamp.strings
  TeslaSync — P4 shared surface · 0108 · TimeStamp (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (web/src/components/data-display/TimeStamp.tsx) is anonymous — it makes no `t()` calls and wraps the
  pure helpers in web/src/lib/dateFormat.ts, which hold a few hardcoded English relative phrases
  ("just now", "{n}m ago", "{n}h ago", "{n}d ago"). Native code holds no English literals, so those
  phrases plus the P4 leaf chrome (empty / loading a11y / freshness) + the VoiceOver strings resolve
  through these keys. The `{{count}}` / `{{value}}` tokens mirror the web i18next interpolation. These
  entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept
  in a per-surface table ("TimeStamp") so each parallel surface prompt owns its own strings without
  editing the shared catalog.
*/

/* --- Relative-time phrases (parity of formatRelative in dateFormat.ts) --- */
"format.timeStamp.relative.justNow" = "just now";
"format.timeStamp.relative.minutesAgo" = "{{count}}m ago";
"format.timeStamp.relative.hoursAgo" = "{{count}}h ago";
"format.timeStamp.relative.daysAgo" = "{{count}}d ago";

/* --- Empty / loading chrome (P4 leaf contract) --- */
"format.timeStamp.emptyA11y" = "No time";
"format.timeStamp.loadingA11y" = "Loading time";

/* --- Tooltip alternate (web Tooltip content), spoken as the VoiceOver hint --- */
"format.timeStamp.alternateA11y" = "Also {{value}}";

/* --- Freshness (P4 connectivity axis) --- */
"format.timeStamp.live" = "Live";
"format.timeStamp.stale" = "Stale";
"format.timeStamp.offline" = "Offline";
"format.timeStamp.staleA11y" = "Stale — tap to refresh";
"format.timeStamp.offlineA11y" = "Offline — showing the last known time";
