/*
  BrowserCompatBanner.strings
  TeslaSync — P4 shared surface · 0114 · BrowserCompatBanner (Apple)

  The P1/S10 i18n catalog contribution for this surface. The banner keys mirror the web source
  (components/feedback/BrowserCompatBanner.tsx) verbatim — compat.banner.title / .body / .dismiss —
  with the body template carrying the {features} / {recommendation} tokens the native body builder
  substitutes (web i18next {{features}} / {{recommendation}}). The capability names, the recommended
  runtime, and the native P4 leaf chrome (loading / empty / error / freshness) round out the surface
  so the Swift sources hold no English literals. These entries fold into the app
  Localizable.xcstrings master catalog at integration time; they are kept in a per-surface table
  ("BrowserCompatBanner") so each parallel surface prompt owns its own strings without editing the
  shared catalog.
*/

/* --- Banner (web `compat.banner.*`) --- */
"compat.banner.title" = "Your device is missing required features";
"compat.banner.body" = "TeslaSync needs {features} to work correctly. {recommendation}";
"compat.banner.dismiss" = "Dismiss";
"compat.banner.recommendation" = "Update to iOS 18, iPadOS 18, or macOS 15 (or later), then reinstall TeslaSync.";

/* --- Required capabilities (web required-feature list) --- */
"compat.capability.swiftCharts" = "Swift Charts";
"compat.capability.mapKit" = "MapKit";
"compat.capability.liveActivities" = "Live Activities";
"compat.capability.widgets" = "Widgets";
"compat.capability.backgroundRefresh" = "Background App Refresh";

/* --- Empty card (web `if (dismissed || missing.length === 0) return null`, P4 leaf contract) --- */
"compat.empty.compatible.title" = "Your device is fully supported";
"compat.empty.compatible.message" = "All required features are available. A notice appears here only if your device is missing something TeslaSync needs.";
"compat.empty.acknowledged.title" = "Compatibility notice dismissed";
"compat.empty.acknowledged.message" = "You dismissed the compatibility notice. Some features may not work correctly until you update your device.";

/* --- Loading / error chrome (P4 leaf contract) --- */
"compat.loadingA11y" = "Checking device compatibility";
"compat.errorTitle" = "Couldn't check device compatibility";
"compat.retry" = "Retry";

/* --- Freshness (P4 connectivity axis) --- */
"compat.live" = "Live";
"compat.stale" = "Stale";
"compat.offline" = "Offline";
"compat.staleA11y" = "Stale — tap to re-check compatibility";
"compat.offlineA11y" = "Offline — showing the last compatibility check";
