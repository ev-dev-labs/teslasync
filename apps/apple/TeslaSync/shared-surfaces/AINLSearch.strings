/*
  AINLSearch.strings
  TeslaSync — P4 shared surface · 0034 · AINLSearch (Apple)

  The P1/S10 i18n catalog contribution for this surface. Every key the native surface
  resolves (table "AINLSearch") lives here with its web `t(key, default)` English value.
  These entries fold into the app `Localizable.xcstrings` master catalog at integration time;
  they are kept in a per-surface table so each parallel surface prompt owns its own strings
  without editing the shared catalog.

  Group 1 is the exact set of keys from the web source (components/ai/AINLSearch.tsx). Group 2
  is the shared Helix scaffold keys the web `AIFeatureCard` / `AiOutputPanel` / `AIBadge`
  resolve (the universal "Ask Helix" CTA, the thinking label, the badge tooltip, the error
  label). Group 3 backs the native chrome — the prompt field a11y label (the web Textarea has
  no aria-label), the P4 leaf freshness / loading / empty / error copy + the a11y results-ready
  phrase — so the Swift sources hold no English literals.
*/

/* --- Group 1: keys from the web source (parity) --- */
"search.aiSearch.title" = "Search with natural language";
"search.aiSearch.description" = "Describe what you are looking for and the assistant will surface drives, charging sessions, and alerts that match — citing each entity by name.";
"search.aiSearch.searchButton" = "Search with Helix";
"search.aiSearch.badge" = "Helix";
"search.aiSearch.placeholder" = "e.g. drives last weekend over 200 km with phantom drain";

/* --- Group 2: shared Helix scaffold (web AIFeatureCard / AiOutputPanel / AIBadge) --- */
"helix.askHelix" = "Ask Helix";
"helix.thinking" = "Helix is thinking…";
"helix.tooltip" = "Helix is your AI assistant. It generates responses using your redacted fleet context.";
"helix.ariaLabel" = "Helix";
"helix.errorLabel" = "Helix error:";
"ai.common.errorUnknown" = "unknown";

/* --- Group 3: native chrome — prompt a11y label + P4 leaf freshness / loading / empty / error + a11y --- */
"search.aiSearch.inputLabel" = "Search prompt";
"search.aiSearch.emptyHintPrompt" = "Describe what you're looking for to search.";
"search.aiSearch.resultsReady" = "Results ready";
"search.aiSearch.loadingA11y" = "Loading Helix search";
"search.aiSearch.errorTitle" = "Couldn't load Helix search";
"search.aiSearch.retry" = "Retry";
"search.aiSearch.live" = "Live";
"search.aiSearch.stale" = "Stale";
"search.aiSearch.offline" = "Offline";
