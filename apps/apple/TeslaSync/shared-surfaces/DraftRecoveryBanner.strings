/*
  DraftRecoveryBanner.strings
  TeslaSync — P4 shared surface · 0116 · DraftRecoveryBanner (Apple)

  The P1/S10 i18n catalog contribution for this surface. The keys mirror the web source
  (components/feedback/DraftRecoveryBanner.tsx) one-for-one — the "a moment ago" fallback, the
  noun-qualified and plain "draft restored" copy, and the "Use draft" / "Discard draft" affordances —
  plus the relative-time phrases the web `formatRelativeTime` produces (kept here so the native port
  holds no English literals) and the native P4 leaf chrome (loading / empty / error / freshness).
  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are
  kept in a per-surface table ("DraftRecoveryBanner") so each parallel surface prompt owns its own
  strings without editing the shared catalog.
*/

/* --- Banner copy (web `DraftRecoveryBanner.tsx`) --- */
"draft.unknownTime" = "a moment ago";
"draft.restoredItem" = "{{noun}} draft restored from {{when}}.";
"draft.restored" = "Draft restored from {{when}}.";
"draft.useDraft" = "Use draft";
"draft.discardDraft" = "Discard draft";

/* --- Relative time (web `formatRelativeTime`, dateFormat.ts) --- */
"draft.relative.justNow" = "Just now";
"draft.relative.minutesAgo" = "{{count}}m ago";
"draft.relative.hoursAgo" = "{{count}}h ago";

/* --- Loading / empty / error chrome (P4 leaf contract) --- */
"draft.loadingA11y" = "Loading draft";
"draft.empty" = "No draft to restore";
"draft.emptyMessage" = "Your unsaved edits will appear here if you leave and come back.";
"draft.errorTitle" = "Couldn't load your draft";
"draft.retry" = "Retry";

/* --- Freshness (P4 connectivity axis) --- */
"draft.live" = "Live";
"draft.stale" = "Stale";
"draft.offline" = "Offline";
"draft.staleA11y" = "Stale — tap to refresh";
"draft.offlineA11y" = "Offline — showing your saved draft";
