/*
  ComboboxMulti.strings
  TeslaSync — P4 shared surface · 0149 · ComboboxMulti (Apple)

  The P1/S10 i18n catalog contribution for this surface — the native peers of the web `t(key, default)`
  keys in `components/forms/ComboboxMulti.tsx`. Every web key/fallback pair below is byte-identical to
  the web source so the picker reads the same on both platforms; the `{{count}}` / `{{label}}` tokens
  carry the i18next interpolation markers through verbatim (resolved by
  ComboboxMultiProjector.interpolate). The remaining keys are native P4 leaf chrome (error retry + the
  stale/offline freshness axis + accessibility copy) so the Swift sources hold no English literals.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are
  kept in a per-surface table ("ComboboxMulti") so each parallel surface prompt owns its own strings
  without editing the shared catalog. In test / preview bundles `NSLocalizedString` returns the value
  below, keeping the labels deterministic.
*/

/* --- Web `t()` keys (verbatim from components/forms/ComboboxMulti.tsx) --- */

/* Empty-list row + zero-count announcement (web `combobox.noResults`). */
"combobox.noResults" = "No results";

/* The single-result screen-reader announcement (web `combobox.resultsCountOne`). */
"combobox.resultsCountOne" = "1 result";

/* The result-count announcement; {{count}} is the filtered option count (web `combobox.resultsCount`). */
"combobox.resultsCount" = "{{count}} results";

/* In-flight fetch indicator + loading row (web `combobox.loading`). */
"combobox.loading" = "Loading";

/* Empty-row + input-prompt copy when the selection cap is reached (web `combobox.maxReached`). */
"combobox.maxReached" = "Maximum reached";

/* Chevron accessibility label while the list is open (web `combobox.closeListAria`). */
"combobox.closeListAria" = "Hide options";

/* Chevron accessibility label while the list is closed (web `combobox.openListAria`). */
"combobox.openListAria" = "Show options";

/* The "+N more" overflow footer; {{count}} is the hidden-row count (web `combobox.moreHidden`). */
"combobox.moreHidden" = "{{count}} more — refine search";

/* One chip's remove-button accessibility label; {{label}} is the chip text (web `combobox.removeChip`). */
"combobox.removeChip" = "Remove {{label}}";

/* The polite announcement after a chip is removed; {{label}} is the chip text (web `combobox.removedChip`). */
"combobox.removedChip" = "Removed {{label}}";

/* --- Native P4 leaf chrome (no blank box; never an English literal in Swift) --- */

/* The listbox accessibility container label fallback, used when the field label is empty. */
"combobox.optionsLabel" = "Options";

/* The error-row title — the P4 `QueryError` peer for the loader failure the web swallows to empty. */
"combobox.errorTitle" = "Couldn't load options";

/* The error-row retry affordance. */
"combobox.retry" = "Retry";

/* --- Freshness (P4 connectivity axis) --- */
"combobox.live" = "Live";
"combobox.stale" = "Stale";
"combobox.offline" = "Offline";
"combobox.staleA11y" = "Stale — tap to refresh";
"combobox.offlineA11y" = "Offline — showing the last loaded options";
