/*
  LayoutBreadcrumbs.strings
  TeslaSync — P4 shared surface · 0170 · LayoutBreadcrumbs (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/layout/LayoutBreadcrumbs.tsx) is an anonymous composition — it renders no user-facing copy
  of its own (it reads the merged overrides, resolves the trail, and renders `<Breadcrumbs>`). The one
  shipped entry backs the breadcrumb-row container's accessibility label (the composition-level peer of
  the web `<nav aria-label="Breadcrumb">`; the trail renderer carries its own a11y wording in the sibling
  "BreadcrumbOverridesContext" table). The route labels themselves resolve through the app's master
  catalog (`routes.*`) with the English fallback — they are not owned by this surface.

  The remaining "sample" entries back the DEBUG-only inspector + scenarios the previews and the
  view-composition tests render; they are never shipped.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are
  kept in a per-surface table ("LayoutBreadcrumbs") so each parallel surface prompt owns its own strings.
*/

/* --- Breadcrumb-row accessibility (shipped) --- */
"layoutBreadcrumbs.a11y.row" = "Breadcrumb";

/* --- DEBUG inspector scenario titles (previews + tests only; not shipped) --- */
"layoutBreadcrumbs.sample.scenario.nested" = "Nested route (drive detail)";
"layoutBreadcrumbs.sample.scenario.deep" = "Deep route (trip replay)";
"layoutBreadcrumbs.sample.scenario.overridden" = "Override applied (drive detail)";
"layoutBreadcrumbs.sample.scenario.suppressed" = "Suppressed (top-level route)";
"layoutBreadcrumbs.sample.scenario.unknown" = "Unknown route (no trail)";

/* --- DEBUG inspector notes for the non-rendering branches (previews + tests only; not shipped) --- */
"layoutBreadcrumbs.sample.note.empty" = "No breadcrumb — route not registered";
"layoutBreadcrumbs.sample.note.suppressed" = "Single item — breadcrumb hidden (top-level page)";
