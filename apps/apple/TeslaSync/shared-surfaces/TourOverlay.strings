"tour.retry" = "Retry";

/* --- Freshness (P4 connectivity axis) --- */
"tour.live" = "Live";
"tour.stale" = "Stale";
"tour.offline" = "Offline";
"tour.staleA11y" = "Stale — tap to refresh";
