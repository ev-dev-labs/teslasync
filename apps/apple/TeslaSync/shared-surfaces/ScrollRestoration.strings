/*
  ScrollRestoration.strings
  TeslaSync — P4 shared surface · 0173 · ScrollRestoration (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/layout/ScrollRestoration.tsx) is an anonymous, transparent
  behavioral component: it renders `return null` and calls NO `t()` — it only
  tracks + restores the scroll position across navigation. It therefore has no
  user-facing copy of its own to mirror.

  The keys below back the NATIVE status surface (ScrollRestorationStatusView),
  the phase chip, and the degraded banner that satisfy the P4 "render every
  state" + accessibility contract — a legible visualization of which branch the
  (otherwise invisible) restoration logic took. Production restoration itself
  needs none of this copy; it is the platform-idiomatic way to surface the
  behavioral states the web component exposes only through its effects.

  These entries fold into the app `Localizable.xcstrings` master catalog at
  integration time; they are kept in a per-surface table ("ScrollRestoration")
  so each parallel surface prompt owns its own strings.
*/

/* --- Status surface heading + position read-out --- */
"scrollRestoration.title" = "Scroll restoration";
"scrollRestoration.position.label" = "Target position";
"scrollRestoration.offset.top" = "Top";
"scrollRestoration.unit.points" = "pt";

/* --- Phase: preparing (before the first navigation resolves) --- */
"scrollRestoration.phase.preparing.title" = "Preparing";
"scrollRestoration.phase.preparing.description" = "Waiting for the first navigation.";

/* --- Phase: restored (POP with a finite saved offset → return to it) --- */
"scrollRestoration.phase.restored.title" = "Position restored";
"scrollRestoration.phase.restored.description" = "Returned to your last scroll position on this view.";

/* --- Phase: freshTop (PUSH / REPLACE → start at the top) --- */
"scrollRestoration.phase.freshTop.title" = "Scrolled to top";
"scrollRestoration.phase.freshTop.description" = "Opened a new view at the top.";

/* --- Phase: noSavedTop (POP with nothing saved yet → start at the top) --- */
"scrollRestoration.phase.noSavedTop.title" = "Top of view";
"scrollRestoration.phase.noSavedTop.description" = "No saved position for this view yet.";

/* --- Phase: unavailable (session store disabled → can't persist) --- */
"scrollRestoration.phase.unavailable.title" = "Restoration unavailable";
"scrollRestoration.phase.unavailable.description" = "Scroll positions can't be saved on this device.";

/* --- Degraded banner (web private-mode / quota-exceeded try/catch degrade) --- */
"scrollRestoration.degraded.title" = "Scroll restoration is off";
"scrollRestoration.degraded.message" = "This device can't save scroll positions, so views always open at the top.";
