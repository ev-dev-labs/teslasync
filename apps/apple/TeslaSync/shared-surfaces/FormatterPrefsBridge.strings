"settings.formatter.localeLabel" = "Locale";
"settings.formatter.precisionLabel" = "Decimal precision";
"settings.formatter.syncedNote" = "Synced from your settings.";
"settings.formatter.offlineNote" = "Showing the last synced preferences.";

/* --- Device-defaults state (native parity of resolveLocale('') -> en-US + decimal_precision ?? 2) --- */
"settings.formatter.defaults.title" = "Using device defaults";
"settings.formatter.defaults.message" = "No locale or decimal preference is set yet, so numbers and dates use the device defaults.";

/* --- Loading chrome (native P4 leaf state) --- */
"settings.formatter.loadingA11y" = "Loading formatting preferences";

/* --- Unavailable chrome (native P4 leaf state — settings query failed; web `QueryError` peer) --- */
"settings.formatter.errorTitle" = "Couldn't load formatting preferences";
"settings.formatter.retry" = "Retry";
"settings.formatter.retryA11y" = "Retry loading formatting preferences";

/* --- Freshness chip (native P4 connectivity axis) --- */
