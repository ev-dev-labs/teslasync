/*
  ChartLegend.strings
  TeslaSync — P4 shared surface · 0068 · ChartLegend (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/charts/ChartLegend.tsx) is a Recharts <Legend> wrapper that renders each entry's value
  verbatim and contains NO t() calls — the surface is anonymous. So every key here is native chrome:
  the P4 leaf states (loading / empty / error / freshness) the standalone surface adds so it is never
  a blank box, plus the VoiceOver scaffolding the colour-only web swatch needs (the spoken shown /
  hidden state + the toggle hint, the native peer of the web aria-pressed signal). These entries fold
  into the app Localizable.xcstrings master catalog at integration time; they are kept in a
  per-surface table ("ChartLegend") so each parallel surface prompt owns its own strings.
*/

/* --- Accessibility group label (the colour-only legend names its entry group for VoiceOver) --- */
"chartLegend.a11y.group" = "Chart legend";

/* --- Entry visibility (native peer of the web aria-pressed signal + toggle affordance) --- */
"chartLegend.entry.shown" = "Shown";
"chartLegend.entry.hidden" = "Hidden";
"chartLegend.entry.toggleHint" = "Double tap to toggle this series";

/* --- Empty state (native P4 leaf state — Recharts renders nothing for an empty payload) --- */
"chartLegend.empty.title" = "No series";
"chartLegend.empty.message" = "This chart has no series to show in the legend yet.";

/* --- Error state (native P4 leaf state — QueryError peer) --- */
"chartLegend.error.title" = "Couldn't load the chart legend";
"chartLegend.error.message" = "Couldn't load the chart legend.";
"chartLegend.error.retry" = "Retry";

/* --- Loading chrome (native P4 leaf state) --- */
"chartLegend.loadingA11y" = "Loading chart legend";

/* --- Freshness (P4 connectivity axis) --- */
"chartLegend.freshness.stale" = "Stale";
"chartLegend.freshness.staleA11y" = "Stale — tap to refresh";
"chartLegend.freshness.offline" = "Offline";
"chartLegend.freshness.offlineA11y" = "Offline — showing the last known series";
