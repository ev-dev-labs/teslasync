/*
  SortControl.strings
  TeslaSync — P4 shared surface · 0159 · SortControl (Apple)

  The P1/S10 i18n catalog contribution for this surface — the native peers of the web `t(key, default)`
  keys in `components/forms/SortControl.tsx`. Every key/fallback pair below is byte-identical to the web
  source so the control reads the same on both platforms.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept
  in a per-surface table ("SortControl") so each parallel surface prompt owns its own strings. In test /
  preview bundles `NSLocalizedString` returns the value below, keeping the labels deterministic.
*/

/* --- Web `t()` keys (verbatim from components/forms/SortControl.tsx) --- */

/* Ascending-direction label; also the direction button title (web `sortControl.ascending`). */
"sortControl.ascending" = "Ascending";

/* Descending-direction label; also the direction button title (web `sortControl.descending`). */
"sortControl.descending" = "Descending";

/* The field dropdown's accessible name (web `sortControl.fieldLabel`). */
"sortControl.fieldLabel" = "Sort by";

/* The direction word used to build the button's accessible name, e.g. "Sort direction: Ascending"
   (web `sortControl.direction`). */
"sortControl.direction" = "Sort direction";

/* --- Native a11y addition (no bare box — see the empty-options branch) --- */

/* Friendly body shown when no field options are supplied, so the dropdown never renders a bare box. The
   web simply maps over an empty option list; the native HIG calls for a labelled empty state. */
"sortControl.empty" = "No sort fields";
