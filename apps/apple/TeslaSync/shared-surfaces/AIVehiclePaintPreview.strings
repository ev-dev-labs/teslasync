/*
  AIVehiclePaintPreview.strings
  TeslaSync — P4 shared surface · 0058 · AIVehiclePaintPreview (Apple)

  The P1/S10 i18n catalog contribution for this surface. Every key the native
  `AIVehiclePaintPreview` resolves (table "AIVehiclePaintPreview") lives here with its web English
  value. These entries fold into the app `Localizable.xcstrings` master catalog at integration time;
  they are kept in a per-surface table so each parallel surface prompt owns its own strings without
  editing the shared catalog.

  The first group is the parity set extracted from the web source
  (web/src/components/ai/AIVehiclePaintPreview.tsx + the shared AIFeatureCard / AiOutputPanel /
  AIThinkingIndicator literals it composes). The second group backs the native P4 leaf chrome (the
  freshness / connectivity / loading / error copy) so the Swift sources hold no English prose.
*/

/* --- Parity: the web source's t(key, default) calls --- */
"vehicles.aiPaintPreview.title" = "Draft a Helix paint preview";
"vehicles.aiPaintPreview.description" = "Ask Helix to draft a propose-only paint-color image prompt for this vehicle. Helix only sees the redacted vehicle context (model, trim, current exterior color) — never the display name, VIN, license plate, or location. The draft is never applied automatically; review the proposed image prompt here, then use the existing Color setting below to apply the new paint if you’d like to keep it.";
"vehicles.aiPaintPreview.button" = "Preview paint color";
"vehicles.aiPaintPreview.badge" = "Helix";
"vehicles.aiPaintPreview.noVehicleHint" = "Open a vehicle detail page to enable Helix.";

