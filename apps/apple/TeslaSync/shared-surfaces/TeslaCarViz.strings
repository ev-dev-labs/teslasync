/*
  TeslaCarViz.strings
  TeslaSync — P4 shared surface · 0106 · TeslaCarViz (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web `components/data-display/TeslaCarViz.tsx`
  renders a handful of literal status labels in its `<StatusDot>` row ("Charging" / "Not Charging" /
  "Locked" / "Unlocked" / "Climate" / "Sentry"); those are mirrored verbatim here so the native row carries
  no hardcoded prose. The remaining entries are the native accessibility additions — the illustration's
  spoken element name + value fragments (the web `<svg>` is unlabelled) and the per-model display names —
  so the whole car reads as one informative VoiceOver element.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept
  in a per-surface table ("TeslaCarViz") so each parallel surface prompt owns its own strings. In test /
  preview bundles `NSLocalizedString` returns the value below, keeping the labels deterministic.
*/

/* --- Status row labels (web `<StatusDot label>` literals) --- */

/* Charging status, lit dot. */
"teslaCarViz.status.charging" = "Charging";

/* Charging status, resting dot. */
"teslaCarViz.status.notCharging" = "Not Charging";

/* Lock status, locked. */
"teslaCarViz.status.locked" = "Locked";

/* Lock status, unlocked. */
"teslaCarViz.status.unlocked" = "Unlocked";

/* Climate / pre-conditioning running. */
"teslaCarViz.status.climate" = "Climate";

/* Sentry Mode armed. */
"teslaCarViz.status.sentry" = "Sentry";

/* --- Accessibility additions (the web <svg> is unlabelled) --- */

/* VoiceOver element name for the whole illustration. */
"teslaCarViz.a11y.label" = "Vehicle status";

/* Spoken battery phrase; %d is the integer percentage. */
"teslaCarViz.a11y.battery" = "Battery %d percent";

/* Spoken motion state when the vehicle is moving. */
"teslaCarViz.a11y.driving" = "Driving";

/* Spoken motion state when the vehicle is stationary. */
"teslaCarViz.a11y.parked" = "Parked";

/* Spoken climate fragment, added when climate is on. */
"teslaCarViz.a11y.climateOn" = "Climate on";

/* Spoken Sentry fragment, added when Sentry is armed. */
"teslaCarViz.a11y.sentryOn" = "Sentry armed";

/* --- Per-model display names --- */

"teslaCarViz.model.model3" = "Model 3";
"teslaCarViz.model.modelS" = "Model S";
"teslaCarViz.model.modelY" = "Model Y";
"teslaCarViz.model.modelX" = "Model X";
"teslaCarViz.model.cybertruck" = "Cybertruck";
