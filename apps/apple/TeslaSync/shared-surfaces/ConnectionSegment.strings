/*
  ConnectionSegment.strings
  TeslaSync — P4 shared surface · 0178 · ConnectionSegment (Apple)

  The P1/S10 i18n catalog contribution for this surface. The keys in the first block mirror the web source
  (components/layout/status-bar/ConnectionSegment.tsx) one-for-one — the short "API" label, the four state
  labels (Online / Degraded / Offline / Connecting…), the tooltip prefix, and the aria prefix. The remaining
  keys are the native P4 leaf chrome (the freshness "Stale" marker and the open hint) so the Swift sources
  hold no English literals.

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept
  in a per-surface table ("ConnectionSegment") so each parallel surface prompt owns its own strings without
  editing the shared catalog. In test / preview bundles `NSLocalizedString` returns the value below, keeping
  the labels deterministic.
*/

/* --- Web source keys (ConnectionSegment.tsx) --- */
"statusBar.connection.short" = "API";
"statusBar.connection.ok" = "Online";
"statusBar.connection.degraded" = "Degraded";
"statusBar.connection.offline" = "Offline";
"statusBar.connection.unknown" = "Connecting…";
"statusBar.connection.tooltip" = "API connection";
"statusBar.connection.aria" = "API connection status";

/* --- Freshness + open hint (P4 leaf contract) --- */
"statusBar.connection.stale" = "Stale";
"statusBar.connection.openHint" = "Opens the system status page";
