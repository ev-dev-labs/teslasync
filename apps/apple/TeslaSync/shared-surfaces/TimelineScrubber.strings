/*
  TimelineScrubber.strings
  TeslaSync — P4 shared surface · 0107 · TimelineScrubber (Apple)

  The P1/S10 i18n catalog contribution for this surface. Mirrors every `t(key, default)` the web
  source (web/src/components/data-display/TimelineScrubber.tsx) resolves, plus the native-chrome keys
  the web pure render has no concept of (the P4 leaf states, the freshness chip + banner, and the
  VoiceOver labels). Entries fold into the app Localizable.xcstrings master catalog at integration
  time; kept in a per-surface table ("TimelineScrubber") so each parallel surface prompt owns its own
  strings.

  Web-source parity:
    timelineScrubber.progress        ← t('replay.controls.progress', 'Playback progress')
    timelineScrubber.markerAtPercent ← t('replay.markers.atPercent', 'at {{pct}}%')
*/

/* --- Track accessibility (web slider aria-label + marker aria-labels) --- */
"timelineScrubber.progress" = "Playback progress";
"timelineScrubber.markerAtPercent" = "at {{pct}}%";
"timelineScrubber.markerCount" = "{{count}} events";

/* --- Timeline marker kinds (web marker aria-label / tooltip fallback) --- */
"timelineScrubber.markers.start" = "Start";
"timelineScrubber.markers.stop" = "Stop";
"timelineScrubber.markers.chargeStart" = "Charge start";
"timelineScrubber.markers.chargeStop" = "Charge stop";
"timelineScrubber.markers.fastSegment" = "Fast segment";
"timelineScrubber.markers.regenPeak" = "Regen peak";
"timelineScrubber.markers.lowSoc" = "Low battery";
"timelineScrubber.markers.event" = "Event";

/* --- P4 leaf contract — loading / empty --- */
"timelineScrubber.loadingA11y" = "Loading timeline";
"timelineScrubber.empty.title" = "Nothing to scrub";
"timelineScrubber.empty.message" = "This drive has no timeline to scrub through.";

/* --- Freshness (P4 connectivity axis) --- */
"timelineScrubber.live" = "Live";
"timelineScrubber.stale" = "Stale";
"timelineScrubber.offline" = "Offline";
"timelineScrubber.staleA11y" = "Stale — tap to refresh";
"timelineScrubber.offlineA11y" = "Offline — showing the last position";
"timelineScrubber.staleBanner" = "Showing a slightly out-of-date timeline.";
"timelineScrubber.offlineBanner" = "You're offline — showing the last cached timeline.";
"timelineScrubber.refresh" = "Refresh";
