/*
  FreshnessIndicator.strings
  TeslaSync — P4 shared surface · 0090 · FreshnessIndicator (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web source
  (components/data-display/FreshnessIndicator.tsx) is anonymous — it hardcodes English literals
  ("just now", "{n}s ago", "—") rather than calling `t()`. Native code holds no English literals, so
  those literals are lifted into keys here with the verbatim web text as the fallback value, plus the
  native P4 leaf chrome (loading / unavailable / retry) and the VoiceOver status words. These entries
  fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept in a
  per-surface table ("FreshnessIndicator") so each parallel surface prompt owns its own strings.

  The age templates insert the numeric value with a `%@` token (locale- and width-safe).
*/

/* --- Relative-time label (verbatim port of web `formatAge`) --- */
"freshness.age.unknown" = "—";
"freshness.age.justNow" = "just now";
"freshness.age.seconds" = "%@s ago";
"freshness.age.minutes" = "%@m ago";
"freshness.age.hours" = "%@h ago";

/* --- Status words (VoiceOver — the spoken band name) --- */
"freshness.status.fresh" = "Fresh";
"freshness.status.stale" = "Stale";
"freshness.status.offline" = "Offline";
"freshness.status.unknown" = "No data";

/* --- Loading chrome (native P4 leaf state) --- */
"freshness.loadingA11y" = "Loading freshness";

/* --- Unavailable chrome (native P4 leaf state — timestamp feed failed) --- */
"freshness.unavailable" = "Freshness unavailable";
"freshness.unavailableA11y" = "Freshness unavailable — tap to retry";
"freshness.retry" = "Retry";
