/*
  DriveOverviewChart.strings
  TeslaSync — P4 feature view · 0138 · DriveOverviewChart (Apple)

  The P1/S10 i18n catalog contribution for this surface. Every key the native
  `DriveOverviewChart` resolves (table "DriveOverviewChart") lives here with its web
  `t(key, default)` English value. These entries fold into the app
  `Localizable.xcstrings` master catalog at integration time; they are kept in a
  per-surface table so each parallel surface prompt owns its own strings without
  editing the shared catalog.

  The first group is the exact keys extracted from the web source
  (features/driving/components/drive-detail/DriveOverviewChart.tsx). The remainder back
  the rich-legend parenthetical labels (the web passes "Range (ideal)" / "Range (est.)"
  as the SAME driveDetail.range* key's default at the legend call site — preserved here
  as distinct .legend keys so the native legend renders the same text), the legend
  Mean/Max/Min headers, the native state envelope (freshness chip, connectivity banner,
  loading / empty / error chrome), and the accessibility summary scaffolding.
*/

/* --- Keys from the web source (parity) --- */
"driveDetail.driveChart" = "Drive Overview";
"driveDetail.driveChart.aria" = "Drive overview composed chart of speed, range, SOC and power over time";
"driveDetail.speed" = "Speed";
"driveDetail.rangeIdeal" = "Range ideal";
"driveDetail.rangeEst" = "Range est.";
"driveDetail.soc" = "SOC";
"driveDetail.usableSoc" = "Usable SOC";
"driveDetail.power" = "Power";
"driveDetail.noChartData" = "No telemetry data available";

/* --- Rich-legend label variants (web legend call-site defaults for the range keys) --- */
"driveDetail.rangeIdeal.legend" = "Range (ideal)";
"driveDetail.rangeEst.legend" = "Range (est.)";

/* --- Rich-legend Mean/Max/Min headers (web `Mean:` / `Max:` / `Min:`) --- */
"driveDetail.chart.mean" = "Mean";
"driveDetail.chart.max" = "Max";
"driveDetail.chart.min" = "Min";

/* --- Freshness chip (Live / Stale / Offline) --- */
"driveDetail.live" = "Live";
"driveDetail.stale" = "Stale";
"driveDetail.offline" = "Offline";

/* --- Connectivity banner (stale / offline) --- */
"driveDetail.staleBanner" = "Reconnecting — the drive trace may be out of date";
"driveDetail.offlineBanner" = "Offline — showing the last loaded drive trace";

/* --- Loading / empty / error chrome --- */
"driveDetail.loading" = "Loading drive overview";
"driveDetail.emptyHint" = "The drive trace appears here once this drive has streamed a few telemetry samples.";
"driveDetail.errorTitle" = "Couldn't load the drive overview";
"driveDetail.retry" = "Retry";

/* --- Accessibility --- */
"driveDetail.chart.samples" = "samples";
