/*
  HealthOverview.strings
  TeslaSync — P4 feature view · 0155 · HealthOverview (Apple)

  The P1/S10 i18n catalog contribution for this surface. Every key the native `HealthOverview`
  resolves (table "HealthOverview") lives here with its web English value. These entries fold into
  the app `Localizable.xcstrings` master catalog at integration time; they are kept in a
  per-surface table so each parallel surface prompt owns its own strings without editing the
  shared catalog.

  The first group holds the keys extracted verbatim from the web source
  (features/driving/components/drivetrain-health/HealthOverview.tsx) — the canonical `drivetrain.*`
  labels, alert titles + messages, and the uppercased status-badge values (the web `Badge` default
  is `overallHealth.toUpperCase()`). The remaining keys back the native-only chrome (freshness
  chip, connectivity banner, loading + empty + error + retry copy).
*/

/* --- Keys from the web source (parity) --- */
"drivetrain.alert.criticalTitle" = "Critical Temperature Warning";
"drivetrain.alert.warningTitle" = "Elevated Temperatures Detected";
"drivetrain.alert.criticalMsg" = "One or more drivetrain components are operating at critically high temperatures. Immediate attention is recommended.";
"drivetrain.alert.warningMsg" = "Drivetrain temperatures are above normal operating range. Monitor closely and consider reducing load.";
"drivetrain.healthGood" = "Drivetrain Healthy";
"drivetrain.healthWarn" = "Drivetrain Running Warm";
"drivetrain.healthCrit" = "Drivetrain Overheating";
"drivetrain.motorState" = "Motor State";

/* --- Status badge text (web Badge default = overallHealth.toUpperCase()) --- */
"drivetrain.health.good" = "GOOD";
"drivetrain.health.warning" = "WARNING";
"drivetrain.health.critical" = "CRITICAL";

/* --- Native chrome: freshness chip --- */
"drivetrain.healthOverview.live" = "Live";
"drivetrain.healthOverview.stale" = "Stale";
"drivetrain.healthOverview.offline" = "Offline";
"drivetrain.healthOverview.updating" = "Updating";

/* --- Native chrome: connectivity banner --- */
"drivetrain.healthOverview.staleBanner" = "Reconnecting — drivetrain health may be stale";
"drivetrain.healthOverview.offlineBanner" = "Offline — showing last known drivetrain health";

/* --- Native chrome: states --- */
"drivetrain.healthOverview.loading" = "Loading drivetrain health";
"drivetrain.healthOverview.empty" = "No drivetrain health data yet";
"drivetrain.healthOverview.errorTitle" = "Couldn't load drivetrain health";
"drivetrain.healthOverview.retry" = "Retry";
