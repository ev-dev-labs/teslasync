/*
  TelemetryGrid.strings
  TeslaSync — P4 feature view · 0285 · TelemetryGrid (Apple)

  The P1/S10 i18n catalog contribution for this surface. Every key the native
  `TelemetryGrid` (its six tiles + the P4 leaf chrome) resolves (table
  "TelemetryGrid") lives here with its web English value. These entries fold into
  the app `Localizable.xcstrings` master catalog at integration time; they are
  kept in a per-surface table so each parallel surface prompt owns its own strings
  without editing the shared catalog.

  The `common.*` keys mirror the web source's `t(key, default)` calls in
  TelemetryGrid.tsx (`common.battery` / `common.range` / `common.speed` /
  `common.inside` / `common.outside` / `common.odometer` / `common.charger` /
  `common.sentry`) VERBATIM. Web literals that were hardcoded in the source
  ("Driving" / "Parked" / "Not charging" / "Full in {h}h" / "{kW} kW" / "Active" /
  "Off") are promoted to keys here so the native surface holds zero English
  literals. The `telemetryGrid.*` chrome keys back the standardized P4 leaf
  contract (freshness chip, relative age, loading / empty / error states, banners).
*/


/* --- tile labels (web `common.*` from TelemetryGrid.tsx) --- */
"common.battery" = "Battery";
"common.range" = "range";
"common.speed" = "Speed";
"common.inside" = "Inside";
"common.outside" = "Outside";
"common.odometer" = "Odometer";
"common.charger" = "Charger";
"common.sentry" = "Sentry";

/* --- tile values promoted from web literals --- */
"common.active" = "Active";
"common.off" = "Off";
"telemetryGrid.driving" = "Driving";
"telemetryGrid.parked" = "Parked";
"telemetryGrid.notCharging" = "Not charging";
"telemetryGrid.chargerPower" = "%@ kW";
"telemetryGrid.fullIn" = "Full in %@h";

/* --- surface accessibility --- */
"telemetryGrid.accessibilityLabel" = "Vehicle telemetry";

/* --- freshness chip + banners (P4 leaf contract, ADR-013) --- */
"telemetryGrid.refresh" = "Refresh";
"telemetryGrid.updating" = "Updating";
"telemetryGrid.live" = "Live";
"telemetryGrid.stale" = "Stale";
"telemetryGrid.offline" = "Offline";
"telemetryGrid.freshness.label" = "Data freshness";
"telemetryGrid.staleBanner" = "Reconnecting — data may be stale";
"telemetryGrid.offlineBanner" = "Offline — showing last known data";

/* --- relative age (web freshness age label) --- */
"telemetryGrid.age.unknown" = "—";
"telemetryGrid.age.justNow" = "just now";
"telemetryGrid.age.seconds" = "%ds ago";
"telemetryGrid.age.minutes" = "%dm ago";
"telemetryGrid.age.hours" = "%dh ago";

/* --- loading / empty / error (P4 leaf contract) --- */
"telemetryGrid.loading" = "Loading telemetry";
"telemetryGrid.empty.title" = "No telemetry";
"telemetryGrid.empty.message" = "Vehicle telemetry will appear here once the vehicle reports its state";
"telemetryGrid.error.message" = "Couldn't load telemetry";
