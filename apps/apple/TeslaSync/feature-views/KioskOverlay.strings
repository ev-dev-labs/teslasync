/*
  KioskOverlay.strings
  TeslaSync — P4 feature view · 0124 · KioskOverlay (Apple)

  The P1/S10 i18n catalog contribution for this surface (table "KioskOverlay").
  These entries fold into the app Localizable.xcstrings master catalog at
  integration time; they are kept in a per-surface table so each parallel surface
  prompt owns its own strings without editing the shared catalog (parallel-safe
  across the concurrent slots).

  The web source (web/src/features/dashboard/components/KioskOverlay.tsx) carries
  two literals, both behind `t(key, default)`:
    • t('kiosk.exit', 'Exit kiosk mode')   — the exit control's aria-label
    • t('kiosk.exitLabel', 'Exit Kiosk')    — the exit control's visible text
  The remaining keys back the native VoiceOver chrome the web component renders as
  plain text (the live clock readout and the rotation indicator), which on Apple
  must be spoken through explicit accessibility labels.
*/

/* --- Exit control (web `t()` calls) --- */
"kiosk.exit" = "Exit kiosk mode";
"kiosk.exitLabel" = "Exit Kiosk";

/* --- VoiceOver labels (native chrome the web renders as visible-only text) --- */
/* %1$@ = formatted time, %2$@ = formatted weekday + date */
"kiosk.clock.a11y" = "Time %1$@, %2$@";
/* %1$lld = current dashboard (1-based), %2$lld = total dashboards */
"kiosk.rotation.a11y" = "Dashboard %1$lld of %2$lld";
