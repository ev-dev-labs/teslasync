/*
  EnvironmentSlide.strings
  TeslaSync — P4 feature view · 0063 · EnvironmentSlide (Apple)

  The P1/S10 i18n catalog contribution for this surface. Every key the native
  `EnvironmentSlide` resolves (table "EnvironmentSlide") lives here with its web
  `t(key, default)` English value. These entries fold into the app
  `Localizable.xcstrings` master catalog at integration time; they are kept in a
  per-surface table so each parallel surface prompt owns its own strings without
  editing the shared catalog (parallel-unsafe across the concurrent slots).

  The first block is the exact set of keys extracted from the web source
  (features/analytics/components/review/EnvironmentSlide.tsx). All three already
  exist in apps/shared/i18n/catalog/en.json under the "yearReview" namespace
  (co2Offset, treesEquiv {count}, more). The remaining keys back the native-only
  chrome (CO₂ unit, freshness banners, loading/empty/error copy, accessibility).
*/

/* --- Keys from the web source (parity) --- */
"yearReview.co2Offset" = "CO₂ offset";
"yearReview.treesEquiv" = "Like planting {{count}} trees";
"yearReview.more" = "more";

/* --- Native chrome: unit + freshness --- */
"environment.co2Unit" = "kg";
"environment.liveBanner" = "Live";
"environment.staleBanner" = "Reconnecting — recap may be stale";
"environment.updatingBanner" = "Refreshing your recap…";
"environment.offlineBanner" = "Offline — showing last known recap";

/* --- Native chrome: states --- */
"environment.loadingA11y" = "Loading environmental recap";
"environment.emptyTitle" = "No environmental recap yet";
"environment.emptyHint" = "Drive through the year to grow your forest.";
"environment.errorTitle" = "Couldn't load your environmental recap";
"environment.retry" = "Retry";
