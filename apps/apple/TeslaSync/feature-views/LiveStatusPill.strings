/*
  LiveStatusPill.strings
  TeslaSync — P4 feature view · 0249 · LiveStatusPill (Apple)

  The P1/S10 i18n catalog contribution for this surface (table "LiveStatusPill").
  These entries fold into the app Localizable.xcstrings master catalog at
  integration time; they are kept in a per-surface table so each parallel surface
  prompt owns its own strings without editing the shared catalog (parallel-safe
  across the concurrent slots).

  Every literal the web source renders is keyed here so no English survives in
  native code:
    • the three TONE labels (web `TONE[state].label`),
    • the relative-time ladder (web `relative(now, lastUpdateAt)`),
    • the composed aria-label (web
      `Live status stream: ${tone.label}, updated ${rel}`).
  The decorative middot separator is a typographic glyph (not prose) and is
  rendered verbatim + hidden from VoiceOver, matching the web `aria-hidden` span.
*/

/* --- Connection-state labels (web TONE[state].label) --- */
"liveStatusPill.state.live" = "Live";
"liveStatusPill.state.reconnecting" = "Reconnecting";
"liveStatusPill.state.offline" = "Offline";

/* --- Relative-time ladder (web relative(now, lastUpdateAt)); %@ is the magnitude --- */
"liveStatusPill.relative.none" = "—";
"liveStatusPill.relative.justNow" = "just now";
"liveStatusPill.relative.seconds" = "%@s ago";
"liveStatusPill.relative.minutes" = "%@m ago";
"liveStatusPill.relative.hours" = "%@h ago";

/* --- Composed VoiceOver label (web aria-label); %1$@ = state label, %2$@ = relative --- */
"liveStatusPill.a11y.label" = "Live status stream: %1$@, updated %2$@";
