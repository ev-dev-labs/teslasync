/*
  BatteryPill.strings
  TeslaSync — P4 feature view · 0073 · BatteryPill (Apple)

  The P1/S10 i18n catalog contribution for this surface (table "BatteryPill").
  These entries fold into the app Localizable.xcstrings master catalog at
  integration time; they are kept in a per-surface table so each parallel surface
  prompt owns its own strings without editing the shared catalog (parallel-safe
  across the concurrent slots).

  The web source (web/src/features/analytics/components/weekly-digest/BatteryPill.tsx)
  extracts no literals of its own — the `label` is caller-supplied and the value
  is `{fmtInt(level)}%` (a number + the `%` unit symbol, appended verbatim, the
  same way the shared TSPercentage formatter does). The keys below back the
  native-only chrome the web component lacks but the Apple surface contract
  requires: the VoiceOver status descriptors (color is not an accessible signal)
  and the preview label.
*/

/* --- VoiceOver status descriptors (spoken alongside the percent value) --- */
"battery.pill.status.good" = "Good";
"battery.pill.status.warning" = "Low";
"battery.pill.status.critical" = "Critical";

/* --- Preview-only label (DEBUG #Preview gallery) --- */
"battery.pill.preview.label" = "State of charge";
