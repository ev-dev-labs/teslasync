/* --- Success toast (web source, parity) ---
   The web uses one `settingsReset.toasts.successTitle` key with two contextual defaults
   ("Section reset" / "All settings reset"); the catalog registers the umbrella key plus
   the two contextual variants so native preserves the distinction the web fallbacks carry. */
"settingsReset.toasts.successTitle" = "Settings reset";
"settingsReset.toasts.successTitle.section" = "Section reset";
"settingsReset.toasts.successTitle.all" = "All settings reset";
"settingsReset.toasts.successDetail" = "%1$lld item(s) reset across %2$lld section(s).";

/* --- Failure toast (web useSettingsReset useMutationToast keys, parity) --- */
"toast.settings.reset.error" = "Failed to reset section";
