/*
  AnomalyInlineRow.strings
  TeslaSync — P4 feature view · 0238 · AnomalyInlineRow (Apple)

  The P1/S10 i18n catalog contribution for this surface (table "AnomalyInlineRow").
  These entries fold into the app Localizable.xcstrings master catalog at integration
  time; they are kept in a per-surface table so each parallel surface prompt owns its
  own strings without editing the shared catalog (parallel-safe across the concurrent
  slots).

  The web source (web/src/features/system/components/status/AnomalyInlineRow.tsx)
  hardcodes its strings (no t() calls): the label "Anomalies", the summary template
  `${count} in 24h · ${signal} ${formatRelative(detected_at)}`, and the "s/m/h/d ago"
  / "recently" relative-time words. They are reproduced here as catalog keys so no
  English literal lives in the native code. The remaining keys back the native-only
  chrome the Apple surface contract requires (loading / empty / error / retry copy, the
  freshness chip, and the VoiceOver status descriptors — color is not an accessible
  signal). `{{count}}`, `{{signal}}`, and `{{n}}` are interpolation tokens replaced at
  render with the raw count, the verbatim signal id, and the relative magnitude.
*/

/* --- Core row (web `HealthRow` label + summary + aria) --- */
"anomaly.row.label" = "Anomalies";
"anomaly.row.hint" = "Opens anomaly detection";
"anomaly.summary" = "{{count}} in 24h · {{signal}} {{relative}}";

/* --- Relative time (web `formatRelative`) --- */
"anomaly.relative.recently" = "recently";
"anomaly.relative.seconds" = "{{n}}s ago";
"anomaly.relative.minutes" = "{{n}}m ago";
"anomaly.relative.hours" = "{{n}}h ago";
"anomaly.relative.days" = "{{n}}d ago";

/* --- States (native-only chrome; web renders nothing / has no states) --- */
"anomaly.loading" = "Checking for anomalies…";
"anomaly.empty" = "No anomalies in the last 24h";
"anomaly.error" = "Couldn't load anomalies";
"anomaly.retry" = "Retry";

/* --- Freshness chip (ADR-013) --- */
"anomaly.live" = "Live";
"anomaly.stale" = "Stale";
"anomaly.offline" = "Offline";

/* --- VoiceOver status descriptors (spoken alongside the summary) --- */
"anomaly.status.healthy" = "Healthy";
"anomaly.status.degraded" = "Warning";
"anomaly.status.unhealthy" = "Critical";
"anomaly.status.unknown" = "Info";
"anomaly.status.maintenance" = "Maintenance";
