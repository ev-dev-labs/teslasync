/*
  UnixPermissionTool.strings
  TeslaSync — P4 feature view · 0022 · UnixPermissionTool (Apple)

  The P1/S10 i18n catalog contribution for this surface. Every key the native
  `UnixPermissionTool` resolves (table "UnixPermissionTool") lives here with its
  web `t(key, default)` English value. These entries fold into the app
  `Localizable.xcstrings` master catalog at integration time; they are kept in a
  per-surface table so each parallel surface prompt owns its own strings without
  editing the shared catalog (parallel-unsafe across the concurrent slots).

  The first block is the exact set of keys extracted from the web source
  (features/admin/components/devtools/tools/UnixPermissionTool.tsx). The web
  en.json carries "Presets"/"Owner"/"Group"/"Other" verbatim and has no entry
  for "Unix Perm"/"Unix Perm Desc"/"Octal Perm", so i18next renders those keys
  as-is — the native fallbacks reproduce that exactly. The remaining keys back
  native-only chrome (the invalid-input hint and accessibility).
*/

/* --- Keys from the web source (parity) --- */
"Unix Perm" = "Unix Perm";
"Unix Perm Desc" = "Unix Perm Desc";
"Octal Perm" = "Octal Perm";
"Presets" = "Presets";
"Owner" = "Owner";
"Group" = "Group";
"Other" = "Other";

/* --- Native chrome: invalid-input hint + accessibility --- */
"Unix Perm Empty Hint" = "Enter a 3-digit octal value using digits 0–7 (for example, 755) to see its symbolic permissions.";
"Unix Perm Symbolic A11y" = "Symbolic permissions";
