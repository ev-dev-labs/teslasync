/*
  FlagsTable.strings
  TeslaSync — P4 feature view · 0031 · FlagsTable (Apple)

  The P1/S10 i18n catalog contribution for this surface. Every key the native
  FlagsTable resolves (table "FlagsTable") lives here with its web
  `t(key, default)` English value. These entries fold into the app
  Localizable.xcstrings master catalog at integration time; they are kept in a
  per-surface table so each parallel surface prompt owns its own strings without
  editing the shared catalog.

  The first block is the exact key set extracted from the web source
  (features/admin/components/feature-flags/FlagsTable.tsx). The remaining keys
  back the native-only chrome (freshness chip, refresh/retry/error copy, the
  stale/offline banners, and the accessibility labels).
*/

/* --- Keys from the web source (parity) --- */
"admin.flags.cols.key" = "Flag key";
"admin.flags.cols.value" = "Value";
"admin.flags.cols.actions" = "Actions";
"admin.flags.actions.edit" = "Edit";
"admin.flags.actions.delete" = "Delete";
"admin.flags.table.loading" = "Loading flags…";
"admin.flags.table.empty" = "No feature flags are set on this server.";

/* --- Native surface chrome (freshness / refresh / error) --- */
"admin.flags.title" = "Feature Flags";
"admin.flags.refresh" = "Refresh";
"admin.flags.retry" = "Retry";
"admin.flags.errorTitle" = "Couldn't load feature flags";
"admin.flags.live" = "Live";
"admin.flags.stale" = "Stale";
"admin.flags.offline" = "Offline";
"admin.flags.staleBanner" = "Reconnecting — data may be stale";
"admin.flags.offlineBanner" = "Offline — showing last known data";

/* --- Accessibility (VoiceOver labels) --- */
"admin.flags.a11y.count" = "%lld feature flags";
"admin.flags.a11y.row" = "%1$@, value %2$@";
"admin.flags.actions.editFlag" = "Edit %@";
