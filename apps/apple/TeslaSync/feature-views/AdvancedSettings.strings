"advanced.restoreConfirms.emptyTitle" = "No silenced prompts";
"advanced.restoreConfirms.errorTitle" = "Couldn't load silenced prompts";
"advanced.restoreConfirms.retry" = "Retry";
"advanced.restoreConfirms.promptRole" = "Silenced prompt";

/* --- Freshness chip (Live / Stale / Offline) --- */
"advanced.restoreConfirms.live" = "Live";
"advanced.restoreConfirms.stale" = "Stale";
"advanced.restoreConfirms.offline" = "Offline";

/* --- Connectivity banner (stale / offline) --- */
