/*
  WidgetDetailCard.strings
  TeslaSync — P4 widget primitive · 0004 · WidgetDetailCard (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web
  `features/dashboard/widgets/shared/WidgetDetailCard.tsx` renders exactly one copy string of its own — the
  empty default `emptyMessage ?? 'No details available'` (a literal, not a `t()` call); its row `label` /
  `value` / `badge.text` are caller-supplied, already-localized props rendered verbatim. The first entry
  below mirrors that single literal; the rest are native a11y / HIG additions: the em-dash value fallback
  (the web `value ?? '—'`), the row's combined label/value/badge reading, and the empty-leaf supporting hint
  (the "never a blank box" peer of the web single-line empty state).

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept
  in a per-surface table ("WidgetDetailCard") so each parallel surface prompt owns its own strings. In
  test / preview bundles `NSLocalizedString` returns the value below, keeping the labels deterministic.
*/

/* --- Web copy (verbatim port of the web literal) --- */

/* Empty default message — the web `emptyMessage ?? 'No details available'`. */
"widgetDetailCard.empty" = "No details available";

/* The em-dash shown for a missing value — the web `entry.value ?? '—'`. */
"widgetDetailCard.valueFallback" = "—";

/* --- Native a11y / HIG additions (no web `t()` key exists) --- */

/* Supporting line of the empty leaf, so the surface never renders a bare box. */
"widgetDetailCard.emptyHint" = "Details appear here once there is something to show.";

/* A row's combined VoiceOver reading — "{label}, {value}". Positional so translators can reorder. */
"widgetDetailCard.rowLabel" = "%1$@, %2$@";

/* A row's combined VoiceOver reading with a badge — "{label}, {value}, {badge}". Positional. */
"widgetDetailCard.rowLabelWithBadge" = "%1$@, %2$@, %3$@";
