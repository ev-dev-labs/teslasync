/*
  WidgetStatGrid.strings
  TeslaSync — P4 widget primitive · 0010 · WidgetStatGrid (Apple)

  The P1/S10 i18n catalog contribution for this surface. The web
  `features/dashboard/widgets/shared/WidgetStatGrid.tsx` renders exactly one copy string of its own — the
  empty leaf `<EmptyState message="No stats available" />` (a literal, not a `t()` call); its cell `label`
  / `value` / `unit` / `trendValue` are caller-supplied, already-localized props rendered verbatim. The
  first entry below mirrors that single literal; the rest are native a11y additions: the cell's combined
  label/value reading, the value-with-unit join, the spoken trend (direction word + magnitude), and the
  empty-leaf supporting hint (the "never a blank box" peer of the web's single centered line).

  These entries fold into the app `Localizable.xcstrings` master catalog at integration time; they are kept
  in a per-surface table ("WidgetStatGrid") so each parallel surface prompt owns its own strings. In test /
  preview bundles `NSLocalizedString` returns the value below, keeping the labels deterministic.
*/

/* --- Web copy (verbatim port of the web literal) --- */

/* Empty-leaf headline — the web `<EmptyState message="No stats available" />`. */
"widgetStatGrid.empty" = "No stats available";

/* --- Native a11y / HIG additions (no web `t()` key exists) --- */

/* Supporting line of the empty leaf, so the surface never renders a bare box. */
"widgetStatGrid.emptyHint" = "Stats appear here once vehicle data is available.";

/* A cell's combined VoiceOver reading — "{label}, {value}". Positional so translators can reorder. */
"widgetStatGrid.cellLabel" = "%1$@, %2$@";

/* Joins a formatted value with its optional unit affix — "{value} {unit}" — for the cell's spoken value. */
"widgetStatGrid.valueUnit" = "%1$@ %2$@";

/* A cell's spoken trend — "{direction} {magnitude}", e.g. "Up 12%". Positional so translators can reorder. */
"widgetStatGrid.trend" = "%1$@ %2$@";

/* Appends a cell's trend reading to its base label — "{base}, {trend}". Positional for reordering. */
"widgetStatGrid.cellTrend" = "%1$@, %2$@";

/* Direction word spoken in place of the up arrow glyph (web `↑`). */
"widgetStatGrid.trendUp" = "Up";

/* Direction word spoken in place of the down arrow glyph (web `↓`). */
"widgetStatGrid.trendDown" = "Down";

/* Direction word spoken in place of the flat glyph (web `—`). */
"widgetStatGrid.trendFlat" = "No change";
