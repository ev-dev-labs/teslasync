{
  "$schema": "./tokens.schema.json",
  "$meta": {
    "source": "web/src/index.css (CSS vars), web/tailwind.config.js, web/src/lib/tokens.ts, web/src/lib/colors.ts",
    "extractedFor": "P1/S9/0001 — neutral design tokens per ADR-005",
    "note": "Platform-neutral semantic tokens. No platform specifics. Values extracted verbatim from the web theme; generators map these to Fluent / Material 3 / HIG."
  },
  "color": {
    "light": {
      "bg": "#f8fafc",
      "surface": "#ffffff",
      "surfaceGlass": "rgba(255, 255, 255, 0.95)",
      "textPrimary": "#0f172a",
      "textSecondary": "#1e293b",
      "textMuted": "#64748b",
      "accent": "#0891b2",
      "border": "rgba(0, 0, 0, 0.12)",
      "status": {
        "success": "#15803d",
        "warning": "#b45309",
        "danger": "#dc2626",
        "info": "#0891b2"
      }
    },
    "dark": {
      "bg": "#0a0a0f",
      "surface": "#0f1019",
      "surfaceGlass": "rgba(255, 255, 255, 0.04)",
      "textPrimary": "#ffffff",
      "textSecondary": "#9ca3af",
      "textMuted": "#8a95a6",
      "accent": "#00f0ff",
      "border": "rgba(255, 255, 255, 0.12)",
      "status": {
        "success": "#10b981",
        "warning": "#f59e0b",
        "danger": "#ef4444",
        "info": "#00f0ff"
      }
    },
    "highContrast": {
      "bg": "#ffffff",
      "surface": "#ffffff",
      "surfaceGlass": "#ffffff",
      "textPrimary": "#000000",
      "textSecondary": "#222222",
      "textMuted": "#555555",
      "accent": "#0e7490",
      "border": "#cccccc",
      "status": {
        "success": "#15803d",
        "warning": "#b45309",
        "danger": "#b91c1c",
        "info": "#0369a1"
      }
    }
  },
  "chart": {
    "categorical": [
      "#0072B2",
      "#E69F00",
      "#009E73",
      "#F0E442",
      "#56B4E9",
      "#D55E00",
      "#CC79A7",
      "#4B4B4B"
    ],
    "series": {
      "battery": "#10b981",
      "energy": "#f59e0b",
      "speed": "#3b82f6",
      "regen": "#06b6d4",
      "temperature": "#ef4444",
      "power": "#a855f7"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter",
      "mono": "JetBrains Mono"
    },
    "display": { "size": 30, "lineHeight": 36, "weight": "bold", "letterSpacing": -0.5 },
    "title": { "size": 24, "lineHeight": 32, "weight": "bold", "letterSpacing": -0.25 },
    "section": { "size": 18, "lineHeight": 28, "weight": "semibold", "letterSpacing": -0.15 },
    "panel": { "size": 16, "lineHeight": 24, "weight": "semibold", "letterSpacing": 0 },
    "body": { "size": 14, "lineHeight": 20, "weight": "regular", "letterSpacing": 0 },
    "bodySm": { "size": 12, "lineHeight": 16, "weight": "regular", "letterSpacing": 0 },
    "caption": { "size": 12, "lineHeight": 16, "weight": "regular", "letterSpacing": 0 },
    "label": { "size": 12, "lineHeight": 16, "weight": "medium", "letterSpacing": 0.6, "textTransform": "uppercase" },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "spacing": {
    "base": 4,
    "scale": {
      "none": 0,
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 20,
      "2xl": 24,
      "3xl": 32,
      "4xl": 48
    }
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "pill": 9999
  },
  "elevation": {
    "levels": {
      "base": { "z": 0, "shadow": "none" },
      "raised": { "z": 1, "shadow": "0 8px 32px rgba(0, 0, 0, 0.4)" },
      "overlay": { "z": 2, "shadow": "0 0 30px rgba(0, 240, 255, 0.15)" },
      "modal": { "z": 3, "shadow": "0 24px 64px rgba(0, 0, 0, 0.6)" }
    },
    "material": {
      "base": { "fluent": "Solid", "material3": "surface", "hig": "opaque" },
      "raised": { "fluent": "Mica", "material3": "surfaceContainer", "hig": "thinMaterial" },
      "overlay": { "fluent": "Acrylic", "material3": "surfaceContainerHigh", "hig": "regularMaterial" },
      "modal": { "fluent": "Acrylic", "material3": "surfaceContainerHighest", "hig": "thickMaterial" }
    }
  },
  "motion": {
    "durations": {
      "fast": 150,
      "normal": 250,
      "slow": 400
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "accelerate": "cubic-bezier(0.3, 0, 1, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)"
    }
  }
}
