{
  "name": "teslasync-native",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "test:ui": "jest __tests__/NativeUiAutomation.test.tsx --runInBand",
    "test:platform": "npm test -- --runInBand && npm run test:windows -- --runInBand",
    "typecheck": "tsc --noEmit",
    "visual:survey": "node scripts/visual-parity/survey.mjs",
    "visual:capture": "node scripts/visual-parity/capture.mjs",
    "visual:compare": "node scripts/visual-parity/compare.mjs",
    "web": "npm run web:dev",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:package": "npm run package:web",
    "web:preview": "vite preview",
    "windows": "npx @react-native-community/cli run-windows",
    "macos": "react-native run-macos",
    "bundle:android": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\bundle-native.ps1 -Platform android",
    "bundle:ios": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\bundle-native.ps1 -Platform ios",
    "bundle:windows": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\bundle-native.ps1 -Platform windows",
    "bundle:macos": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\bundle-native.ps1 -Platform macos",
    "package:web": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\package-native.ps1 -Platform web",
    "package:android": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\package-native.ps1 -Platform android",
    "package:ios": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\package-native.ps1 -Platform ios",
    "package:windows": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\package-native.ps1 -Platform windows",
    "package:macos": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\package-native.ps1 -Platform macos",
    "package:all": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\package-native.ps1 -Platform all",
    "check:packaging": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\check-packaging.ps1",
    "test:windows": "jest --config jest.config.windows.js",
    "gate:web": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\run-device-build-gates.ps1 -Platform web",
    "gate:android": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\run-device-build-gates.ps1 -Platform android",
    "gate:ios": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\run-device-build-gates.ps1 -Platform ios",
    "gate:windows": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\run-device-build-gates.ps1 -Platform windows",
    "gate:macos": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\run-device-build-gates.ps1 -Platform macos",
    "gate:device": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\run-device-build-gates.ps1 -Platform all",
    "gate:native": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\run-device-build-gates.ps1 -Platform all -RunQualityGates"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.1",
    "react": "19.1.4",
    "react-dom": "^19.1.4",
    "react-native": "0.81.6",
    "react-native-macos": "^0.81.6",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-web": "^0.21.2",
    "react-native-windows": "^0.81.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/eslint-config": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@react-native/typescript-config": "0.81.6",
    "@rnx-kit/jest-preset": "^0.1.17",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=20"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "TeslaSyncNative",
      "namespace": "TeslaSync.Native",
      "template": "cpp-app"
    }
  }
}
