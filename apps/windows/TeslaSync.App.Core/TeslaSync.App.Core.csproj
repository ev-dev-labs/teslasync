<Project Sdk="Microsoft.NET.Sdk">

  <!--
    P2/W2-0001 — pure, UI-thread-free logic backing the Fluent UI primitives.
    Kept WinUI-free so it can be unit-tested headlessly via `dotnet test`
    (the WinUI controls in TeslaSync.App reference these models for their
    sorting, pagination, selection, masking and command-filter behaviour).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TeslaSync.App.Core</RootNamespace>
    <AssemblyName>TeslaSync.App.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <!--
    P2/W5-0001 — the data layer consumes the generated OpenAPI C# client (the only
    contract client), caches via SQLite, and is wired through Microsoft DI together
    with the W4 auth handler. These references keep the layer headless-testable.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Generated\Generated.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\Cache\cache_schema.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
