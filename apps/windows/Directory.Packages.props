<!--
  Central Package Management — Windows program (ADR-012 version lock).

  Source of truth: apps/versions.lock.md. Baselines below are placeholders to be
  finalized/wired by the first Windows build prompt (W0-0001-sln-scaffold).
  Renovate keeps patch versions current; major bumps require a superseding ADR.

  Target framework: net10.0-windows10.0.19041.0 (.NET 10 LTS).
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.2.1" />
  </ItemGroup>
</Project>
