<?xml version="1.0" encoding="utf-8"?>
<!--
  Release publish profile (ARM64) — the locked toolchain's second target RID (apps/versions.lock.md).

  Mirrors win-x64.pubxml for native ARM64 devices. As with x64, MSIX signing is driven by the
  TESLASYNC_MSIX_CERT_THUMBPRINT environment variable in TeslaSync.App.csproj (P2/W8-0002): no private
  certificate is committed, and signing is a no-op until CI injects the thumbprint.

  Native AOT note (ADR-012): WinUI 3 / Windows App SDK does not support PublishAot=true, so we use
  ReadyToRun (PublishReadyToRun) as the closest startup optimization.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>ARM64</Platform>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishAot>false</PublishAot>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
</Project>
