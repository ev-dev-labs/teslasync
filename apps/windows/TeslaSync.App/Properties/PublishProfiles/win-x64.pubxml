<?xml version="1.0" encoding="utf-8"?>
<!--
  Release publish profile (x64).

  Native AOT note (ADR-012): WinUI 3 / Windows App SDK does not support
  PublishAot=true — the XAML compiler and CsWinRT projection rely on
  reflection/metadata that Native AOT trims away. We therefore use
  ReadyToRun ahead-of-time compilation (PublishReadyToRun) as the closest
  viable startup optimization. Revisit when Windows App SDK ships AOT support.

  MSIX signing note (P2/W8-0002): signing is driven by the
  TESLASYNC_MSIX_CERT_THUMBPRINT environment variable in TeslaSync.App.csproj.
  No private certificate is committed; signing is a no-op until CI injects the
  thumbprint, so a local `dotnet publish` never requires a cert.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishAot>false</PublishAot>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
</Project>
