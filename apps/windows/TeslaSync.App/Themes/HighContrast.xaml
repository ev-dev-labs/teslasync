<?xml version="1.0" encoding="utf-8"?>
<!--
    P2/W1-0001 — High-contrast theme dictionary.
    High contrast intentionally defers to the OS system brushes rather than
    forcing brand colors, and drops Acrylic/Mica (which are disabled in high
    contrast). Token keys keep the same names so components resolve uniformly.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="TsAppRootBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
    <SolidColorBrush x:Key="TsAppContentForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

    <SolidColorBrush x:Key="TsSurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
    <SolidColorBrush x:Key="TsSurfaceOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />

    <ThemeShadow x:Key="TsElevationOverlayShadow" />
    <ThemeShadow x:Key="TsElevationModalShadow" />

</ResourceDictionary>
