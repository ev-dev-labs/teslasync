<?xml version="1.0" encoding="utf-8"?>
<!--
    P2/W2-0001 — shared component styles for the Fluent UI primitives.
    Every brush, size and corner derives from the generated design tokens
    (Themes/Tokens.xaml) so light/dark/high-contrast all flow from W1.
    Merged into Application.Resources by App.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:TeslaSync.App.Components.UI">

    <!-- ============================ Buttons ============================ -->
    <Style x:Key="TsButtonPrimaryStyle" TargetType="ui:TsButton" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource TsColorAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TsColorBgBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource TsColorAccentBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource TsRadiusSm}" />
        <Setter Property="Padding" Value="16,8,16,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="TsButtonSecondaryStyle" TargetType="ui:TsButton" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource TsColorSurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TsColorTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource TsColorBorderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource TsRadiusSm}" />
        <Setter Property="Padding" Value="16,8,16,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="TsButtonSubtleStyle" TargetType="ui:TsButton" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TsColorTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource TsRadiusSm}" />
        <Setter Property="Padding" Value="16,8,16,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="TsButtonOutlineStyle" TargetType="ui:TsButton" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TsColorTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource TsColorBorderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource TsRadiusSm}" />
        <Setter Property="Padding" Value="16,8,16,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="TsButtonDestructiveStyle" TargetType="ui:TsButton" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource TsColorDangerBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource TsColorDangerBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource TsRadiusSm}" />
        <Setter Property="Padding" Value="16,8,16,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="TsButtonIconStyle" TargetType="ui:TsButton" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TsColorTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource TsRadiusSm}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- ===================== Inputs (TextBox family) ===================== -->
    <Style x:Key="TsInputStyle" TargetType="ui:TsInput" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource TsRadiusSm}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,8,12,8" />
        <Setter Property="FontSize" Value="{StaticResource TsTypeBodyFontSize}" />
    </Style>

    <Style x:Key="TsTextareaStyle" TargetType="ui:TsTextarea" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource TsRadiusSm}" />
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="Padding" Value="12,8,12,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="FontSize" Value="{StaticResource TsTypeBodyFontSize}" />
    </Style>

    <Style x:Key="TsSelectStyle" TargetType="ui:TsSelect" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource TsRadiusSm}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="{StaticResource TsTypeBodyFontSize}" />
    </Style>

    <!-- Shared converters -->
    <ui:BoolToVisibilityConverter x:Key="TsBoolToVisibility" />

    <!-- ===================== Surfaces (implicit styles) ===================== -->
    <Style TargetType="ui:TsGlassPanel">
        <Setter Property="Padding" Value="16" />
        <Setter Property="BorderBrush" Value="{ThemeResource TsColorBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:TsGlassPanel">
                    <Border
                        Background="{ThemeResource TsColorSurfaceGlassBrush}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TsRadiusLg}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:TsCard">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:TsCard">
                    <Border
                        Background="{ThemeResource TsColorSurfaceBrush}"
                        BorderBrush="{ThemeResource TsColorBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TsRadiusMd}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:TsCardHeader">
        <Setter Property="Padding" Value="16,12,16,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:TsCardHeader">
                    <Border
                        BorderBrush="{ThemeResource TsColorBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:TsCardFooter">
        <Setter Property="Padding" Value="16,12,16,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:TsCardFooter">
                    <Border
                        BorderBrush="{ThemeResource TsColorBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:TsBadge">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,2,8,2" />
        <Setter Property="FontSize" Value="{StaticResource TsTypeBodySmFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:TsBadge">
                    <Border
                        Background="{ThemeResource TsColorSurfaceGlassBrush}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource TsRadiusPill}"
                        Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{TemplateBinding AccentBrush}"
                                Visibility="{Binding Dot, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TsBoolToVisibility}}" />
                            <ContentPresenter
                                VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:TsStatusPill">
        <Setter Property="Padding" Value="10,3,10,3" />
        <Setter Property="FontSize" Value="{StaticResource TsTypeBodySmFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TsColorTextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:TsStatusPill">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="PulseStates">
                                <VisualState x:Name="Static" />
                                <VisualState x:Name="Pulsing">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation
                                            Storyboard.TargetName="StateDot"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1.0"
                                            To="0.3"
                                            Duration="0:0:0.8" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            Background="{ThemeResource TsColorSurfaceGlassBrush}"
                            BorderBrush="{ThemeResource TsColorBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource TsRadiusPill}"
                            Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse
                                    x:Name="StateDot"
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="{TemplateBinding DotBrush}" />
                                <ContentPresenter
                                    VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
