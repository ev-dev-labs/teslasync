<Project Sdk="Microsoft.NET.Sdk">

  <!--
    P2/W0-0001 — WinUI 3 application shell (ADR-002, ADR-012).
    Package versions are pinned centrally in ../Directory.Packages.props
    from apps/versions.lock.md. This project intentionally ships an empty
    NavigationView shell only; real navigation/pages land in W4/W7.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>TeslaSync.App</RootNamespace>
    <AssemblyName>TeslaSync.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    The token dictionary is generated outside the project cone
    (apps/design/generated/windows/Tokens.xaml by TeslaSync.TokenGen) and linked
    in as a compiled Page so it resolves at ms-appx:///Themes/Tokens.xaml.
  -->
  <ItemGroup>
    <Page Include="..\..\design\generated\windows\Tokens.xaml" Link="Themes\Tokens.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

</Project>
