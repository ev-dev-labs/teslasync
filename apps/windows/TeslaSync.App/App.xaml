<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TeslaSync.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Generated design tokens (apps/design/generated/windows/Tokens.xaml). -->
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
                <!-- P2/W2-0001 shared Fluent UI primitive styles. -->
                <ResourceDictionary Source="ms-appx:///Components/UI/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default" Source="ms-appx:///Themes/Dark.xaml" />
                <ResourceDictionary x:Key="Light" Source="ms-appx:///Themes/Light.xaml" />
                <ResourceDictionary x:Key="HighContrast" Source="ms-appx:///Themes/HighContrast.xaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
