<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TeslaSync.App.Tests — headless (plain net10.0, no WinUI host) verification of the WinUI app's
    Microsoft.UI-free logic (Model / Source / ViewModel / Projection / Registration / diagnostics) for every
    dashboard-widget, feature-view, misc-surface, modal/dialog, shared-surface and widget-primitive.
    TeslaSync.App targets a WinUI TFM and cannot be project-referenced from a plain net10.0 host, so each
    surface's Microsoft.UI-free sources are Compile-linked below (the Link mirrors each source's real
    location under Widgets, FeatureViews, MiscSurfaces, ModalsDialogs, SharedSurfaces or WidgetPrimitives).
    The bare WinUI view files are excluded and exercised by the app build; the test classes are picked up by
    the SDK default-compile glob; the Content links copy the units-golden, Package.appxmanifest and
    widget-template fixtures the tests read from the output directory.

    INVARIANT: keep this file as exactly ONE Project root with a single PropertyGroup, the package /
    project-reference / content item groups, and ONE Compile item group (the case-insensitive ordinal
    path-sorted, Include-deduplicated union of every Microsoft.UI-free .cs on disk under dashboard-widgets/,
    feature-views/, misc-surfaces/, modals-dialogs/, shared-surfaces/ and widget-primitives/). This file
    carries the .gitattributes merge=union strategy, so a chain of integration merges can re-concatenate it
    into multiple Project roots plus duplicate Compile items (and can strand comment prose as bare text under
    the root element), failing XML load (MSB4025 / MSB4067); when that happens, regenerate it directly from
    the Microsoft.UI-free sources on disk. Regenerated into this single canonical Project root for P2
    windows/W7 admin/SchemaDriftPage (repairing a merge=union multi-root corruption), plus the new
    SchemaDriftPage Model/Source/ViewModel links. Do NOT re-concatenate into multiple roots, and never write
    a literal build item or project start tag inside this comment.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Generated\Generated.csproj" />
    <ProjectReference Include="..\TeslaSync.App.Core\TeslaSync.App.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\shared\spec\units-golden.json" Link="units-golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\TeslaSync.App\Package.appxmanifest" Link="Package.appxmanifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\TeslaSync.App\Platform\Widgets\Public\VehicleStatusTemplate.json" Link="VehicleStatusTemplate.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

