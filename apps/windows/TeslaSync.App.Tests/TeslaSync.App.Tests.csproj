<Project Sdk="Microsoft.NET.Sdk">

  <!--
    P2/W2-0001 — headless unit tests for the UI-primitive logic models.
    Targets plain net10.0 so `dotnet test` runs without a WinUI/UI-thread host.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TeslaSync.App.Core\TeslaSync.App.Core.csproj" />
    <ProjectReference Include="..\Generated\Generated.csproj" />
  </ItemGroup>

  <!--
    P2 dashboard-widgets: the AlertFeedWidget's UI-thread-free logic (the alert DTO/parse, the
    drill-through map, the projection, the result mapper, and the state-holder view-model) lives in
    the WinUI app project but is WinUI-free by construction. Link those two source files in so the
    headless (net10.0) test project verifies the adapter + per-state transitions row-for-row without
    a UI host — the same pattern used for the Core widget logic. The WinUI view itself is exercised
    by the app build.
  -->
