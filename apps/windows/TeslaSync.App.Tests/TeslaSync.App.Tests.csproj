<Project Sdk="Microsoft.NET.Sdk">

  <!--
    P2/W2-0001 — headless unit tests for the UI-primitive logic models.
    Targets plain net10.0 so `dotnet test` runs without a WinUI/UI-thread host.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TeslaSync.App.Core\TeslaSync.App.Core.csproj" />
    <ProjectReference Include="..\Generated\Generated.csproj" />
  </ItemGroup>

  <!--
    P2 dashboard-widgets: the AlertFeedWidget's UI-thread-free logic (the alert DTO/parse, the
    drill-through map, the projection, the result mapper, and the state-holder view-model) lives in
    the WinUI app project but is WinUI-free by construction. Link those two source files in so the
    headless (net10.0) test project verifies the adapter + per-state transitions row-for-row without
    a UI host — the same pattern used for the Core widget logic. The WinUI view itself is exercised
    by the app build.
  -->
  <ItemGroup>
    <Compile Include="..\TeslaSync.App\dashboard-widgets\AlertFeedWidget\AlertFeedWidget.Model.cs" Link="Widgets\AlertFeedWidget\AlertFeedWidget.Model.cs" />
    <Compile Include="..\TeslaSync.App\dashboard-widgets\AlertFeedWidget\AlertFeedWidget.ViewModel.cs" Link="Widgets\AlertFeedWidget\AlertFeedWidget.ViewModel.cs" />
    <Compile Include="..\TeslaSync.App\dashboard-widgets\AnalyticsSummaryWidget\AnalyticsSummaryWidget.Model.cs" Link="Widgets\AnalyticsSummaryWidget\AnalyticsSummaryWidget.Model.cs" />
    <Compile Include="..\TeslaSync.App\dashboard-widgets\AnalyticsSummaryWidget\AnalyticsSummaryWidget.ViewModel.cs" Link="Widgets\AnalyticsSummaryWidget\AnalyticsSummaryWidget.ViewModel.cs" />
    <Compile Include="..\TeslaSync.App\dashboard-widgets\AnomalyDetectorWidget\AnomalyDetectorWidget.Model.cs" Link="Widgets\AnomalyDetectorWidget\AnomalyDetectorWidget.Model.cs" />
    <Compile Include="..\TeslaSync.App\dashboard-widgets\AnomalyDetectorWidget\AnomalyDetectorWidget.ViewModel.cs" Link="Widgets\AnomalyDetectorWidget\AnomalyDetectorWidget.ViewModel.cs" />
    <Compile Include="..\TeslaSync.App\dashboard-widgets\AnomalyDetectorWidget\AnomalyDetectorWidget.Source.cs" Link="Widgets\AnomalyDetectorWidget\AnomalyDetectorWidget.Source.cs" />
  </ItemGroup>

  <!--
    Language-neutral SI golden vectors (apps/shared/spec/units-golden.json) copied
    next to the test assembly so the C# behavior port is verified row-for-row
    against the web truth (ADR-004), exactly as the shared Kotlin port is.
  -->
  <ItemGroup>
    <Content Include="..\..\shared\spec\units-golden.json" Link="units-golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    P2/W8-0002 — copy the MSIX package manifest next to the test assembly so the packaging assertions
    (identity, protocol activation, capabilities, file type association) verify the real manifest.
  -->
  <ItemGroup>
    <Content Include="..\TeslaSync.App\Package.appxmanifest" Link="Package.appxmanifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    P2/W8-0003 — copy the packaged widget Adaptive Card template next to the tests so the drift test can
    assert it matches the canonical Core template constant.
  -->
  <ItemGroup>
    <Content Include="..\TeslaSync.App\Platform\Widgets\Public\VehicleStatusTemplate.json" Link="VehicleStatusTemplate.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
