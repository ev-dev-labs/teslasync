<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TeslaSync.App.Tests - headless (plain net10.0, no WinUI host) verification of the WinUI app's
    UI-thread-free logic (Model / Source / ViewModel / Projection / Registry / diagnostics) for each
    feature-view and dashboard-widget surface. The WinUI app (TeslaSync.App) targets a WinUI TFM and
    cannot be project-referenced from a plain net10.0 test host, so each surface's WinUI-free sources are
    Compile-linked into the single ItemGroup below (the Link mirrors each source's real location under
    FeatureViews\ or Widgets\); the WinUI views themselves are exercised by the app build. The matching
    test classes live under this project and are picked up by the SDK default-compile glob.

    INVARIANT: keep this file as exactly ONE Project root with a single, ordinal-sorted, Include-deduplicated
    Compile ItemGroup - the union of every WinUI-free logic source on disk under dashboard-widgets/ and
    feature-views/ (every .cs with a role suffix that does not reference Microsoft.UI; the bare WinUI view
    files, and the WinUI-referencing ResponseViewer.Snippet.cs, are excluded). This file uses the
    .gitattributes "merge=union" strategy, so a chain of integration merges had repeatedly re-concatenated it
    into multiple Project roots plus duplicate Compile items and orphaned comment prose, failing XML load
    (MSB4025 / MSB4067). Do NOT re-concatenate into multiple roots, and never write a literal build-item or
    project start tag inside this comment.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TeslaSync.App.Core\TeslaSync.App.Core.csproj" />
    <ProjectReference Include="..\Generated\Generated.csproj" />
  </ItemGroup>

