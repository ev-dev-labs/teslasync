# Phase-50 / p50-ocpp.
# Standalone OCPP 1.6-J CSMS (Charging Station Management System).
# Built as a separate binary so the WebSocket handshake + ocpp1.6
# subprotocol don't bloat the main API router.

FROM golang:1.27-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /src

COPY go.mod ./
COPY go.sum* ./
RUN go mod download 2>/dev/null || true

COPY . .
RUN go mod tidy

ARG VERSION=dev

RUN GOMEMLIMIT=2GiB CGO_ENABLED=0 GOOS=linux go build \
    -p 2 \
    -gcflags=all=-l \
    -ldflags="-s -w -X main.Version=${VERSION}" \
    -o /bin/ocpp-server ./cmd/ocpp-server

FROM gcr.io/distroless/static:nonroot

COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /bin/ocpp-server /usr/local/bin/ocpp-server

USER nonroot:nonroot

EXPOSE 9090

ENTRYPOINT ["ocpp-server"]
