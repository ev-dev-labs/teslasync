{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: API server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/teslasync",
      "env": {
        "DATABASE_HOST": "localhost",
        "DATABASE_PORT": "5432",
        "DATABASE_NAME": "teslasync",
        "DATABASE_USER": "teslasync",
        "DATABASE_PASS": "teslasync",
        "LOG_LEVEL": "debug"
      }
    },
    {
      "name": "Debug: notification worker",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/notification-worker"
    },
    {
      "name": "Debug: Go test (current file)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": ["-test.run", "${selectedText}"]
    },
    {
      "name": "Debug: Vitest (current file)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test", "--", "--no-coverage", "${relativeFile}"],
      "console": "integratedTerminal"
    }
  ]
}
