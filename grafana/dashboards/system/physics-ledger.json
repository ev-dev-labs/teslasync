      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH p AS (\n  SELECT ts, float_value AS v FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND field = 'PackVoltage' AND $__timeFilter(ts)\n), i AS (\n  SELECT ts, float_value AS a FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND field = 'PackCurrent' AND $__timeFilter(ts)\n)\nSELECT ROUND(SUM(-(p.v * i.a) * 5 / 3600.0)::numeric, 1) AS \"Measured Wh\"\nFROM p JOIN i USING (ts)\nWHERE EXISTS (SELECT 1 FROM signal_log s\n  WHERE s.vehicle_id = ${vehicle_id} AND s.field = 'Gear'\n    AND s.ts <= p.ts AND s.str_value = 'D'\n  ORDER BY s.ts DESC LIMIT 1)",
          "refId": "A"
        }
      ],
      "title": "Measured drive Wh",
      "transparent": true,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "DS_TESLASYNC_POSTGRESQL"
