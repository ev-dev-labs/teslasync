          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT p.ts AS \"time\",\n  p.float_value * i.float_value AS \"Pack VI W\"\nFROM signal_log p JOIN signal_log i\n  ON i.vehicle_id = p.vehicle_id AND i.ts = p.ts AND i.field = 'PackCurrent'\nWHERE p.vehicle_id = ${vehicle_id} AND p.field = 'PackVoltage'\n  AND $__timeFilter(p.ts)\nORDER BY p.ts",
          "refId": "A"
        }
      ],
      "title": "Pack VI power (charge+)",
      "transparent": true,
      "type": "timeseries"
