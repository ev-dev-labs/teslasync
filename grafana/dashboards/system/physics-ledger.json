          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(SUM(0.5 * 1.225 * 0.575\n    * POWER(float_value, 3) * 5 / 3600.0)::numeric, 1) AS \"Aero Wh\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id} AND field = 'VehicleSpeed'\n  AND float_value > 1 AND $__timeFilter(ts)",
          "refId": "A"
        }
      ],
      "title": "Aero Wh (default CdA)",
      "transparent": true,
      "type": "stat"
