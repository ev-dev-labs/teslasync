      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT d.started_at AS \"time\",\n  d.id AS \"Drive\",\n  ROUND(d.energy_used_wh::numeric, 1) AS \"Session Wh\",\n  ROUND((d.avg_power_w * d.duration_s / 3600.0)::numeric, 1) AS \"Avg-power Wh\",\n  ROUND((d.energy_used_wh - d.avg_power_w * d.duration_s / 3600.0)::numeric, 1) AS \"Delta Wh\"\nFROM drives d\nWHERE d.vehicle_id = ${vehicle_id} AND $__timeFilter(d.started_at)\n  AND d.energy_used_wh IS NOT NULL\nORDER BY d.started_at DESC LIMIT 200",
          "refId": "A"
        }
      ],
      "title": "Session aggregates (not independent reconciliation)",
      "transparent": true,
      "type": "table"
