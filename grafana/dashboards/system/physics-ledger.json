          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH points AS (SELECT ts, 0.5*1.225*0.575*POWER(ABS(float_value),3) AS w FROM signal_log\nWHERE vehicle_id=${vehicle_id} AND field='VehicleSpeed' AND $__timeFilter(ts)), intervals AS (\n  SELECT ts, w, LEAD(w) OVER (ORDER BY ts) AS next_w,\n    LEAD(ts) OVER (ORDER BY ts) AS next_ts FROM points\n)\nSELECT ROUND(SUM((w + next_w) / 2 * EXTRACT(EPOCH FROM (next_ts-ts)) / 3600.0)::numeric, 1) AS \"Aero model Wh\"\nFROM intervals WHERE next_ts > ts AND next_ts-ts <= INTERVAL '120 seconds'",
          "refId": "A"
        }
      ],
      "title": "Aero Wh (default CdA)",
      "transparent": true,
      "type": "stat"
    },
