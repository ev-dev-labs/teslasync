      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH points AS (SELECT p.ts, -(p.float_value*i.float_value) AS w\nFROM signal_log p JOIN signal_log i ON i.vehicle_id=p.vehicle_id AND i.ts=p.ts AND i.field='PackCurrent'\nWHERE p.vehicle_id=${vehicle_id} AND p.field='PackVoltage' AND $__timeFilter(p.ts)), intervals AS (\n  SELECT ts, w, LEAD(w) OVER (ORDER BY ts) AS next_w,\n    LEAD(ts) OVER (ORDER BY ts) AS next_ts FROM points\n)\nSELECT ROUND(SUM((w + next_w) / 2 * EXTRACT(EPOCH FROM (next_ts-ts)) / 3600.0)::numeric, 1) AS \"Observed drive Wh\"\nFROM intervals WHERE next_ts > ts AND next_ts-ts <= INTERVAL '120 seconds'\nAND (SELECT g.str_value FROM signal_log g WHERE g.vehicle_id = ${vehicle_id} AND g.field = 'Gear' AND g.ts <= intervals.ts ORDER BY g.ts DESC LIMIT 1) = 'D'\nAND NOT EXISTS (SELECT 1 FROM signal_log g WHERE g.vehicle_id=${vehicle_id} AND g.field='Gear'\n  AND g.ts > intervals.ts AND g.ts <= intervals.next_ts AND g.str_value IS DISTINCT FROM 'D')",
          "refId": "A"
        }
      ],
      "title": "Observed drive Wh (partial aligned coverage)",
      "transparent": true,
      "type": "stat"
    },
