            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(100.0 * SUM(EXTRACT(EPOCH FROM (\n    LEAST(r.ends_at, $__timeTo()) - GREATEST(r.starts_at, $__timeFrom()))) / 3600.0)\n  / NULLIF(EXTRACT(EPOCH FROM ($__timeTo() - $__timeFrom())) / 3600.0, 0), 1)\n  AS \"Use %\"\nFROM fleet_reservations r\nWHERE r.vehicle_id = ${vehicle_id} AND r.status = 'completed'\n  AND r.ends_at >= $__timeFrom() AND r.starts_at <= $__timeTo()",
          "refId": "A"
        }
      ],
      "title": "Utilization %",
      "transparent": true,
      "type": "stat"
