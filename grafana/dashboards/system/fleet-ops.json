          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.starts_at AS \"time\", r.title AS \"Title\",\n  d.display_name AS \"Driver\", c.code AS \"Cost center\", r.status AS \"Status\"\nFROM fleet_reservations r\nLEFT JOIN fleet_drivers d ON d.id = r.driver_id\nLEFT JOIN fleet_cost_centers c ON c.id = r.cost_center_id\nWHERE r.vehicle_id = ${vehicle_id} AND r.ends_at >= NOW()\nORDER BY r.starts_at LIMIT 200",
          "refId": "A"
        }
      ],
      "title": "Upcoming reservations",
