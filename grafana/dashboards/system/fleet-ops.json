          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.code AS \"Code\", c.name AS \"Name\",\n  COUNT(r.id) AS \"Reservations\"\nFROM fleet_cost_centers c\nLEFT JOIN fleet_reservations r ON r.cost_center_id = c.id\n  AND r.vehicle_id = ${vehicle_id} AND $__timeFilter(r.starts_at)\nWHERE c.active\nGROUP BY c.code, c.name ORDER BY \"Reservations\" DESC LIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Cost centers",
