      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH comp AS (\n  SELECT vehicle_id, ts FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND field = 'DetailedChargeState'\n    AND str_value LIKE '%Complete%' AND $__timeFilter(ts)\n)\nSELECT ROUND(AVG(EXTRACT(EPOCH FROM (c.ended_at - m.last_complete)) / 60.0)::numeric, 1)\n  AS \"Dwell min\"\nFROM charging_sessions c\nJOIN LATERAL (SELECT MAX(ts) AS last_complete FROM comp\n  WHERE ts >= c.started_at AND ts <= COALESCE(c.ended_at, NOW())) m ON true\nWHERE c.vehicle_id = ${vehicle_id} AND $__timeFilter(c.started_at)\n  AND c.ended_at IS NOT NULL AND m.last_complete IS NOT NULL",
          "refId": "A"
        }
      ],
      "title": "Avg dwell Complete→end",
      "transparent": true,
      "type": "stat"
    },
