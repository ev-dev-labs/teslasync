          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(ts, '5m') AS \"time\",\n  AVG(CASE WHEN field = 'ACChargingPower' THEN float_value END) AS \"AC W\",\n  AVG(CASE WHEN field = 'DCChargingPower' THEN float_value END) AS \"DC W\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id} AND field IN ('ACChargingPower', 'DCChargingPower')\n  AND $__timeFilter(ts)\nGROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Wall power AC+DC",
