          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT started_at AS \"time\", id AS \"ID\",\n  ROUND(total_energy_added_wh::numeric, 0) AS \"Wh\",\n  charger_type AS \"Charger\",\n  ROUND((EXTRACT(EPOCH FROM (COALESCE(ended_at, NOW()) - started_at)) / 60.0)::numeric, 0)\n    AS \"Duration min\"\nFROM charging_sessions\nWHERE vehicle_id = ${vehicle_id} AND $__timeFilter(started_at)\nORDER BY started_at DESC LIMIT 200",
