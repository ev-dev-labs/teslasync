      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH dfw AS (\n  SELECT d.id, d.started_at, d.energy_used_wh, d.distance_m, (\n    SELECT str_value FROM signal_log s\n    WHERE s.vehicle_id = d.vehicle_id AND s.field = 'Version' AND s.ts <= d.started_at\n    ORDER BY s.ts DESC LIMIT 1\n  ) AS fw\n  FROM drives d\n  WHERE d.vehicle_id = ${vehicle_id} AND $__timeFilter(d.started_at)\n    AND d.energy_used_wh > 0 AND d.distance_m > 0\n)\nSELECT fw AS \"Firmware\", COUNT(*) AS \"Drives\",\n  ROUND(AVG(1000.0 * energy_used_wh / NULLIF(distance_m, 0))::numeric, 1) AS \"Avg Wh/km\",\n  MIN(started_at) AS \"First\", MAX(started_at) AS \"Last\"\nFROM dfw GROUP BY fw ORDER BY \"Last\" DESC LIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Efficiency by firmware (correlation)",
      "transparent": true,
      "type": "table"
    },
