          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT started_at AS \"time\",\n  1000.0 * energy_used_wh / NULLIF(distance_m, 0) AS \"Wh/km\"\nFROM drives\nWHERE vehicle_id = ${vehicle_id} AND $__timeFilter(started_at)\n  AND energy_used_wh > 0 AND distance_m > 0\nORDER BY started_at",
          "refId": "A"
        }
