          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT MIN(ts) AS \"First\", MAX(ts) AS \"Last\",\n  str_value AS \"Version\", COUNT(*) AS \"Samples\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id} AND field = 'Version' AND $__timeFilter(ts)\nGROUP BY str_value ORDER BY \"Last\" DESC LIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Firmware sightings",
