      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  d.id AS \"🔗 ID\",\n  d.started_at AS \"📅 Date\",\n  CASE\n    WHEN (d.distance_m / 1609.344) > 100 THEN '🛣️ Road Trip'\n    WHEN (d.distance_m / 1609.344) > 30 THEN '🚗 Drive'\n    WHEN (d.distance_m / 1609.344) > 0 THEN '🏙️ Short'\n    ELSE '🅿️ Parked'\n  END AS \"🏷️ Type\",\n  ROUND(convert_distance((d.distance_m / 1609.344))::numeric, 1) AS \"📏 Distance\",\n  ROUND((d.duration_s / 60.0)::numeric) AS \"⏱️ Duration\",\n  ROUND(convert_speed((d.distance_m / 1609.344) / NULLIF((d.duration_s / 60.0), 0) * 60)::numeric, 1) AS \"🚗 Avg Speed\",\n  ROUND(convert_speed((d.max_speed_mps * 2.2369362920544))::numeric) AS \"🏎️ Max Speed\",\n  CASE\n    WHEN (d.max_speed_mps * 2.2369362920544) > 130 THEN '🔴'\n    WHEN (d.max_speed_mps * 2.2369362920544) > 100 THEN '🟡'\n    ELSE '🟢'\n  END AS \"🚦 Speed\",\n  d.start_soc_pct AS \"🔋 Start %\",\n  d.end_soc_pct AS \"🔋 End %\",\n  CASE\n    WHEN (d.start_soc_pct - COALESCE(d.end_soc_pct, d.start_soc_pct)) > 20 THEN '⚠️ High'\n    WHEN (d.start_soc_pct - COALESCE(d.end_soc_pct, d.start_soc_pct)) > 10 THEN '📊 Medium'\n    ELSE '✅ Low'\n  END AS \"📊 Usage\",\n  ROUND(convert_distance(NULL)::numeric) AS \"📏 Range Start\",\n  ROUND(convert_distance(NULL)::numeric) AS \"📏 Range End\",\n  ROUND(convert_temp(d.ambient_temp_c_avg)::numeric, 1) AS \"🌡️ Temp\"\nFROM drives d\nWHERE d.vehicle_id = ${vehicle_id}\n  AND $__timeFilter(d.started_at)\nORDER BY d.started_at DESC\nLIMIT 200",
          "refId": "A"
        }
      ],
      "title": "Drive History",
      "type": "table",
      "transparent": false
    }
  ],
