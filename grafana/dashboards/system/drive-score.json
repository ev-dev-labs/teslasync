      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH scored AS (\n  SELECT\n    started_at AS date,\n    (distance_m / 1609.344) AS distance_mi,\n    (avg_speed_mps * 2.2369362920544) AS avg_speed,\n    (NULL::float8)::integer AS score,\n    CASE\n      WHEN (NULL::float8) >= 90 THEN 'A'\n      WHEN (NULL::float8) >= 80 THEN 'B'\n      WHEN (NULL::float8) >= 70 THEN 'C'\n      WHEN (NULL::float8) >= 60 THEN 'D'\n      ELSE 'F'\n    END AS grade,\n    CASE WHEN (distance_m / 1609.344) > 0 AND (energy_used_wh / 1000.0) IS NOT NULL\n      THEN (energy_used_wh / 1000.0) * 1000 / (distance_m / 1609.344)\n      ELSE NULL END AS wh_per_mi\n  FROM drives\n  WHERE vehicle_id = ${vehicle_id}\n    AND $__timeFilter(started_at)\n    AND (distance_m / 1609.344) > 1\n    AND (NULL::float8) IS NOT NULL\n  ORDER BY started_at DESC\n  LIMIT 30\n)\nSELECT\n  date AS \"📅 Date\",\n  ROUND(convert_distance(scored.distance_mi)::numeric, 1) AS \"📏 Distance\",\n  ROUND(convert_speed(scored.avg_speed)::numeric, 1) AS \"🚗 Avg Speed\",\n  (NULL::float8) AS \"⭐ Score\",\n  scored.grade AS \"🏅 Grade\",\n  CASE WHEN scored.wh_per_mi IS NOT NULL\n    THEN ROUND(convert_efficiency(scored.wh_per_mi)::numeric, 0)\n    ELSE NULL\n  END AS \"⚡ Efficiency\"\nFROM scored",
          "refId": "A"
        }
      ],
      "title": "Recent Drive Scores",
      "type": "table",
      "transparent": false
    },
