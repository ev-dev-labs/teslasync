      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  started_at AS time,\n  (NULL::float8)::integer AS \"Score\",\n  ROUND(AVG((NULL::float8)) OVER (ORDER BY started_at ROWS BETWEEN 6 PRECEDING AND CURRENT ROW))::int AS \"7-Drive Avg\"\nFROM drives\nWHERE vehicle_id = ${vehicle_id}\n  AND $__timeFilter(started_at)\n  AND (NULL::float8) IS NOT NULL\nORDER BY started_at",
          "refId": "A"
        }
      ],
      "title": "Drive Score Trend",
      "type": "timeseries",
      "transparent": false
    },
