      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Efficiency'::text AS \"Category\",\n  ROUND(AVG((NULL::float8))::numeric, 0) AS \"Score\"\nFROM drives\nWHERE vehicle_id = ${vehicle_id}\n  AND $__timeFilter(started_at)\n  AND (NULL::float8) IS NOT NULL\nUNION ALL\nSELECT 'Smoothness'::text,\n  ROUND(AVG(\n    CASE WHEN (max_speed_mps * 2.2369362920544) > 0 AND (avg_speed_mps * 2.2369362920544) > 0\n      THEN LEAST(100.0, 100.0 * (avg_speed_mps * 2.2369362920544) / (max_speed_mps * 2.2369362920544))\n      ELSE NULL END\n  )::numeric, 0)\nFROM drives\nWHERE vehicle_id = ${vehicle_id}\n  AND $__timeFilter(started_at)\nUNION ALL\nSELECT 'Speed'::text,\n  ROUND(AVG(\n    CASE WHEN (duration_s / 60.0) > 0 AND (distance_m / 1609.344) > 0\n      THEN LEAST(100.0, ((distance_m / 1609.344) * 1.60934 / (duration_s / 60.0) * 60.0) / 1.2)\n      ELSE NULL END\n  )::numeric, 0)\nFROM drives\nWHERE vehicle_id = ${vehicle_id}\n  AND $__timeFilter(started_at)",
          "refId": "A"
        }
      ],
      "title": "Score Breakdown by Category",
      "type": "bargauge",
      "transparent": false
    },
