      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH samples AS (\n  SELECT speed_mps * 3.6 AS speed_kmh\n  FROM drive_telemetry\n  WHERE vehicle_id = ${vehicle_id}\n    AND ts BETWEEN $__timeFrom() AND $__timeTo()\n    AND speed_mps > 0\n)\nSELECT\n  (FLOOR(speed_kmh / 10) * 10 || '-' || (FLOOR(speed_kmh / 10) * 10 + 10))::text AS speed_band,\n  COUNT(*)::bigint AS reading_count\nFROM samples\nGROUP BY FLOOR(speed_kmh / 10)\nORDER BY FLOOR(speed_kmh / 10)",
          "refId": "A"
        }
      ],
      "title": "Speed Histogram",
      "type": "barchart"
    },
    {
      "datasource": {
