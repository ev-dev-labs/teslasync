      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  ROUND(convert_distance(distance)::numeric, 1) AS \"🛣️ Distance\",\n  ROUND(duration_min::numeric) AS \"⏱️ Duration (min)\",\n  ROUND(convert_speed(speed_max)::numeric) AS \"🏎️ Max Speed\",\n  start_battery_level AS \"🔋 Start %\",\n  end_battery_level AS \"🔋 End %\",\n  ROUND(convert_temp(outside_temp_avg)::numeric, 1) AS \"🌡️ Temp\"\nFROM v_drives WHERE id = ${drive_id}",
          "refId": "A"
        }
      ],
      "title": "Drive Summary",
      "type": "stat",
      "transparent": false
    },
    {
      "type": "geomap",
      "title": "🗺️ Route",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TESLASYNC_POSTGRESQL"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(sl.ts, '10s') AS time,\n  ((MAX(sl.value_text) FILTER (WHERE sl.signal_name = 'Location'))::jsonb->>'latitude')::float AS latitude,\n  ((MAX(sl.value_text) FILTER (WHERE sl.signal_name = 'Location'))::jsonb->>'longitude')::float AS longitude,\n  convert_speed(MAX(sl.value_num) FILTER (WHERE sl.signal_name = 'VehicleSpeed')) AS speed,\n  MAX(sl.value_num) FILTER (WHERE sl.signal_name = 'BatteryLevel') AS battery_level\nFROM signal_log sl\nJOIN drives d ON d.vehicle_id = sl.vehicle_id\n  AND sl.ts BETWEEN d.start_ts AND COALESCE(d.end_ts, NOW())\nWHERE d.id = ${drive_id}\n  AND sl.ts BETWEEN $__timeFrom() AND $__timeTo()\n  AND sl.signal_name IN ('Location', 'VehicleSpeed', 'BatteryLevel')\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {
        "view": {
          "allLayers": true,
          "id": "fit",
          "lat": 0,
          "lon": 0,
          "zoom": 10
        },
        "basemap": {
          "name": "CartoDB Dark Matter",
          "type": "xyz",
          "config": {
            "url": "https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png",
            "attribution": "CARTO"
          }
        },
        "layers": [
          {
            "type": "route",
            "name": "Drive Route",
            "config": {
              "style": {
                "color": {
                  "fixed": "#00f0ff"
                },
                "lineWidth": 3,
                "opacity": 0.8
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "tooltip": true
          },
          {
            "type": "markers",
            "name": "Start/End",
            "config": {
              "style": {
                "color": {
                  "field": "speed",
                  "fixed": "#10b981"
                },
                "opacity": 0.7,
                "size": {
                  "fixed": 5
                }
              },
              "showLegend": true
            },
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            }
          }
        ]
      }
    },
