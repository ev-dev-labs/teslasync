          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(sl.ts, '30s') AS time,\n  convert_temp(MAX(sl.value_num) FILTER (WHERE sl.signal_name = 'InsideTemp')) AS \"Cabin\",\n  convert_temp(MAX(sl.value_num) FILTER (WHERE sl.signal_name = 'OutsideTemp')) AS \"Outside\"\nFROM signal_log sl\nJOIN drives d ON d.vehicle_id = sl.vehicle_id\n  AND sl.ts BETWEEN d.start_ts AND COALESCE(d.end_ts, NOW())\nWHERE d.id = ${drive_id}\n  AND sl.ts BETWEEN $__timeFrom() AND $__timeTo()\n  AND sl.signal_name IN ('InsideTemp', 'OutsideTemp')\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
