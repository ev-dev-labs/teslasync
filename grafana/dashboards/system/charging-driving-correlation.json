          "rawQuery": true,
          "rawSql": "SELECT\n  d.day::text AS \"Date\",\n  ROUND(d.distance_mi::numeric, 1) AS \"Distance (${unit_length})\",\n  ROUND(COALESCE(c.energy_added, 0)::numeric, 1) AS \"Energy Added (kWh)\"\nFROM (\n  SELECT started_at::date AS day, SUM((distance_m / 1609.344)) AS distance_mi\n  FROM drives WHERE vehicle_id = ${vehicle_id} AND $__timeFilter(started_at)\n  GROUP BY started_at::date\n) d\nLEFT JOIN (\n  SELECT started_at::date AS day, SUM((total_energy_added_wh / 1000.0)) AS energy_added\n  FROM charging_sessions WHERE vehicle_id = ${vehicle_id} AND $__timeFilter(started_at)\n  GROUP BY started_at::date\n) c ON d.day = c.day\nORDER BY d.day",
