      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(d.day, c.day) AS \"Date\",\n  COALESCE(d.drives, 0) AS \"Drives\",\n  ROUND(COALESCE(d.distance_mi, 0)::numeric, 1) AS \"Distance (${unit_length})\",\n  COALESCE(c.charges, 0) AS \"Charges\",\n  ROUND(COALESCE(c.energy_added, 0)::numeric, 1) AS \"Energy Added (kWh)\",\n  ROUND(COALESCE(c.cost, 0)::numeric, 2) AS \"Cost ($)\"\nFROM (\n  SELECT started_at::date AS day, COUNT(*) AS drives, SUM((distance_m / 1609.344)) AS distance_mi\n  FROM drives WHERE vehicle_id = ${vehicle_id} AND $__timeFilter(started_at)\n  GROUP BY started_at::date\n) d\nFULL OUTER JOIN (\n  SELECT started_at::date AS day, COUNT(*) AS charges, SUM((total_energy_added_wh / 1000.0)) AS energy_added, SUM(cost_decimal) AS cost\n  FROM charging_sessions WHERE vehicle_id = ${vehicle_id} AND $__timeFilter(started_at)\n  GROUP BY started_at::date\n) c ON d.day = c.day\nORDER BY COALESCE(d.day, c.day) DESC",
          "refId": "A"
        }
      ],
      "title": "Combined Daily View",
      "type": "table",
      "transparent": false
