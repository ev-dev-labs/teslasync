            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "pointSize": {
              "fixed": 3
            },
            "show": "points+lines",
            "lineWidth": 2,
            "lineStyle": {
              "fill": "solid"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Power (kW)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "kwatt"
              },
              {
                "id": "custom.axisLabel",
                "value": "Power (kW)"
              },
              {
                "id": "custom.axisPlacement",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SoC %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "custom.axisLabel",
                "value": "State of Charge (%)"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "dims": {
          "x": "SoC %"
        },
        "series": [],
        "seriesMapping": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "Session"
            ],
            "keepFields": false
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH recent_sessions AS (\n  SELECT id, vehicle_id, started_at, COALESCE(ended_at, NOW()) AS ended_at\n  FROM charging_sessions\n  WHERE vehicle_id = ${vehicle_id}\n  ORDER BY started_at DESC\n  LIMIT 5\n),\nbucketed AS (\n  SELECT\n    rs.id AS session_id,\n    rs.started_at,\n    time_bucket('1 minute', sl.ts) AS bucket,\n    MAX(CASE WHEN sl.field = 'BatteryLevel' THEN COALESCE(sl.float_value, sl.int_value::float8) END) AS soc,\n    MAX(CASE WHEN sl.field IN ('ACChargingPower', 'DCChargingPower') THEN COALESCE(sl.float_value, sl.int_value::float8) END) AS power_kw\n  FROM recent_sessions rs\n  JOIN signal_log sl\n    ON sl.vehicle_id = rs.vehicle_id\n    AND sl.field IN ('BatteryLevel', 'ACChargingPower', 'DCChargingPower')\n    AND sl.ts BETWEEN rs.started_at AND rs.ended_at\n  GROUP BY rs.id, rs.started_at, time_bucket('1 minute', sl.ts)\n)\nSELECT\n  soc AS \"SoC %\",\n  COALESCE(power_kw, 0) AS \"Power (kW)\",\n  TO_CHAR(started_at, 'YYYY-MM-DD HH24:MI') AS \"Session\"\nFROM bucketed\nWHERE soc IS NOT NULL\nORDER BY soc",
          "refId": "A"
        }
      ],
      "title": "⚡ Charge Rate vs SoC Curve",
      "type": "xychart",
      "transparent": false
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TESLASYNC_POSTGRESQL"
