      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH daily_capacity AS (\n  SELECT\n    time_bucket('1 day', ts) AS day,\n    AVG(COALESCE(float_value, int_value::float8))\n      FILTER (WHERE field = 'EnergyRemaining')\n      / NULLIF(\n          AVG(COALESCE(float_value, int_value::float8))\n            FILTER (WHERE field = 'BatteryLevel'),\n          0\n        ) * 100.0 AS estimated_capacity\n  FROM signal_log\n  WHERE vehicle_id = ${vehicle_id}\n    AND field IN ('EnergyRemaining', 'BatteryLevel')\n    AND COALESCE(float_value, int_value::float8) > 0\n  GROUP BY 1\n),\nindexed AS (\n  SELECT\n    day,\n    estimated_capacity,\n    MAX(estimated_capacity) OVER () AS best_observed_capacity,\n    ROW_NUMBER() OVER (ORDER BY day DESC) AS recency\n  FROM daily_capacity\n  WHERE estimated_capacity IS NOT NULL\n)\nSELECT\n  day AS time,\n  ROUND((\n    100.0 * estimated_capacity / NULLIF(best_observed_capacity, 0)\n  )::numeric, 1) AS value\nFROM indexed\nWHERE recency = 1",
          "refId": "A"
        }
      ],
      "title": "Observed Capacity Index",
      "description": "Latest EnergyRemaining/BatteryLevel capacity estimate normalized to the best observed daily estimate. This is a relative index, not an absolute battery State of Health measurement.",
      "type": "stat",
      "transparent": false
    },
