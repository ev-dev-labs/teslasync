          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  cs.started_at AS \"Date\",\n  COALESCE(NULLIF(BTRIM(cs.start_place), ''), g.name, 'Unknown') AS \"Location\",\n  ROUND((cs.total_energy_added_wh / 1000.0)::numeric, 1) AS \"kWh\",\n  ROUND(cs.cost_decimal::numeric, 2) AS \"Cost\",\n  NULLIF(BTRIM(cs.cost_currency::text), '') AS \"Currency\"\nFROM charging_sessions cs\nLEFT JOIN geofences g ON g.id = cs.geofence_id\nWHERE cs.vehicle_id = ${vehicle_id}\nORDER BY cs.started_at DESC\nLIMIT 10",
          "refId": "A"
        }
      ],
