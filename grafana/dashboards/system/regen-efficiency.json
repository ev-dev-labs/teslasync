      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  started_at AS \"Date\",\n  ROUND(convert_distance(distance_m / 1609.344)::numeric, 1) AS \"Distance (${unit_length})\",\n  ROUND(convert_speed(avg_speed_mps * 2.2369362920544)::numeric, 0) AS \"Avg Speed\",\n  ROUND((regen_energy_wh / 1000.0)::numeric, 2) AS \"Regen kWh\",\n  ROUND(((energy_used_wh + regen_energy_wh) / 1000.0)::numeric, 2) AS \"Total kWh\",\n  ROUND((\n    100.0 * regen_energy_wh / NULLIF(energy_used_wh + regen_energy_wh, 0)\n  )::numeric, 1) AS \"Regen %\"\nFROM drives\nWHERE vehicle_id = ${vehicle_id}\n  AND $__timeFilter(started_at)\n  AND energy_used_wh >= 0\n  AND regen_energy_wh >= 0\nORDER BY started_at DESC\nLIMIT 30",
          "refId": "A"
        }
      ],
