      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(started_at, '1M') AS time,\n  ROUND((SUM(regen_energy_wh) / 1000.0)::numeric, 1) AS \"Regen kWh\",\n  ROUND((\n    100.0 * SUM(regen_energy_wh)\n      / NULLIF(SUM(energy_used_wh) + SUM(regen_energy_wh), 0)\n  )::numeric, 1) AS \"Regen %\"\nFROM drives\nWHERE vehicle_id = ${vehicle_id}\n  AND $__timeFilter(started_at)\n  AND energy_used_wh >= 0\n  AND regen_energy_wh >= 0\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Regen Energy Trend",
      "type": "timeseries"
    },
