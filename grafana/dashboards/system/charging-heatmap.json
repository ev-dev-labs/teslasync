          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  EXTRACT(HOUR FROM start_date) AS \"Hour\",\n  COUNT(*) AS \"Sessions\"\nFROM charging_sessions\nWHERE vehicle_id = ${vehicle_id}\n  AND $__timeFilter(start_date)\nGROUP BY EXTRACT(HOUR FROM start_date)\nORDER BY \"Hour\"",
