      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  DATE_TRUNC('day', start_date) AS time,\n  COUNT(*) AS \"Sessions\"\nFROM charging_sessions\nWHERE vehicle_id = ${vehicle_id}\n  AND $__timeFilter(start_date)\nGROUP BY DATE_TRUNC('day', start_date)\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Charging Sessions per Day",
      "type": "heatmap"
