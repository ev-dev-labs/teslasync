      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  TO_CHAR(start_date, 'Dy') AS \"Day\",\n  EXTRACT(ISODOW FROM start_date) AS day_num,\n  COUNT(*) AS \"Sessions\",\n  ROUND(SUM(COALESCE(energy_added_kwh, 0))::numeric, 1) AS \"Energy (kWh)\"\nFROM charging_sessions\nWHERE vehicle_id = ${vehicle_id}\n  AND $__timeFilter(start_date)\nGROUP BY TO_CHAR(start_date, 'Dy'), EXTRACT(ISODOW FROM start_date)\nORDER BY day_num",
          "refId": "A"
        }
      ],
      "title": "Weekday Charging Distribution",
      "type": "barchart",
      "transparent": false
