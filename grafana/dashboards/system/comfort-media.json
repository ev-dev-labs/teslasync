          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  NULL AS \"HVAC Mode\",  -- Signal not available in signal_log\n  CASE WHEN COALESCE((SELECT value_num FROM signal_log WHERE vehicle_id = ${vehicle_id} AND signal_name = 'HvacSteeringWheelHeatLevel' AND ts BETWEEN $__timeFrom() AND $__timeTo() ORDER BY ts DESC LIMIT 1), 0) > 0 THEN 'On' ELSE 'Off' END AS \"Steering Wheel Heat\",\n  NULL AS \"Auto Climate\"  -- Signal not available in signal_log",
          "refId": "A"
        }
      ],
      "title": "Climate Details",
      "type": "stat",
      "transparent": false
