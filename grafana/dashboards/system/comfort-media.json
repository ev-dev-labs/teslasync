          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time,\n  0 AS \"AC Enabled\",  -- Signal not available in signal_log\n  CASE WHEN MAX(value_text) FILTER (WHERE signal_name = 'DefrostMode') IS NOT NULL AND MAX(value_text) FILTER (WHERE signal_name = 'DefrostMode') != '' THEN 1 ELSE 0 END AS \"Defrost\",\n  CASE WHEN bool_or(value_bool) FILTER (WHERE signal_name = 'RearDefrostEnabled') THEN 1 ELSE 0 END AS \"Rear Defrost\",\n  CASE WHEN bool_or(value_bool) FILTER (WHERE signal_name = 'WiperHeatEnabled') THEN 1 ELSE 0 END AS \"Wiper Heat\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND signal_name IN ('DefrostMode', 'RearDefrostEnabled', 'WiperHeatEnabled')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY ts\nORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "HVAC Mode History",
      "type": "timeseries",
      "transparent": false
