            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  (SELECT value_num FROM signal_log WHERE vehicle_id = ${vehicle_id} AND signal_name = 'SeatHeaterLeft' AND ts BETWEEN $__timeFrom() AND $__timeTo() ORDER BY ts DESC LIMIT 1) AS \"Left\",\n  (SELECT value_num FROM signal_log WHERE vehicle_id = ${vehicle_id} AND signal_name = 'SeatHeaterRight' AND ts BETWEEN $__timeFrom() AND $__timeTo() ORDER BY ts DESC LIMIT 1) AS \"Right\",\n  (SELECT value_num FROM signal_log WHERE vehicle_id = ${vehicle_id} AND signal_name = 'SeatHeaterRearLeft' AND ts BETWEEN $__timeFrom() AND $__timeTo() ORDER BY ts DESC LIMIT 1) AS \"Rear Left\",\n  (SELECT value_num FROM signal_log WHERE vehicle_id = ${vehicle_id} AND signal_name = 'SeatHeaterRearCenter' AND ts BETWEEN $__timeFrom() AND $__timeTo() ORDER BY ts DESC LIMIT 1) AS \"Rear Center\",\n  (SELECT value_num FROM signal_log WHERE vehicle_id = ${vehicle_id} AND signal_name = 'SeatHeaterRearRight' AND ts BETWEEN $__timeFrom() AND $__timeTo() ORDER BY ts DESC LIMIT 1) AS \"Rear Right\"",
          "refId": "A"
        }
      ],
      "title": "Seat Heaters",
      "type": "stat",
      "transparent": false
    },
