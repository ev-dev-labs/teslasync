          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  CASE WHEN hvac_power THEN 'On' WHEN hvac_power = false THEN 'Off' ELSE 'Unknown' END AS \"HVAC\",\n  CASE WHEN hvac_steering_wheel_heat_level > 0 THEN 'On' WHEN hvac_steering_wheel_heat_level = 0 THEN 'Off' ELSE 'Unknown' END AS \"Steering Wheel Heat\",\n  CASE WHEN hvac_auto_mode THEN 'On' WHEN hvac_auto_mode = false THEN 'Off' ELSE 'Unknown' END AS \"Auto Climate\"\nFROM climate_snapshots\nWHERE vehicle_id = ${vehicle_id}\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\n  AND (hvac_power IS NOT NULL OR hvac_steering_wheel_heat_level IS NOT NULL OR hvac_auto_mode IS NOT NULL)\nORDER BY ts DESC\nLIMIT 1",
          "refId": "A"
        }
      ],
      "title": "Climate Details",
      "type": "stat",
      "transparent": false
    },
