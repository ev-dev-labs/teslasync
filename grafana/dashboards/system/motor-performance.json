      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH motor AS (\n  SELECT\n    AVG(front_torque_nm) AS avg_torque_nm,\n    MAX(front_torque_nm) AS peak_torque_nm,\n    AVG(rear_stator_c) AS avg_stator_c\n  FROM motor_snapshots\n  WHERE vehicle_id = ${vehicle_id}\n    AND ts BETWEEN $__timeFrom() AND $__timeTo()\n), dynamics AS (\n  SELECT MAX(ABS(lateral_acceleration_mps2)) / 9.80665 AS peak_lateral_g\n  FROM drive_telemetry\n  WHERE vehicle_id = ${vehicle_id}\n    AND ts BETWEEN $__timeFrom() AND $__timeTo()\n)\nSELECT\n  motor.avg_torque_nm AS \"Avg Torque (Nm)\",\n  motor.peak_torque_nm AS \"Peak Torque (Nm)\",\n  convert_temp(motor.avg_stator_c) AS \"Avg Stator Temp\",\n  dynamics.peak_lateral_g AS \"Peak Lateral G\"\nFROM motor CROSS JOIN dynamics",
          "refId": "A"
        }
      ],
      "title": "Motor Stats",
      "type": "stat",
      "transparent": false
    }
