          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time,\n  convert_pressure_pa(front_left_pa) AS \"Front Left\",\n  convert_pressure_pa(front_right_pa) AS \"Front Right\",\n  convert_pressure_pa(rear_left_pa) AS \"Rear Left\",\n  convert_pressure_pa(rear_right_pa) AS \"Rear Right\"\nFROM tire_pressure_snapshots\nWHERE vehicle_id = ${vehicle_id}\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\n  AND (front_left_pa IS NOT NULL OR front_right_pa IS NOT NULL OR rear_left_pa IS NOT NULL OR rear_right_pa IS NOT NULL)\nORDER BY ts",
          "refId": "A"
        }
      ],
