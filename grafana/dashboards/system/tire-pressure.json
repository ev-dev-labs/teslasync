    {
      "id": 6,
      "type": "table",
      "title": "TPMS Warnings History",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TESLASYNC_POSTGRESQL"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "rawSql": "SELECT ts AS \"Time\",\n  COALESCE(last(str_value, ts) FILTER (WHERE field = 'TpmsHardWarnings'), 'None') AS \"Hard Warnings\",\n  COALESCE(last(str_value, ts) FILTER (WHERE field = 'TpmsSoftWarnings'), 'None') AS \"Soft Warnings\",\n  MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'TpmsLastSeenPressureTimeFl') AS \"FL Last Seen\",\n  MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'TpmsLastSeenPressureTimeFr') AS \"FR Last Seen\",\n  MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'TpmsLastSeenPressureTimeRl') AS \"RL Last Seen\",\n  MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'TpmsLastSeenPressureTimeRr') AS \"RR Last Seen\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND field IN ('TpmsHardWarnings', 'TpmsSoftWarnings', 'TpmsLastSeenPressureTimeFl', 'TpmsLastSeenPressureTimeFr', 'TpmsLastSeenPressureTimeRl', 'TpmsLastSeenPressureTimeRr')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY ts\nHAVING last(str_value, ts) FILTER (WHERE field = 'TpmsHardWarnings') IS NOT NULL\n   OR last(str_value, ts) FILTER (WHERE field = 'TpmsSoftWarnings') IS NOT NULL\n   OR MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'TpmsLastSeenPressureTimeFl') IS NOT NULL\nORDER BY ts DESC\nLIMIT 30",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          }
        }
      ],
