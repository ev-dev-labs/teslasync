        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time,\n  convert_pressure(MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'TpmsPressureFl')) AS \"Front Left\",\n  convert_pressure(MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'TpmsPressureFr')) AS \"Front Right\",\n  convert_pressure(MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'TpmsPressureRl')) AS \"Rear Left\",\n  convert_pressure(MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'TpmsPressureRr')) AS \"Rear Right\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND field IN ('TpmsPressureFl', 'TpmsPressureFr', 'TpmsPressureRl', 'TpmsPressureRr')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY ts\nORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Tire Pressure Over Time",
      "type": "timeseries",
      "transparent": false
    },
