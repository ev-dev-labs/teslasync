    {
      "id": 6,
      "type": "table",
      "title": "TPMS Warning Changes",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TESLASYNC_POSTGRESQL"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "rawSql": "SELECT\n  ts AS \"Time\",\n  CASE\n    WHEN field LIKE '%FrontLeft' THEN 'Front Left'\n    WHEN field LIKE '%FrontRight' THEN 'Front Right'\n    WHEN field LIKE '%RearLeft' THEN 'Rear Left'\n    WHEN field LIKE '%RearRight' THEN 'Rear Right'\n  END AS \"Tire\",\n  CASE\n    WHEN field LIKE 'TpmsHardWarnings%' THEN 'Hard'\n    ELSE 'Soft'\n  END AS \"Severity\",\n  CASE WHEN bool_value THEN 'Active' ELSE 'Cleared' END AS \"State\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\n  AND field IN (\n    'TpmsHardWarningsFrontLeft', 'TpmsHardWarningsFrontRight',\n    'TpmsHardWarningsRearLeft', 'TpmsHardWarningsRearRight',\n    'TpmsSoftWarningsFrontLeft', 'TpmsSoftWarningsFrontRight',\n    'TpmsSoftWarningsRearLeft', 'TpmsSoftWarningsRearRight'\n  )\n  AND bool_value IS NOT NULL\nORDER BY ts DESC\nLIMIT 100",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          }
        }
      ],
