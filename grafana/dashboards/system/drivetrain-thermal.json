          "rawSql": "SELECT\n  convert_temp(MAX(front_stator_c)) AS \"Front Stator\",\n  convert_temp(MAX(rear_stator_c)) AS \"Rear Stator\",\n  convert_temp(MAX(front_heatsink_c)) AS \"Front Heatsink\",\n  convert_temp(MAX(rear_heatsink_c)) AS \"Rear Heatsink\",\n  convert_temp(MAX(front_inverter_c)) AS \"Front Inverter\",\n  convert_temp(MAX(rear_inverter_c)) AS \"Rear Inverter\"\nFROM motor_snapshots\nWHERE vehicle_id = ${vehicle_id}\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()",
