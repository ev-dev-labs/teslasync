          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  convert_temp(MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'DiStatorTempF')) AS \"Front Stator\",\n  convert_temp(MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'DiStatorTempR')) AS \"Rear Stator\",\n  convert_temp(MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'DiHeatsinkTF')) AS \"Front Heatsink\",\n  convert_temp(MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'DiHeatsinkTR')) AS \"Rear Heatsink\",\n  convert_temp(MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'DiInverterTF')) AS \"Front Inverter\",\n  convert_temp(MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'DiInverterTR')) AS \"Rear Inverter\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND field IN ('DiStatorTempF', 'DiStatorTempR', 'DiHeatsinkTF', 'DiHeatsinkTR', 'DiInverterTF', 'DiInverterTR')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()",
          "refId": "A"
        }
      ],
