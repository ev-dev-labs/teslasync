            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.severity AS \"Severity\", COUNT(*)::bigint AS \"Count\"\nFROM alerts a\nWHERE a.vehicle_id = ${vehicle_id}\n  AND a.created_at >= $__timeFrom()::timestamptz\n  AND a.created_at <= $__timeTo()::timestamptz\nGROUP BY a.severity\nORDER BY CASE a.severity WHEN 'critical' THEN 1 WHEN 'warning' THEN 2 WHEN 'info' THEN 3 ELSE 4 END",
          "refId": "A"
        }
      ],
