      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  a.created_at AS time,\n  CASE WHEN a.severity = 'critical' THEN NULL::double precision END AS \"Critical\",\n  CASE WHEN a.severity = 'warning' THEN NULL::double precision END AS \"Warning\",\n  CASE WHEN a.severity = 'info' THEN NULL::double precision END AS \"Info\",\n  a.title AS \"Signal\",\n  a.type AS \"Type\"\nFROM alerts a\nWHERE a.vehicle_id = ${vehicle_id}\n  AND a.created_at >= $__timeFrom()::timestamptz\n  AND a.created_at <= $__timeTo()::timestamptz\nORDER BY a.created_at",
          "refId": "A"
        }
      ],
      "title": "Anomaly Timeline",
      "type": "timeseries",
      "transparent": false
    },
