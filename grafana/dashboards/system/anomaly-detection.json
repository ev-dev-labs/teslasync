          "rawSql": "SELECT\n  a.created_at AS \"Time\",\n  a.title AS \"Signal\",\n  a.type AS \"Type\",\n  a.severity AS \"Severity\",\n  NULL::numeric AS \"Z-Score\",\n  a.message AS \"Description\"\nFROM alerts a\nWHERE a.vehicle_id = ${vehicle_id}\n  AND a.created_at >= $__timeFrom()::timestamptz\n  AND a.created_at <= $__timeTo()::timestamptz\nORDER BY a.created_at DESC LIMIT 50",
