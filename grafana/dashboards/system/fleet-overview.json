      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  v.display_name AS \"🚗 Vehicle\",\n  v.model AS \"🚗 Model\",\n  (SELECT vs.to_state FROM fsm_transitions vs WHERE vs.vehicle_id = v.id AND vs.fsm_name = 'vehicle' ORDER BY vs.ts DESC LIMIT 1) AS \"📊 State\",\n  (SELECT ROUND(convert_distance_m(COALESCE(sl.float_value, sl.int_value::float8))::numeric, 1) FROM signal_log sl WHERE sl.vehicle_id = v.id AND sl.field = 'Odometer' AND sl.ts BETWEEN $__timeFrom() AND $__timeTo() ORDER BY sl.ts DESC LIMIT 1) AS \"📏 Odometer\",\n  (SELECT COALESCE(sl.float_value, sl.int_value::float8) FROM signal_log sl WHERE sl.vehicle_id = v.id AND sl.field = 'BatteryLevel' AND sl.ts BETWEEN $__timeFrom() AND $__timeTo() ORDER BY sl.ts DESC LIMIT 1) AS \"🔋 Battery %\",\n  (SELECT COUNT(*) FROM drives d WHERE d.vehicle_id = v.id) AS \"🛣️ Total Drives\",\n  (SELECT ROUND(convert_distance(SUM((d2.distance_m / 1609.344)))::numeric, 1) FROM drives d2 WHERE d2.vehicle_id = v.id) AS \"📏 Total Dist\",\n  (SELECT COUNT(*) FROM charging_sessions cs WHERE cs.vehicle_id = v.id) AS \"⚡ Charges\",\n  (SELECT ROUND(SUM((cs2.total_energy_added_wh / 1000.0))::numeric, 1) FROM charging_sessions cs2 WHERE cs2.vehicle_id = v.id) AS \"⚡ Total kWh\",\n  (SELECT su.version FROM software_updates su WHERE su.vehicle_id = v.id AND su.status = 'installed' ORDER BY su.installed_at DESC LIMIT 1) AS \"📦 Version\"\nFROM vehicles v\nORDER BY v.display_name",
          "refId": "A"
        }
      ],
      "title": "Fleet Summary",
      "type": "table",
      "transparent": false
    },
