          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  AVG(value_num) FILTER (WHERE signal_name = 'BatteryLevel') AS \"🔋 Avg SOC\",\n  AVG(value_num) FILTER (WHERE signal_name = 'PackVoltage') AS \"⚡ Avg Pack V\",\n  AVG(value_num) FILTER (WHERE signal_name = 'PackCurrent') AS \"🔌 Avg Pack A\",\n  AVG(value_num) FILTER (WHERE signal_name = 'EnergyRemaining') AS \"🔋 Energy kWh\",\n  MAX(value_num) FILTER (WHERE signal_name = 'DCChargingPower') AS \"⚡ Peak DC kW\",\n  MAX(value_num) FILTER (WHERE signal_name = 'ACChargingPower') AS \"🔌 Peak AC kW\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND signal_name IN ('BatteryLevel', 'PackVoltage', 'PackCurrent', 'EnergyRemaining', 'DCChargingPower', 'ACChargingPower')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()",
          "refId": "A"
        }
      ],
      "title": "Energy Stats",
      "type": "stat",
      "transparent": false
    },
