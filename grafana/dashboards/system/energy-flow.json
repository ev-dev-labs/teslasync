            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(last(value_text, ts) FILTER (WHERE signal_name = 'BMSState'), 'N/A') AS \"BMS State\",\n  CASE WHEN last(value_bool, ts) FILTER (WHERE signal_name = 'BmsFullchargecomplete') THEN 'Yes' ELSE 'No' END AS \"Full Charge\",\n  CASE WHEN last(value_bool, ts) FILTER (WHERE signal_name = 'BatteryHeaterOn') THEN 'On' ELSE 'Off' END AS \"Battery Heater\",\n  ROUND(last(value_num, ts) FILTER (WHERE signal_name = 'IsolationResistance')::numeric) AS \"Isolation Ω\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND signal_name IN ('BMSState', 'BmsFullchargecomplete', 'BatteryHeaterOn', 'IsolationResistance')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()",
          "refId": "A"
        }
      ],
      "title": "BMS & System",
      "type": "stat",
      "transparent": false
    },
