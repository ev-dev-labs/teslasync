          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(last(value_text, ts) FILTER (WHERE signal_name = 'PowershareStatus'), 'N/A') AS \"Status\",\n  COALESCE(last(value_text, ts) FILTER (WHERE signal_name = 'PowershareType'), 'N/A') AS \"Type\",\n  last(value_num, ts) FILTER (WHERE signal_name = 'PowershareHoursLeft') AS \"Hours Left\",\n  ROUND(last(value_num, ts) FILTER (WHERE signal_name = 'PowershareInstantaneousPowerKW')::numeric, 1) AS \"Power kW\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND signal_name IN ('PowershareStatus', 'PowershareType', 'PowershareHoursLeft', 'PowershareInstantaneousPowerKW')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\nHAVING last(value_text, ts) FILTER (WHERE signal_name = 'PowershareStatus') IS NOT NULL",
          "refId": "A"
        }
      ],
      "title": "Powershare Status",
