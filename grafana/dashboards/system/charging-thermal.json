        {
          "datasource": {
            "type": "postgres",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(ts, '5m') AS \"time\",\n  AVG(CASE WHEN field = 'ModuleTempMax' THEN convert_temp(float_value) END) AS \"Pack temp\",\n  AVG(CASE WHEN field = 'DCChargingPower' THEN float_value END) AS \"DC W\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND field IN ('ModuleTempMax', 'DCChargingPower') AND $__timeFilter(ts)\nGROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Pack temp vs DC power",
      "transparent": true,
      "type": "timeseries"
    },
