      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.started_at AS \"time\", c.id AS \"ID\",\n  c.charger_type AS \"Charger\",\n  convert_temp(MAX(s.float_value)) AS \"Max pack\",\n  ROUND(MAX(dc.float_value)::numeric, 0) AS \"Peak DC W\"\nFROM charging_sessions c\nJOIN signal_log s ON s.vehicle_id = c.vehicle_id AND s.field = 'ModuleTempMax'\n  AND s.ts >= c.started_at AND s.ts <= COALESCE(c.ended_at, NOW())\nLEFT JOIN signal_log dc ON dc.vehicle_id = c.vehicle_id\n  AND dc.field = 'DCChargingPower'\n  AND dc.ts >= c.started_at AND dc.ts <= COALESCE(c.ended_at, NOW())\nWHERE c.vehicle_id = ${vehicle_id} AND $__timeFilter(c.started_at)\nGROUP BY c.started_at, c.id, c.charger_type\nORDER BY \"Max pack\" DESC NULLS LAST LIMIT 200",
          "refId": "A"
        }
      ],
      "title": "Hottest sessions",
      "transparent": true,
      "type": "table"
    },
