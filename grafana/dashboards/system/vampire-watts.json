          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH days AS (\n  SELECT date_trunc('day', ts) AS d,\n    MAX(float_value) FILTER (WHERE field = 'EnergyRemaining') AS e_max,\n    MIN(float_value) FILTER (WHERE field = 'EnergyRemaining') AS e_min,\n    COUNT(*) FILTER (WHERE field = 'Gear' AND str_value = 'P') AS p_n\n  FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND $__timeFilter(ts)\n    AND field IN ('EnergyRemaining', 'Gear')\n  GROUP BY 1\n)\nSELECT d AS \"time\", ROUND((e_max - e_min)::numeric, 0) AS \"Parked Wh\",\n  p_n AS \"Park samples\"\nFROM days WHERE p_n > 0 AND e_max IS NOT NULL\nORDER BY d DESC LIMIT 200",
          "refId": "A"
