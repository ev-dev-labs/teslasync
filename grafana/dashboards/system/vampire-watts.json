          "rawQuery": true,
          "rawSql": "WITH hours AS (\n  SELECT date_trunc('hour', ts) AS h,\n    COUNT(*) FILTER (WHERE field = 'Gear' AND str_value = 'P') AS p_n,\n    MAX(CASE WHEN field = 'SentryMode' AND str_value IS DISTINCT FROM 'Off'\n      THEN 1 ELSE 0 END) AS sentry\n  FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND $__timeFilter(ts)\n    AND field IN ('Gear', 'SentryMode')\n  GROUP BY 1\n)\nSELECT COUNT(*) AS \"Sentry h\" FROM hours WHERE p_n > 0 AND sentry = 1",
