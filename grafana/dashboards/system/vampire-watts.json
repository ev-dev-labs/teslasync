      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH hours AS (\n  SELECT date_trunc('hour', ts) AS h,\n    MAX(float_value) FILTER (WHERE field = 'EnergyRemaining') AS e_max,\n    MIN(float_value) FILTER (WHERE field = 'EnergyRemaining') AS e_min,\n    COUNT(*) FILTER (WHERE field = 'Gear' AND str_value = 'P') AS p_n,\n    COUNT(*) FILTER (WHERE field = 'Gear' AND str_value IS DISTINCT FROM 'P') AS other_n\n  FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND $__timeFilter(ts)\n    AND field IN ('EnergyRemaining', 'Gear')\n  GROUP BY 1\n)\nSELECT ROUND(AVG((e_max - e_min))::numeric, 1) AS \"Avg W\"\nFROM hours WHERE p_n > 0 AND other_n = 0 AND e_max IS NOT NULL",
          "refId": "A"
        }
      ],
      "title": "Avg parked watts",
      "transparent": true,
      "type": "stat"
