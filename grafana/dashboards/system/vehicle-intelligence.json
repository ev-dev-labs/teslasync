          "rawSql": "SELECT\n  $__timeGroup(ts, '1m') AS time,\n  MAX(COALESCE(float_value, int_value::float8)) AS \"Tonneau Open %\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND field = 'TonneauOpenPercent'\n  AND COALESCE(float_value, int_value::float8) IS NOT NULL\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY 1\nORDER BY 1",
