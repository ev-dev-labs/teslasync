            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\n  SELECT DISTINCT ON (field) field, str_value, bool_value, int_value, float_value, time_value, ts\n  FROM signal_log\n  WHERE vehicle_id = ${vehicle_id}\n    AND field IN ('DestinationName', 'RouteLastUpdated', 'RouteTrafficMinutesDelay')\n  ORDER BY field, ts DESC\n)\nSELECT field AS \"Setting\",\n  COALESCE(str_value, bool_value::text, int_value::text, float_value::text, time_value::text) AS \"Value\",\n  ts AS \"Last Updated\"\nFROM latest\nWHERE COALESCE(str_value, bool_value::text, int_value::text, float_value::text, time_value::text) IS NOT NULL\nORDER BY field;",
          "refId": "A"
        }
      ],
