          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(ts, '1m') AS time,\n  MAX(CASE WHEN bool_value THEN 1 ELSE 0 END) FILTER (WHERE field = 'LightsHazardsActive') AS \"Hazards Active\",\n  MAX(CASE WHEN bool_value THEN 1 ELSE 0 END) FILTER (WHERE field = 'LightsHighBeams') AS \"High Beams\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND field IN ('LightsHazardsActive', 'LightsHighBeams')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
