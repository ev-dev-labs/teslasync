      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest_valet AS (\n  SELECT to_state, ts\n  FROM security_events\n  WHERE vehicle_id = ${vehicle_id} AND event_type = 'valet_mode_enabled'\n  ORDER BY ts DESC\n  LIMIT 1\n), latest_cold AS (\n  SELECT DISTINCT ON (field) field, str_value, bool_value, int_value, float_value, ts\n  FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND field IN ('PinToDriveEnabled', 'SpeedLimitMode')\n  ORDER BY field, ts DESC\n)\nSELECT 'Locked'::text AS \"Setting\", locked::text AS \"Value\", updated_at AS \"Last Updated\"\nFROM vehicle_live_state WHERE vehicle_id = ${vehicle_id} AND locked IS NOT NULL\nUNION ALL\nSELECT 'Sentry Mode', sentry_mode::text, updated_at\nFROM vehicle_live_state WHERE vehicle_id = ${vehicle_id} AND sentry_mode IS NOT NULL\nUNION ALL\nSELECT 'Valet Mode', to_state, ts FROM latest_valet\nUNION ALL\nSELECT\n  CASE field WHEN 'PinToDriveEnabled' THEN 'PIN to Drive' WHEN 'SpeedLimitMode' THEN 'Speed Limit Mode' END,\n  COALESCE(str_value, bool_value::text, int_value::text, float_value::text),\n  ts\nFROM latest_cold\nORDER BY \"Setting\";",
          "refId": "A"
        }
      ],
      "title": "Safety Settings",
      "type": "table",
      "transparent": false
    },
