      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \"Setting\", \"Value\", \"Last Updated\"\nFROM (\n  SELECT '24-Hour Time'::text AS \"Setting\", COALESCE(str_value, bool_value::text, int_value::text) AS \"Value\", ts AS \"Last Updated\"\n  FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND field = 'Setting24HourTime'\n  ORDER BY ts DESC\n  LIMIT 1\n) clock_pref\nUNION ALL\nSELECT\n  CASE unit_kind WHEN 'distance' THEN 'Distance Unit' WHEN 'temperature' THEN 'Temperature Unit' WHEN 'pressure' THEN 'Tire Pressure Unit' WHEN 'charge' THEN 'Charge Display Unit' END AS \"Setting\",\n  unit_value AS \"Value\",\n  effective_from AS \"Last Updated\"\nFROM (\n  SELECT DISTINCT ON (unit_kind) unit_kind, unit_value, effective_from\n  FROM vehicle_unit_history\n  WHERE vehicle_id = ${vehicle_id} AND unit_kind IN ('distance', 'temperature', 'pressure', 'charge')\n  ORDER BY unit_kind, effective_from DESC\n) latest_units\nORDER BY \"Setting\";",
          "refId": "A"
        }
      ],
      "title": "User Preferences",
      "type": "table",
      "transparent": false
    },
