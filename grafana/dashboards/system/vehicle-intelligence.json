            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  end_place AS \"Destination\",\n  COUNT(*) AS \"Visits\",\n  ROUND(AVG(EXTRACT(EPOCH FROM (ended_at - started_at)) / 60.0)::numeric, 1) AS \"Avg Drive (min)\"\nFROM drives\nWHERE vehicle_id = ${vehicle_id}\n  AND end_place IS NOT NULL\n  AND end_place <> ''\n  AND ended_at BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY end_place\nORDER BY COUNT(*) DESC\nLIMIT 10;",
          "refId": "A"
        }
      ],
      "title": "Top Destinations",
      "type": "table",
      "transparent": false
