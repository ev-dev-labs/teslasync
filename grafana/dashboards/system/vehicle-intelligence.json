          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\n  SELECT DISTINCT ON (field) field, str_value, bool_value, int_value, ts\n  FROM signal_log\n  WHERE vehicle_id = ${vehicle_id}\n    AND field IN ('Locked','PinToDriveEnabled','ValetModeEnabled','SentryMode','SpeedLimitMode')\n    AND ts BETWEEN $__timeFrom() AND $__timeTo()\n  ORDER BY field, ts DESC\n)\nSELECT\n  field AS \"Setting\",\n  COALESCE(str_value, bool_value::text, int_value::text) AS \"Value\",\n  ts AS \"Last Updated\"\nFROM latest\nORDER BY field;",
          "refId": "A"
        }
      ],
      "title": "Safety Settings",
