      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \"Setting\", \"Value\", \"Last Updated\"\nFROM (\n  SELECT cfg.setting AS \"Setting\", cfg.value AS \"Value\", v.updated_at AS \"Last Updated\"\n  FROM vehicles v\n  CROSS JOIN LATERAL (VALUES\n    ('Vehicle Name'::text, v.display_name),\n    ('Model'::text, v.model),\n    ('Trim'::text, v.trim_level),\n    ('Exterior Color'::text, v.color)\n  ) AS cfg(setting, value)\n  WHERE v.id = ${vehicle_id}\n  UNION ALL\n  SELECT 'Software Version', su.version::text, COALESCE(su.installed_at, su.scheduled_at, su.created_at)\n  FROM software_updates su\n  WHERE su.id = (SELECT id FROM software_updates WHERE vehicle_id = ${vehicle_id} ORDER BY (status = 'installed') DESC, COALESCE(installed_at, scheduled_at, created_at) DESC LIMIT 1)\n) config\nWHERE \"Value\" IS NOT NULL AND \"Value\" <> ''\nORDER BY \"Setting\";",
          "refId": "A"
        }
      ],
      "title": "Vehicle Config",
      "type": "table",
      "transparent": false
    },
