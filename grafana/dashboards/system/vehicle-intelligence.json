          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(installed_at, scheduled_at, created_at) AS time, version AS \"Version\"\nFROM software_updates\nWHERE vehicle_id = ${vehicle_id}\n  AND version IS NOT NULL\nORDER BY (status = 'installed') DESC, COALESCE(installed_at, scheduled_at, created_at) DESC\nLIMIT 1;",
          "refId": "A"
        }
      ],
      "title": "Software Updates",
