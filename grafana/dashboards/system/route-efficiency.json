            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  start_place || ' → ' || end_place AS \"Route\",\n  COUNT(*) AS \"Trips\",\n  ROUND(AVG(distance_m / 1000.0)::numeric, 1) AS \"Avg Dist (km)\",\n  ROUND(MIN(energy_used_wh / (distance_m / 1000.0))::numeric, 0) AS \"Best Wh/km\",\n  ROUND(AVG(energy_used_wh / (distance_m / 1000.0))::numeric, 0) AS \"Avg Wh/km\",\n  ROUND(MAX(energy_used_wh / (distance_m / 1000.0))::numeric, 0) AS \"Worst Wh/km\"\nFROM drives\nWHERE vehicle_id = ${vehicle_id}\n  AND $__timeFilter(started_at)\n  AND distance_m > 1609.344\n  AND energy_used_wh > 0\n  AND NULLIF(BTRIM(start_place), '') IS NOT NULL\n  AND NULLIF(BTRIM(end_place), '') IS NOT NULL\nGROUP BY start_place, end_place\nHAVING COUNT(*) >= 2\nORDER BY COUNT(*) DESC",
          "refId": "A"
        }
      ],
      "title": "Top Routes",
      "type": "table",
      "transparent": false
