          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH routes AS (\n  SELECT\n    start_place || ' → ' || end_place AS route,\n    energy_used_wh / (distance_m / 1000.0) AS wh_per_km\n  FROM drives\n  WHERE vehicle_id = ${vehicle_id}\n    AND $__timeFilter(started_at)\n    AND distance_m > 1609.344\n    AND energy_used_wh > 0\n    AND NULLIF(BTRIM(start_place), '') IS NOT NULL\n    AND NULLIF(BTRIM(end_place), '') IS NOT NULL\n)\nSELECT\n  route AS \"Route\",\n  ROUND(MIN(wh_per_km)::numeric, 0) AS \"Best\",\n  ROUND(AVG(wh_per_km)::numeric, 0) AS \"Average\",\n  ROUND(MAX(wh_per_km)::numeric, 0) AS \"Worst\"\nFROM routes\nGROUP BY route\nHAVING COUNT(*) >= 3\nORDER BY COUNT(*) DESC\nLIMIT 10",
          "refId": "A"
