      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH routes AS (\n  SELECT\n    start_place || ' → ' || end_place AS route,\n    COUNT(*) AS trips,\n    AVG(energy_used_wh / (distance_m / 1000.0)) AS avg_wh_per_km\n  FROM drives\n  WHERE vehicle_id = ${vehicle_id}\n    AND $__timeFilter(started_at)\n    AND distance_m > 1609.344\n    AND energy_used_wh > 0\n    AND NULLIF(BTRIM(start_place), '') IS NOT NULL\n    AND NULLIF(BTRIM(end_place), '') IS NOT NULL\n  GROUP BY start_place, end_place\n  HAVING COUNT(*) >= 3\n)\nSELECT\n  route AS \"Route\",\n  ROUND(avg_wh_per_km::numeric, 0) AS \"Avg Wh/km\",\n  trips AS \"Trips\"\nFROM routes\nORDER BY avg_wh_per_km\nLIMIT 15",
          "refId": "A"
        }
      ],
      "title": "Efficiency by Route (Wh/km)",
      "type": "barchart",
      "transparent": false
    },
