      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(start_address, 'Unknown') || ' → ' || COALESCE(end_address, 'Unknown') AS \"Route\",\n  ROUND(AVG(CASE WHEN distance > 0 THEN energy_used_kwh * 1000 / distance END)::numeric, 0) AS \"Avg Wh/km\",\n  COUNT(*) AS \"Trips\"\nFROM drives\nWHERE vehicle_id = ${vehicle_id}\n  AND $__timeFilter(start_date)\n  AND distance > 1\nGROUP BY start_address, end_address\nHAVING COUNT(*) >= 3\nORDER BY \"Avg Wh/km\"\nLIMIT 15",
          "refId": "A"
        }
      ],
      "title": "Efficiency by Route (Wh/km)",
      "type": "barchart",
      "transparent": false
