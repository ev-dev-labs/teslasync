          "rawQuery": true,
          "rawSql": "SELECT\n  convert_temp((SELECT cs.inside_temp_c\n   FROM climate_snapshots cs\n   WHERE cs.vehicle_id = ${vehicle_id}\n     AND cs.inside_temp_c IS NOT NULL\n     AND cs.ts BETWEEN $__timeFrom() AND $__timeTo()\n   ORDER BY cs.ts DESC LIMIT 1)) AS \"Cabin\",\n  convert_temp((SELECT cs.outside_temp_c\n   FROM climate_snapshots cs\n   WHERE cs.vehicle_id = ${vehicle_id}\n     AND cs.outside_temp_c IS NOT NULL\n     AND cs.ts BETWEEN $__timeFrom() AND $__timeTo()\n   ORDER BY cs.ts DESC LIMIT 1)) AS \"Outside\",\n  CASE (SELECT cs.hvac_power\n   FROM climate_snapshots cs\n   WHERE cs.vehicle_id = ${vehicle_id}\n     AND cs.hvac_power IS NOT NULL\n     AND cs.ts BETWEEN $__timeFrom() AND $__timeTo()\n   ORDER BY cs.ts DESC LIMIT 1)\n    WHEN TRUE THEN 'On' WHEN FALSE THEN 'Off' ELSE 'Unknown'\n  END AS \"HVAC State\",\n  (SELECT cs.hvac_fan_speed\n   FROM climate_snapshots cs\n   WHERE cs.vehicle_id = ${vehicle_id}\n     AND cs.hvac_fan_speed IS NOT NULL\n     AND cs.ts BETWEEN $__timeFrom() AND $__timeTo()\n   ORDER BY cs.ts DESC LIMIT 1) AS \"Fan Speed\"",
