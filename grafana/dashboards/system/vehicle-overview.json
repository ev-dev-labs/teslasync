      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH live AS (\n  SELECT locked, sentry_mode\n  FROM vehicle_live_state\n  WHERE vehicle_id = ${vehicle_id}\n  LIMIT 1\n), latest_doors AS (\n  SELECT DISTINCT ON (field) field, bool_value\n  FROM signal_log\n  WHERE vehicle_id = ${vehicle_id}\n    AND field IN ('DoorStateDriverFront', 'DoorStateDriverRear',\n                  'DoorStatePassengerFront', 'DoorStatePassengerRear',\n                  'DoorStateFrontTrunk', 'DoorStateRearTrunk')\n    AND bool_value IS NOT NULL\n  ORDER BY field, ts DESC\n), doors AS (\n  SELECT CASE\n    WHEN COUNT(*) = 0 THEN 'Unknown'\n    WHEN BOOL_OR(bool_value) THEN 'Open'\n    WHEN COUNT(*) = 6 THEN 'Closed'\n    ELSE 'Unknown (partial)'\n  END AS door_status\n  FROM latest_doors\n)\nSELECT\n  COALESCE((SELECT CASE locked WHEN TRUE THEN 'Locked' WHEN FALSE THEN 'Unlocked' ELSE 'Unknown' END FROM live), 'Unknown') AS \"🔒 Lock\",\n  COALESCE((SELECT CASE sentry_mode WHEN TRUE THEN 'Active' WHEN FALSE THEN 'Off' ELSE 'Unknown' END FROM live), 'Unknown') AS \"🛡️ Sentry\",\n  (SELECT door_status FROM doors) AS \"🚪 Doors\"",
          "refId": "A"
        }
      ],
      "title": "Security Status",
      "type": "stat",
      "transparent": false
    }
