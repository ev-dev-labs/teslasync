          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT d.started_at AS \"📅 Date\",\n  COALESCE(d.start_place, 'Unknown') AS \"📍 From\",\n  COALESCE(d.end_place, 'Unknown') AS \"📍 To\",\n  ROUND(convert_distance((d.distance_m / 1609.344))::numeric, 1) AS \"📏 Distance\",\n  ROUND((d.duration_s / 60.0)::numeric) AS \"⏱️ Duration\",\n  d.start_soc_pct AS \"🔋 Start %\",\n  d.end_soc_pct AS \"🔋 End %\"\nFROM drives d\nWHERE d.vehicle_id = ${vehicle_id}\nORDER BY d.started_at DESC LIMIT 1",
