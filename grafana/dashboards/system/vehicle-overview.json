          "rawQuery": true,
          "rawSql": "SELECT\n  (SELECT ms.front_torque_nm\n   FROM motor_snapshots ms\n   WHERE ms.vehicle_id = ${vehicle_id}\n     AND ms.front_torque_nm IS NOT NULL\n     AND ms.ts BETWEEN $__timeFrom() AND $__timeTo()\n   ORDER BY ms.ts DESC LIMIT 1) AS \"Torque (Nm)\",\n  convert_temp((SELECT ms.front_stator_c\n   FROM motor_snapshots ms\n   WHERE ms.vehicle_id = ${vehicle_id}\n     AND ms.front_stator_c IS NOT NULL\n     AND ms.ts BETWEEN $__timeFrom() AND $__timeTo()\n   ORDER BY ms.ts DESC LIMIT 1)) AS \"Stator Temp\",\n  convert_speed_mps((SELECT dt.speed_mps\n   FROM drive_telemetry dt\n   WHERE dt.vehicle_id = ${vehicle_id}\n     AND dt.speed_mps IS NOT NULL\n     AND dt.ts BETWEEN $__timeFrom() AND $__timeTo()\n   ORDER BY dt.ts DESC LIMIT 1)) AS \"Speed\",\n  (SELECT dt.gear\n   FROM drive_telemetry dt\n   WHERE dt.vehicle_id = ${vehicle_id}\n     AND dt.gear IS NOT NULL\n     AND dt.ts BETWEEN $__timeFrom() AND $__timeTo()\n   ORDER BY dt.ts DESC LIMIT 1) AS \"Gear\"",
          "refId": "A"
