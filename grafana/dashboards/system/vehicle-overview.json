          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT display_name AS \"🚗 Name\", model AS \"🚗 Model\", trim_level AS \"✨ Trim\", vin AS \"🔑 VIN\",\n  color AS \"🎨 Color\",\n  COALESCE((SELECT sl.str_value FROM signal_log sl WHERE sl.vehicle_id = vehicles.id AND sl.field = 'WheelType' AND sl.str_value IS NOT NULL ORDER BY sl.ts DESC LIMIT 1), 'Unknown') AS \"🛞 Wheels\",\n  (SELECT vs.to_state FROM fsm_transitions vs WHERE vs.vehicle_id = vehicles.id AND vs.fsm_name = 'vehicle' ORDER BY vs.ts DESC LIMIT 1) AS \"📊 State\",\n  created_at AS \"📅 Added\"\nFROM vehicles WHERE id = ${vehicle_id}",
          "refId": "A"
        }
      ],
      "title": "Vehicle Info",
      "type": "table",
      "transparent": false
    },
