          "rawQuery": true,
          "rawSql": "SELECT\n  EXTRACT(DOW FROM started_at) AS \"dayofweek\",\n  EXTRACT(HOUR FROM started_at) AS \"hourofday\",\n  COUNT(*) AS \"count\"\nFROM charging_sessions\nWHERE vehicle_id = ${vehicle_id} AND $__timeFilter(started_at)\nGROUP BY 1, 2 ORDER BY 1, 2",
