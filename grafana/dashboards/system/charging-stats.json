      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(NULLIF(BTRIM(cs.start_place), ''), g.name, 'Unknown') AS \"📍 Location\",\n  COALESCE(NULLIF(BTRIM(cs.cost_currency::text), ''), 'Unpriced') AS \"Currency\",\n  COUNT(*) AS \"🔄 Sessions\",\n  ROUND((SUM(cs.total_energy_added_wh) / 1000.0)::numeric, 1) AS \"⚡ Total kWh\",\n  ROUND(SUM(cs.cost_decimal)::numeric, 2) AS \"💰 Total Cost\",\n  ROUND((AVG(cs.total_energy_added_wh) / 1000.0)::numeric, 1) AS \"⚡ Avg kWh\"\nFROM charging_sessions cs\nLEFT JOIN geofences g ON g.id = cs.geofence_id\nWHERE cs.vehicle_id = ${vehicle_id}\n  AND $__timeFilter(cs.started_at)\nGROUP BY\n  COALESCE(NULLIF(BTRIM(cs.start_place), ''), g.name, 'Unknown'),\n  COALESCE(NULLIF(BTRIM(cs.cost_currency::text), ''), 'Unpriced')\nORDER BY \"🔄 Sessions\" DESC\nLIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Top Charging Locations",
      "type": "table",
      "transparent": false
    }
