          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH ci AS (\n  SELECT ts, float_value AS t FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND field = 'InsideTemp' AND $__timeFilter(ts)\n), co AS (\n  SELECT ts, float_value AS t FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND field = 'OutsideTemp' AND $__timeFilter(ts)\n)\nSELECT ROUND(AVG(ci.t - co.t)::numeric, 1) AS \"Delta C\"\nFROM ci JOIN co USING (ts)",
          "refId": "A"
        }
      ],
      "title": "Avg cabin-ambient Δ",
