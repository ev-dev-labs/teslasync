      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH points AS (SELECT ts, float_value AS w FROM signal_log WHERE vehicle_id=${vehicle_id}\nAND field='HvacPower' AND $__timeFilter(ts)), intervals AS (\n  SELECT ts, w, LEAD(w) OVER (ORDER BY ts) AS next_w,\n    LEAD(ts) OVER (ORDER BY ts) AS next_ts FROM points\n)\nSELECT ROUND(SUM((w + next_w) / 2 * EXTRACT(EPOCH FROM (next_ts-ts)) / 3600.0)::numeric, 1) AS \"Observed preconditioning Wh\"\nFROM intervals WHERE next_ts > ts AND next_ts-ts <= INTERVAL '120 seconds'\nAND (SELECT p.bool_value FROM signal_log p WHERE p.vehicle_id = ${vehicle_id} AND p.field = 'PreconditioningEnabled' AND p.ts <= intervals.ts ORDER BY p.ts DESC LIMIT 1) IS TRUE\nAND NOT EXISTS (SELECT 1 FROM signal_log p WHERE p.vehicle_id=${vehicle_id}\nAND p.field='PreconditioningEnabled' AND p.ts > intervals.ts AND p.ts <= intervals.next_ts AND p.bool_value IS DISTINCT FROM TRUE)",
          "refId": "A"
        }
      ],
      "title": "Observed preconditioning Wh (partial coverage)",
      "transparent": true,
      "type": "stat"
    },
