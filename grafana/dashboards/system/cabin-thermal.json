          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(ts, '5m') AS \"time\",\n  AVG(CASE WHEN field = 'InsideTemp' THEN convert_temp(float_value) END) AS \"Cabin\",\n  AVG(CASE WHEN field = 'OutsideTemp' THEN convert_temp(float_value) END) AS \"Ambient\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id} AND field IN ('InsideTemp', 'OutsideTemp')\n  AND $__timeFilter(ts)\nGROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Cabin vs ambient",
      "transparent": true,
      "type": "timeseries"
