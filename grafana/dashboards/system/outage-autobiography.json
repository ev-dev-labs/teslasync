          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT v.display_name AS \"Vehicle\",\n  MAX(s.ts) AS \"Last seen\", COUNT(s.*) AS \"Rows\"\nFROM vehicles v\nLEFT JOIN signal_log s ON s.vehicle_id = v.id AND $__timeFilter(s.ts)\nGROUP BY v.display_name ORDER BY \"Last seen\" DESC NULLS LAST LIMIT 100",
          "refId": "A"
        }
