      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH this_week AS (\n  SELECT EXTRACT(ISODOW FROM started_at)::int AS dow,\n    SUM((distance_m / 1609.344)) AS distance_mi\n  FROM drives\n  WHERE vehicle_id = ${vehicle_id}\n    AND started_at >= DATE_TRUNC('week', NOW())\n  GROUP BY 1\n),\nlast_week AS (\n  SELECT EXTRACT(ISODOW FROM started_at)::int AS dow,\n    SUM((distance_m / 1609.344)) AS distance_mi\n  FROM drives\n  WHERE vehicle_id = ${vehicle_id}\n    AND started_at >= DATE_TRUNC('week', NOW()) - INTERVAL '7 days'\n    AND started_at < DATE_TRUNC('week', NOW())\n  GROUP BY 1\n)\nSELECT\n  TO_CHAR(DATE_TRUNC('week', NOW()) + ((d - 1) || ' days')::interval, 'Dy') AS \"Day\",\n  COALESCE(ROUND(convert_distance(tw.distance_mi)::numeric, 1), 0) AS \"This Week\",\n  COALESCE(ROUND(convert_distance(lw.distance_mi)::numeric, 1), 0) AS \"Last Week\"\nFROM generate_series(1, 7) AS d\nLEFT JOIN this_week tw ON tw.dow = d\nLEFT JOIN last_week lw ON lw.dow = d\nORDER BY d",
          "refId": "A"
        }
      ],
      "title": "Week-over-Week Comparison",
      "type": "barchart",
      "transparent": false
    },
