          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  DATE(started_at) AS time,\n  COALESCE(ROUND(convert_distance(SUM((distance_m / 1609.344)))::numeric, 1), 0) AS \"Distance (${unit_length})\",\n  COALESCE(ROUND(SUM((energy_used_wh / 1000.0))::numeric, 1), 0) AS \"Energy (kWh)\"\nFROM drives\nWHERE vehicle_id = ${vehicle_id}\n  AND started_at >= NOW() - INTERVAL '7 days'\nGROUP BY DATE(started_at)\nORDER BY time",
          "refId": "A"
        }
