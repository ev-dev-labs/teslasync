      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  'Drive' AS \"Type\",\n  started_at AS \"Start\",\n  COALESCE(NULLIF(BTRIM(start_place), ''), 'Unknown') || ' → '\n    || COALESCE(NULLIF(BTRIM(end_place), ''), 'Unknown') AS \"Activity\",\n  ROUND((duration_s / 60.0)::numeric, 0) AS \"Duration (min)\",\n  ROUND(convert_distance(distance_m / 1609.344)::numeric, 1)::text\n    || ' ${unit_length}' AS \"Details\"\nFROM drives\nWHERE vehicle_id = ${vehicle_id}\n  AND started_at >= NOW() - INTERVAL '7 days'\nUNION ALL\nSELECT\n  'Charge' AS \"Type\",\n  cs.started_at AS \"Start\",\n  COALESCE(NULLIF(BTRIM(cs.start_place), ''), g.name, 'Unknown') AS \"Activity\",\n  ROUND((EXTRACT(EPOCH FROM (cs.ended_at - cs.started_at)) / 60.0)::numeric, 0)\n    AS \"Duration (min)\",\n  ROUND((cs.total_energy_added_wh / 1000.0)::numeric, 1)::text || ' kWh'\n    AS \"Details\"\nFROM charging_sessions cs\nLEFT JOIN geofences g ON g.id = cs.geofence_id\nWHERE cs.vehicle_id = ${vehicle_id}\n  AND cs.started_at >= NOW() - INTERVAL '7 days'\nORDER BY \"Start\" DESC",
          "refId": "A"
        }
      ],
      "title": "Weekly Activity",
