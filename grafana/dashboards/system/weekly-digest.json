          "rawSql": "SELECT\n  DATE_TRUNC('day', start_date) AS time,\n  ROUND(SUM(distance)::numeric, 1) AS \"Distance (km)\",\n  ROUND(SUM(energy_used_kwh)::numeric, 1) AS \"Energy (kWh)\"\nFROM drives\nWHERE vehicle_id = ${vehicle_id}\n  AND start_date >= DATE_TRUNC('week', NOW())\nGROUP BY DATE_TRUNC('day', start_date)\nORDER BY time",
