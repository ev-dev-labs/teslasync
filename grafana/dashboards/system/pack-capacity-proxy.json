          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH e AS (\n  SELECT ts, float_value AS wh FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND field = 'EnergyRemaining' AND $__timeFilter(ts)\n  ORDER BY ts DESC LIMIT 1\n), s AS (\n  SELECT ts, float_value AS soc FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND field = 'Soc' AND $__timeFilter(ts)\n  ORDER BY ts DESC LIMIT 1\n)\nSELECT ROUND((e.wh / NULLIF(s.soc / 100.0, 0))::numeric, 0) AS \"Proxy Wh\"\nFROM e, s",
          "refId": "A"
        }
      ],
