      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH ev AS (\n  SELECT ts, float_value AS wh FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND field = 'EnergyRemaining' AND $__timeFilter(ts)\n), sv AS (\n  SELECT ts, float_value AS soc FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND field = 'Soc' AND $__timeFilter(ts)\n)\nSELECT $__timeGroup(ev.ts, '1w') AS \"time\",\n  PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY ev.wh / NULLIF(sv.soc / 100.0, 0))\n    AS \"Median proxy Wh\"\nFROM ev JOIN sv USING (ts)\nGROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Weekly median proxy",
