      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.ts AS \"time\",\n  ROUND((e.float_value / NULLIF(s.float_value / 100.0, 0))::numeric, 0) AS \"Proxy Wh\",\n  ROUND(s.float_value::numeric, 1) AS \"Soc %\",\n  t.float_value AS \"Pack C\"\nFROM signal_log e\nJOIN signal_log s ON s.vehicle_id = e.vehicle_id AND s.ts = e.ts AND s.field = 'Soc'\nLEFT JOIN signal_log t ON t.vehicle_id = e.vehicle_id AND t.ts = e.ts\n  AND t.field = 'ModuleTempMax'\nWHERE e.vehicle_id = ${vehicle_id} AND e.field = 'EnergyRemaining'\n  AND $__timeFilter(e.ts)\nORDER BY e.ts DESC LIMIT 200",
          "refId": "A"
        }
      ],
      "title": "Rest samples (latest 200)",
      "transparent": true,
      "type": "table"
    }
