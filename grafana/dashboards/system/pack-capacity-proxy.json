      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH ev AS (\n  SELECT ts, float_value AS wh FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND field = 'EnergyRemaining' AND $__timeFilter(ts)\n), sv AS (\n  SELECT ts, float_value AS soc FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND field = 'Soc' AND $__timeFilter(ts)\n)\nSELECT ev.ts AS \"time\", ev.wh / NULLIF(sv.soc / 100.0, 0) AS \"Proxy Wh\"\nFROM ev JOIN sv USING (ts)\nWHERE EXISTS (SELECT 1 FROM signal_log g\n  WHERE g.vehicle_id = ${vehicle_id} AND g.field = 'Gear'\n    AND g.ts <= ev.ts AND g.str_value = 'P'\n  ORDER BY g.ts DESC LIMIT 1)\nORDER BY ev.ts",
          "refId": "A"
        }
      ],
      "title": "Proxy Wh while parked",
      "transparent": true,
      "type": "timeseries"
