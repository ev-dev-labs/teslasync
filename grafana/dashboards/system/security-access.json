      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"🕐 Time\",\n  CASE event_type\n    WHEN 'locked' THEN '🔒 Lock'\n    WHEN 'sentry_mode' THEN '🛡️ Sentry'\n    WHEN 'valet_mode_enabled' THEN '🔑 Valet Mode'\n    ELSE event_type\n  END AS \"Event\",\n  COALESCE(from_state, '—') AS \"Previous\",\n  COALESCE(to_state, '—') AS \"New State\",\n  CASE WHEN acknowledged_at IS NULL THEN 'No' ELSE 'Yes' END AS \"Acknowledged\"\nFROM security_events\nWHERE vehicle_id = ${vehicle_id}\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\nORDER BY ts DESC\nLIMIT 50",
          "refId": "A"
        }
      ],
      "title": "Recent Events Table",
      "type": "table",
      "transparent": false
    },
    {
      "id": 8,
      "type": "table",
      "title": "Lights & Turn Signal History",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TESLASYNC_POSTGRESQL"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "targets": [
        {
          "rawSql": "SELECT ts AS \"Time\",\n  CASE WHEN last(bool_value, ts) FILTER (WHERE field = 'LightsHazardsActive') THEN 'ON' ELSE 'Off' END AS \"Hazards\",\n  CASE WHEN last(bool_value, ts) FILTER (WHERE field = 'LightsHighBeams') THEN 'ON' ELSE 'Off' END AS \"High Beams\",\n  COALESCE(last(str_value, ts) FILTER (WHERE field = 'LightsTurnSignal'), 'Off') AS \"Turn Signal\",\n  COALESCE(last(str_value, ts) FILTER (WHERE field = 'CenterDisplay'), '—') AS \"Center Display\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND field IN ('LightsHazardsActive', 'LightsHighBeams', 'LightsTurnSignal', 'CenterDisplay')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY ts\nORDER BY ts DESC\nLIMIT 50",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "table",
      "title": "Access Modes Timeline",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TESLASYNC_POSTGRESQL"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "targets": [
        {
          "rawSql": "SELECT \"Time\", \"Mode\", \"State\"\nFROM (\n  SELECT ts AS \"Time\", 'Valet Mode'::text AS \"Mode\", COALESCE(to_state, 'Unknown') AS \"State\"\n  FROM security_events\n  WHERE vehicle_id = ${vehicle_id} AND event_type = 'valet_mode_enabled' AND ts BETWEEN $__timeFrom() AND $__timeTo()\n  UNION ALL\n  SELECT ts, 'Service Mode', CASE WHEN service_mode THEN 'On' ELSE 'Off' END\n  FROM safety_snapshots\n  WHERE vehicle_id = ${vehicle_id} AND service_mode IS NOT NULL AND ts BETWEEN $__timeFrom() AND $__timeTo()\n  UNION ALL\n  SELECT ts,\n    CASE field WHEN 'SpeedLimitMode' THEN 'Speed Limit Mode' WHEN 'GuestModeEnabled' THEN 'Guest Mode' WHEN 'CurrentLimitMph' THEN 'Speed Limit' WHEN 'PairedPhoneKeyAndKeyFobQty' THEN 'Paired Keys' END,\n    CASE WHEN field = 'CurrentLimitMph' THEN\n      ROUND(convert_distance_m(COALESCE(float_value, int_value::float8))::numeric, 1)::text || ' ${unit_length}/h'\n    ELSE COALESCE(str_value, bool_value::text, int_value::text, float_value::text, 'Unknown') END\n  FROM signal_log\n  WHERE vehicle_id = ${vehicle_id}\n    AND field IN ('SpeedLimitMode', 'GuestModeEnabled', 'CurrentLimitMph', 'PairedPhoneKeyAndKeyFobQty')\n    AND ts BETWEEN $__timeFrom() AND $__timeTo()\n) modes\nORDER BY \"Time\" DESC\nLIMIT 50",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "table",
      "title": "Driver & Seatbelt Status",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TESLASYNC_POSTGRESQL"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 60
      },
      "targets": [
        {
          "rawSql": "SELECT ts AS \"Time\",\n  CASE WHEN driver_seat_occupied THEN 'Occupied' WHEN driver_seat_occupied = false THEN 'Empty' ELSE 'Unknown' END AS \"Driver Seat\",\n  CASE WHEN driver_seat_belt THEN 'Buckled' WHEN driver_seat_belt = false THEN 'Unbuckled' ELSE 'Unknown' END AS \"Driver Belt\",\n  CASE WHEN passenger_seat_belt THEN 'Buckled' WHEN passenger_seat_belt = false THEN 'Unbuckled' ELSE 'Unknown' END AS \"Passenger Belt\"\nFROM climate_snapshots\nWHERE vehicle_id = ${vehicle_id}\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\n  AND (driver_seat_occupied IS NOT NULL OR driver_seat_belt IS NOT NULL OR passenger_seat_belt IS NOT NULL)\nORDER BY ts DESC\nLIMIT 50",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
