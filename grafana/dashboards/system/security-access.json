            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time,\n  last(str_value, ts) FILTER (WHERE field = 'FdWindow') AS \"Front Driver\",\n  last(str_value, ts) FILTER (WHERE field = 'FpWindow') AS \"Front Passenger\",\n  last(str_value, ts) FILTER (WHERE field = 'RdWindow') AS \"Rear Driver\",\n  last(str_value, ts) FILTER (WHERE field = 'RpWindow') AS \"Rear Passenger\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND field IN ('FdWindow', 'FpWindow', 'RdWindow', 'RpWindow')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY ts\nORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Window States",
