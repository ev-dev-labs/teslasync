      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"🕐 Time\",\n  CASE WHEN last(bool_value, ts) FILTER (WHERE field = 'Locked') THEN '🔒 Locked' ELSE '🔓 Unlocked' END AS \"🔒 Lock\",\n  CASE WHEN last(bool_value, ts) FILTER (WHERE field = 'SentryMode') THEN '🛡️ Active' ELSE '⬜ Off' END AS \"🛡️ Sentry\",\n  COALESCE(last(str_value, ts) FILTER (WHERE field = 'DoorState'), '-') AS \"🚪 Doors\",\n  COALESCE(last(str_value, ts) FILTER (WHERE field = 'FdWindow'), '-') AS \"🪟 FD\",\n  COALESCE(last(str_value, ts) FILTER (WHERE field = 'FpWindow'), '-') AS \"🪟 FP\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND field IN ('Locked', 'SentryMode', 'DoorState', 'FdWindow', 'FpWindow')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY ts\nORDER BY ts DESC\nLIMIT 50",
          "refId": "A"
        }
      ],
      "title": "Recent Events Table",
      "type": "table",
      "transparent": false
    },
