          "rawSql": "SELECT\n  COUNT(*) AS \"Total Events\",\n  COUNT(*) FILTER (WHERE event_type = 'locked') AS \"Lock Changes\",\n  COUNT(*) FILTER (WHERE event_type = 'sentry_mode' AND lower(to_state) ~ '(true|on|active)$') AS \"Sentry Activations\",\n  COUNT(*) FILTER (WHERE event_type = 'valet_mode_enabled') AS \"Valet Mode Changes\",\n  COUNT(DISTINCT DATE(ts)) AS \"Days Tracked\"\nFROM security_events\nWHERE vehicle_id = ${vehicle_id}\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()",
          "refId": "A"
        }
      ],
