          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COUNT(DISTINCT ts) FILTER (WHERE field = 'Locked') AS \"Total Events\",\n  COUNT(*) FILTER (WHERE field = 'Locked' AND bool_value = true) AS \"Locked Events\",\n  COUNT(*) FILTER (WHERE field = 'SentryMode' AND bool_value = true) AS \"Sentry Active\",\n  COUNT(*) FILTER (WHERE field = 'DoorState' AND str_value LIKE '%Open%') AS \"Door Opens\",\n  COUNT(DISTINCT DATE(ts)) AS \"Days Tracked\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND field IN ('Locked', 'SentryMode', 'DoorState')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()",
          "refId": "A"
        }
      ],
      "title": "Security Summary Stats",
      "type": "stat",
      "transparent": false
