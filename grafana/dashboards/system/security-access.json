      },
      "targets": [
        {
          "rawSql": "SELECT ts AS \"Time\",\n  CASE WHEN last(bool_value, ts) FILTER (WHERE field = 'ValetModeEnabled') THEN 'ON' ELSE 'Off' END AS \"Valet\",\n  CASE WHEN last(bool_value, ts) FILTER (WHERE field = 'ServiceMode') THEN 'ON' ELSE 'Off' END AS \"Service\",\n  CASE WHEN last(bool_value, ts) FILTER (WHERE field = 'SpeedLimitMode') THEN 'ON' ELSE 'Off' END AS \"Speed Limit\",\n  CASE WHEN last(bool_value, ts) FILTER (WHERE field = 'GuestModeEnabled') THEN 'ON' ELSE 'Off' END AS \"Guest\",\n  MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'CurrentLimitMph') AS \"Speed Limit (mph)\",\n  MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'PairedPhoneKeyAndKeyFobQty') AS \"Paired Keys\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND field IN ('ValetModeEnabled', 'ServiceMode', 'SpeedLimitMode', 'GuestModeEnabled', 'CurrentLimitMph', 'PairedPhoneKeyAndKeyFobQty')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY ts\nORDER BY ts DESC\nLIMIT 50",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          }
        }
