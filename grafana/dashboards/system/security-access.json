      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH events AS (\n  (SELECT ts, to_state\n   FROM security_events\n   WHERE vehicle_id = ${vehicle_id}\n     AND event_type = 'sentry_mode'\n     AND ts < $__timeFrom()\n   ORDER BY ts DESC\n   LIMIT 1)\n  UNION ALL\n  SELECT ts, to_state\n  FROM security_events\n  WHERE vehicle_id = ${vehicle_id}\n    AND event_type = 'sentry_mode'\n    AND ts BETWEEN $__timeFrom() AND $__timeTo()\n), segments AS (\n  SELECT GREATEST(ts, $__timeFrom()) AS start_ts,\n    LEAST(LEAD(ts, 1, $__timeTo()) OVER (ORDER BY ts), $__timeTo()) AS end_ts,\n    lower(to_state) AS state\n  FROM events\n)\nSELECT ROUND((100.0 * SUM(EXTRACT(EPOCH FROM (end_ts - start_ts))) FILTER (WHERE state ~ '(true|on|active)$') / NULLIF(SUM(EXTRACT(EPOCH FROM (end_ts - start_ts))), 0))::numeric, 1) AS \"Sentry Uptime %\"\nFROM segments\nWHERE end_ts > start_ts",
          "refId": "A"
        }
      ],
      "title": "Sentry Uptime %",
      "type": "gauge",
      "transparent": false
    },
