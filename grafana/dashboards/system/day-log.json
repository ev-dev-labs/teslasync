          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH hours AS (\n  SELECT generate_series(date_trunc('hour', $__timeFrom()), date_trunc('hour', $__timeTo()),\n    INTERVAL '1 hour') AS h\n)\nSELECT COUNT(*) AS \"Gap hours\" FROM hours\nWHERE NOT EXISTS (SELECT 1 FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND ts >= hours.h AND ts < hours.h + INTERVAL '1 hour')",
          "refId": "A"
        }
      ],
