          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(ts, '1d') AS \"time\",\n  field AS \"metric\", COUNT(*) AS \"events\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id} AND $__timeFilter(ts)\n  AND field IN (SELECT field FROM signal_log\n    WHERE vehicle_id = ${vehicle_id} AND $__timeFilter(ts)\n    GROUP BY field ORDER BY COUNT(*) DESC LIMIT 8)\nGROUP BY 1, 2 ORDER BY 1",
