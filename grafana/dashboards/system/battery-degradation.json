      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH daily_cap AS (SELECT time_bucket('1 day', ts) AS \"time\", AVG(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'EnergyRemaining') / NULLIF(AVG(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'BatteryLevel'), 0) * 100 AS est_capacity FROM signal_log WHERE vehicle_id = ${vehicle_id} AND field IN ('EnergyRemaining', 'BatteryLevel') AND ts BETWEEN $__timeFrom() AND $__timeTo() AND COALESCE(float_value, int_value::float8) > 0 GROUP BY 1) SELECT \"time\", est_capacity / MAX(est_capacity) OVER () * 100 AS \"SoH %\" FROM daily_cap WHERE est_capacity IS NOT NULL ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Battery SoH Trend",
      "type": "timeseries",
      "transparent": false
    },
