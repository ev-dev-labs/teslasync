        },
        "text": {
          "titleSize": 14,
          "valueSize": 32
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH daily_cap AS (SELECT time_bucket('1 day', ts) AS day, AVG(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'EnergyRemaining') / NULLIF(AVG(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'BatteryLevel'), 0) * 100 AS est_cap FROM signal_log WHERE vehicle_id = ${vehicle_id} AND field IN ('EnergyRemaining', 'BatteryLevel') AND ts BETWEEN $__timeFrom() AND $__timeTo() AND COALESCE(float_value, int_value::float8) > 0 GROUP BY 1 HAVING AVG(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'BatteryLevel') > 0), regression AS (SELECT regr_slope(est_cap, EXTRACT(EPOCH FROM day)) AS slope_per_sec, AVG(est_cap) AS avg_cap FROM daily_cap WHERE est_cap IS NOT NULL) SELECT ABS(slope_per_sec * 86400 * 365 / NULLIF(avg_cap, 0) * 100) AS \"Annual Degradation %\" FROM regression",
          "refId": "A"
        }
      ],
      "title": "Annual Degradation Rate",
      "type": "stat",
      "transparent": false
