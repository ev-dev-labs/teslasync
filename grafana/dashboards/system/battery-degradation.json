    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TESLASYNC_POSTGRESQL"
      },
      "description": "Observed record shares for measurable battery-stress proxies: fast charging, high charge-end SOC, hot drives, and deep discharge. These are exposure rates, not causal degradation scores.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "unit": "percent",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "id": 4,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH exposure_rates AS (\n  SELECT\n    'Fast charging (>20 kW)'::text AS factor,\n    100.0 * COUNT(*) FILTER (\n      WHERE peak_power_w > 20000\n         OR charger_type ILIKE '%supercharger%'\n         OR charger_type ILIKE '%dc%'\n    ) / NULLIF(COUNT(*) FILTER (\n      WHERE peak_power_w IS NOT NULL\n         OR NULLIF(BTRIM(charger_type), '') IS NOT NULL\n    ), 0) AS observed_pct\n  FROM charging_sessions\n  WHERE vehicle_id = ${vehicle_id} AND $__timeFilter(started_at)\n\n  UNION ALL\n\n  SELECT\n    'Charges ending ≥90% SOC'::text,\n    100.0 * COUNT(*) FILTER (WHERE end_soc_pct >= 90)\n      / NULLIF(COUNT(end_soc_pct), 0)\n  FROM charging_sessions\n  WHERE vehicle_id = ${vehicle_id} AND $__timeFilter(started_at)\n\n  UNION ALL\n\n  SELECT\n    'Drives above 35 °C'::text,\n    100.0 * COUNT(*) FILTER (WHERE ambient_temp_c_avg > 35)\n      / NULLIF(COUNT(ambient_temp_c_avg), 0)\n  FROM drives\n  WHERE vehicle_id = ${vehicle_id} AND $__timeFilter(started_at)\n\n  UNION ALL\n\n  SELECT\n    'Drives ending ≤10% SOC'::text,\n    100.0 * COUNT(*) FILTER (WHERE end_soc_pct <= 10)\n      / NULLIF(COUNT(end_soc_pct), 0)\n  FROM drives\n  WHERE vehicle_id = ${vehicle_id} AND $__timeFilter(started_at)\n)\nSELECT factor AS \"Observed Exposure\", ROUND(observed_pct::numeric, 1) AS \"Percent\"\nFROM exposure_rates\nWHERE observed_pct IS NOT NULL\nORDER BY factor",
          "refId": "A"
        }
      ],
      "title": "Observed Battery Stress Exposures",
      "type": "bargauge",
      "transparent": false
    }
  ],
