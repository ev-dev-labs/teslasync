    {
      "id": 13,
      "type": "timeseries",
      "title": "Pack Voltage & Current",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TESLASYNC_POSTGRESQL"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
