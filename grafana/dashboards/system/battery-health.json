      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH recent AS (\n  SELECT\n    (COALESCE(ac_energy_added_wh, 0) + COALESCE(dc_energy_added_wh, 0))\n      / NULLIF((max_soc - min_soc) / 100.0, 0) AS capacity_wh\n  FROM cagg_battery_daily\n  WHERE vehicle_id = ${vehicle_id}\n    AND max_soc IS NOT NULL\n    AND min_soc IS NOT NULL\n    AND (max_soc - min_soc) >= 20\n    AND (COALESCE(ac_energy_added_wh, 0) + COALESCE(dc_energy_added_wh, 0)) > 0\n  ORDER BY bucket DESC\n  LIMIT 8\n)\nSELECT ROUND((PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY capacity_wh) / 1000.0)::numeric, 1) AS \"⚡ kWh\"\nFROM recent\nHAVING COUNT(*) > 0",
          "refId": "A"
        }
      ],
      "title": "Estimated Usable Capacity",
      "type": "stat",
      "transparent": false
    },
