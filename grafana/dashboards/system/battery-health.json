      },
      "targets": [
        {
          "rawSql": "SELECT\n  $__timeGroup(ts, '1h') AS time,\n  MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'BrickVoltageMax') AS \"Max Cell (V)\",\n  MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'BrickVoltageMin') AS \"Min Cell (V)\",\n  MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'BrickVoltageMax') - MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'BrickVoltageMin') AS \"Delta (V)\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\n  AND field IN ('BrickVoltageMax', 'BrickVoltageMin')\nGROUP BY 1\nORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
