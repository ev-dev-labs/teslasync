    {
      "id": 14,
      "type": "table",
      "title": "BMS & Isolation",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TESLASYNC_POSTGRESQL"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "rawSql": "WITH samples AS (\n  SELECT\n    $__timeGroup(sl.ts, '5m') AS time,\n    last(sl.int_value, sl.ts) FILTER (WHERE sl.field = 'BMSState') AS bms_state_code,\n    NULL::double precision AS isolation_ohm,\n    last(COALESCE(sl.float_value, sl.int_value::float8), sl.ts)\n      FILTER (WHERE sl.field = 'LifetimeEnergyUsed') AS lifetime_energy,\n    NULL::boolean AS battery_heater_on\n  FROM signal_log sl\n  WHERE sl.vehicle_id = ${vehicle_id}\n    AND sl.ts BETWEEN $__timeFrom() AND $__timeTo()\n    AND sl.field IN ('BMSState', 'LifetimeEnergyUsed')\n  GROUP BY 1\n\n  UNION ALL\n\n  SELECT\n    $__timeGroup(ms.ts, '5m') AS time,\n    NULL::bigint AS bms_state_code,\n    last(ms.isolation_resistance_ohm, ms.ts) AS isolation_ohm,\n    NULL::double precision AS lifetime_energy,\n    NULL::boolean AS battery_heater_on\n  FROM motor_snapshots ms\n  WHERE ms.vehicle_id = ${vehicle_id}\n    AND ms.ts BETWEEN $__timeFrom() AND $__timeTo()\n    AND ms.isolation_resistance_ohm IS NOT NULL\n  GROUP BY 1\n\n  UNION ALL\n\n  SELECT\n    $__timeGroup(ct.ts, '5m') AS time,\n    NULL::bigint AS bms_state_code,\n    NULL::double precision AS isolation_ohm,\n    NULL::double precision AS lifetime_energy,\n    last(ct.battery_heater_on, ct.ts) AS battery_heater_on\n  FROM charging_telemetry ct\n  WHERE ct.vehicle_id = ${vehicle_id}\n    AND ct.ts BETWEEN $__timeFrom() AND $__timeTo()\n    AND ct.battery_heater_on IS NOT NULL\n  GROUP BY 1\n), combined AS (\n  SELECT\n    time,\n    MAX(bms_state_code) AS bms_state_code,\n    MAX(isolation_ohm) AS isolation_ohm,\n    MAX(lifetime_energy) AS lifetime_energy,\n    COUNT(battery_heater_on) AS heater_samples,\n    BOOL_OR(battery_heater_on) AS battery_heater_on\n  FROM samples\n  GROUP BY time\n)\nSELECT\n  time AS \"Time\",\n  CASE bms_state_code\n    WHEN 0 THEN 'Unknown' WHEN 1 THEN 'Standby' WHEN 2 THEN 'Drive'\n    WHEN 3 THEN 'Support' WHEN 4 THEN 'Charge' WHEN 5 THEN 'FEIM'\n    WHEN 6 THEN 'Clear Fault' WHEN 7 THEN 'Fault' WHEN 8 THEN 'Weld'\n    WHEN 9 THEN 'Test' WHEN 10 THEN 'SNA'\n    ELSE CASE WHEN bms_state_code IS NULL THEN NULL ELSE 'Code ' || bms_state_code::text END\n  END AS \"BMS State\",\n  isolation_ohm AS \"Isolation (Ω)\",\n  lifetime_energy AS \"Lifetime Energy (kWh)\",\n  CASE WHEN heater_samples = 0 THEN 'Unknown'\n       WHEN battery_heater_on THEN 'ON' ELSE 'Off' END AS \"Battery Heater\"\nFROM combined\nORDER BY time DESC\nLIMIT 20",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "type": "table",
      "title": "Powershare Status",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TESLASYNC_POSTGRESQL"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "rawSql": "WITH buckets AS (\n  SELECT\n    $__timeGroup(ts, '5m') AS time,\n    last(int_value, ts) FILTER (WHERE field = 'PowershareStatus') AS status_code,\n    last(int_value, ts) FILTER (WHERE field = 'PowershareType') AS type_code,\n    last(COALESCE(float_value, int_value::float8), ts)\n      FILTER (WHERE field = 'PowershareInstantaneousPowerKW') AS power_kw,\n    last(COALESCE(float_value, int_value::float8), ts)\n      FILTER (WHERE field = 'PowershareHoursLeft') AS hours_left\n  FROM signal_log\n  WHERE vehicle_id = ${vehicle_id}\n    AND ts BETWEEN $__timeFrom() AND $__timeTo()\n    AND field IN ('PowershareStatus', 'PowershareType',\n                  'PowershareInstantaneousPowerKW', 'PowershareHoursLeft')\n  GROUP BY 1\n)\nSELECT\n  time AS \"Time\",\n  CASE status_code\n    WHEN 0 THEN 'Unknown' WHEN 1 THEN 'Inactive' WHEN 2 THEN 'Handshaking'\n    WHEN 3 THEN 'Initializing' WHEN 4 THEN 'Enabled'\n    WHEN 5 THEN 'Enabled (reconnecting soon)' WHEN 6 THEN 'Stopped'\n    ELSE 'Code ' || status_code::text\n  END AS \"Status\",\n  CASE type_code\n    WHEN 0 THEN 'Unknown' WHEN 1 THEN 'None' WHEN 2 THEN 'Load' WHEN 3 THEN 'Home'\n    ELSE CASE WHEN type_code IS NULL THEN NULL ELSE 'Code ' || type_code::text END\n  END AS \"Type\",\n  power_kw AS \"Power (kW)\",\n  hours_left AS \"Hours Left\"\nFROM buckets\nWHERE status_code IS NOT NULL\nORDER BY time DESC\nLIMIT 20",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
