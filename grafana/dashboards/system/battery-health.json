        "y": 22
      },
      "targets": [
        {
          "rawSql": "SELECT\n  $__timeGroup(ts, '1h') AS time,\n  MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'PackVoltage') AS \"Pack Voltage (V)\",\n  MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'PackCurrent') AS \"Pack Current (A)\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\n  AND field IN ('PackVoltage', 'PackCurrent')\nGROUP BY 1\nORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "datasource": {
