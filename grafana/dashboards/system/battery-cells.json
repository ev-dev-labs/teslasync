          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  created_at AS time,\n  cell_id AS \"Cell\",\n  temperature AS \"Temp °C\"\nFROM battery_cells\nWHERE vehicle_id = ${vehicle_id}\n  AND $__timeFilter(created_at)\nORDER BY created_at, cell_id",
          "refId": "A"
        }
      ],
      "title": "Cell Temperature Heatmap",
