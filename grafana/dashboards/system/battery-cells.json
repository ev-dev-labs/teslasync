        "uid": "DS_TESLASYNC_POSTGRESQL"
      },
      "description": "Shows the max–min voltage delta across all cells. A growing delta indicates cell imbalance.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 4,
          "mappings": [],
          "unit": "volt",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "id": 1,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  ROUND((MAX(voltage) - MIN(voltage))::numeric, 4) AS \"Voltage Delta (V)\"\nFROM battery_cells\nWHERE vehicle_id = ${vehicle_id}\n  AND created_at = (\n    SELECT MAX(created_at) FROM battery_cells WHERE vehicle_id = ${vehicle_id}\n  )",
          "refId": "A"
        }
      ],
      "title": "Cell Voltage Balance Delta",
      "type": "stat",
      "transparent": false
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TESLASYNC_POSTGRESQL"
      },
      "description": "Sortable table showing the latest reading for each cell: cell ID, voltage, temperature, and deviation from average. Allows quick identification of outlier cells.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellHeight": "sm",
            "align": "auto",
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
