      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH pivoted AS (\n  SELECT ts,\n    MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'RatedRange') AS rated_range,\n    MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'BatteryLevel') AS battery_level\n  FROM signal_log\n  WHERE vehicle_id = ${vehicle_id}\n    AND field IN ('RatedRange', 'BatteryLevel')\n    AND ts BETWEEN $__timeFrom() AND $__timeTo()\n  GROUP BY ts\n  HAVING MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'RatedRange') IS NOT NULL\n    AND MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'BatteryLevel') > 10\n)\nSELECT\n  time_bucket('1 day', ts) AS time,\n  ROUND(convert_distance(AVG(rated_range / NULLIF(battery_level, 0) * 100))::numeric, 1) AS \"Projected Range\"\nFROM pivoted\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Projected Full-Charge Range",
      "type": "timeseries",
      "transparent": false
    }
