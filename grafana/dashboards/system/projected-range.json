          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time,\n  MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'BatteryLevel') AS \"🔋 Battery %\",\n  convert_distance_m(MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'RatedRange')) AS \"Rated Range\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND field IN ('BatteryLevel', 'RatedRange')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY ts\nHAVING MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'RatedRange') IS NOT NULL\nORDER BY ts",
          "refId": "A"
        }
      ],
