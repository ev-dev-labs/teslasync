          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time,\n  ROUND(convert_distance_m(MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'RatedRange'))::numeric, 1) AS \"Rated Range\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND field IN ('RatedRange', 'BatteryLevel')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY ts\nHAVING MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'RatedRange') IS NOT NULL\n  AND MAX(COALESCE(float_value, int_value::float8)) FILTER (WHERE field = 'BatteryLevel') >= 95\nORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Rated Range Over Time",
