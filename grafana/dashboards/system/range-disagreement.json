            "type": "postgres",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"time\",\n  CASE WHEN field = 'RatedRange' THEN convert_distance_m(float_value) END AS \"Rated\",\n  CASE WHEN field = 'EstBatteryRange' THEN convert_distance_m(float_value) END AS \"Typical\",\n  CASE WHEN field = 'IdealBatteryRange' THEN convert_distance_m(float_value) END AS \"Ideal\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND field IN ('RatedRange', 'EstBatteryRange', 'IdealBatteryRange')\n  AND $__timeFilter(ts)\nORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Estimators",
      "transparent": true,
      "type": "timeseries"
