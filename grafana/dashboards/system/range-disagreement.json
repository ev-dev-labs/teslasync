      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH days AS (\n  SELECT date_trunc('day', ts) AS d, field,\n    AVG(float_value) AS v\n  FROM signal_log\n  WHERE vehicle_id = ${vehicle_id}\n    AND field IN ('RatedRange', 'EstBatteryRange', 'IdealBatteryRange')\n    AND $__timeFilter(ts)\n  GROUP BY 1, 2\n)\nSELECT d AS \"time\",\n  convert_distance_m(MAX(v) - MIN(v)) AS \"Spread\",\n  COUNT(DISTINCT field) AS \"Estimators\"\nFROM days GROUP BY d HAVING COUNT(DISTINCT field) >= 2 ORDER BY d DESC LIMIT 200",
          "refId": "A"
        }
      ],
      "title": "Daily spread",
      "transparent": true,
      "type": "table"
