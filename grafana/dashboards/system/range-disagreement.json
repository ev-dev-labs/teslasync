        {
          "datasource": {
            "type": "postgres",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\nSELECT DISTINCT ON (field) field, ts, float_value AS v FROM signal_log\nWHERE vehicle_id=${vehicle_id} AND field IN ('RatedRange','EstBatteryRange','IdealBatteryRange')\nAND $__timeFilter(ts) ORDER BY field, ts DESC\n)\nSELECT CASE WHEN COUNT(v) >= 2 AND MAX(ts)-MIN(ts) <= INTERVAL '120 seconds'\nTHEN convert_distance_m(MAX(v)-MIN(v)) END AS \"Spread\" FROM latest",
          "refId": "A"
        }
      ],
      "title": "Spread (latest)",
      "transparent": true,
      "type": "stat"
