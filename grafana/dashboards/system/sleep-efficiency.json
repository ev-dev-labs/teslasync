            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  start_date AS \"Start\",\n  end_date AS \"End\",\n  ROUND(duration_hours::numeric, 1) AS \"Duration (hrs)\",\n  battery_lost AS \"Battery Lost %\",\n  ROUND(drain_rate_pct_per_hour::numeric, 2) AS \"Drain %/hr\",\n  CASE WHEN sentry_mode THEN '🛡 Yes' ELSE 'No' END AS \"Sentry\"\nFROM vampire_drain_events\nWHERE vehicle_id = ${vehicle_id}\n  AND $__timeFilter(start_date)\nORDER BY start_date DESC\nLIMIT 50",
          "refId": "A"
        }
      ],
      "title": "Drain Events",
      "type": "table",
