          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  ROUND(AVG(drain_rate_pct_per_hour)::numeric, 2) AS \"Drain %/hr\"\nFROM vampire_drain_events\nWHERE vehicle_id = ${vehicle_id}\n  AND $__timeFilter(start_date)",
