        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_state AS \"📊 State\", SUM(EXTRACT(EPOCH FROM (next_ts - ts)) / 60) AS \"Minutes\"\nFROM (\n  SELECT to_state, ts,\n         LEAD(ts, 1, NOW()) OVER (ORDER BY ts) AS next_ts\n  FROM fsm_transitions\n  WHERE vehicle_id = ${vehicle_id}\n    AND fsm_name = 'vehicle'\n    AND $__timeFilter(ts)\n) sub\nGROUP BY to_state ORDER BY \"Minutes\" DESC",
          "refId": "A"
        }
      ],
      "title": "State Distribution",
      "type": "piechart",
      "transparent": false
