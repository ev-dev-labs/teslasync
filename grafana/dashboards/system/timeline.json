      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  ts AS \"time\",\n  to_state AS \"📊 State\"\nFROM fsm_transitions\nWHERE vehicle_id = ${vehicle_id}\n  AND fsm_name = 'vehicle'\n  AND $__timeFilter(ts)\nORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Vehicle State Timeline",
      "type": "state-timeline",
      "transparent": false
