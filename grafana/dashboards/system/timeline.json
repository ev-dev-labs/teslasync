          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "id": 2,
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Date",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  to_state AS \"📊 State\",\n  COUNT(*) AS \"📊 Count\",\n  ROUND(SUM(EXTRACT(EPOCH FROM (next_ts - ts)) / 60)::numeric) AS \"⏱️ Total Min\",\n  ROUND((SUM(EXTRACT(EPOCH FROM (next_ts - ts)) / 3600))::numeric, 1) AS \"⏱️ Total Hours\"\nFROM (\n  SELECT to_state, ts,\n         LEAD(ts, 1, NOW()) OVER (ORDER BY ts) AS next_ts\n  FROM fsm_transitions\n  WHERE vehicle_id = ${vehicle_id}\n    AND fsm_name = 'vehicle'\n    AND $__timeFilter(ts)\n) sub\nGROUP BY to_state\nORDER BY 3 DESC",
          "refId": "A"
        }
      ],
      "title": "State Duration Breakdown",
      "type": "table",
      "transparent": false
    },
