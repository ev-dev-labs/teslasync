    {
      "id": 10,
      "type": "table",
      "title": "Steering Wheel & Defrost",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TESLASYNC_POSTGRESQL"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "rawSql": "SELECT ts AS \"Time\",\n  hvac_steering_wheel_heat_level AS \"Steering Wheel Level\",\n  COALESCE(NULLIF(defrost_mode, ''), 'Unknown') AS \"Defrost\",\n  CASE WHEN wiper_heat_enabled THEN 'ON' WHEN wiper_heat_enabled = false THEN 'Off' ELSE 'Unknown' END AS \"Wiper Heat\",\n  COALESCE(NULLIF(climate_keeper_mode, ''), 'Unknown') AS \"Climate Keeper\",\n  COALESCE(NULLIF(cabin_overheat_protection_mode, ''), 'Unknown') AS \"Overheat Protection\"\nFROM climate_snapshots\nWHERE vehicle_id = ${vehicle_id}\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\n  AND (hvac_steering_wheel_heat_level IS NOT NULL OR defrost_mode IS NOT NULL OR wiper_heat_enabled IS NOT NULL OR climate_keeper_mode IS NOT NULL OR cabin_overheat_protection_mode IS NOT NULL)\nORDER BY ts DESC\nLIMIT 50",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
