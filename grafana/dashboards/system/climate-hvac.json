    {
      "id": 10,
      "type": "table",
      "title": "Steering Wheel & Defrost",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TESLASYNC_POSTGRESQL"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "rawSql": "SELECT ts AS \"Time\",\n  MAX(value_num) FILTER (WHERE signal_name = 'HvacSteeringWheelHeatLevel') AS \"Steering Wheel Level\",\n  CASE WHEN MAX(value_text) FILTER (WHERE signal_name = 'DefrostMode') IS NOT NULL AND MAX(value_text) FILTER (WHERE signal_name = 'DefrostMode') != '' THEN 'ON' ELSE 'Off' END AS \"Defrost\",\n  CASE WHEN bool_or(value_bool) FILTER (WHERE signal_name = 'RearDefrostEnabled') THEN 'ON' ELSE 'Off' END AS \"Rear Defrost\",\n  CASE WHEN bool_or(value_bool) FILTER (WHERE signal_name = 'WiperHeatEnabled') THEN 'ON' ELSE 'Off' END AS \"Wiper Heat\",\n  COALESCE(MAX(value_text) FILTER (WHERE signal_name = 'ClimateKeeperMode'), 'Off') AS \"Climate Keeper\",\n  COALESCE(MAX(value_text) FILTER (WHERE signal_name = 'CabinOverheatProtectionMode'), 'Off') AS \"Overheat Protection\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND signal_name IN ('HvacSteeringWheelHeatLevel', 'DefrostMode', 'RearDefrostEnabled', 'WiperHeatEnabled', 'ClimateKeeperMode', 'CabinOverheatProtectionMode')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY ts\nORDER BY ts DESC\nLIMIT 50",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "table",
      "title": "Seat Cooling & Auto Climate",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TESLASYNC_POSTGRESQL"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "targets": [
        {
          "rawSql": "SELECT ts AS \"Time\",\n  MAX(value_num) FILTER (WHERE signal_name = 'ClimateSeatCoolingFrontLeft') AS \"Cool FL\",\n  MAX(value_num) FILTER (WHERE signal_name = 'ClimateSeatCoolingFrontRight') AS \"Cool FR\",\n  CASE WHEN bool_or(value_bool) FILTER (WHERE signal_name = 'AutoSeatClimateLeft') THEN 'Auto' ELSE 'Manual' END AS \"Left Mode\",\n  CASE WHEN bool_or(value_bool) FILTER (WHERE signal_name = 'AutoSeatClimateRight') THEN 'Auto' ELSE 'Manual' END AS \"Right Mode\",\n  CASE WHEN bool_or(value_bool) FILTER (WHERE signal_name = 'SeatVentEnabled') THEN 'ON' ELSE 'Off' END AS \"Ventilation\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND signal_name IN ('ClimateSeatCoolingFrontLeft', 'ClimateSeatCoolingFrontRight', 'AutoSeatClimateLeft', 'AutoSeatClimateRight', 'SeatVentEnabled')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY ts\nHAVING MAX(value_num) FILTER (WHERE signal_name = 'ClimateSeatCoolingFrontLeft') IS NOT NULL\n   OR bool_or(value_bool) FILTER (WHERE signal_name = 'AutoSeatClimateLeft') IS NOT NULL\nORDER BY ts DESC\nLIMIT 50",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
