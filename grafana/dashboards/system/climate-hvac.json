        {
          "rawSql": "SELECT ts AS time,\n  seat_heater_left AS \"Driver\",\n  seat_heater_right AS \"Passenger\",\n  seat_heater_rear_left AS \"Rear Left\",\n  seat_heater_rear_center AS \"Rear Center\",\n  seat_heater_rear_right AS \"Rear Right\"\nFROM climate_snapshots\nWHERE vehicle_id = ${vehicle_id}\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\n  AND (seat_heater_left IS NOT NULL OR seat_heater_right IS NOT NULL OR seat_heater_rear_left IS NOT NULL OR seat_heater_rear_center IS NOT NULL OR seat_heater_rear_right IS NOT NULL)\nORDER BY ts",
