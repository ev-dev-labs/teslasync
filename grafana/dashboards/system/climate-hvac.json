      "targets": [
        {
          "rawSql": "SELECT ts AS \"Time\",\n  climate_seat_cooling_front_left AS \"Cool FL\",\n  climate_seat_cooling_front_right AS \"Cool FR\",\n  CASE WHEN auto_seat_climate_left THEN 'Auto' WHEN auto_seat_climate_left = false THEN 'Manual' ELSE 'Unknown' END AS \"Left Mode\",\n  CASE WHEN auto_seat_climate_right THEN 'Auto' WHEN auto_seat_climate_right = false THEN 'Manual' ELSE 'Unknown' END AS \"Right Mode\",\n  CASE WHEN seat_vent_enabled THEN 'ON' WHEN seat_vent_enabled = false THEN 'Off' ELSE 'Unknown' END AS \"Ventilation\"\nFROM climate_snapshots\nWHERE vehicle_id = ${vehicle_id}\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\n  AND (climate_seat_cooling_front_left IS NOT NULL OR climate_seat_cooling_front_right IS NOT NULL OR auto_seat_climate_left IS NOT NULL OR auto_seat_climate_right IS NOT NULL OR seat_vent_enabled IS NOT NULL)\nORDER BY ts DESC\nLIMIT 50",
          "format": "table",
          "refId": "A",
          "datasource": {
