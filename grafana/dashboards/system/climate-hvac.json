        "y": 34
      },
      "targets": [
        {
          "rawSql": "SELECT ts AS time,\n  MAX(value_num) FILTER (WHERE signal_name = 'SeatHeaterLeft') AS \"Driver\",\n  MAX(value_num) FILTER (WHERE signal_name = 'SeatHeaterRight') AS \"Passenger\",\n  MAX(value_num) FILTER (WHERE signal_name = 'SeatHeaterRearLeft') AS \"Rear Left\",\n  MAX(value_num) FILTER (WHERE signal_name = 'SeatHeaterRearCenter') AS \"Rear Center\",\n  MAX(value_num) FILTER (WHERE signal_name = 'SeatHeaterRearRight') AS \"Rear Right\"\nFROM signal_log\nWHERE vehicle_id = ${vehicle_id}\n  AND signal_name IN ('SeatHeaterLeft', 'SeatHeaterRight', 'SeatHeaterRearLeft', 'SeatHeaterRearCenter', 'SeatHeaterRearRight')\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY ts\nORDER BY ts",
          "format": "time_series",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
