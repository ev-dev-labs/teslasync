          "rawSql": "SELECT\n  ROUND((100.0 * AVG(CASE WHEN hvac_power THEN 1.0 WHEN hvac_power = false THEN 0.0 END))::numeric, 1) AS \"HVAC Active %\",\n  ROUND((100.0 * AVG(CASE WHEN hvac_ac_enabled THEN 1.0 WHEN hvac_ac_enabled = false THEN 0.0 END))::numeric, 1) AS \"AC Active %\",\n  ROUND(AVG(hvac_fan_speed)::numeric, 1) AS \"Avg Fan Speed\"\nFROM climate_snapshots\nWHERE vehicle_id = ${vehicle_id}\n  AND ts BETWEEN $__timeFrom() AND $__timeTo()",
          "refId": "A"
        }
      ],
