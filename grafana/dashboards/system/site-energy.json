          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(timestamp, '1d') AS \"time\",\n  SUM(solar_energy_wh) AS \"Solar Wh\",\n  SUM(grid_energy_in_wh) AS \"Grid in Wh\",\n  SUM(grid_energy_out_wh) AS \"Grid out Wh\",\n  SUM(consumer_energy_wh) AS \"Home Wh\"\nFROM tesla_energy_history\nWHERE $__timeFilter(timestamp) AND period = 'day'\nGROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
