          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH anchor AS (\n  SELECT MAX(ts) AS t FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND $__timeFilter(ts)\n    AND ((field = 'Gear' AND str_value = 'P')\n      OR (field = 'ChargePortLatch' AND str_value LIKE '%Disengaged%'))\n)\nSELECT COUNT(*) AS \"Samples\" FROM signal_log, anchor\nWHERE vehicle_id = ${vehicle_id}\n  AND field IN ('VehicleSpeed', 'PackVoltage', 'PackCurrent')\n  AND ts > anchor.t - INTERVAL '90 seconds' AND ts <= anchor.t",
          "refId": "A"
        }
