          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH anchor AS (\n  SELECT MAX(ts) AS t FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND $__timeFilter(ts)\n    AND ((field = 'Gear' AND str_value = 'P')\n      OR (field = 'ChargePortLatch' AND str_value LIKE '%Disengaged%'))\n)\nSELECT p.ts AS \"time\", p.float_value * i.float_value AS \"Pack VI W\"\nFROM signal_log p\nJOIN signal_log i ON i.vehicle_id = p.vehicle_id AND i.ts = p.ts\n  AND i.field = 'PackCurrent', anchor\nWHERE p.vehicle_id = ${vehicle_id} AND p.field = 'PackVoltage'\n  AND p.ts > anchor.t - INTERVAL '90 seconds' AND p.ts <= anchor.t\nORDER BY p.ts",
          "refId": "A"
        }
      ],
