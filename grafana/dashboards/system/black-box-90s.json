          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH anchor AS (\n  SELECT MAX(ts) AS t FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND $__timeFilter(ts)\n    AND ((field = 'Gear' AND str_value = 'P')\n      OR (field = 'ChargePortLatch' AND str_value LIKE '%Disengaged%'))\n)\nSELECT s.ts AS \"time\", convert_speed_mps(s.float_value) AS \"Speed\"\nFROM signal_log s, anchor\nWHERE s.vehicle_id = ${vehicle_id} AND s.field = 'VehicleSpeed'\n  AND s.ts > anchor.t - INTERVAL '90 seconds' AND s.ts <= anchor.t\nORDER BY s.ts",
          "refId": "A"
        }
