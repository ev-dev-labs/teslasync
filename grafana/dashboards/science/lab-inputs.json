          "rawSql": "WITH lo AS (\n  SELECT ts, float_value AS v FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND field = 'BrickVoltageMin' AND $__timeFilter(ts)\n), hi AS (\n  SELECT ts, float_value AS v FROM signal_log\n  WHERE vehicle_id = ${vehicle_id} AND field = 'BrickVoltageMax' AND $__timeFilter(ts)\n)\nSELECT lo.ts AS \"time\", 1000.0 * (hi.v - lo.v) AS \"Spread mV\"\nFROM lo JOIN hi USING (ts) ORDER BY lo.ts",
          "refId": "A"
        }
      ],
