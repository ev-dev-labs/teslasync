            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  cs.start_date AS \"Date\",\n  COALESCE(a.display_name, a.city, 'Unknown') AS \"Location\",\n  ROUND(cs.charge_energy_added::numeric, 1) AS \"kWh Added\",\n  ROUND(cs.cost::numeric, 2) AS \"Cost $\",\n  cs.start_battery_level AS \"Start %\",\n  cs.end_battery_level AS \"End %\",\n  ROUND(cs.charger_power::numeric) AS \"Power kW\",\n  COALESCE(cs.fast_charger_type, 'AC') AS \"Type\",\n  COALESCE(cs.fast_charger_brand, '-') AS \"Brand\",\n  ROUND(cs.duration_min::numeric) AS \"Duration min\"\nFROM charging_sessions cs\nLEFT JOIN addresses a ON cs.address_id = a.id\nWHERE cs.vehicle_id = ${vehicle_id}\n  AND $__timeFilter(cs.start_date)\nORDER BY cs.start_date DESC\nLIMIT 200",
          "refId": "A"
        }
      ],
      "title": "Charging Session History",
      "type": "table",
      "transparent": false
    }
