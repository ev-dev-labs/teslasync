{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 2,
  "id": null,
  "links": [
    { "title": "Drives", "url": "/d/teslasync-drives/drives", "type": "link" },
    { "title": "Efficiency", "url": "/d/teslasync-efficiency/efficiency", "type": "link" }
  ],
  "panels": [
    {
      "title": "Total Distance (km)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "DS_TESLASYNC_POSTGRESQL" },
      "fieldConfig": { "defaults": { "unit": "km", "decimals": 0, "color": { "fixedColor": "#00f0ff", "mode": "fixed" } } },
      "targets": [{ "rawSql": "SELECT COALESCE(ROUND(SUM(distance_km)::numeric), 0) FROM daily_mileage WHERE vehicle_id = $vehicle_id AND $__timeFilter(date)", "format": "table", "refId": "A" }]
    },
    {
      "title": "Daily Average (km)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "DS_TESLASYNC_POSTGRESQL" },
      "fieldConfig": { "defaults": { "unit": "km", "decimals": 1, "color": { "fixedColor": "#10b981", "mode": "fixed" } } },
      "targets": [{ "rawSql": "SELECT COALESCE(ROUND(AVG(distance_km)::numeric, 1), 0) FROM daily_mileage WHERE vehicle_id = $vehicle_id AND distance_km > 0 AND $__timeFilter(date)", "format": "table", "refId": "A" }]
    },
    {
      "title": "Best Day (km)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "DS_TESLASYNC_POSTGRESQL" },
      "fieldConfig": { "defaults": { "unit": "km", "decimals": 0, "color": { "fixedColor": "#f59e0b", "mode": "fixed" } } },
      "targets": [{ "rawSql": "SELECT COALESCE(ROUND(MAX(distance_km)::numeric), 0) FROM daily_mileage WHERE vehicle_id = $vehicle_id AND $__timeFilter(date)", "format": "table", "refId": "A" }]
    },
    {
      "title": "Tracked Days",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "DS_TESLASYNC_POSTGRESQL" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#a855f7", "mode": "fixed" } } },
      "targets": [{ "rawSql": "SELECT COUNT(*) FROM daily_mileage WHERE vehicle_id = $vehicle_id AND $__timeFilter(date)", "format": "table", "refId": "A" }]
    },
    {
      "title": "Daily Mileage",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "DS_TESLASYNC_POSTGRESQL" },
      "fieldConfig": { "defaults": { "unit": "km", "custom": { "drawStyle": "bars", "fillOpacity": 60 }, "color": { "fixedColor": "#00f0ff", "mode": "fixed" } } },
      "targets": [{ "rawSql": "SELECT date AS time, distance_km FROM daily_mileage WHERE vehicle_id = $vehicle_id AND $__timeFilter(date) ORDER BY date", "format": "time_series", "refId": "A" }]
    },
    {
      "title": "Monthly Mileage",
      "type": "barchart",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "postgres", "uid": "DS_TESLASYNC_POSTGRESQL" },
      "fieldConfig": { "defaults": { "unit": "km", "color": { "fixedColor": "#10b981", "mode": "fixed" } } },
      "targets": [{ "rawSql": "SELECT TO_CHAR(date, 'YYYY-MM') AS month, ROUND(SUM(distance_km)::numeric) AS total_km FROM daily_mileage WHERE vehicle_id = $vehicle_id AND $__timeFilter(date) GROUP BY TO_CHAR(date, 'YYYY-MM') ORDER BY month", "format": "table", "refId": "A" }]
    },
    {
      "title": "Odometer Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "postgres", "uid": "DS_TESLASYNC_POSTGRESQL" },
      "fieldConfig": { "defaults": { "unit": "km", "custom": { "drawStyle": "line", "fillOpacity": 10 }, "color": { "fixedColor": "#a855f7", "mode": "fixed" } } },
      "targets": [{ "rawSql": "SELECT date AS time, odometer_end FROM daily_mileage WHERE vehicle_id = $vehicle_id AND $__timeFilter(date) ORDER BY date", "format": "time_series", "refId": "A" }]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "vehicle_id",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "DS_TESLASYNC_POSTGRESQL" },
        "query": "SELECT id AS __value, COALESCE(display_name, vin) AS __text FROM vehicles ORDER BY id",
        "refresh": 1
      }
    ]
  },
  "time": { "from": "now-1y", "to": "now" },
  "title": "Mileage",
  "uid": "teslasync-mileage"
}
