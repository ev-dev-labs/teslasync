{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 2,
  "id": null,
  "links": [
    { "title": "Drives", "url": "/d/teslasync-drives/drives", "type": "link" }
  ],
  "panels": [
    {
      "title": "Unique Locations",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_TESLASYNC_POSTGRESQL}" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#00f0ff", "mode": "fixed" } } },
      "targets": [{ "rawSql": "SELECT COUNT(DISTINCT address_id) FROM visited_locations WHERE vehicle_id = $vehicle_id", "format": "table", "refId": "A" }]
    },
    {
      "title": "Total Visits",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_TESLASYNC_POSTGRESQL}" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#10b981", "mode": "fixed" } } },
      "targets": [{ "rawSql": "SELECT COALESCE(SUM(visit_count), 0) FROM visited_locations WHERE vehicle_id = $vehicle_id", "format": "table", "refId": "A" }]
    },
    {
      "title": "Total Time at Locations",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_TESLASYNC_POSTGRESQL}" },
      "fieldConfig": { "defaults": { "unit": "h", "decimals": 0, "color": { "fixedColor": "#f59e0b", "mode": "fixed" } } },
      "targets": [{ "rawSql": "SELECT COALESCE(ROUND(SUM(total_duration_min)/60), 0) FROM visited_locations WHERE vehicle_id = $vehicle_id", "format": "table", "refId": "A" }]
    },
    {
      "title": "Most Visited (name)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_TESLASYNC_POSTGRESQL}" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#a855f7", "mode": "fixed" } } },
      "targets": [{ "rawSql": "SELECT a.display_name FROM visited_locations vl JOIN addresses a ON a.id = vl.address_id WHERE vl.vehicle_id = $vehicle_id ORDER BY vl.visit_count DESC LIMIT 1", "format": "table", "refId": "A" }]
    },
    {
      "title": "Top Visited Locations",
      "type": "barchart",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "${DS_TESLASYNC_POSTGRESQL}" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#00f0ff", "mode": "fixed" } } },
      "options": { "orientation": "horizontal" },
      "targets": [{ "rawSql": "SELECT a.display_name AS location, vl.visit_count FROM visited_locations vl JOIN addresses a ON a.id = vl.address_id WHERE vl.vehicle_id = $vehicle_id ORDER BY vl.visit_count DESC LIMIT 20", "format": "table", "refId": "A" }]
    },
    {
      "title": "All Visited Locations",
      "type": "table",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "postgres", "uid": "${DS_TESLASYNC_POSTGRESQL}" },
      "targets": [{ "rawSql": "SELECT a.display_name AS location, vl.visit_count, ROUND(vl.total_duration_min::numeric / 60, 1) AS total_hours, vl.last_visited FROM visited_locations vl JOIN addresses a ON a.id = vl.address_id WHERE vl.vehicle_id = $vehicle_id ORDER BY vl.visit_count DESC LIMIT 100", "format": "table", "refId": "A" }]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "vehicle_id",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "${DS_TESLASYNC_POSTGRESQL}" },
        "query": "SELECT id AS __value, COALESCE(display_name, vin) AS __text FROM vehicles ORDER BY id",
        "refresh": 1
      }
    ]
  },
  "time": { "from": "now-1y", "to": "now" },
  "title": "Visited Locations",
  "uid": "teslasync-locations"
}
