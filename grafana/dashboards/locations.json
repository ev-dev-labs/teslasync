            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  a.latitude,\n  a.longitude,\n  COALESCE(a.display_name, a.city, 'Unknown') AS \"name\",\n  vl.visit_count AS \"visits\",\n  a.city AS \"city\",\n  a.state AS \"state\"\nFROM visited_locations vl\nJOIN addresses a ON vl.address_id = a.id\nWHERE vl.vehicle_id = ${vehicle_id}\n  AND a.latitude IS NOT NULL\nORDER BY vl.visit_count DESC",
          "refId": "A"
        }
      ],
