            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  CASE\n    WHEN a.display_name LIKE '%Home%' OR a.display_name LIKE '%Residence%' THEN '🏠 Home'\n    WHEN a.display_name LIKE '%Office%' THEN '🏢 Work'\n    WHEN a.display_name LIKE '%Supercharger%' THEN '⚡ Supercharger'\n    WHEN a.display_name LIKE '%Hotel%' THEN '🏨 Hotel'\n    WHEN a.display_name LIKE '%Costco%' OR a.display_name LIKE '%Walmart%' THEN '🛒 Shopping'\n    WHEN a.display_name LIKE '%Service%' THEN '🔧 Service'\n    ELSE '📍 Other'\n  END AS \"Type\",\n  SUM(vl.visit_count) AS \"Visits\"\nFROM visited_locations vl\nJOIN addresses a ON vl.address_id = a.id\nWHERE vl.vehicle_id = ${vehicle_id}\nGROUP BY 1\nORDER BY \"Visits\" DESC",
          "refId": "A"
        }
      ],
      "title": "Location Type Distribution",
      "type": "piechart",
      "transparent": false
