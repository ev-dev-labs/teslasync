        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  COUNT(DISTINCT a.city) AS \"🏙️ Cities\",\n  COUNT(DISTINCT a.state) AS \"🗺️ States\",\n  COUNT(*) AS \"📍 Locations\",\n  SUM(vl.visit_count) AS \"🔄 Total Visits\",\n  ROUND(SUM(vl.total_duration_min) / 60) AS \"⏱️ Total Hours\"\nFROM visited_locations vl\nJOIN addresses a ON vl.address_id = a.id\nWHERE vl.vehicle_id = ${vehicle_id}",
          "refId": "A"
        }
      ],
      "title": "Location Summary Stats",
      "type": "stat",
      "transparent": false
    },
