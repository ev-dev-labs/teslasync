          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(a.display_name, a.city, 'Unknown') AS \"Location\",\n  a.city AS \"City\",\n  a.state AS \"State\",\n  vl.visit_count AS \"Visits\",\n  ROUND(vl.total_duration_min::numeric) AS \"Total Minutes\",\n  ROUND((vl.total_duration_min / 60)::numeric, 1) AS \"Total Hours\",\n  vl.last_visited AS \"Last Visited\"\nFROM visited_locations vl\nJOIN addresses a ON vl.address_id = a.id\nWHERE vl.vehicle_id = ${vehicle_id}\nORDER BY vl.visit_count DESC\nLIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Visited Locations",
      "type": "table",
      "transparent": false
