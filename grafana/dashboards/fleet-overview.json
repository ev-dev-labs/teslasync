          "rawSql": "SELECT v.display_name AS \"Vehicle\", ROUND(SUM(d.distance)::numeric, 1) AS \"Distance km\"\nFROM drives d JOIN vehicles v ON d.vehicle_id = v.id\nGROUP BY v.display_name ORDER BY \"Distance km\" DESC",
