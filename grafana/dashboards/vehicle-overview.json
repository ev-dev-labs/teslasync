          "rawSql": "SELECT display_name AS \"Name\", model AS \"Model\", trim_badging AS \"Trim\", vin AS \"VIN\",\n  exterior_color AS \"Color\", wheel_type AS \"Wheels\", state AS \"State\",\n  created_at AS \"Added\"\nFROM vehicles WHERE id = ${vehicle_id}",
