            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT cs.start_date AS \"Date\",\n  COALESCE(a.display_name, 'Unknown') AS \"Location\",\n  ROUND(cs.charge_energy_added::numeric, 1) AS \"kWh\",\n  cs.start_battery_level AS \"Start %\",\n  cs.end_battery_level AS \"End %\",\n  ROUND(cs.duration_min::numeric) AS \"Duration min\"\nFROM charging_sessions cs\nLEFT JOIN addresses a ON cs.address_id = a.id\nWHERE cs.vehicle_id = ${vehicle_id}\nORDER BY cs.start_date DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "title": "Last Charge",
