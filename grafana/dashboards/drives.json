        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TESLASYNC_POSTGRESQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  d.start_date AS \"Date\",\n  COALESCE(sa.display_name, sa.city, 'Unknown') AS \"From\",\n  COALESCE(ea.display_name, ea.city, 'Unknown') AS \"To\",\n  ROUND(d.distance::numeric, 1) AS \"Distance km\",\n  ROUND(d.duration_min::numeric) AS \"Duration min\",\n  ROUND((d.distance / NULLIF(d.duration_min, 0) * 60)::numeric, 1) AS \"Avg km/h\",\n  ROUND(d.speed_max::numeric) AS \"Max km/h\",\n  d.start_battery_level AS \"Battery Start %\",\n  d.end_battery_level AS \"Battery End %\",\n  ROUND(d.start_range_km::numeric, 1) AS \"Start Range km\",\n  ROUND(d.end_range_km::numeric, 1) AS \"End Range km\",\n  ROUND(d.outside_temp_avg::numeric, 1) AS \"Temp °C\"\nFROM drives d\nLEFT JOIN addresses sa ON d.start_address_id = sa.id\nLEFT JOIN addresses ea ON d.end_address_id = ea.id\nWHERE d.vehicle_id = ${vehicle_id}\n  AND $__timeFilter(d.start_date)\nORDER BY d.start_date DESC\nLIMIT 200",
          "refId": "A"
        }
      ],
      "title": "Drive History",
      "type": "table",
      "transparent": false
    }
