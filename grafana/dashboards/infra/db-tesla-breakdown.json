{
  "uid": "teslasync-infra-db-tesla-breakdown",
  "title": "TeslaSync - DB & Tesla API Span Breakdown (Tempo)",
  "description": "Requires OTEL_ENABLED=true and docker compose --profile tracing up.",
  "tags": [
    "teslasync",
    "infra",
    "tempo",
    "tracing",
    "database",
    "tesla-api"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Database — span breakdown by db.system",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "DB call rate",
      "description": "Rate of CLIENT-kind spans tagged with `db.system` (postgresql / redis). Sourced from span_metrics.",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "ops" } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "sum(rate(traces_spanmetrics_calls_total{db_system!=\"\", span_kind=\"SPAN_KIND_CLIENT\"}[5m]))", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "DB error %",
      "description": "Errored DB-call fraction. Postgres errors usually mean SQL violation, deadlock, or pool exhaustion; Redis errors usually mean connection drop or timeout.",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 2 }] }, "unit": "percent" } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "100 * sum(rate(traces_spanmetrics_calls_total{db_system!=\"\", span_kind=\"SPAN_KIND_CLIENT\", status_code=\"STATUS_CODE_ERROR\"}[5m])) / clamp_min(sum(rate(traces_spanmetrics_calls_total{db_system!=\"\", span_kind=\"SPAN_KIND_CLIENT\"}[5m])), 0.001)", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "DB P95 latency",
      "description": "Aggregate DB-call P95 across all systems.",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.5 }] }, "unit": "s" } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{db_system!=\"\", span_kind=\"SPAN_KIND_CLIENT\"}[5m])))", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "DB P95 latency split by db.system",
      "description": "Postgres vs Redis P95 over time. Diverging trends point at one specific datastore.",
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": true }, "unit": "s" } },
      "options": { "legend": { "calcs": ["max"], "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "histogram_quantile(0.95, sum by (db_system, le) (rate(traces_spanmetrics_latency_bucket{db_system!=\"\", span_kind=\"SPAN_KIND_CLIENT\"}[5m])))", "legendFormat": "{{db_system}}", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top 20 slowest DB span_names (P95)",
      "description": "Slowest individual DB operations. Each row is one (service, span_name) pair — the span_name typically encodes the operation (e.g., `pgx.Query SELECT signal_log`).",
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 10 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "displayMode": "auto" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "s" }, "overrides": [{ "matcher": { "id": "byName", "options": "service" }, "properties": [{ "id": "unit", "value": "string" }] }, { "matcher": { "id": "byName", "options": "span_name" }, "properties": [{ "id": "unit", "value": "string" }] }, { "matcher": { "id": "byName", "options": "db_system" }, "properties": [{ "id": "unit", "value": "string" }] }] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "P95 latency", "desc": true }] },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "topk(20, histogram_quantile(0.95, sum by (service, span_name, db_system, le) (rate(traces_spanmetrics_latency_bucket{db_system!=\"\", span_kind=\"SPAN_KIND_CLIENT\"}[5m]))))", "refId": "A", "instant": true, "format": "table" }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true }, "renameByName": { "Value": "P95 latency" } } }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top 20 most-called DB span_names",
      "description": "High-volume queries. Combine with the slow-table on the left for a risk × volume ranking.",
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 10 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "displayMode": "auto" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "ops" }, "overrides": [{ "matcher": { "id": "byName", "options": "service" }, "properties": [{ "id": "unit", "value": "string" }] }, { "matcher": { "id": "byName", "options": "span_name" }, "properties": [{ "id": "unit", "value": "string" }] }, { "matcher": { "id": "byName", "options": "db_system" }, "properties": [{ "id": "unit", "value": "string" }] }] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "calls/s", "desc": true }] },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "topk(20, sum by (service, span_name, db_system) (rate(traces_spanmetrics_calls_total{db_system!=\"\", span_kind=\"SPAN_KIND_CLIENT\"}[5m])))", "refId": "A", "instant": true, "format": "table" }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true }, "renameByName": { "Value": "calls/s" } } }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 7,
      "type": "traces",
      "title": "Slow DB traces (db span > 200ms)",
      "description": "Native TraceQL drill-in. Click a trace to see which upstream request triggered the slow query and the SQL statement attribute.",
      "gridPos": { "x": 0, "y": 19, "w": 24, "h": 8 },
      "options": {},
      "targets": [{ "datasource": { "type": "tempo", "uid": "DS_TESLASYNC_TEMPO" }, "queryType": "traceql", "query": "{ span.db.system != nil && duration > 200ms }", "limit": 30, "refId": "A" }],
      "datasource": { "type": "tempo", "uid": "DS_TESLASYNC_TEMPO" }
    },

    {
      "id": 200,
      "type": "row",
      "title": "Tesla API — outbound HTTP CLIENT spans",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Tesla API call rate",
      "description": "CLIENT-kind spans whose service name is the Tesla client. Identifies outbound calls to the Tesla Fleet API.",
      "gridPos": { "x": 0, "y": 28, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "ops" } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "sum(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_CLIENT\", span_name=~\"(?i)tesla.*|.*fleet.*|.*tesla-api.*\"}[5m]))", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Tesla API error %",
      "description": "Tesla-side error fraction. Common causes: vehicle offline, OAuth token expired, fleet API rate limit (429).",
      "gridPos": { "x": 4, "y": 28, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 10 }] }, "unit": "percent" } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "100 * sum(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_CLIENT\", span_name=~\"(?i)tesla.*|.*fleet.*|.*tesla-api.*\", status_code=\"STATUS_CODE_ERROR\"}[5m])) / clamp_min(sum(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_CLIENT\", span_name=~\"(?i)tesla.*|.*fleet.*|.*tesla-api.*\"}[5m])), 0.001)", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Tesla API P95",
      "description": "Tesla-side P95 latency. Fleet API typically returns in <500ms; sustained P95 above 1s often means region-wide degradation.",
      "gridPos": { "x": 8, "y": 28, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 }] }, "unit": "s" } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_CLIENT\", span_name=~\"(?i)tesla.*|.*fleet.*|.*tesla-api.*\"}[5m])))", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Tesla API latency by span (P95)",
      "description": "Per-operation P95 for outbound Tesla client spans, grouped by the span_name label emitted by Tempo span metrics.",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": true }, "unit": "s" } },
      "options": { "legend": { "calcs": ["max"], "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "topk(8, histogram_quantile(0.95, sum by (span_name, le) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_CLIENT\", span_name=~\"(?i)tesla.*|.*fleet.*|.*tesla-api.*\"}[5m]))))", "legendFormat": "{{span_name}}", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Tesla API errors by HTTP status",
      "description": "Per-status-code error rate. 401/403 = auth issues; 408/504 = timeouts; 429 = rate limit; 5xx = Tesla outage.",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 30, "lineWidth": 2, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "normal" } }, "unit": "ops" } },
      "options": { "legend": { "calcs": ["max"], "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "sum by (http_response_status_code) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_CLIENT\", span_name=~\"(?i)tesla.*|.*fleet.*|.*tesla-api.*\", http_response_status_code!~\"2..|^$\"}[5m]))", "legendFormat": "{{http_response_status_code}}", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 13,
      "type": "traces",
      "title": "Slow Tesla API traces (>2s)",
      "description": "Native Tempo TraceQL — slow Tesla CLIENT spans with full request context.",
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
      "options": {},
      "targets": [{ "datasource": { "type": "tempo", "uid": "DS_TESLASYNC_TEMPO" }, "queryType": "traceql", "query": "{ span.kind = \"client\" && span.url.full =~ \".*tesla.*\" && duration > 2s }", "limit": 30, "refId": "A" }],
      "datasource": { "type": "tempo", "uid": "DS_TESLASYNC_TEMPO" }
    }
  ],
