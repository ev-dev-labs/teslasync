{
  "uid": "teslasync-infra-service-red",
  "title": "TeslaSync - Service RED (Tempo span-metrics)",
  "description": "Requires OTEL_ENABLED=true and docker compose --profile tracing up.",
  "tags": [
    "teslasync",
    "infra",
    "tempo",
    "tracing"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "DS_TESLASYNC_PROMETHEUS"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(traces_spanmetrics_calls_total, service)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "hide": 0,
        "skipUrlSync": false,
        "allValue": ".+"
      },
      {
        "name": "span_kind",
        "label": "Span Kind",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "DS_TESLASYNC_PROMETHEUS"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(traces_spanmetrics_calls_total{service=~\"$service\"}, span_kind)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "hide": 0,
        "skipUrlSync": false,
        "allValue": ".+"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Golden Signals (RED)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Request Rate (req/s)",
      "description": "Total span call rate across selected services. Derived from sampled spans by Tempo's metrics_generator (span_metrics processor).",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=~\"$span_kind\"}[5m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Rate %",
      "description": "Percentage of spans whose status_code is ERROR. Computed across the selected service+span_kind window.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "100 * sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=~\"$span_kind\", status_code=\"STATUS_CODE_ERROR\"}[5m])) / clamp_min(sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=~\"$span_kind\"}[5m])), 0.001)",
          "legendFormat": "error %",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P95 Latency",
      "description": "P95 of span latency histogram, summed across selected services.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_kind=~\"$span_kind\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "P99 Latency",
      "description": "P99 of span latency histogram. Tail-sensitive; spike here without a P95 spike usually means a slow outlier path (cold cache, retry, GC pause).",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_kind=~\"$span_kind\"}[5m])))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Per-Service Trends",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request Rate by Service",
      "description": "Span call rate broken out per service. Spikes here on a service that doesn't normally peak point at retry storms or upstream fan-out.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "req/s",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=~\"$span_kind\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error Rate by Service",
      "description": "Errored span rate per service.",
      "gridPos": {
        "x": 12,
