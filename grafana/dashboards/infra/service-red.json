            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "topk(20, sum by (service, span_name) (rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=~\"$span_kind\"}[5m])))",
          "legendFormat": "{{service}} / {{span_name}}",
          "refId": "A",
