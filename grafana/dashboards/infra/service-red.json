            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_kind=~\"$span_kind\"}[5m])))",
          "legendFormat": "P50",
          "refId": "A",
          "exemplar": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_kind=~\"$span_kind\"}[5m])))",
          "legendFormat": "P95",
          "refId": "B",
          "exemplar": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_kind=~\"$span_kind\"}[5m])))",
          "legendFormat": "P99",
          "refId": "C",
          "exemplar": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
