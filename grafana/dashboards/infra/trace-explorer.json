{
  "uid": "teslasync-infra-trace-explorer",
  "title": "TeslaSync - Trace Explorer (Tempo TraceQL)",
  "description": "Requires OTEL_ENABLED=true and docker compose --profile tracing up.",
  "tags": [
    "teslasync",
    "infra",
    "tempo",
    "tracing",
    "traceql"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "min_duration_ms",
        "label": "Min duration (ms)",
        "type": "textbox",
        "current": {
          "text": "500",
          "value": "500"
        },
        "query": "500",
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "vehicle_id",
        "label": "Vehicle",
        "type": "query",
        "current": {
          "selected": true,
          "text": "(none)",
          "value": "0"
        },
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "DS_TESLASYNC_POSTGRESQL"
        },
        "definition": "SELECT id AS __value, display_name AS __text FROM vehicles WHERE archived_at IS NULL UNION ALL SELECT 0::bigint, '(none)'::text ORDER BY __text",
        "query": "SELECT id AS __value, display_name AS __text FROM vehicles WHERE archived_at IS NULL UNION ALL SELECT 0::bigint, '(none)'::text ORDER BY __text",
        "options": [],
        "refresh": 1,
        "regex": "",
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "skipUrlSync": false,
        "sort": 0,
        "description": "Vehicle filter for spans carrying vehicle_id or vehicle.id."
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Sampling & Pipeline Health",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Spans Received/s",
      "description": "Rate of spans hitting the OTel collector OTLP receiver. Sum across both gRPC and HTTP transports.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "ops"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_spans[5m]))",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Spans Forwarded to Tempo/s",
      "description": "Spans successfully exported to Tempo. This works with both the unsampled compose collector and the tail-sampled Helm collector.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "ops"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "sum(rate(otelcol_exporter_sent_spans{exporter=~\"otlp(/tempo|http/tempo)\"}[5m])) or vector(0)",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tempo Export Queue Depth",
      "description": "Spans waiting in the Tempo export queue. A sustained increase indicates that Tempo or the collector-to-Tempo path cannot keep up.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              }
            ]
          },
          "unit": "none"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "sum(otelcol_exporter_queue_size{exporter=~\"otlp(/tempo|http/tempo)\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tempo Ingester Bytes",
      "description": "Bytes received by Tempo's distributor. Should match (sampled-spans/s × avg span size).",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "Bps"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "sum(rate(tempo_distributor_bytes_received_total[5m]))",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Trace Search",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "traces",
      "title": "Slow Traces (duration > $min_duration_ms ms)",
      "description": "All traces whose root-span duration exceeds the threshold. Click any row to open the flame graph in the Tempo explore view.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 10
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "DS_TESLASYNC_TEMPO"
          },
          "queryType": "traceql",
          "query": "{ duration > ${min_duration_ms}ms }",
          "limit": 50,
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "tempo",
        "uid": "DS_TESLASYNC_TEMPO"
      }
    },
    {
      "id": 6,
      "type": "traces",
      "title": "Error Traces",
      "description": "All traces whose root span finished with status=error. Helm tail sampling retains errors; the compose collector exports every trace.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 10
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "DS_TESLASYNC_TEMPO"
          },
          "queryType": "traceql",
          "query": "{ status = error }",
          "limit": 50,
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "tempo",
        "uid": "DS_TESLASYNC_TEMPO"
      }
    },
    {
      "id": 7,
      "type": "traces",
      "title": "Vehicle-Specific Traces (vehicle_id=$vehicle_id)",
      "description": "Filters by the `vehicle_id` resource/span attribute. Set the Vehicle ID variable above. Leave blank to disable this panel.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 10
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "DS_TESLASYNC_TEMPO"
          },
          "queryType": "traceql",
          "query": "{ span.vehicle_id = ${vehicle_id} || span.vehicle.id = ${vehicle_id} }",
          "limit": 50,
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "tempo",
        "uid": "DS_TESLASYNC_TEMPO"
      }
    },
    {
      "id": 300,
      "type": "row",
      "title": "Critical Flows",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "traces",
      "title": "OAuth Initiation Traces",
      "description": "GET /api/v1/auth/login traces for OAuth state creation and Tesla authorization-URL generation. Helm retains these via its always-sample policy; compose exports every trace.",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 10
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "DS_TESLASYNC_TEMPO"
          },
          "queryType": "traceql",
          "query": "{ span.http.route = \"/api/v1/auth/login\" }",
          "limit": 50,
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "tempo",
        "uid": "DS_TESLASYNC_TEMPO"
      }
    },
    {
      "id": 9,
      "type": "traces",
      "title": "Wake-Command Traces",
      "description": "POST /vehicles/{vehicleID}/wake — critical flow with full instrumentation. Useful for diagnosing slow wakes (Tesla API + auth + retry).",
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 10
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "DS_TESLASYNC_TEMPO"
          },
          "queryType": "traceql",
          "query": "{ span.http.route =~ \".*/vehicles/.*/wake.*\" }",
          "limit": 50,
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "tempo",
        "uid": "DS_TESLASYNC_TEMPO"
      }
    },
    {
      "id": 10,
      "type": "traces",
      "title": "MQTT Pipeline Traces",
      "description": "MQTT consume → normalize → store. Phase-44 instrumented; tracks fleet-telemetry ingestion latency end-to-end.",
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 10
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "DS_TESLASYNC_TEMPO"
          },
          "queryType": "traceql",
          "query": "{ name =~ \"mqtt.*\" || name =~ \"normalize.*\" }",
          "limit": 50,
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "tempo",
        "uid": "DS_TESLASYNC_TEMPO"
      }
    }
  ],
