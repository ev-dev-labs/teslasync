{
  "uid": "teslasync-infra-service-graph",
  "title": "TeslaSync - Service Graph & Dependencies (Tempo)",
  "description": "Requires OTEL_ENABLED=true and docker compose --profile tracing up.",
  "tags": [
    "teslasync",
    "infra",
    "tempo",
    "tracing"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "client",
        "label": "Client (caller)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "DS_TESLASYNC_PROMETHEUS"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(traces_service_graph_request_total, client)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "hide": 0,
        "skipUrlSync": false,
        "allValue": ".+"
      },
      {
        "name": "server",
        "label": "Server (callee)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "DS_TESLASYNC_PROMETHEUS"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(traces_service_graph_request_total, server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "hide": 0,
        "skipUrlSync": false,
        "allValue": ".+"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Health Snapshot",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Active Edges",
      "description": "Distinct (client → server) pairs with traffic in the last 5 minutes. Sudden drop usually indicates a service crash.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "none"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "count(sum by (client, server) (rate(traces_service_graph_request_total{client=~\"$client\", server=~\"$server\"}[5m])) > 0)",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Requests/s",
      "description": "Aggregate request rate across all (client → server) edges.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "sum(rate(traces_service_graph_request_total{client=~\"$client\", server=~\"$server\"}[5m]))",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed Requests/s",
      "description": "Edges flagged as failed by Tempo's service-graph processor (server span had ERROR status).",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "reqps"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "sum(rate(traces_service_graph_request_failed_total{client=~\"$client\", server=~\"$server\"}[5m]))",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unpaired Spans/s",
      "description": "Spans that the processor couldn't pair with the matching client/server side within the lookback window. Persistent non-zero suggests a missing traceparent propagation hop or a tail-sampling drop on one end.",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "unit": "reqps"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "sum(rate(traces_service_graph_unpaired_spans_total[5m]))",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Per-Edge Detail",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top Edges (req/s, error %, server p95)",
      "description": "All discovered (client → server) edges with their request rate, error rate, and server-side p95 latency. Sort by error % to find broken edges, by p95 to find slow links.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "req/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "server p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "client p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "req/s",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "sum by (client, server) (rate(traces_service_graph_request_total{client=~\"$client\", server=~\"$server\"}[5m]))",
          "legendFormat": "{{client}} -> {{server}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "100 * sum by (client, server) (rate(traces_service_graph_request_failed_total{client=~\"$client\", server=~\"$server\"}[5m])) / clamp_min(sum by (client, server) (rate(traces_service_graph_request_total{client=~\"$client\", server=~\"$server\"}[5m])), 0.001)",
          "legendFormat": "{{client}} -> {{server}}",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "histogram_quantile(0.95, sum by (client, server, le) (rate(traces_service_graph_request_server_seconds_bucket{client=~\"$client\", server=~\"$server\"}[5m])))",
          "legendFormat": "{{client}} -> {{server}}",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "histogram_quantile(0.95, sum by (client, server, le) (rate(traces_service_graph_request_client_seconds_bucket{client=~\"$client\", server=~\"$server\"}[5m])))",
          "legendFormat": "{{client}} -> {{server}}",
          "refId": "D",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value #A": "req/s",
              "Value #B": "error %",
              "Value #C": "server p95",
              "Value #D": "client p95"
            },
            "indexByName": {
              "client": 0,
              "server": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 300,
      "type": "row",
      "title": "Latency Trends",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Server-Side P95 Latency by Edge",
      "description": "Latency measured from the server's perspective (time the callee spent processing). Compare with client-p95 — large delta = network or queue time.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "calcs": [
            "max"
          ],
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "topk(8, histogram_quantile(0.95, sum by (client, server, le) (rate(traces_service_graph_request_server_seconds_bucket{client=~\"$client\", server=~\"$server\"}[5m]))))",
          "legendFormat": "{{client}} -> {{server}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Client-Side P95 Latency by Edge",
      "description": "Latency measured from the caller's perspective (time the call took including network). Server-p95 vs client-p95 gap = network/serialization overhead.",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "calcs": [
            "max"
          ],
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "topk(8, histogram_quantile(0.95, sum by (client, server, le) (rate(traces_service_graph_request_client_seconds_bucket{client=~\"$client\", server=~\"$server\"}[5m]))))",
          "legendFormat": "{{client}} -> {{server}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 400,
      "type": "row",
      "title": "Connection-Type Mix",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Requests by Connection Type",
      "description": "Mix of edge types (messaging = MQTT, database = postgres, virtual_node = HTTP without paired client). Helps verify expected traffic shape.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "unit": "reqps"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "displayLabels": [
          "name",
          "percent"
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "sum by (connection_type) (rate(traces_service_graph_request_total{client=~\"$client\", server=~\"$server\"}[5m]))",
          "legendFormat": "{{connection_type}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Failures by Edge Over Time",
      "description": "Per-edge failed-request rate over time. Correlate spikes here with deploys / incidents in other dashboards.",
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 16,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "reqps"
        }
      },
      "options": {
        "legend": {
          "calcs": [
            "max"
          ],
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_TESLASYNC_PROMETHEUS"
          },
          "expr": "sum by (client, server) (rate(traces_service_graph_request_failed_total{client=~\"$client\", server=~\"$server\"}[5m])) > 0",
          "legendFormat": "{{client}} -> {{server}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      }
    }
  ],
