{
  "uid": "teslasync-infra-auth-deep-dive",
  "title": "TeslaSync - Auth Login Deep-Dive (always-sampled)",
  "tags": [
    "teslasync",
    "infra",
    "tempo",
    "tracing",
    "auth",
    "security"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Headline — POST /api/v1/auth/login (100% sampled)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Login attempts/s",
      "description": "POST /auth/login server-span rate. The OTel collector's `auth-login-always` policy keeps 100% of these traces — distribution numbers are exact, not sampled estimates.",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 50 }] }, "unit": "reqps" } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "sum(rate(traces_spanmetrics_calls_total{http_route=\"/api/v1/auth/login\", span_kind=\"SPAN_KIND_SERVER\"}[5m]))", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failure rate %",
      "description": "Failed-login fraction. Sustained > 30% during normal hours suggests credential stuffing.",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 30 }] }, "unit": "percent" } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "100 * sum(rate(traces_spanmetrics_calls_total{http_route=\"/api/v1/auth/login\", span_kind=\"SPAN_KIND_SERVER\", http_status_code!~\"2..\"}[5m])) / clamp_min(sum(rate(traces_spanmetrics_calls_total{http_route=\"/api/v1/auth/login\", span_kind=\"SPAN_KIND_SERVER\"}[5m])), 0.001)", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Login P50",
      "description": "Median login latency. Most of this is bcrypt cost.",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "s" } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_spanmetrics_latency_bucket{http_route=\"/api/v1/auth/login\", span_kind=\"SPAN_KIND_SERVER\"}[5m])))", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Login P99",
      "description": "Tail latency. Spike here without P50 movement = slow code path (e.g., user not found → still doing bcrypt; or DB lookup blocked).",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 }] }, "unit": "s" } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_spanmetrics_latency_bucket{http_route=\"/api/v1/auth/login\", span_kind=\"SPAN_KIND_SERVER\"}[5m])))", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Distinct trace IDs (1h)",
      "description": "Unique attempts in the last hour. Useful baseline for detecting bursts.",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "none" } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "sum(increase(traces_spanmetrics_calls_total{http_route=\"/api/v1/auth/login\", span_kind=\"SPAN_KIND_SERVER\"}[1h]))", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Trends",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Login attempts vs failures over time",
      "description": "Stacked: green=success (2xx), red=4xx (bad credentials / rate-limited), yellow=5xx (server error).",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 30, "lineWidth": 2, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "normal" } }, "unit": "reqps" }, "overrides": [{ "matcher": { "id": "byRegexp", "options": "^2..$" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }, { "matcher": { "id": "byRegexp", "options": "^4..$" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }, { "matcher": { "id": "byRegexp", "options": "^5..$" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] }] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "sum by (http_status_code) (rate(traces_spanmetrics_calls_total{http_route=\"/api/v1/auth/login\", span_kind=\"SPAN_KIND_SERVER\"}[5m]))", "legendFormat": "{{http_status_code}}", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Login latency P50 / P95 / P99 (with exemplars)",
      "description": "Click an exemplar dot to jump to that specific login trace in Tempo. Useful for inspecting outlier failures.",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": true }, "unit": "s" } },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_spanmetrics_latency_bucket{http_route=\"/api/v1/auth/login\", span_kind=\"SPAN_KIND_SERVER\"}[5m])))", "legendFormat": "P50", "refId": "A", "exemplar": true },
        { "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{http_route=\"/api/v1/auth/login\", span_kind=\"SPAN_KIND_SERVER\"}[5m])))", "legendFormat": "P95", "refId": "B", "exemplar": true },
        { "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_spanmetrics_latency_bucket{http_route=\"/api/v1/auth/login\", span_kind=\"SPAN_KIND_SERVER\"}[5m])))", "legendFormat": "P99", "refId": "C", "exemplar": true }
      ],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 300,
      "type": "row",
      "title": "Burst Detection",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Failed-login burst rate (5m vs 1h baseline)",
      "description": "Ratio of 5-minute failed-login rate to 1-hour baseline. Sustained > 5 = something abnormal (deploy, bot, leak).",
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 8 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never", "spanNulls": true, "thresholdsStyle": { "mode": "line+area" } }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 3 }, { "color": "red", "value": 5 }] }, "unit": "none" } },
      "options": { "legend": { "calcs": ["max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "(sum(rate(traces_spanmetrics_calls_total{http_route=\"/api/v1/auth/login\", http_status_code=~\"4..\"}[5m]))) / clamp_min(sum(rate(traces_spanmetrics_calls_total{http_route=\"/api/v1/auth/login\", http_status_code=~\"4..\"}[1h])), 0.001)", "legendFormat": "burst ratio", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 400,
      "type": "row",
      "title": "Trace-level Detail",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "traces",
      "title": "Recent failed-login traces (4xx)",
      "description": "All 4xx login attempts. Inspect headers / IP / user-agent in the trace tags to spot bot patterns.",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 10 },
      "options": {},
      "targets": [{ "datasource": { "type": "tempo", "uid": "DS_TESLASYNC_TEMPO" }, "queryType": "traceql", "query": "{ span.http.route = \"/api/v1/auth/login\" && span.http.status_code >= 400 && span.http.status_code < 500 }", "limit": 50, "refId": "A" }],
      "datasource": { "type": "tempo", "uid": "DS_TESLASYNC_TEMPO" }
    },
    {
      "id": 10,
      "type": "traces",
      "title": "Slow login traces (>1s)",
      "description": "Slow logins. P99 spike investigation starts here — typical cause is the user-not-found path doing dummy bcrypt to prevent timing attacks.",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 10 },
      "options": {},
      "targets": [{ "datasource": { "type": "tempo", "uid": "DS_TESLASYNC_TEMPO" }, "queryType": "traceql", "query": "{ span.http.route = \"/api/v1/auth/login\" && duration > 1s }", "limit": 30, "refId": "A" }],
      "datasource": { "type": "tempo", "uid": "DS_TESLASYNC_TEMPO" }
    }
  ]
}
