{
  "uid": "teslasync-infra-slo-burn",
  "title": "TeslaSync - SLO / Error Budget Board",
  "description": "Requires OTEL_ENABLED=true and docker compose --profile tracing up.",
  "tags": [
    "teslasync",
    "infra",
    "tempo",
    "tracing",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "availability_objective",
        "label": "Availability objective",
        "type": "custom",
        "current": { "text": "0.999", "value": "0.999" },
        "query": "0.99,0.995,0.999,0.9995,0.9999",
        "options": [
          { "text": "99% (7h 12m / month)", "value": "0.99", "selected": false },
          { "text": "99.5% (3h 36m / month)", "value": "0.995", "selected": false },
          { "text": "99.9% (43m / month)", "value": "0.999", "selected": true },
          { "text": "99.95% (21m / month)", "value": "0.9995", "selected": false },
          { "text": "99.99% (4-nines: 4m / month)", "value": "0.9999", "selected": false }
        ],
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "latency_objective_seconds",
        "label": "Latency objective (P95)",
        "type": "custom",
        "current": { "text": "500 ms", "value": "0.5" },
        "query": "250 ms : 0.25,500 ms : 0.5,1 s : 1,2.5 s : 2.5,5 s : 5",
        "options": [
          { "text": "250 ms", "value": "0.25", "selected": false },
          { "text": "500 ms", "value": "0.5", "selected": true },
          { "text": "1 s", "value": "1", "selected": false },
          { "text": "2.5 s", "value": "2.5", "selected": false },
          { "text": "5 s", "value": "5", "selected": false }
        ],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Availability SLO — non-5xx HTTP responses",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "30d availability SLI",
      "description": "Non-5xx server-span fraction over 30 days. The SLI = good_events / total_events.",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.99 }, { "color": "green", "value": 0.999 }] }, "unit": "percentunit", "decimals": 4 } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "sum(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", http_response_status_code!~\"5..\"}[30d])) / clamp_min(sum(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[30d])), 0.001)", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error budget remaining",
      "description": "1 - (1 - SLI) / (1 - objective). Negative = budget blown. Positive = headroom remaining.",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0 }, { "color": "green", "value": 0.5 }] }, "unit": "percentunit" } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "1 - (1 - (sum(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", http_response_status_code!~\"5..\"}[30d])) / clamp_min(sum(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[30d])), 0.001))) / (1 - $availability_objective)", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "1h burn rate",
      "description": "Error rate over the last 1h, normalised by the budget. Burn > 14.4 in a 1h window means the entire 30d budget would be spent in <2 days at this rate (alert-worthy per the multi-window multi-burn-rate methodology).",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "orange", "value": 6 }, { "color": "red", "value": 14.4 }] }, "unit": "none", "decimals": 2 } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "(sum(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", http_response_status_code=~\"5..\"}[1h])) / clamp_min(sum(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[1h])), 0.001)) / (1 - $availability_objective)", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "6h burn rate",
      "description": "Slower 6h window. Burn > 6 in this window also fires the page (paired with 1h burn > 14.4 in standard SRE practice — see Google SRE Workbook ch4).",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "orange", "value": 3 }, { "color": "red", "value": 6 }] }, "unit": "none", "decimals": 2 } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "(sum(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", http_response_status_code=~\"5..\"}[6h])) / clamp_min(sum(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[6h])), 0.001)) / (1 - $availability_objective)", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error budget burndown (30d, with exemplars)",
      "description": "Cumulative bad events over the 30d window. Steeper slope = budget burning faster. Exemplar dots link to the specific failed traces in Tempo.",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 9 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never", "spanNulls": true }, "unit": "percentunit", "decimals": 4 } },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "1 - (sum(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", http_response_status_code!~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])), 0.001))", "legendFormat": "instantaneous error rate", "refId": "A", "exemplar": true },
        { "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "1 - $availability_objective", "legendFormat": "objective threshold", "refId": "B" }
      ],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Latency SLO — P95 < ${latency_objective_seconds}s",
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "type": "stat",
      "title": "30d latency compliance",
      "description": "Fraction of requests served under the configured P95 threshold over 30 days.",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.99 }] }, "unit": "percentunit", "decimals": 3 } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "sum(rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\", le=\"${latency_objective_seconds}\"}[30d])) / clamp_min(sum(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[30d])), 0.001)", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Live P95 vs latency objective",
      "description": "Server-side P95 with the latency objective overlaid. Sustained P95 above the objective = paging condition.",
      "gridPos": { "x": 6, "y": 16, "w": 18, "h": 8 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": true, "thresholdsStyle": { "mode": "line" } }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.5 }] }, "unit": "s" } },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\"}[5m])))", "legendFormat": "p95", "refId": "A", "exemplar": true },
        { "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "${latency_objective_seconds}", "legendFormat": "objective", "refId": "B" }
      ],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 300,
      "type": "row",
      "title": "Failure Drill-In",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top 20 services driving budget burn (1h)",
      "description": "Services ranked by the 5xx error rate they're producing in the last hour. Click into a service in the Service RED dashboard for detail.",
      "gridPos": { "x": 0, "y": 25, "w": 12, "h": 10 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "displayMode": "auto" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "ops" }, "overrides": [{ "matcher": { "id": "byName", "options": "service" }, "properties": [{ "id": "unit", "value": "string" }] }] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "5xx/s", "desc": true }] },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }, "expr": "topk(20, sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", http_response_status_code=~\"5..\"}[1h])))", "refId": "A", "instant": true, "format": "table" }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true }, "renameByName": { "Value": "5xx/s" } } }],
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" }
    },
    {
      "id": 9,
      "type": "traces",
      "title": "Recent server errors (5xx)",
      "description": "Native TraceQL — every 5xx server trace. Always-sampled per the OTel collector errors-always policy.",
      "gridPos": { "x": 12, "y": 25, "w": 12, "h": 10 },
      "options": {},
      "targets": [{ "datasource": { "type": "tempo", "uid": "DS_TESLASYNC_TEMPO" }, "queryType": "traceql", "query": "{ span.kind = \"server\" && span.http.response.status_code >= 500 }", "limit": 50, "refId": "A" }],
      "datasource": { "type": "tempo", "uid": "DS_TESLASYNC_TEMPO" }
    }
  ],
  "links": [
    {
      "asDropdown": false,
      "icon": "bolt",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "◀ Prev",
      "tooltip": "TeslaSync - Sessions & Business Metrics",
      "type": "link",
      "url": "/d/teslasync-infra-sessions"
    },
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "teslasync"
      ],
      "targetBlank": false,
      "title": "⚡ TeslaSync",
      "type": "dashboards"
    },
    {
      "asDropdown": false,
      "icon": "bolt",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Next ▶",
      "tooltip": "TeslaSync - SSE & Real-Time",
      "type": "link",
      "url": "/d/teslasync-infra-sse"
    }
  ]
}
