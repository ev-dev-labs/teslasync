# Build stage
FROM golang:1.25-alpine@sha256:8d22e29d960bc50cd025d93d5b7c7d220b1ee9aa7a239b3c8f55a57e987e8d45 AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /src

COPY go.mod ./
COPY go.sum* ./
RUN go mod download 2>/dev/null || true

COPY . .
RUN go mod tidy

ARG VERSION=dev

RUN GOMEMLIMIT=2GiB CGO_ENABLED=0 GOOS=linux go build \
    -p 2 \
    -gcflags=all=-l \
    -ldflags="-s -w -X main.Version=${VERSION}" \
    -o /bin/backup ./cmd/backup

# Runtime stage — Alpine is required because we shell out to pg_dump.
# Distroless would be smaller but would force vendoring pg_dump's
# native code, defeating the point of using the canonical tool.
#
# postgresql17-client matches the postgresql.image.tag (timescaledb-ha:pg17)
# default. pg_dump versions must be >= the source server's major; pg17
# can dump from pg15/16/17 servers, so this image works against any
# Postgres the chart can deploy today.
FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc

RUN apk add --no-cache \
        postgresql17-client \
        ca-certificates \
        tzdata \
    && addgroup -S -g 65532 nonroot \
    && adduser -S -u 65532 -G nonroot nonroot

COPY --from=builder /bin/backup /usr/local/bin/backup

USER 65532:65532

ENTRYPOINT ["backup"]
