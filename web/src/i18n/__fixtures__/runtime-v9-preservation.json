      "hunks": [
        {"start": 0, "old": ["import { startTransition, useMemo, useEffect, useRef, useCallback, useState } from 'react';", "import { useParams, Link, useSearchParams } from 'react-router-dom';"], "new": ["import { useMemo, useEffect, useRef, useCallback, useState } from 'react';", "import { useParams, Link, useSearchParams, useLocation } from 'react-router-dom';"]},
        {"start": 279, "old": ["  const [pendingUrlWrite, setPendingUrlWrite] = useState<{", "    id: string;", "    progress: number;", "    playing: boolean;", "  } | null>(null);"], "new": ["  const { pathname } = useLocation();", "  const latestUrlWriterRef = useRef({", "    id, pathname, progress: replay.progress, playing: replay.isPlaying,", "    sampleCount: positions.length, setSearchParams,", "  });", "  latestUrlWriterRef.current = {", "    id, pathname, progress: replay.progress, playing: replay.isPlaying,", "    sampleCount: positions.length, setSearchParams,", "  };"]},
        {"start": 323, "old": ["      // Match Router's transitions rather than overtaking a pending navigation.", "      startTransition(() => {", "        setPendingUrlWrite({ id, progress: snapshotProgress, playing: snapshotPlaying });", "      });"], "new": ["      const writer = latestUrlWriterRef.current;", "      if (writer.id !== id || writer.sampleCount === 0", "        || writer.progress !== snapshotProgress || writer.playing !== snapshotPlaying) return;", "      // BrowserRouter's rendered query can lag navigation already written to history.", "      const currentUrl = new URL(window.location.href);", "      if (currentUrl.pathname !== writer.pathname) return;", "      const prev = currentUrl.searchParams;", "      const next = new URLSearchParams(prev);", "      if (snapshotProgress > 0 && snapshotProgress < 1) {", "        next.set('at', snapshotProgress.toFixed(3));", "      } else {", "        next.delete('at');", "      }", "      if (snapshotPlaying) next.set('play', '1');", "      else next.delete('play');", "      if (next.toString() !== prev.toString()) {", "        writer.setSearchParams(next, { replace: true });", "      }"]},
        {"start": 345, "old": ["  }, [id, replay.progress, replay.isPlaying, positions.length, setSearchParams]);", "", "  // Commit pending navigation before merging a due write into the router's query.", "  useEffect(() => {", "    if (!pendingUrlWrite) return;", "    setPendingUrlWrite(null);", "    if (pendingUrlWrite.id !== id || positions.length === 0", "      || pendingUrlWrite.progress !== replay.progress", "      || pendingUrlWrite.playing !== replay.isPlaying) return;", "    setSearchParams(", "      (prev) => {", "        const next = new URLSearchParams(prev);", "        if (pendingUrlWrite.progress > 0 && pendingUrlWrite.progress < 1) {", "          next.set('at', pendingUrlWrite.progress.toFixed(3));", "        } else {", "          next.delete('at');", "        }", "        if (pendingUrlWrite.playing) next.set('play', '1');", "        else next.delete('play');", "        return next;", "      },", "      { replace: true },", "    );", "  }, [pendingUrlWrite, id, positions.length, replay.progress, replay.isPlaying, setSearchParams]);"], "new": ["  }, [id, pathname, replay.progress, replay.isPlaying, positions.length, setSearchParams]);"]}
