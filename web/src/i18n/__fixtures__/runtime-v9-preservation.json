        {"start": 19, "old": [], "new": ["import { AppDesignPortal } from './AppDesignPortal';", "", "/** Header compositions can move triggers without changing their allocated size. */", "export const TooltipPortalContext = createContext(false);"]},
        {"start": 57, "old": [], "new": ["  /** Escape layout/scroll containers while retaining the trigger's complete design profile. */", "  portal?: boolean;"]},
        {"start": 156, "old": [" * - The visibility CSS handles both `:hover` AND `:focus-within` so keyboard", " *   users (Tab into a button wrapped in a tooltip) get the same affordance as", " *   mouse users."], "new": [" * - Hover and focus-within share visibility, using trigger events when the", " *   bubble is portaled. Keyboard and mouse users get the same affordance."]},
        {"start": 168, "old": ["export function Tooltip({ content, side = 'top', multiline, boundaryRef, children }: TooltipProps) {"], "new": ["export function Tooltip({ content, side = 'top', multiline, boundaryRef, portal: portalProp, children }: TooltipProps) {"]},
        {"start": 170, "old": [], "new": ["  const inheritedPortal = useContext(TooltipPortalContext);", "  const portal = portalProp ?? inheritedPortal;"]},
        {"start": 176, "old": [], "new": ["  const [verticalOffset, setVerticalOffset] = useState(12);"]},
        {"start": 179, "old": [], "new": ["  const [active, setActive] = useState(false);"]},
        {"start": 208, "old": ["    for (const clipper of findClippingAncestors(trigger)) {"], "new": ["    for (const clipper of portal ? [] : findClippingAncestors(trigger)) {"]},
        {"start": 216, "old": ["    if (multiline || boundaryRef) setMaxWidth(availableWidth);", "    const width = multiline || boundaryRef"], "new": ["    if (multiline || boundaryRef || portal) setMaxWidth(availableWidth);", "    const width = multiline || boundaryRef || portal"]},
        {"start": 228, "old": ["    setHorizontalOffset(left - bounds.left);", "  }, [side, multiline, boundaryRef]);"], "new": ["    setHorizontalOffset(portal ? left : left - bounds.left);", "    if (portal) {", "      const viewportHeight = document.documentElement.clientHeight || window.innerHeight;", "      const height = tooltip.offsetHeight;", "      const below = bounds.bottom + 8;", "      const above = bounds.top - height - 8;", "      let top = side === 'bottom' ? below", "        : side === 'top' ? above : bounds.top + (bounds.height - height) / 2;", "      if (side === 'bottom' && below + height > viewportHeight - 12 && above >= 12) top = above;", "      if (side === 'top' && above < 12 && below + height <= viewportHeight - 12) top = below;", "      setVerticalOffset(Math.max(12, Math.min(top, viewportHeight - height - 12)));", "    }", "  }, [side, multiline, boundaryRef, portal]);"]},
        {"start": 259, "old": [], "new": ["    // Complete-profile changes can recenter a fixed-size title without a", "    // ResizeObserver notification. Observe only the portaled trigger's ancestry,", "    // never the bubble whose measured offsets we write ourselves.", "    const layoutObserver = portal && typeof MutationObserver === 'function'", "      ? new MutationObserver(updatePosition) : null;", "    if (layoutObserver) {", "      for (let ancestor = triggerRef.current as HTMLElement | null; ancestor; ancestor = ancestor.parentElement) {", "        layoutObserver.observe(ancestor, {", "          attributes: true,", "          attributeFilter: ['class', 'style', 'dir', 'data-app-design-owner'],", "        });", "      }", "    }"]},
        {"start": 273, "old": [], "new": ["    if (portal) window.addEventListener('scroll', updatePosition, true);"]},
        {"start": 276, "old": [], "new": ["      layoutObserver?.disconnect();"]},
        {"start": 278, "old": [], "new": ["      if (portal) window.removeEventListener('scroll', updatePosition, true);"]},
        {"start": 280, "old": ["  }, [content, updatePosition, boundaryRef]);"], "new": ["  }, [content, updatePosition, boundaryRef, portal]);"]},
        {"start": 320, "old": ["  return (", "    <span", "      ref={triggerRef}", "      className=\"relative inline-flex group/tip\"", "      onMouseEnter={() => {", "        hoveredRef.current = true;", "        setDismissed(false);", "        updatePosition();", "      }}", "      onMouseLeave={() => { hoveredRef.current = false; }}", "      onFocus={() => {", "        setDismissed(false);", "        updatePosition();", "      }}", "    >", "      {enrichedChild}"], "new": ["  const bubble = ("]},
        {"start": 328, "old": [], "new": ["          ...(portal ? { top: verticalOffset } : {}),"]},
        {"start": 332, "old": ["          'pointer-events-none absolute z-50 rounded-shape-sm px-2.5 py-1.5',"], "new": ["          'pointer-events-none z-50 rounded-shape-sm px-2.5 py-1.5',", "          portal ? 'fixed' : 'absolute',"]},
        {"start": 338, "old": [], "new": ["          portal && 'max-w-tooltip-viewport whitespace-normal break-words',"]},
        {"start": 349, "old": ["          'opacity-0 transition-opacity duration-fast ease-standard motion-reduce:transition-none',", "          'group-hover/tip:opacity-100 group-focus-within/tip:opacity-100',"], "new": ["          'transition-opacity duration-fast ease-standard motion-reduce:transition-none',", "          portal && active ? 'opacity-100' : 'opacity-0',", "          !portal && 'group-hover/tip:opacity-100 group-focus-within/tip:opacity-100',"]},
        {"start": 354, "old": ["          sideClasses[side],"], "new": ["          !portal && sideClasses[side],"]},
        {"start": 359, "old": [], "new": ["  );", "", "  return (", "    <span", "      ref={triggerRef}", "      className=\"relative inline-flex group/tip\"", "      onMouseEnter={() => {", "        hoveredRef.current = true;", "        if (portal) setActive(true);", "        setDismissed(false);", "        updatePosition();", "      }}", "      onMouseLeave={() => {", "        hoveredRef.current = false;", "        if (portal) setActive(Boolean(triggerRef.current?.contains(document.activeElement)));", "      }}", "      onFocus={() => {", "        if (portal) setActive(true);", "        setDismissed(false);", "        updatePosition();", "      }}", "      onBlur={event => {", "        if (portal) setActive(hoveredRef.current || Boolean(event.currentTarget.contains(event.relatedTarget)));", "      }}", "    >", "      {enrichedChild}", "      {portal ? <AppDesignPortal anchorRef={triggerRef}>{bubble}</AppDesignPortal> : bubble}"]}
