{
  "name": "teslasync-web",
  "description": "TeslaSync fleet intelligence web application",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/buildChangelog.mjs --check",
    "dev": "vite",
    "prebuild": "node scripts/buildChangelog.mjs --check",
    "generate:changelog": "node scripts/buildChangelog.mjs",
    "build": "tsc && npm run typecheck:sw && vite build",
    "postbuild": "node scripts/check-bundle-size.mjs && node scripts/check-pwa-precache.mjs && node scripts/check-pwa-contract.mjs && node scripts/check-source-maps.mjs",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 && npm run lint:i18n && npm run lint:light-mode && npm run audit:empty-state && npm run audit:tooltip-text && npm run audit:i18n-shadowed && npm run audit:query-signal && npm run audit:datatable-tableid && npm run audit:filterbar-chips && npm run audit:forced-colors && npm run audit:sr-only && npm run audit:accessible-name && npm run audit:landmarks && npm run audit:reduced-motion && npm run audit:chart-a11y && npm run audit:chart-frame && npm run audit:chart-safety && npm run audit:chart-legend && npm run audit:marker-cluster && npm run audit:deferred-filter && npm run audit:prefetch-link && npm run audit:tag-input && npm run audit:required-fields && npm run audit:unit-input && npm run audit:masked-values && npm run audit:rtl && npm run audit:bg-polling && npm run audit:export-adoption && npm run audit:live-mutations && npm run audit:inline-help && npm run audit:touch-target && npm run audit:gauge-width && npm run audit:typography && npm run audit:virtualization && npm run audit:skeletons && npm run audit:motion && npm run audit:palette && npm run audit:help-tooltip && npm run audit:registry && npm run check:release-identity",
    "audit:typography": "node scripts/audit-typography.mjs",
    "lint:i18n": "node scripts/lint-i18n-no-template-literals.mjs",
    "lint:light-mode": "node scripts/audit-light-mode-parity.mjs",
    "audit:empty-state": "node scripts/audit-empty-state-cta.mjs",
    "audit:tooltip-text": "node scripts/audit-tooltip-text-color.mjs",
    "audit:i18n-shadowed": "node scripts/audit-i18n-shadowed-keys.mjs",
    "audit:query-signal": "node scripts/audit-query-signal.mjs",
    "audit:datatable-tableid": "node scripts/audit-datatable-tableid.mjs",
    "audit:filterbar-chips": "node scripts/audit-filterbar-chips.mjs",
    "audit:forced-colors": "node scripts/audit-forced-colors.mjs",
    "audit:accessible-name": "node scripts/audit-accessible-name.mjs",
    "audit:landmarks": "node scripts/audit-landmarks.mjs",
    "audit:reduced-motion": "node scripts/audit-reduced-motion.mjs",
    "audit:a11y-static": "npm run audit:forced-colors && npm run audit:sr-only && npm run audit:accessible-name && npm run audit:landmarks && npm run audit:reduced-motion && npm run audit:touch-target",
    "audit:sr-only": "node scripts/audit-sr-only.mjs",
    "audit:chart-a11y": "node scripts/audit-chart-a11y.mjs",
    "audit:chart-frame": "node scripts/audit-chart-frame.mjs",
    "audit:chart-safety": "node scripts/audit-chart-safety.mjs",
    "audit:marker-cluster": "node scripts/audit-marker-cluster.mjs",
    "audit:deferred-filter": "node scripts/audit-deferred-filter.mjs",
    "audit:prefetch-link": "node scripts/auditPrefetchLink.mjs",
    "audit:tag-input": "node scripts/auditTagInput.mjs",
    "audit:required-fields": "node scripts/auditRequiredFields.mjs",
    "audit:unit-input": "node scripts/auditUnitInput.mjs",
    "audit:masked-values": "node scripts/auditMaskedValues.mjs",
    "audit:rtl": "node scripts/audit-rtl-properties.mjs",
    "audit:bg-polling": "node scripts/audit-background-polling.mjs",
    "audit:export-adoption": "node scripts/audit-export-adoption.mjs",
    "audit:live-mutations": "node scripts/audit-live-mutations.mjs",
    "audit:inline-help": "node scripts/audit-inline-help.mjs",
    "audit:touch-target": "node scripts/audit-touch-target.mjs",
    "audit:virtualization": "node scripts/audit-virtualization.mjs",
    "audit:help-tooltip": "node scripts/audit-help-tooltip-coverage.mjs",
    "audit:registry": "node scripts/check-audit-registry.mjs",
    "audit:chart-legend": "node scripts/audit-chart-legend-toggle.mjs",
    "audit:skeletons": "node scripts/auditSkeletons.mjs",
    "audit:motion": "node scripts/auditMotionTokens.mjs",
    "audit:palette": "node scripts/auditChartPalette.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "node scripts/run-e2e-suite.mjs e2e:run",
    "e2e:run": "playwright test",
    "e2e:build": "vite build --outDir e2e/.app-dist",
    "e2e:list": "playwright test --list",
    "e2e:quality": "node scripts/run-e2e-suite.mjs e2e:quality:run",
    "e2e:quality:run": "playwright test --project=chromium-*-* --project=chromium-smoke --workers=2",
    "e2e:performance": "node scripts/run-e2e-suite.mjs e2e:performance:run",
    "e2e:performance:run": "playwright test --project=chromium-performance --workers=1",
    "e2e:synthetic": "node scripts/run-e2e-suite.mjs e2e:synthetic:run",
    "e2e:synthetic:run": "playwright test --project=chromium-smoke production-journeys.smoke.spec.ts --workers=1",
    "e2e:a11y": "node scripts/run-e2e-suite.mjs e2e:a11y:run",
    "e2e:a11y:run": "playwright test --project=chromium-a11y --workers=1",
    "e2e:contract": "playwright test --config=playwright.contract.config.ts",
    "e2e:scenario-contract": "node scripts/check-e2e-scenario-coverage.mjs",
    "e2e:cross-browser": "node scripts/run-e2e-suite.mjs e2e:cross-browser:run",
    "e2e:cross-browser:run": "playwright test --project=firefox-smoke --project=webkit-smoke",
    "e2e:visual": "node scripts/run-e2e-suite.mjs e2e:visual:run",
    "e2e:visual:run": "playwright test --config=playwright.visual.config.ts",
    "e2e:update-visual": "node scripts/run-e2e-suite.mjs e2e:update-visual:run",
    "e2e:update-visual:run": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "screenshots:docs": "node scripts/capture-docs-screenshots.mjs",
    "e2e:routes": "node scripts/check-e2e-route-registry.mjs",
    "perf:baseline": "node scripts/measure-perf.mjs",
    "perf:check": "node scripts/check-bundle-size.mjs --strict && node scripts/check-pwa-precache.mjs && node scripts/check-i18n-shell-closure.mjs && node scripts/check-i18n-runtime.mjs && node scripts/check-duplicate-modules.mjs && node scripts/check-source-maps.mjs",
    "check:source-maps": "node scripts/check-source-maps.mjs",
    "check:release-identity": "node scripts/check-release-build-identity.mjs",
    "check:duplicate-modules": "node scripts/check-duplicate-modules.mjs",
    "check:generated": "node ../scripts/check-generated-freshness.mjs",
    "check:vite-deprecations": "node scripts/check-vite-deprecations.mjs",
    "perf:i18n-runtime": "node scripts/check-i18n-runtime.mjs",
    "perf:pwa": "node scripts/check-pwa-precache.mjs",
    "audit:a11y": "pwsh ../scripts/a11y-audit.ps1",
    "audit:i18n": "pwsh ../scripts/i18n-coverage.ps1",
    "i18n:validate": "node ../scripts/i18n-validate-keys.mjs",
    "i18n:validate:strict": "node ../scripts/i18n-validate-keys.mjs --strict",
    "i18n:extract": "node ../scripts/i18n-validate-keys.mjs --extract",
    "audit:gauge-width": "node scripts/audit-gauge-width.mjs",
    "typecheck:sw": "tsc -p tsconfig.sw.json --noEmit",
    "check:pwa-contract": "node scripts/check-pwa-contract.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@opentelemetry/auto-instrumentations-web": "^0.62.0",
    "@opentelemetry/context-zone": "^2.7.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/instrumentation-fetch": "^0.217.0",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@tanstack/react-query": "^5.28.0",
    "@tanstack/react-virtual": "^3.13.24",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.38.0",
    "html2canvas-pro": "^2.0.2",
    "i18next": "^25.10.4",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.363.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.2",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.3",
    "react-hook-form": "^7.74.0",
    "react-i18next": "^16.6.1",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "web-vitals": "^4.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/leaflet": "^1.9.8",
    "@types/leaflet-draw": "^1.0.13",
    "@types/leaflet.heat": "^0.2.4",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/react-grid-layout": "^1.3.6",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.18",
    "culori": "^4.0.2",
    "eslint": "^8.57.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "js-yaml": "^4.3.2",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "react-grid-layout": {
      "fast-equals": "^5.4.0"
    },
    "lodash": "^4.18.0",
    "protobufjs": "^8.4.1"
  }
}
