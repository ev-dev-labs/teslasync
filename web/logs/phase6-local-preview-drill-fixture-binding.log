COMMAND03 | 2026-10-14T06:09:31.1257838Z | docker --context desktop-linux exec -i teslasync-postgres psql -X -U teslasync -d teslasync -v ON_ERROR_STOP=1 -At [stdin read-only exact fixture metadata]
BEGIN READ ONLY;
SET LOCAL statement_timeout = '5s';
SELECT 'MIGRATION|' || version::text || '|' || dirty::text FROM schema_migrations;
WITH fixtures AS (
 SELECT id, CASE vin WHEN 'DRILL000000000001' THEN 'canonical-model-y' WHEN 'DRILL000000000002' THEN 'canonical-model-3' END AS fixture_key
 FROM vehicles WHERE vin IN ('DRILL000000000001','DRILL000000000002')
)
SELECT 'FIXTURE_MAP|' || json_build_object('fixture_key',f.fixture_key,'vehicle_id',f.id,'drive_count',(SELECT count(*) FROM drives d WHERE d.vehicle_id=f.id),'charge_count',(SELECT count(*) FROM charging_sessions c WHERE c.vehicle_id=f.id))::text FROM fixtures f ORDER BY fixture_key;
WITH fixtures AS (SELECT id FROM vehicles WHERE vin IN ('DRILL000000000001','DRILL000000000002'))
SELECT 'DRIVE_METADATA|' || json_build_object('drive_id',d.id,'vehicle_id',d.vehicle_id,'started_at',d.started_at,'ended_at',d.ended_at,'historical_oct1_oct14',d.started_at >= '2026-10-01T00:00:00Z'::timestamptz AND d.started_at < '2026-10-14T00:00:00Z'::timestamptz,'historical_selected_oct8_oct13_newyork',d.started_at >= '2026-10-08T04:00:00Z'::timestamptz AND d.started_at < '2026-10-14T04:00:00Z'::timestamptz)::text
FROM drives d WHERE d.vehicle_id IN (SELECT id FROM fixtures) ORDER BY d.vehicle_id,d.id;
WITH fixtures AS (SELECT id FROM vehicles WHERE vin IN ('DRILL000000000001','DRILL000000000002'))
SELECT 'CHARGE_METADATA|' || json_build_object('session_id',c.id,'vehicle_id',c.vehicle_id)::text FROM charging_sessions c WHERE c.vehicle_id IN (SELECT id FROM fixtures) ORDER BY c.vehicle_id,c.id;
ROLLBACK;
