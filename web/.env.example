# Phase 44 / Prompt 0060 — RUM env example.
#
# Copy to web/.env.local for local dev, or wire via your build pipeline.
# Leaving any of these unset disables the relevant feature gracefully.

# Full URL of the OTel collector's OTLP/HTTP traces ingest. When empty,
# initRum() is a no-op and no telemetry is sent.
VITE_OTLP_HTTP_ENDPOINT=

# Resource attributes attached to every span. Defaults:
#   service.name=teslasync-web
#   deployment.environment.name=<vite mode>
#   service.version=unknown
VITE_OTEL_SERVICE_NAME=teslasync-web
VITE_OTEL_DEPLOY_ENV=
VITE_APP_VERSION=
