# TeslaSync Environment Configuration
# Copy this file to .env and update the values

# Tesla API credentials (required)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback

# Database
POSTGRES_USER=teslasync
POSTGRES_PASSWORD=teslasync
POSTGRES_DB=teslasync
POSTGRES_PORT=5432

# Application
TESLASYNC_PORT=8080
WEB_PORT=3000
POLL_INTERVAL=30s
LOG_LEVEL=info

# Grafana
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=teslasync

# MQTT
MQTT_PORT=1883

# Redis
REDIS_PORT=6379
