        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:api_availability:ratio_rate1h",
          "legendFormat": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 3
