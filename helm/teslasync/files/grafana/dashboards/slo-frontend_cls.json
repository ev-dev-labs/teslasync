{
  "uid": "slo-frontend_cls",
  "title": "SLO: frontend_cls",
  "description": "Cumulative Layout Shift must stay within the 0.1 good threshold for at least 90% of real user samples.",
  "tags": [
    "slo",
    "owner:frontend",
    "frontend",
    "web-vitals",
    "rum",
    "stability"
  ],
  "schemaVersion": 38,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "SLI (5m)",
      "description": "Current good/valid ratio.",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:frontend_cls:ratio_rate5m",
          "legendFormat": "ratio_5m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 3
        },
        "overrides": null
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Objective",
      "description": "SLO target.",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vector(0.9)",
          "legendFormat": "objective"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 3
        },
        "overrides": null
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error budget remaining (30d)",
      "description": "1 - (1 - SLI_30d) / (1 - objective). Negative = budget blown.",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - ((1 - slo:frontend_cls:ratio_rate30d) / (1 - 0.9))",
          "legendFormat": "budget_remaining"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 3
        },
        "overrides": null
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "SLI over time (5m / 1h / 6h)",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:frontend_cls:ratio_rate5m",
          "legendFormat": "5m"
        },
        {
          "refId": "B",
          "expr": "slo:frontend_cls:ratio_rate1h",
          "legendFormat": "1h"
        },
        {
          "refId": "C",
          "expr": "slo:frontend_cls:ratio_rate6h",
          "legendFormat": "6h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 3
        },
        "overrides": null
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Burn rate (1h / 6h)",
      "description": "Bad-event ratio multiplied so the y-axis is in 'budgets per hour' units.",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - slo:frontend_cls:ratio_rate1h) / (1 - 0.9)",
          "legendFormat": "1h"
        },
        {
          "refId": "B",
          "expr": "(1 - slo:frontend_cls:ratio_rate6h) / (1 - 0.9)",
          "legendFormat": "6h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": null
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "web_vitals_cls_ratio distribution (p75 / p95, with Tempo exemplars)",
      "description": "Real-user distribution behind this SLO. p75 is the quantile the Core Web Vitals objective is defined against. Exemplars link to Tempo for the trace that served the navigation.",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(teslasync_frontend_web_vitals_cls_ratio_bucket[5m])))",
          "legendFormat": "p75",
          "exemplar": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(teslasync_frontend_web_vitals_cls_ratio_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": null
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p75 by route template",
      "description": "Per-route p75. Route labels are ID-, VIN- and coordinate-redacted templates, capped server-side to bound cardinality.",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_TESLASYNC_PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le, route) (rate(teslasync_frontend_web_vitals_cls_ratio_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": null
      }
    }
  ],
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Tempo (traces)",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22:%22tempo%22%7D"
    }
  ],
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "DS_TESLASYNC_PROMETHEUS"
        },
        "enable": true,
        "expr": "changes(teslasync_frontend_release_first_seen_timestamp_seconds[$__rate_interval]) > 0",
        "hide": false,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Frontend releases",
        "step": "60s",
        "tagKeys": "release",
        "textFormat": "First real-user sample reported by release {{release}}",
        "titleFormat": "Frontend release {{release}}"
      }
    ]
  }
}
