{
  "uid": "frontend-rum-overview",
  "title": "Frontend: RUM overview",
  "description": "Real-User-Monitoring overview for the TeslaSync SPA. Fed by POST /api/v1/web-vitals (internal/api/webvitals). Every label on this dashboard is drawn from a closed set or a server-capped registry: route templates are ID-, VIN- and coordinate-redacted, and device/connection/theme are bounded enums. No VINs, entity IDs, raw URLs, user agents or coordinates are collected. Hand-maintained (NOT generated by cmd/slogen) — the per-SLO dashboards are generated, this cross-cutting view is not.",
  "tags": [
    "frontend",
    "rum",
    "web-vitals",
    "owner:frontend"
  ],
  "schemaVersion": 38,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "vital",
        "label": "Web Vital",
        "type": "custom",
        "query": "LCP,INP,CLS,FCP,TTFB",
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "LCP",
          "value": "LCP"
        },
        "options": [
          { "text": "LCP", "value": "LCP", "selected": true },
          { "text": "INP", "value": "INP", "selected": false },
          { "text": "CLS", "value": "CLS", "selected": false },
          { "text": "FCP", "value": "FCP", "selected": false },
          { "text": "TTFB", "value": "TTFB", "selected": false }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Frontend releases",
        "enable": true,
        "hide": false,
        "iconColor": "rgba(0, 211, 255, 1)",
        "datasource": {
          "type": "prometheus",
          "uid": "DS_TESLASYNC_PROMETHEUS"
        },
        "expr": "changes(teslasync_frontend_release_first_seen_timestamp_seconds[$__rate_interval]) > 0",
        "step": "60s",
        "tagKeys": "release",
        "titleFormat": "Frontend release {{release}}",
        "textFormat": "First real-user sample reported by release {{release}}"
      }
    ]
  },
  "links": [
    {
      "title": "SLO overview",
      "type": "link",
      "url": "/d/slo-overview"
    },
    {
      "title": "Synthetic journeys",
      "type": "link",
      "url": "/d/frontend-synthetic-journeys"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "LCP p75",
      "description": "Good < 2.5s. SLO: frontend_lcp.",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(teslasync_frontend_web_vitals_lcp_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p75"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 2.5 },
              { "color": "red", "value": 4 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "INP p75",
      "description": "Good < 200ms. SLO: frontend_inp.",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(teslasync_frontend_web_vitals_inp_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p75"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.2 },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CLS p75",
      "description": "Unitless layout-shift score. Good < 0.1. SLO: frontend_cls.",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(teslasync_frontend_web_vitals_cls_ratio_bucket[$__rate_interval])))",
          "legendFormat": "p75"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "FCP p75",
      "description": "Good < 1.8s (internal budget 1.5s on 4G). SLO: frontend_fcp.",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(teslasync_frontend_web_vitals_fcp_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p75"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1.8 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "TTFB p75",
      "description": "Good < 800ms. SLO: frontend_ttfb.",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(teslasync_frontend_web_vitals_ttfb_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p75"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "red", "value": 1.8 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "RUM samples/s",
      "description": "Ingest volume. A drop to zero means the reporter stopped, consent was withdrawn, or the ingest route is failing — every frontend SLO goes blind.",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(teslasync_web_vitals_samples_ingested_total[$__rate_interval]))",
          "legendFormat": "samples/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2 },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Core Web Vitals p75 over time",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(teslasync_frontend_web_vitals_lcp_seconds_bucket[$__rate_interval])))",
          "legendFormat": "LCP p75"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(teslasync_frontend_web_vitals_fcp_seconds_bucket[$__rate_interval])))",
          "legendFormat": "FCP p75"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(teslasync_frontend_web_vitals_ttfb_seconds_bucket[$__rate_interval])))",
          "legendFormat": "TTFB p75"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(teslasync_frontend_web_vitals_inp_seconds_bucket[$__rate_interval])))",
          "legendFormat": "INP p75"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3 },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Good-sample share by metric",
      "description": "Fraction of samples rated `good` by the web-vitals library. This is the same numerator/denominator shape the frontend_* SLOs use.",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(teslasync_frontend_web_vitals_samples_total{rating=\"good\"}[$__rate_interval])) / clamp_min(sum by (name) (rate(teslasync_frontend_web_vitals_samples_total[$__rate_interval])), 0.0001)",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 3 },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "$vital good share by device class",
      "description": "Device class is derived from viewport width only — never from the user-agent string.",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (device) (rate(teslasync_frontend_web_vitals_samples_total{name=\"$vital\",rating=\"good\"}[$__rate_interval])) / clamp_min(sum by (device) (rate(teslasync_frontend_web_vitals_samples_total{name=\"$vital\"}[$__rate_interval])), 0.0001)",
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 3 },
        "overrides": []
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "$vital good share by effective connection",
      "description": "Network Information API effectiveType, folded onto slow-2g/2g/3g/4g/5g/unknown.",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (connection) (rate(teslasync_frontend_web_vitals_samples_total{name=\"$vital\",rating=\"good\"}[$__rate_interval])) / clamp_min(sum by (connection) (rate(teslasync_frontend_web_vitals_samples_total{name=\"$vital\"}[$__rate_interval])), 0.0001)",
          "legendFormat": "{{connection}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 3 },
        "overrides": []
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "$vital sample rate by theme",
      "description": "Dark/light split. Used to catch theme-specific paint or layout regressions.",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (theme) (rate(teslasync_frontend_web_vitals_samples_total{name=\"$vital\"}[$__rate_interval]))",
          "legendFormat": "{{theme}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 3 },
        "overrides": []
      }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Route paint p75 by route template",
      "description": "Navigation start to first paint after the new route committed. A responsiveness signal, NOT a usability signal — the route may have painted skeletons. SLO: frontend_route_transition (500ms).",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le, route) (rate(teslasync_frontend_route_transition_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3 },
        "overrides": []
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Time to usable content p75 by route template — GATED, requires page integration",
      "description": "Navigation start to primary data rendered. Populated ONLY by pages that call markContentReady(token) (web/src/lib/webVitalsReporter.ts). There is intentionally no automatic completion — two animation frames after a URL change say nothing about usability — and therefore intentionally NO SLO until pages are wired. Expect 'No data' until then; see docs/runbooks/frontend-rum-slos.md.",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le, route) (rate(teslasync_frontend_time_to_usable_content_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3 },
        "overrides": []
      }
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "UX events by kind and outcome",
      "description": "Bounded frontend signals: resource load failures, query outcomes, retries, cache hits/misses, cancellations and explicit user actions.",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, outcome) (rate(teslasync_frontend_ux_events_total[$__rate_interval]))",
          "legendFormat": "{{kind}}/{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 3 },
        "overrides": []
      }
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Browser errors by route template",
      "description": "From POST /api/v1/web-errors (internal/api/weberrors). Error names are bucketed to a closed set; routes use the same redacted templates.",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (name, route) (rate(teslasync_web_errors_total[$__rate_interval])))",
          "legendFormat": "{{name}} @ {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 3 },
        "overrides": []
      }
    },
    {
      "id": 50,
      "type": "timeseries",
      "title": "Ingest health",
      "description": "Batch/sample throughput plus rejection reasons. A rising rejection rate means the client and server contracts have drifted.",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(teslasync_web_vitals_batches_ingested_total[$__rate_interval]))",
          "legendFormat": "batches/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(teslasync_web_vitals_samples_ingested_total[$__rate_interval]))",
          "legendFormat": "samples/s"
        },
        {
          "refId": "C",
          "expr": "sum by (reason) (rate(teslasync_web_vitals_samples_rejected_total[$__rate_interval]))",
          "legendFormat": "rejected: {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 3 },
        "overrides": []
      }
    },
    {
      "id": 51,
      "type": "timeseries",
      "title": "Label cardinality overflow",
      "description": "Non-zero means a label hit its server-side cap and is being folded into an overflow bucket. Investigate before raising the cap — it usually indicates unredacted identifiers in route templates.",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (label) (rate(teslasync_frontend_label_overflow_total[$__rate_interval]))",
          "legendFormat": "{{label}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 4 },
        "overrides": []
      }
    },
    {
      "id": 60,
      "type": "table",
      "title": "Releases reporting RUM",
      "description": "One row per frontend release observed. `first_seen` drives the deploy annotations on every frontend dashboard.",
      "datasource": { "type": "prometheus", "uid": "DS_TESLASYNC_PROMETHEUS" },
      "gridPos": { "x": 0, "y": 42, "w": 24, "h": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "teslasync_frontend_release_first_seen_timestamp_seconds",
          "legendFormat": "{{release}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "dateTimeAsIso" },
        "overrides": []
      }
    }
  ]
}
