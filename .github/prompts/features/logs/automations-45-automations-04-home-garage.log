#### **B) LOCATION CONDITION** (`location.go`)

```go
type LocationConfig struct {
	Type       string `json:"type"`        // "location"
	GeofenceID int64  `json:"geofence_id"` // geofence to check against
	Operator   string `json:"operator"`    // "inside" or "outside"
}

// Uses spherical law of cosines (great-circle distance):
// distance = earthRadiusM * acos(sin(lat1)*sin(lat2) + cos(lat1)*cos(lat2)*cos(lon2-lon1))
// met = (operator == "inside" && distance <= geofence.Radius) ||
//       (operator == "outside" && distance > geofence.Radius)

// locationSnapshot:
type locationSnapshot struct {
	GeofenceID   int64   `json:"geofence_id"`
	GeofenceName string  `json:"geofence_name"`
	Operator     string  `json:"operator"`
	VehicleLat   float64 `json:"vehicle_lat"`
	VehicleLon   float64 `json:"vehicle_lon"`
	DistanceM    float64 `json:"distance_m"`
	RadiusM      float64 `json:"radius_m"`
	Met          bool    `json:"met"`
	Reason       string  `json:"reason"`
}
```

