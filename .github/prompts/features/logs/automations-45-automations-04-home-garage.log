```go
type StateCheckConfig struct {
	Type     string  `json:"type"`     // "state_check"
	Field    string  `json:"field"`    // field name
	Operator string  `json:"operator"` // comparison operator
	
	BoolValue   *bool    `json:"-"` // type-specific values
	NumberValue *float64 `json:"-"`
	StringValue *string  `json:"-"`
}

// Supported fields and their types:
fieldRegistry = map[string]fieldDef{
	"is_locked":     {fieldBool, ...},
	"is_charging":   {fieldBool, ...},
	"is_climate_on": {fieldBool, ...},
	"sentry_mode":   {fieldBool, ...},
	"battery_level": {fieldNumeric, ...},
	"inside_temp":   {fieldNumeric, ...},
	"outside_temp":  {fieldNumeric, ...},
	"speed":         {fieldNumeric, ...},
	"state":         {fieldString, ...},  // "online", "asleep", "offline", "parked", "driving"
}

// Operators:
// Boolean: eq, neq
// Numeric: eq, neq, gt, lt, gte, lte
// String: eq, neq

// stateCheckSnapshot (logged):
type stateCheckSnapshot struct {
	Field    string `json:"field"`
	Operator string `json:"operator"`
	Expected any    `json:"expected"`
	Actual   any    `json:"actual"`
	Met      bool   `json:"met"`
	Reason   string `json:"reason"`  // "battery_level == 45 < 50"
}
