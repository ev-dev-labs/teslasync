### **2. PRESET STRUCT DEFINITION**

```go
// From preset.go (lines 12-29)
type Preset struct {
	ID                string          `json:"id"`                    // unique preset ID
	Name              string          `json:"name"`                  // display name
	Description       string          `json:"description"`           // user-friendly description
	Category          string          `json:"category"`              // e.g., "security", "climate", "charging"
	Icon              string          `json:"icon"`                  // icon name for frontend
	TriggerType       string          `json:"trigger_type"`          // cron, geofence, battery, etc.
	TriggerConfig     json.RawMessage `json:"trigger_config"`        // JSON config for trigger
	Conditions        json.RawMessage `json:"conditions,omitempty"`  // array of condition objects
	Actions           json.RawMessage `json:"actions"`               // array of action objects
	CooldownMinutes   int             `json:"cooldown_minutes"`      // prevent rapid re-execution
	MaxExecutionsHour int             `json:"max_executions_hour"`   // rate limit per hour
	StopOnFailure     bool            `json:"stop_on_failure"`       // stop action chain if error
	NotifyOnRun       bool            `json:"notify_on_run"`         // notify when automation runs
	NotifyOnFailure   bool            `json:"notify_on_failure"`     // notify on execution failure
	Priority          int             `json:"priority"`              // execution priority (lower = higher)
	Tags              []string        `json:"tags"`                  // categorization tags
}
```

