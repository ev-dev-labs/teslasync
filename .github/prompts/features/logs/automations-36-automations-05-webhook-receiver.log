### 12. **RECOMMENDED WEBHOOK RECEIVER ENDPOINT IMPLEMENTATION PATTERN**

Based on the architecture, here's what your webhook receiver endpoint should follow:

```go
// 1. REGISTER PUBLIC WEBHOOK ROUTE (outside /api/v1, no auth)
// In router.go, after line 901, before SPA fallback:
r.Post("/public/webhook/{token}", webhookHandler.ReceiveWebhook)

// 2. WEBHOOK HANDLER
type WebhookReceiverHandler struct {
    webhookTrigger *trigger.WebhookTrigger
    logger         zerolog.Logger
}

func (h *WebhookReceiverHandler) ReceiveWebhook(w http.ResponseWriter, r *http.Request) {
    token := chi.URLParam(r, "token")
    if token == "" {
        writeError(w, http.StatusBadRequest, "token is required")
        return
    }

    // Read payload
    payload, err := io.ReadAll(r.Body)
    if err != nil {
        writeError(w, http.StatusBadRequest, "failed to read body")
        return
    }
    defer r.Body.Close()

    // Extract signature from header
    signature := r.Header.Get("X-Webhook-Signature")
    remoteIP := r.RemoteAddr

    // Process webhook through trigger system
    if err := h.webhookTrigger.HandleWebhook(r.Context(), token, payload, signature, remoteIP); err != nil {
        if errors.Is(err, trigger.ErrWebhookNotFound) {
            writeError(w, http.StatusNotFound, "webhook not found")
            return
        }
        if errors.Is(err, trigger.ErrWebhookSignatureInvalid) {
            writeError(w, http.StatusUnauthorized, "invalid signature")
            return
        }
        writeError(w, http.StatusInternalServerError, "webhook processing failed")
        return
    }

    writeJSON(w, http.StatusOK, map[string]interface{}{"status": "processed"})
}

// 3. RATE LIMITING
// Apply to webhook route:
r.With(httprate.LimitByIP(100, 1*time.Minute)).Post("/public/webhook/{token}", webhookHandler.ReceiveWebhook)
```

