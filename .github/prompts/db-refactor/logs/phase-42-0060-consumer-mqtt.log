# Surface change in internal/mqtt/mqtt.go (legacy publishing Client unchanged)
# New types added at the end of the file:
#   - Pipeline interface (Process(ctx, []byte, int64) error)
#   - VINResolver func type
#   - ErrUnknownVIN sentinel
#   - DLQEntry struct
#   - DLQPublisher interface
#   - MQTTDLQPublisher (default JSON-to-broker impl)
