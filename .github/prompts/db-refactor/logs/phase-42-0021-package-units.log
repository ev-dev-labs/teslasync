=== DESIGN ===
package=internal/tesla/units
public_surface=ToSI(field string, raw float64, active ActiveUnit) (float64, error) + ActiveUnit string + ErrNoUnitContext + ErrUnsupportedField + ErrUnsupportedUnit
boundary_contract=ADR-004 #4 — units.ToSI is THE one place raw producer values get converted to canonical SI; the third arg (active ActiveUnit) is non-negotiable per tesla-pipeline.instructions.md prohibited-pattern #1 (no hardcoded wire-format units)
purity=no I/O imports (no net/http, database/sql, jackc/pgx, redis); ToSI is a pure function; conversion tables are package-level vars
canonical_si=
  UnitKindDistance     -> meters       (mi*1609.344, km*1000)
  UnitKindTemperature  -> Celsius      ((F-32)*5/9, C identity)
  UnitKindPressure     -> Pascals      (psi*6894.757, bar*100000)
  speed override fields -> m/s         (mph*0.44704, kmh*1000/3600)
  UnitKindCharge       -> none (Soc emitted in %; SettingChargeUnit is informational for UI only)
speed_override_list=VehicleSpeed, CruiseSetSpeed (both classified UnitKindNone in generated metadata; SI form is m/s, not meters; UnitKindSpeed refactor deferred)
error_semantics=
  ErrNoUnitContext     active=="" -> caller (normalize pipeline) drops sample + bumps unit-context-missing counter (prohibited-pattern #6)
  ErrUnsupportedField  field unknown to SignalsByName, OR field has UnitKindNone and is not on the speed-override list
  ErrUnsupportedUnit   active is a recognised ActiveUnit but does not match the field's UnitKind (e.g. Odometer with active=psi); also UnitKindCharge fields (Soc) since the conversions table has no UnitKindCharge entry
adr_004_invariants_enforced=
  #1 'no hardcoded wire-format units': locked 3-arg signature, gate regex rejects any 2-arg ToSI variant
  #4 'every unit-bearing field converted to canonical SI at one place': ToSI is the only exported conversion entrypoint; package contains no I/O
  #6 'silent failures on missing unit context forbidden': ErrNoUnitContext is a distinct sentinel so callers can detect drop-vs-default

=== TABLE_TESTS ===
prompt_minimum_coverage=
  5 distance fields x {miles, km}     = 10 rows  [Odometer, RatedRange, EstBatteryRange, IdealBatteryRange, MilesToArrival]
  5 temperature fields x {F, C}       = 10 rows  [DiHeatsinkTR, DiStatorTempR, ModuleTempMax, InsideTemp, OutsideTemp]
  4 pressure fields x {psi, bar}      = 8 rows   [TpmsPressureFl, TpmsPressureFr, TpmsPressureRl, TpmsPressureRr]
  VehicleSpeed x {miles, km}          = 2 rows
  unit-bearing field x active=""      -> ErrNoUnitContext
  non-unit-bearing field              -> ErrUnsupportedField
  mismatched unit                     -> ErrUnsupportedUnit
extra_coverage_added=
  CruiseSetSpeed/mph_to_ms             (breadth on speed-override list)
  Unknown/unknown_field                (unknown-field arm of ErrUnsupportedField)
  VehicleSpeed/no_active               (speed-path empty-active branch)
  VehicleSpeed/wrong_unit              (speed-path table-miss branch)
  Soc/no_charge_conversion             (UnitKindCharge has no conversions entry -> ErrUnsupportedUnit)
purity_test=TestToSI_PurityNoMutation iterates 1000x with the same input to assert the conversion tables are not mutated
stability_test=TestActiveUnit_StringValuesStable pins every ActiveUnit constant's wire-format string (unit-history layer persists these as TEXT; drift = silent historical corruption)
total_subtests=37 (32 table rows + 1000-iteration purity loop + 8 ActiveUnit pins)

