SELECT column_name, dimension_type, time_interval
  FROM timescaledb_information.dimensions
  WHERE hypertable_name='signal_log';
  ->  ts | Time | 7 days
  (chunk_time_interval => INTERVAL '7 days' is honored by Timescale.)

SELECT column_name, data_type, is_nullable
  FROM information_schema.columns
  WHERE table_name='signal_log'
  ORDER BY ordinal_position;
  ->  vehicle_id  | bigint                   | NO
      ts          | timestamp with time zone | NO
      field       | text                     | NO
      value_kind  | smallint                 | NO
      str_value   | text                     | YES
      bool_value  | boolean                  | YES
      int_value   | bigint                   | YES
      float_value | double precision         | YES
      time_value  | timestamp with time zone | YES
  (9 rows; matches prompt schema verbatim. The four NOT NULL columns
  are the PK members + value_kind discriminator; the five typed
  columns are nullable so exactly one is non-null per row dictated by
  value_kind.)

SELECT indexname FROM pg_indexes
  WHERE tablename='signal_log'
  ORDER BY indexname;
  ->  signal_log_field_ts
      signal_log_pkey
      signal_log_ts_idx
      signal_log_vehicle_field_ts
  (4 rows — both prompt-mandated indexes plus the PK index plus the
  TimescaleDB-internal ts_idx that create_hypertable always installs
  on the time dimension. No extra indexes.)

SELECT conname, contype, pg_get_constraintdef(oid)
  FROM pg_constraint
  WHERE conrelid='signal_log'::regclass
  ORDER BY conname;
  ->  signal_log_pkey | p | PRIMARY KEY (vehicle_id, ts, field)
  (1 row — the composite PK is the only constraint. No FK, no CHECK,
  matching the prompt schema and the no-FK precedent of phase-42
  prompts 0030-0033.)

