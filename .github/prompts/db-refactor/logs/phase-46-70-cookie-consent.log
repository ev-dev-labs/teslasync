    metadata:
      labels:
        app.kubernetes.io/name: teslasync
        app.kubernetes.io/instance: test
        app.kubernetes.io/component: redis
    spec:
      
      serviceAccountName: test-teslasync
      containers:
        - name: redis
          image: "redis:7-alpine"
          command:
            - redis-server
            - --appendonly
            - "yes"
            - --maxmemory-policy
            - noeviction
