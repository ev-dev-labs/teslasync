apiVersion: apps/v1
kind: Deployment
metadata:
  name: test-teslasync-grafana
  labels:
    helm.sh/chart: teslasync-0.6.0
    app.kubernetes.io/name: teslasync
    app.kubernetes.io/instance: test
    app.kubernetes.io/version: "1.1.0"
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/component: grafana
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: teslasync
      app.kubernetes.io/instance: test
      app.kubernetes.io/component: grafana
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app.kubernetes.io/name: teslasync
        app.kubernetes.io/instance: test
        app.kubernetes.io/component: grafana
    spec:
      
      serviceAccountName: test-teslasync
      containers:
        - name: grafana
          image: "grafana/grafana:10.4.0"
          ports:
            - name: http
              containerPort: 3000
              protocol: TCP
          env:
            - name: GF_SECURITY_ADMIN_USER
              value: "admin"
            - name: GF_SECURITY_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: test-teslasync
                  key: GRAFANA_ADMIN_PASSWORD
          livenessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 30
            periodSeconds: 10
            failureThreshold: 5
          readinessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 10
            periodSeconds: 5
            failureThreshold: 5
          resources:
            limits:
              cpu: 500m
              memory: 256Mi
            requests:
              cpu: 100m
              memory: 64Mi
          volumeMounts:
            - name: grafana-data
              mountPath: /var/lib/grafana
      volumes:
        - name: grafana-data
          persistentVolumeClaim:
            claimName: test-teslasync-grafana-data
