# Source: teslasync/templates/job-migrate.yaml
apiVersion: batch/v1
kind: Job
metadata:
  name: test-teslasync-migrate-1
  labels:
    helm.sh/chart: teslasync-0.6.0
    app.kubernetes.io/name: teslasync
    app.kubernetes.io/instance: test
    app.kubernetes.io/version: "1.1.0"
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/component: migrate
  annotations:
    "helm.sh/hook": pre-upgrade,pre-install
    "helm.sh/hook-weight": "0"
    "helm.sh/hook-delete-policy": before-hook-creation,hook-succeeded
spec:
  backoffLimit: 3
  ttlSecondsAfterFinished: 300
  template:
    metadata:
      labels:
        app.kubernetes.io/name: teslasync
        app.kubernetes.io/instance: test
        app.kubernetes.io/component: migrate
    spec:
      
      serviceAccountName: test-teslasync
      restartPolicy: Never
      initContainers:
        - name: wait-for-db
          image: busybox:1.36
          command: ['sh', '-c', 'until nc -z test-teslasync-postgresql 5432; do echo "waiting for database..."; sleep 2; done']
      containers:
        - name: migrate
          image: "ghcr.io/ev-dev-labs/teslasync-api:1.1.0"
          imagePullPolicy: IfNotPresent
          env:
            - name: MIGRATE_ONLY
              value: "true"
            - name: DATABASE_MAX_CONNS
              value: "2"
            - name: DATABASE_MIN_CONNS
              value: "1"
          envFrom:
            - configMapRef:
                name: test-teslasync
            - secretRef:
                name: test-teslasync
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 128Mi

