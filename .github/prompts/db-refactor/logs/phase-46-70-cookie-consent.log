apiVersion: v1
kind: ConfigMap
metadata:
  name: test-teslasync
  labels:
    helm.sh/chart: teslasync-0.6.0
    app.kubernetes.io/name: teslasync
    app.kubernetes.io/instance: test
    app.kubernetes.io/version: "1.1.0"
    app.kubernetes.io/managed-by: Helm
data:
  DATABASE_HOST: "test-teslasync-postgresql"
  DATABASE_PORT: "5432"
  DATABASE_USER: "teslasync"
  DATABASE_NAME: "teslasync"
  DATABASE_SSLMODE: "disable"
  DATABASE_MAX_CONNS: "25"
  DATABASE_MIN_CONNS: "5"
  DATABASE_CONNECT_TIMEOUT: "5"
  DATABASE_STATEMENT_TIMEOUT: "30000"
  DATABASE_HEALTH_CHECK_PERIOD: "5s"
  MQTT_HOST: "test-teslasync-mosquitto"
  MQTT_PORT: "1883"
  MQTT_CLIENT_ID: "teslasync"
  MQTT_PREFIX: "teslasync"
  REDIS_ENABLED: "true"
  REDIS_HOST: "test-teslasync-redis"
  REDIS_PORT: "6379"
  REDIS_DB: "0"
  LIVE_SIGNAL_STORE_MODE: "hybrid"
  GRAFANA_HOST: "test-teslasync-grafana"
  GRAFANA_PORT: "3000"
  API_ENDPOINT: "http://test-teslasync-api:8080"
  TESLA_REDIRECT_URI: "http://localhost:8080/api/v1/auth/callback"
  TESLA_API_BASE_URL: "https://fleet-api.prd.na.vn.cloud.tesla.com"
  TESLA_AUTH_URL: "https://auth.tesla.com"
  TESLA_TIMEOUT: "30s"
  WORKER_POLL_INTERVAL: "30s"
  WORKER_SLEEP_POLL_MULT: "4"
  TESLASYNC_LOG_LEVEL: "info"
  FORWARD_AUTH_HEADER: ""
  TESLASYNC_PORT: "8080"
  HELM_CHART_VERSION: "0.6.0"
  # Data retention (0 or unset = no automatic cleanup)
  AUDIT_RETENTION_DAYS: "365"
  AUDIT_IP_RETENTION_DAYS: "30"
  NOTIFICATION_WORKER_HOST: "test-teslasync-notification-worker"
  NOTIFICATION_WORKER_PORT: "8081"
  EXPORT_WORKER_HOST: "test-teslasync-export-worker"
  EXPORT_WORKER_PORT: "8082"
  AUTOMATION_WORKER_HOST: "test-teslasync-automation-worker"
  AUTOMATION_WORKER_PORT: "8083"
  GAS_PRICE_ENABLED: "false"
  GAS_PRICE_POLL_INTERVAL: "7d"
  # Inbound api_call_logs middleware (Phase 38-10).
  # Body capture defaults to OFF; enable only for diagnostic windows.
  API_LOGS_INBOUND_ENABLED: "true"
  API_LOG_CAPTURE_BODIES: "false"
  API_LOG_QUEUE_CAPACITY: "4096"
  API_LOG_BATCH_SIZE: "100"
  API_LOG_FLUSH_INTERVAL: "1s"
  # Service-mode banner override (Phase 46 / Prompt 04). Always rendered
  # so the API picks up the env knob deterministically; empty values
  # mean "fall through to the system_state DB row + admin POST API".
  TESLASYNC_SYSTEM_MODE: ""
  TESLASYNC_SYSTEM_MAINTENANCE_MESSAGE: ""
  TESLASYNC_SYSTEM_MAINTENANCE_UNTIL: ""
  # Optional GitHub Issues bridge for the in-app feedback widget
  # (Phase 46 / Prompt 08). Repo is the non-secret half ΓÇö the
  # corresponding TESLASYNC_GITHUB_TOKEN is rendered to the Secret
  # template only when set. Empty repo disables the bridge entirely.
  TESLASYNC_GITHUB_REPO: ""
  # Vehicle photo upload root ΓÇö Phase 46 / Prompt 54.
  # Hero photos are written under this directory at runtime (3
  # rendered sizes per upload). For persistence across pod restarts,
  # mount a PV at this path on the API deployment ΓÇö the chart does
  # NOT mount one by default so existing installs aren't surprised.
  TESLASYNC_VEHICLE_PHOTO_DIR: "/var/lib/teslasync/photos"
  # Auth-mode contract ΓÇö Phase 46 / Prompt 57.
  # Free-text hint surfaced verbatim by /system/auth-mode and
  # rendered by the SPA's RequiresAuth empty state. Set to your
  # upstream IdP's name (Authentik, Authelia, oauth2-proxy,
  # Keycloak, ΓÇª) for nicer copy. TeslaSync NEVER speaks to the
  # IdP's admin API and NEVER routes off this value ΓÇö it is
  # presentation-only. Empty by default: SPA falls back to a
  # generic "your authentication provider" string.
  TESLASYNC_AUTH_PROVIDER_HINT: ""
  # Cookie / GDPR consent banner ΓÇö Phase 46 / Prompt 70.
  # Default "false": single-user self-hosted installs do not
  # require a banner. Flip to "true" on multi-user fleet or
  # public-facing deployments to comply with ePrivacy / GDPR.
  # When true, the SPA renders a non-blocking bottom banner on
  # first visit and gates optional client-side reporting (web
  # vitals, error reporter) on the user's stored consent.
  TESLASYNC_REQUIRE_COOKIE_CONSENT: "false"
