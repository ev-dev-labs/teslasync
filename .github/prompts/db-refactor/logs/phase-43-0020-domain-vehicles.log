                                           VehicleSpeed→state.Speed (m/s)
                                           Odometer→state.Odometer (m)
                                           RatedRange / EstBatteryRange→state.RatedRange (m)
                                           InsideTemp/OutsideTemp→state.{Inside,Outside}Temp (°C)
                                           ChargeRateMilePerHour→state.ChargeRate (m/h via UnitKindDistance)
                                           ChargerPower / DCChargingPower→state.ChargerPower (kW; UnitKindNone)
                                           TimeToFullCharge→state.TimeToFullChg (h; UnitKindNone)
