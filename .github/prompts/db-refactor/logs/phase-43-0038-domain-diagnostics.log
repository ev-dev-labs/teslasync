        health_summary    map[string]string json:"health_summary"
        signals_monitored int               json:"signals_monitored"
        anomalies_last_7d int               json:"anomalies_last_7d"
        anomalies_last_24h int              json:"anomalies_last_24h"
      }
      anomalyEntry {
        signal      string  json:"signal"
        type        string  json:"type"
        severity    string  json:"severity"
        value       float64 json:"value"
        baseline    float64 json:"baseline"
        z_score     float64 json:"z_score"
