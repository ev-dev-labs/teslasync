# Source: teslasync/templates/tests/test-connection.yaml
apiVersion: v1
kind: Pod
metadata:
  name: "test-teslasync-test-connection"
  labels:
    helm.sh/chart: teslasync-0.6.0
    app.kubernetes.io/name: teslasync
    app.kubernetes.io/instance: test
    app.kubernetes.io/version: "1.1.0"
    app.kubernetes.io/managed-by: Helm
  annotations:
    helm.sh/hook: test
    helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
spec:
  restartPolicy: Never
  containers:
    - name: test-backend-health
      image: busybox:1.36
      command: ['sh', '-c']
      args:
        - |
          echo "=== Testing backend /healthz ==="
          wget -qO- --timeout=10 http://test-teslasync-api:8080/healthz
          echo ""
          echo "Backend health: OK"
    - name: test-backend-ready
      image: busybox:1.36
      command: ['sh', '-c']
      args:
        - |
          echo "=== Testing backend /readyz ==="
          wget -qO- --timeout=10 http://test-teslasync-api:8080/readyz
          echo ""
          echo "Backend readiness: OK"
    - name: test-backend-metrics
      image: busybox:1.36
      command: ['sh', '-c']
      args:
        - |
          echo "=== Testing Prometheus /metrics ==="
          OUTPUT=$(wget -qO- --timeout=10 http://test-teslasync-api:8080/metrics)
          echo "$OUTPUT" | head -5
          echo "$OUTPUT" | grep -q "teslasync_http_requests_total" && echo "Custom metrics: OK" || (echo "Custom metrics: MISSING" && exit 1)
    - name: test-backend-api
      image: busybox:1.36
      command: ['sh', '-c']
      args:
        - |
          echo "=== Testing API /api/v1/vehicles ==="
          CODE=$(wget --server-response -qO/dev/null --timeout=10 http://test-teslasync-api:8080/api/v1/vehicles 2>&1 | awk '/HTTP/{print $2}')
          echo "Status: $CODE"
          [ "$CODE" = "200" ] && echo "API response: OK" || (echo "API response: FAIL ($CODE)" && exit 1)
    - name: test-web
      image: busybox:1.36
      command: ['sh', '-c']
      args:
        - |
          echo "=== Testing web frontend ==="
          wget --spider --timeout=10 http://test-teslasync-web:80/
          echo "Web frontend: OK"
    - name: test-notification-worker
      image: busybox:1.36
      command: ['sh', '-c']
      args:
        - |
          echo "=== Testing notification worker /healthz ==="
          wget -qO- --timeout=10 http://test-teslasync-notification-worker:8081/healthz
          echo ""
          echo "Notification worker: OK"
    - name: test-export-worker
      image: busybox:1.36
      command: ['sh', '-c']
      args:
        - |
          echo "=== Testing export worker /healthz ==="
          wget -qO- --timeout=10 http://test-teslasync-export-worker:8082/healthz
          echo ""
          echo "Export worker: OK"
