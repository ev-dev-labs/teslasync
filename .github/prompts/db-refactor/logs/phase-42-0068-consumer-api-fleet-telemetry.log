    path. Phase-42 wiring prompts will plumb the Pipeline in later.
@@ append
+ MissingUnitDrops(w, r) — GET /api/v1/tesla/fleet-telemetry/missing-unit-drops
    families, _ := prometheus.DefaultGatherer.Gather()
    Walks tesla_normalize_unit_context_missing_total counter family,
    sums by Field label.
    Response: { total: float64, by_field: {field: count} }

