apiVersion: apps/v1
kind: Deployment
metadata:
  name: smoke-teslasync-grafana
  labels:
    helm.sh/chart: teslasync-0.6.0
    app.kubernetes.io/name: teslasync
    app.kubernetes.io/instance: smoke
    app.kubernetes.io/version: "1.1.0"
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/component: grafana
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: teslasync
      app.kubernetes.io/instance: smoke
      app.kubernetes.io/component: grafana
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app.kubernetes.io/name: teslasync
        app.kubernetes.io/instance: smoke
        app.kubernetes.io/component: grafana
    spec:
      
      serviceAccountName: smoke-teslasync
      containers:
        - name: grafana
          image: "grafana/grafana:10.4.0"
          ports:
            - name: http
              containerPort: 3000
              protocol: TCP
          env:
            - name: GF_SECURITY_ADMIN_USER
              value: "admin"
            - name: GF_SECURITY_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: smoke-teslasync
                  key: GRAFANA_ADMIN_PASSWORD
          livenessProbe:
