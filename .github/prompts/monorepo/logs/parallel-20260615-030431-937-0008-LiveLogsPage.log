## **12. DESIGN TOKENS**
**File:** `apps/design/generated/apple/Tokens.swift`

### **Color.TS** (all computed as `tsDynamicColor(light:dark:highContrast:)`)
```swift
extension Color {
    enum TS {
        // Semantic surfaces:
        static let bg                    // page background
        static let surface               // card/field background
        static let surfaceGlass          // frosted glass effect
        
        // Text colors:
        static let textPrimary           // primary prose
        static let textSecondary         // secondary prose
        static let textMuted             // de-emphasized
        
        // Accent:
        static let accent                // brand cyan/teal
        static let border                // subtle 1px borders
        
        // Status colors:
        static let statusSuccess         // green
        static let statusWarning         // amber/orange
        static let statusDanger          // red
        static let statusInfo            // info blue (same as accent)
        
        // Chart palette (8-color categorical + 6 series):
        static let chartCategorical: [Color]  // [Color] array
        static let chartSeriesBattery
        static let chartSeriesEnergy
        static let chartSeriesSpeed
        static let chartSeriesRegen
        static let chartSeriesTemperature
        static let chartSeriesPower
    }
}
```

