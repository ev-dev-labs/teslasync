## **ADAPTIVE LAYOUT PATTERN** (from `ApiLogsPage.Table.swift`)

**How pages adapt regular (table) → compact (cards) layout:**

```swift
// Detect size class (iOS only):
#if os(iOS)
    @Environment(\.horizontalSizeClass) private var horizontalSizeClass
#endif

private var isCompact: Bool {
    #if os(iOS)
        horizontalSizeClass == .compact
    #else
        false
    #endif
}

// Render conditional layouts:
@ViewBuilder
private var stateContent: some View {
    if isCompact {
        // iPhone: stack info in TSCard for each row
        LazyVStack(spacing: TSSpacing.md) {
            ForEach(rows) { row in
                TSCard { ... row fields ... }
            }
        }
    } else {
        // macOS/iPad: columnar layout with HStack rows
        VStack(spacing: 0) {
            headerRow
            ForEach(rows) { row in
                HStack { ... columns ... }
            }
        }
    }
}
```

