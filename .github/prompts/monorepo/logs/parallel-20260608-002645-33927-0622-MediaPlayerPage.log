### **8. SSE / LIVE DATA**

**Main file:** `/Users/atulgupta/Documents/repos/.teslasync-parallel/20260608-002645-33927/slot-622/apps/apple/Sources/Live/LiveDataStore.swift` (L1-100+)

**API for page-level subscription:**
```swift
@MainActor @Observable
public final class LiveDataStore<Value, Event: Sendable> {
    public private(set) var value: Value?           // Merged value to render
    public private(set) var phase: LiveConnectionState = .closed  // live/stale/closed
    public private(set) var lastEventAt: Date?      // Last event timestamp
    public private(set) var error: FacadeError?     // Terminal error, if any
    public private(set) var isActive: Bool          // Scene+view visibility state
    public private(set) var isStale: Bool           // > freshness window?

    public init(
        target: LiveStreamTarget,
        provider: LiveStreamProvider<Event>,
        seed: Value? = nil,
        fetchedAt: Date? = nil,
        auth: (any AuthChallengeHandling)? = nil,
        policy: LiveStalenessPolicy = .standard,
        isEmpty: @escaping @Sendable (Value) -> Bool = { _ in false },
        reduce: @escaping @MainActor (Value?, LiveEnvelope<Event>) -> Value?
    )

    public func activate()
    public func deactivate()
    public var hasContent: Bool  // value && !isEmpty(value)
}
```

**View binding pattern:**
```swift
@MainActor
@Observable
public final class SomePageModel {
    @ObservationIgnored private let liveStore: LiveDataStore<SomeValue, LiveFleetEvent>
    
    var liveValue: SomeValue? { liveStore.value }
    var isLive: Bool { liveStore.phase == .open }
    var isStale: Bool { liveStore.isStale }
}

// In view:
.task {
    liveStore.activate()
    // View reads liveStore.value / .phase / .isStale
}
.onDisappear {
    liveStore.deactivate()
}
```

**Staleness handling:**
- `LiveStalenessPolicy.standard` (default): stale after 2 minutes of no events
- `isStale` property indicates staleness; typical UI shows a "Reconnecting..." banner via `.liveData` modifier
- From AcDcStatsPanel: `"acdc.staleBanner"` = `"Reconnecting — data may be stale"`, triggered when `connection == .stale`

