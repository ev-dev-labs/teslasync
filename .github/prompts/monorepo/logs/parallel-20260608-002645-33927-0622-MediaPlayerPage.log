### **7. SI CONVERTERS & UNITS**

**File:** `/Users/atulgupta/Documents/repos/.teslasync-parallel/20260608-002645-33927/slot-622/apps/apple/Sources/SharedFacade/Units+Facade.swift` (L1-200+)

**Public API:**
```swift
public struct UnitPreferences: Equatable, Sendable {
    public var distance

: String      // "km" or "mi"
    public var speed: String         // "km/h" or "mph"
    public var temperature: String   // "°C" or "°F"
    public var pressure: String      // "kPa" or "psi"
    public var energy: String        // "Wh" or "kWh"
    public var duration: String      // "h" or "min"
    public var power: String         // "W" or "kW"
    public var locale: String?
}

public enum Units {
    // Conversion (SI → user display unit)
    public static func convertDistance(_ meters: Double, _ prefs: UnitPreferences) -> Double
    public static func convertSpeed(_ mps: Double, _ prefs: UnitPreferences) -> Double
    public static func convertTemperature(_ celsius: Double, _ prefs: UnitPreferences) -> Double
    public static func convertPressure(_ kpa: Double, _ prefs: UnitPreferences) -> Double
    public static func convertEnergy(_ wh: Double, _ prefs: UnitPreferences) -> Double
    public static func convertDuration(_ seconds: Double, _ prefs: UnitPreferences) -> Double
    public static func convertPower(_ watts: Double, _ prefs: UnitPreferences) -> Double

    // Formatting (SI → localized string with unit label)
    public static func formatDistance(_ meters: Double?, _ prefs: UnitPreferences) -> String  // "25.3 km"
    public static func formatSpeed(_ mps: Double?, _ prefs: UnitPreferences) -> String       // "80 km/h"
    public static func formatTemperature(_ celsius: Double?, _ prefs: UnitPreferences) -> String // "18°C"
    public static func formatPressure(_ kpa: Double?, _ prefs: UnitPreferences) -> String
    public static func formatEnergy(_ wh: Double?, _ prefs: UnitPreferences) -> String
    public static func formatDuration(_ seconds: Double?, _ prefs: UnitPreferences) -> String
    public static func formatPower(_ watts: Double?, _ prefs: UnitPreferences) -> String
}
```

**Usage pattern (at display boundary):**
```swift
// In a view, pre-formatted via facade:
let distanceText = Units.formatDistance(meters, unitPrefs)  // "42.5 km"
Text(verbatim: distanceText)
```

**Unit preference defaults:**
```swift
public extension UnitPreferences {
    static let metric = UnitPreferences(
        distance: "km", speed: "km/h", temperature: "°C", 
        pressure: "kPa", energy: "Wh", duration: "h", power: "W"
    )
    static let imperial = UnitPreferences(
        distance: "mi", speed: "mph", temperature: "°F", 
        pressure: "psi", energy: "kWh", duration: "min", power: "kW"
