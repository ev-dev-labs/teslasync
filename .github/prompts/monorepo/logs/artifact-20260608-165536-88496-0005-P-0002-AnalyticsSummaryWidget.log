  displayDist = convertDistanceFromSI(total_distance_km*1000, unit)  (km /1000, mi /1609.344, ft /0.3048)
  displayEff  = unit=='mi' ? avg_efficiency_wh_km * 1.60934 : avg_efficiency_wh_km  (Wh/mi | Wh/km)
  costPerDist = displayDist>0 ? total_cost/displayDist : 0 ; value = costPerDist>0 ? cur(.,3) : "—"
