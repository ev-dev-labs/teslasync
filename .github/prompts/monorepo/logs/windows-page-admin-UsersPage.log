        -> UsersPage._panel (new TsGlassPanel { Glow = GlassGlow.None }) hosting the five-branch
           _stateHost, mounted as PageContainer.PageContent (UsersPage.cs BuildPanel/ctor).
[x] state  - loading data state
        -> UsersPageState.Loading + UsersDisplay.ShowLoading (UsersProjection.ResolveState/Project,
           UsersPage.Model.cs) -> UsersPage.cs Render (_loadingHost: Spinner + caption).
           Tests: State_loading_when_first_query_in_flight; ViewModel Loading on first paint.
[x] state  - empty data state
        -> UsersPageState.Empty + UsersDisplay.ShowEmpty -> UsersPage.cs _emptyState (TsEmptyState).
           Tests: State_empty_when_no_other_subjects; ViewModel_empty_candidates_is_the_empty_state;
           Open_candidates_mode_is_treated_as_no_subjects.
[x] state  - error data state
        -> UsersPageState.Error + UsersDisplay.ShowError -> UsersPage.cs _errorState (TsErrorDisplay
           + Retry, ActionInvoked -> RefreshAsync). Tests: State_error_shows_failure_and_retry;
           ViewModel_candidates_failure_is_the_error_state.
[x] state  - success data state
        -> UsersPageState.Populated + UsersDisplay.ShowList + UsersDisplay.Rows -> UsersPage.cs
           _listRoot (one Border row per subject: Code subject + UserImpersonateButton). Tests:
           State_populated_when_subjects_present; ViewModel_loads_subjects_into_the_populated_state;
           Rows_are_disabled_while_an_impersonation_session_is_active (web disabled={active}).
[x] string - impersonation.users.emptyMessage
        -> UsersPageRegistration.EmptyMessage (UsersPage.Model.cs)
           GetString("impersonation.users.emptyMessage","No other subjects have an active session
           right now. Sign someone else in to enable impersonation.")
           -> UsersDisplay.EmptyMessage -> _emptyState.Message (UsersPage.cs Render).
[x] string - impersonation.users.emptyTitle
        -> UsersPageRegistration.EmptyTitle GetString("impersonation.users.emptyTitle","No other
           subjects") -> UsersDisplay.EmptyTitle -> _emptyState.Title (UsersPage.cs Render).
[x] string - impersonation.users.openMode
        -> UsersPageRegistration.OpenModeText GetString("impersonation.users.openMode","Impersonation
           requires forward-auth mode. This install is in open mode, so per-user identity is not
           available.") -> UsersDisplay.OpenModeText -> _openModeText (UsersPage.cs Render).
[x] string - impersonation.users.subtitle
        -> UsersPageRegistration.Subtitle GetString("impersonation.users.subtitle","Active subjects
           you can impersonate for support. Sessions are limited to 15 minutes and recorded in the
           audit log.") -> UsersDisplay.Subtitle + UsersPageViewModel.Subtitle -> PageContainer.Subtitle.
[x] string - impersonation.users.title
        -> UsersPageRegistration.Title GetString("impersonation.users.title","Subjects")
           -> UsersDisplay.Title + UsersPageViewModel.Title -> PageContainer title (UsersPage.cs).
