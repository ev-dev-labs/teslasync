## **10. DataTable ADAPTIVE PATTERN**
**File:** `Features/Admin/DiskForecastPage.Table.swift` (Concrete Example)

This demonstrates the adaptive table pattern:

```swift
struct DiskForecastTable: View {
    let rows: [DiskForecastHypertable]
    
    #if os(iOS)
        @Environment(\.horizontalSizeClass) private var horizontalSizeClass
    #endif
    
    private var isCompact: Bool {
        #if os(iOS)
            horizontalSizeClass == .compact
        #else
            false
        #endif
    }
    
    var body: some View {
        if isCompact {
            // iPhone: card list
            VStack(spacing: TSSpacing.md) {
                ForEach(rows) { row in hypertableCard(row) }
            }
        } else {
            // macOS/iPad: columnar Grid
            Grid(alignment: .topLeading, horizontalSpacing: TSSpacing.lg, verticalSpacing: TSSpacing.sm) {
                GridRow { header(...) header(...) ... }
                Divider()...
                ForEach(rows) { row in GridRow { cell(...) cell(...) ... } }
            }
        }
    }
    
    private func hypertableCard(_ row: DiskForecastHypertable) -> some View {
        TSCard {
            VStack(alignment: .leading, spacing: TSSpacing.sm) {
                // Reuse cell builders as stacked label/value pairs
            }
        }
    }
}
```

**Pattern:** Extract cell builders (nameCell, numericCell) as reusable functions, then use them in both Grid (horizontal) and Card (stacked vertical) layouts. This keeps code D---

## **10. DataTable ADAPTIVE PATTERN (Continued)**

**Pattern:** Extract cell builders (nameCell, numericCell) as reusable functions, then use them in both Grid (horizontal) and Card (stacked vertical) layouts. This keeps code DRY:

```swift
private func nameCell(_ row: DiskForecastHypertable) -> some View {
    VStack(alignment: .leading, spacing: 2) {
        Text(verbatim: row.hypertableName)
            .font(Font.TS.bodySm)
            .fontWeight(.medium)
            .foregroundStyle(Color.TS.textPrimary)
        Text(verbatim: Self.chunkCountText(row.chunkCount))
            .font(Font.TS.caption)
            .foregroundStyle(Color.TS.textMuted)
    }
}

private func numericCell(_ value: String) -> some View {
    Text(verbatim: value)
        .font(Font.TS.bodySm)
        .monospacedDigit()
        .foregroundStyle(Color.TS.textPrimary)
        .frame(maxWidth: .infinity, alignment: .trailing)
}

// Compact variant for cards (labels + values stacked)
private func labeledRow(_ label: LocalizedStringKey, _ value: String) -> some View {
    HStack(alignment: .firstTextBaseline) {
        Text(label).font(Font.TS.caption).foregroundStyle(Color.TS.textMuted)
        Spacer(minLength: TSSpacing.md)
        Text(verbatim: value)
            .font(Font.TS.bodySm)
            .monospacedDigit()
            .foregroundStyle(Color.TS.textPrimary)
    }
}
```

**For your PeriodComparePage**, replicate this by:
1. Define your comparison row struct (e.g., `PeriodComparisonRow` with metric name, periodA, periodB, delta)
2. Create reusable cell builders for each column
3. Wrap in `if isCompact { cards } else { grid }` based on horizontalSizeClass

