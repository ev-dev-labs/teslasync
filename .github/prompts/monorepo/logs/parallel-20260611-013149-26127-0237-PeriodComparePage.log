### **Example 4: Using Environment for Unit Prefs**

```swift
struct PeriodCompareContent: View {
    let data: PeriodComparison
    @Environment(\.tsUnits) var units
    
    var body: some View {
        VStack(spacing: TSSpacing.lg) {
            // Distance comparison (SI meters → formatted)
            TSComparisonHeader(
                leadingLabel: "Distance (A)",
                leadingValue: Units.formatDistance(data.distanceMetersA, units),
                trailingLabel: "Distance (B)",
                trailingValue: Units.formatDistance(data.distanceMetersBv units),
                delta: Units.convertDistance(data.distanceMetersBv units) -
                       Units.convertDistance(data.distanceMetersA, units),
                deltaFormatted: String(format: "%+.1f%%",
                    ((Units.convertDistance(data.distanceMetersBv units) -
                      Units.convertDistance(data.distanceMetersA, units)) /
                     Units.convertDistance(data.distanceMetersA, units)) * 100
                )
            )
            
            // Or use the view components directly (they read from environment)
            HStack {
                VStack(alignment: .leading) {
                    TSMetricLabel("energy.a")
                    TSEnergy(data.energyWhA)
                }
                Spacer()
                VStack(alignment: .leading) {
                    TSMetricLabel("energy.b")
                    TSEnergy(data.energyWhB)
                }
            }
        }
        .tsUnits(units)  // Inject prefs for child components
    }
}

