## **8. SI CONVERTERS & UNITS**
**File:** `SharedFacade/Units+Facade.swift`

### **Unit Preferences (User's Display Prefs)**
```swift
public struct UnitPreferences: Equatable, Sendable {
    public var distance: String      // "km", "mi"
    public var speed: String         // "km/h", "mph"
    public var temperature: String   // "°C", "°F"
    public var pressure: String      // "kPa", "psi"
    public var energy: String        // "Wh", "kWh"
    public var duration: String      // "h", "min"
    public var power: String         // "W", "kW"
    public var locale: String?
    public var precision: Int?
    public var emptyDisplay: String?
    
    public init(
        distance: String,
        speed: String,
        temperature: String,
        pressure: String,
        energy: String,
        duration: String,
        power: String,
        locale: String? = nil,
        precision: Int? = nil,
        emptyDisplay: String? = nil
    )
}

public static let metric = UnitPreferences(
    distance: "km", speed: "km/h", temperature: "°C", pressure: "kPa",
    energy: "Wh", duration: "h", power: "W", locale: "en-US"
)

public static let imperial = UnitPreferences(
    distance: "mi", speed: "mph", temperature: "°F", pressure: "psi",
    energy: "kWh", duration: "min", power: "kW", locale: "en-US"
)
```

### **SI Conversion + Formatting Functions**
```swift
public enum Units {
    // Conversion functions (return Double in user's unit)
    public static func convertDistance(_ meters: Double, _ prefs: UnitPreferences) -> Double
    public static func convertSpeed(_ mps: Double, _ prefs: UnitPreferences) -> Double
    public static func convertTemperature(_ celsius: Double, _ prefs: UnitPreferences) -> Double
    public static func convertPressure(_ kpa: Double, _ prefs: UnitPreferences) -> Double
    public static func convertEnergy(_ wh: Double, _ prefs: UnitPreferences) -> Double
    public static func convertDuration(_ seconds: Double, _ prefs: UnitPreferences) -> Double
    public static func convertPower(_ watts: Double, _ prefs: UnitPreferences) -> Double
    
    // Formatting functions (return formatted String with unit suffix)
    public static func formatDistance(_ meters: Double?, _ prefs: UnitPreferences) -> String
    public static func formatSpeed(_ mps: Double?, _ prefs: UnitPreferences) -> String
    public static func formatTemperature(_ celsius: Double?, _ prefs: UnitPreferences) -> String
    public static func formatPressure(_ kpa: Double?, _ prefs: UnitPreferences) -> String
    public static func formatEnergy(_ wh: Double?, _ prefs: UnitPreferences) -> String
    public static func formatDuration(_ seconds: Double?, _ prefs: UnitPreferences) -> String
    public static func formatPower(_ watts: Double?, _ prefs: UnitPreferences) -> String
}
```

### **Environment Injection (View Extension)**
```swift
public extension EnvironmentValues {
    var tsUnits: UnitPreferences {
        get { self[TSUnitsKey.self] }
        set { self[TSUnitsKey.self] = newValue }
    }
}

public extension View {
    func tsUnits(_ preferences: UnitPreferences) -> some View {
        environment(\.tsUnits, preferences)
    }
}
```

**Example usage:**
```swift
Text(verbatim: Units.formatDistance(1000, unitPrefs))  // "1.0 km" or "0.6 mi"
TSDistance(1000)  // respects .tsUnits environment
```

