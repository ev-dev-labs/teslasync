## **9. FACADE / VEHICLES DATA SOURCE**

### **AppContainer (Dependency Injection Root)**
**File:** `SharedFacade/AppContainer.swift`
```swift
@MainActor
@Observable
public final class AppContainer {
    public var unitPreferences: UnitPreferences
    public init(unitPreferences: UnitPreferences = .metric)
    
    @ObservationIgnored public private(set) var auth: (any AuthTokenProviding & AuthChallengeHandling)?
    public func connectAuth(_ provider: any AuthTokenProviding & AuthChallengeHandling)
    
    public var platformName: String  // "iOS" / "macOS"
    
    // Adapts KMP StateFlow to @Observable model
    public func model<State>(
        from flow: Shared.Kotlinx_coroutines_coreStateFlow,
        transform: @escaping (Any) -> State?
    ) -> StateHolderModel<State>
    
    // Adapts StateFlow<Resource<T>> to LoadableState
    public func loadable<Value>(
        from flow: Shared.Kotlinx_coroutines_coreStateFlow,
        as _: Value.Type = Value.self,
        map: @escaping (Any) -> Value?
    ) -> StateHolderModel<LoadableState<Value>>
}
```

### **StateHolderModel (Observable Adapter)**
**File:** `SharedFacade/StateHolderModel.swift`
```swift
@MainActor
@Observable
public final class StateHolderModel<State> {
    public private(set) var state: State?
    
    public init(
        flow: Shared.Kotlinx_coroutines_coreStateFlow,
        transform: @escaping (Any) -> State?
    )
    
    public func start()    // Begin collecting from KMP StateFlow
    public func stop()     // Stop & close subscription
}
```

### **LoadableState (Cache-Then-Network Projection)**
**File:** `SharedFacade/LoadableState.swift`
```swift
public enum LoadableState<Value> {
    case idle
    case loading(cached: Value?, stale: Bool)
    case loaded(Value, stale: Bool)
    case empty(stale: Bool)
    case failed(FacadeError, cached: Value?, stale: Bool)
    
    public var value: Value?              // Latest displayable value
    public var isLoading: Bool             // Spinner check
    public var isStale: Bool               // Data freshness
    public var error: FacadeError?         // Error if failed
    
    static func from(
        _ resource: Shared.Resource,
        transform: (Any) -> Value?
    ) -> LoadableState
}
```

