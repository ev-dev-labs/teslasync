### **Example 3: Loading + Error States**

```swift
@MainActor
@Observable
class PeriodComparePageModel {
    var comparisonState: LoadableState<PeriodComparison> = .idle
    private let container: AppContainer
    
    init(container: AppContainer) {
        self.container = container
    }
    
    func loadComparison(periodAId: String, periodBId: String) async {
        // Simulate KMP facade call:
        // comparisonState = await container.loadable(from: analyticsHolder.getComparison(...))
    }
}

struct PeriodCompareWithState: View {
    @State var model: PeriodComparePageModel
    
    var body: some View {
        switch model.comparisonState {
        case .idle:
            TSPageLoader()
                .onAppear { Task { await model.loadComparison(...) } }
        
        case .loading(let cached, let stale):
            if let cached {
                // Show cached data with spinner overlay
                PeriodCompareContent(data: cached)
                    .redacted(reason: .placeholder)
                    .overlay(alignment: .topTrailing) {
                        TSSpinner(label: "Refreshing...")
                    }
            } else {
                TSPageLoader(label: "loading.comparison")
            }
        
        case .loaded(let data, let stale):
            VStack {
                if stale {
                    TSLiveStaleDataBanner()
                }
                PeriodCompareContent(data: data)
            }
        
        case .empty:
            TSEmptyState(
                title: "period.compare.empty",
                message: "period.compare.emptyMessage",
                systemImage: "chart.xyaxis.line"
            )
        
        case .failed(let error, let cached, let stale):
            VStack(spacing: TSSpacing.md) {
                if let cached {
                    PeriodCompareContent(data: cached)
                        .opacity(0.5)
                }
                TSErrorDisplay(
                    title: "period.compare.error",
                    message: error.userMessage,
                    onRetry: {
                        Task { await model.loadComparison(...) }
                    }
                )
            }
        }
    }
}
```

