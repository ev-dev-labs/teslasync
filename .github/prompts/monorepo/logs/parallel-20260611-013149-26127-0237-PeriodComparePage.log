### **Example 2: Using TSDataTable for Comparison**

```swift
struct ComparisonRow: Identifiable {
    let id: String
    let metricName: String
    let valueA: Double
    let valueB: Double
    var delta: Double { valueB - valueA }
}

struct PeriodCompareWithDataTable: View {
    @State private var rows: [ComparisonRow] = []
    @State private var selection: Set<String> = []
    
    var body: some View {
        VStack {
            TSDataTable(
                rows: rows,
                columns: [
                    TSColumn(
                        id: "metric",
                        title: "Metric",
                        comparator: { $0.metricName < $1.metricName ? .orderedAscending : .orderedDescending }
                    ) { row in
                        Text(row.metricName)
                    },
                    
                    TSColumn(
                        id: "valueA",
                        title: "Period A",
                        comparator: { $0.valueA < $1.valueA ? .orderedAscending : .orderedDescending }
                    ) { row in
                        Text(String(format: "%.2f", row.valueA)).monospacedDigit()
                    },
                    
                    TSColumn(
                        id: "valueB",
                        title: "Period B",
                        comparator: { $0.valueB < $1.valueB ? .orderedAscending : .orderedDescending }
                    ) { row in
                        Text(String(format: "%.2f", row.valueB)).monospacedDigit()
                    },
                    
                    TSColumn(
                        id: "delta",
                        title: "Change",
                        comparator: { $0.delta < $1.delta ? .orderedAscending : .orderedDescending }
                    ) { row in
                        TSDelta(
                            value: row.delta,
                            formatted: String(format: "%+.2f", row.delta)
                        )
                    }
                ],
                selection: $selection,
                density: .standard
            )
        }
        .padding(TSSpacing.lg)
    }
}
