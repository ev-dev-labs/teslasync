## **CONCRETE USAGE EXAMPLES FOR YOUR PERI0DCOMPAREPAGE**

### **Example 1: Grouped Bar Chart (Period A vs B)**

```swift
import SwiftUI
import Shared

struct PeriodComparePage: View {
    @Environment(\.tsUnits) var units: UnitPreferences
    @State private var periodAData: [String: Double] = [:]
    @State private var periodBData: [String: Double] = [:]
    
    let metrics = ["Energy", "Distance", "Duration", "Avg Speed", "Charging Time", "Efficiency"]
    
    var body: some View {
        ScrollView {
            VStack(alignment: .leading, spacing: TSSpacing.lg) {
                TSPageTitle("period.compare.title")
                
                // Bar chart: grouped bars for Period A vs Period B
                TSChartContainer("period.compare.chart") {
                    TSBarChart(
                        series: [
                            TSChartSeries(
                                id: "periodA",
                                name: "period.a",
                                nameText: "Period A",
                                points: metrics.enumerated().map { idx, name in
                                    TSChartPoint(
                                        x: Double(idx),
                                        y: periodAData[name] ?? 0,
                                        id: "A-\(name)"
                                    )
                                },
                                colorIndex: 0  // First color from palette
                            ),
                            TSChartSeries(
                                id: "periodB",
                                name: "period.b",
                                nameText: "Period B",
                                points: metrics.enumerated().map { idx, name in
                                    TSChartPoint(
                                        x: Double(idx),
                                        y: periodBData[name] ?? 0,
                                        id: "B-\(name)"
                                    )
                                },
                                colorIndex: 1  // Second color from palette
                            )
                        ],
                        stacked: false  // Side-by-side grouped bars
                    )
                }
                
                // Metrics comparison cards (6 KPIs)
                LazyVGrid(
                    columns: Array(repeating: GridItem(.flexible(), spacing: TSSpacing.md), count: 2),
                    spacing: TSSpacing.md
                ) {
                    ForEach(metrics, id: \.self) { metric in
                        metricComparisonCard(metric)
                    }
                }
                
                // Comparison table
                comparisonTable
            }
            .padding(TSSpacing.lg)
        }
        .tsUnits(units)
    }
    
    @ViewBuilder
    private func metricComparisonCard(_ metric: String) -> some View {
        let valueA = periodAData[metric] ?? 0
        let valueB = periodBData[metric] ?? 0
        let delta = valueB - valueA
        let deltaPercent = valueA > 0 ? (delta / valueA) * 100 : 0
        
        TSCard {
            VStack(alignment: .leading, spacing: TSSpacing.sm) {
                TSMetricLabel(LocalizedStringKey(metric))
                
                HStack(alignment: .firstTextBaseline, spacing: TSSpacing.sm) {
                    VStack(alignment: .leading, spacing: 2) {
                        TSMetricValue(String(format: "%.1f", valueA))
                        TSCaption("period.a")
                    }
                    Spacer()
                    VStack(alignment: .trailing, spacing: 2) {
                        TSMetricValue(String(format: "%.1f", valueB))
                        TSCaption("period.b")
                    }
                }
                
                // Delta badge
                TSDelta(
                    value: delta,
                    formatted: String(format: "%+.1f%%", deltaPercent)
                )
            }
        }
    }
    
    @ViewBuilder
    private var comparisonTable: some View {
        TSCard {
            VStack(alignment: .leading, spacing: TSSpacing.md) {
                TSPanelTitle("period.compare.table")
                
                #if os(iOS)
                    @Environment(\.horizontalSizeClass) var sizeClass
                #endif
                
                let isCompact = false  // Your sizeClass check
                
                if isCompact {
                    compactTableCards
                } else {
                    regularTable
                }
            }
        }
    }
    
    @ViewBuilder
    private var regularTable: some View {
        Grid(alignment: .topLeading, horizontalSpacing: TSSpacing.lg, verticalSpacing: TSSpacing.sm) {
            GridRow {
                Text("Metric").font(Font.TS.label).foregroundStyle(Color.TS.textSecondary)
                Text("Period A").font(Font.TS.label).foregroundStyle(Color.TS.textSecondary)
                Text("Period B").font(Font.TS.label).foregroundStyle(Color.TS.textSecondary)
                Text("Change").font(Font.TS.label).foregroundStyle(Color.TS.textSecondary)
            }
            Divider().overlay(Color.TS.border)
            
            ForEach(metrics, id: \.self) { metric in
                let valueA = periodAData[metric] ?? 0
                let valueB = periodBData[metric] ?? 0
                let delta = valueB - valueA
                
                GridRow {
                    Text(metric).font(Font.TS.bodySm).foregroundStyle(Color.TS.textPrimary)
                    Text(String(format: "%.1f", valueA))
                        .font(Font.TS.bodySm)
                        .monospacedDigit()
                        .frame(maxWidth: .infinity, alignment: .trailing)
                    Text(String(format: "%.1f", valueB))
                        .font(Font.TS.bodySm)
                        .monospacedDigit()
                        .frame(maxWidth: .infinity, alignment: .trailing)
                    Text(String(format: "%+.1f", delta))
                        .font(Font.TS.bodySm)
                        .monospacedDigit()
                        .foregroundStyle(delta >= 0 ? Color.TS.statusSuccess : Color.TS.statusDanger)
                        .frame(maxWidth: .infinity, alignment: .trailing)
                }
                Divider().overlay(Color.TS.border.opacity(0.5))
            }
        }
    }
    
    @ViewBuilder
    private var compactTableCards: some View {
        VStack(spacing: TSSpacing.md) {
            ForEach(metrics, id: \.self) { metric in
                let valueA = periodAData[metric] ?? 0
                let valueB = periodBData[metric] ?? 0
                let delta = valueB - valueA
                
                TSCard {
                    VStack(alignment: .leading, spacing: TSSpacing.sm) {
                        TSMetricLabel(LocalizedStringKey(metric))
                        HStack {
                            Text("A: \(String(format: "%.1f", valueA))")
                                .font(Font.TS.bodySm)
                            Spacer()
                            Text("B: \(String(format: "%.1f", valueB))")
                                .font(Font.TS.bodySm)
                        }
                        TSDelta(
                            value: delta,
                            formatted: String(format: "%+.1f", delta)
                        )
                    }
                }
            }
        }
    }
}
```

