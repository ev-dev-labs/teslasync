**Tests:** `/Users/atulgupta/Documents/repos/.teslasync-parallel/20260614-231658-97646/slot-21/apps/apple/TeslaSync/feature-views/AlertStudioPage.ViewModelTests.swift` (lines 100-200)

```swift
@MainActor
final class AlertStudioViewModelTests: XCTestCase {
    private func makeViewModel(
        mutator: any AlertStudioMutator = OSLogAlertStudioMutator()
    ) -> AlertStudioViewModel {
        AlertStudioViewModel(
            rulesModel: ASRulesModel(preview: .loaded(AlertStudioSamples.rules)),
            channelsModel: ASChannelsModel(preview: .loaded(AlertStudioSamples.channels)),
            metricsModel: ASMetricsModel(preview: .loaded(AlertStudioSamples.metrics)),
            vehicles: AlertStudioSamples.vehicles,
            mutator: mutator,
            localize: .echo
        )
    }

    func testSelectRuleHydratesEditorWhenClean() {
        let viewModel = makeViewModel()
        viewModel.requestSelectRule(AlertStudioSamples.rules[1])
        XCTAssertEqual(viewModel.selectedID, 101)
        XCTAssertEqual(viewModel.editor.signalName, "Locked")
    }

    func testGuardedSwitchParksWhenDirty() {
        let viewModel = makeViewModel()
        viewModel.updateEditor { $0.name = "dirty" }
        XCTAssertTrue(viewModel.isDirty)
        viewModel.requestNewRule()
        XCTAssertEqual(viewModel.pendingSwitch, .newRule)
    }
}
```

**Pattern:**
- **Fake repository:** In-memory sources (`ASInMemoryRulesSource`, `ASInMemoryChannelsSource`, `ASInMemoryMetricsSource`) initialized with optional snapshots
- **Localizer:** `.echo` (fallback strings, no bundle) instead of `.bundle` (real i18n)
- **Telemetry:** `OSLogAlertStudioTelemetry()` (logs to os_log) or spy recorder in tests
- **Mutator:** `OSLogAlertStudioMutator()` (logs intent, returns success) for previews; test-specific `ASRecordingMutator` to assert calls
- **ASListSnapshot** state enum encodes loading/loaded/empty/failed + optional cached items

