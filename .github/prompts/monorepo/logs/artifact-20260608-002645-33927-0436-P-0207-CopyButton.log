WEB SOURCE (the specification)
  web/src/components/ui/CopyButton.tsx — a one-click clipboard primitive (promoted from the admin devtools).
    <Button variant="ghost" size="sm" icon={copied ? <CheckCircle/> : <Copy/>} aria-live="polite"
            disabled={disabled} title={title} aria-label={resolvedAriaLabel}>{visibleLabel}</Button>
    handleCopy : navigator.clipboard.writeText(text) → setCopied(true) → onCopy?() →
                 withToast ? toast?.success('Copied to clipboard') : — → setTimeout(setCopied(false), 2000);
                 catch → withToast ? toast?.error('Failed to copy') : — ; console.error(...).
    visibleLabel   = iconOnly ? null : (label ?? (copied ? copiedLabel : copyLabel))
    resolvedAria   = ariaLabel ?? (iconOnly ? (copied ? copiedLabel : (label ?? copyLabel)) : undefined)
    i18n keys      : common.copyButton.{copy='Copy', copied='Copied',
                     successToast='Copied to clipboard', errorToast='Failed to copy'}
    Data sources   : useTranslation + useOptionalToast — NEITHER is a fetch. The component owns no async
                     data, so there is no loading / empty / error / stale / offline axis (see STATES).

