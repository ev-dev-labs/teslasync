  Sources/Features/Battery/BatteryHealthPage.Panels.swift       (new-vs-now + acdc/stats + quick links + recs + boundary)
  Sources/Features/Battery/BatteryHealthPage.Charts.swift       (capacity trend + range + charge dist + acdc + skeleton)
  Sources/Features/Battery/BatteryHealthRouteRegistration.swift (.batteryHealth route registration)
  Tests/Unit/Features/Battery/BatteryHealthPageModelTests.swift (model state-machine tests)
