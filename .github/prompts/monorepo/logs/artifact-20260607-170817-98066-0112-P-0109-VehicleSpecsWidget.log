Parity reproduced exactly from the web source (cross-platform row-for-row parity):
  Model      = asString(specs.car_type) ?? asString(specs.model) ?? asString(config.car_type) ?? "—"
  Trim       = asString(specs.trim_badging) ?? asString(specs.trim) ?? asString(config.trim) ?? "—"
  Paint      = asString(specs.exterior_color) ?? asString(config.exterior_color) ?? "—"
  Wheels     = asString(specs.wheel_type) ?? asString(config.wheel_type) ?? "—"
  Interior   = asString(specs.interior) ?? asString(specs.interior_color) ?? "—"
  Aux Battery= asString(specs.aux_battery_type) ?? "—"
  Car Version= asString(config.version) ?? asString(specs.car_version) ?? "—"   (monospace)
  Options    = first 8 of options.keys → { label: code, value: asString(options[code]) ?? code,
               badge: neutral "Option" }
  hasAnyData = specs!=nil || options!=nil || config!=nil  → else EmptyState "No specs available"
  isCompact  = size.cols <= 1  → compact Model + "Trim: x"; else standard detail list.
  asString   = non-empty String passes; finite Number → JS String(n) (no trailing ".0"); else nil.

