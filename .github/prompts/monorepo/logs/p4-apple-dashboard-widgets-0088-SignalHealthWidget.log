PARITY MAP (web -> native), all conditional branches reproduced
--------------------------------------------------------------------------------------------
  useVehicles                  -> active-vehicle resolution at the source (web `vehicleId ??
                                  vehicles?.[0]?.id ?? 0`); the view never resolves an id.
  useSignals(id) -> string[]   -> Update.signals ([String]?); totalSignals = count (web length).
  useSignalGaps(id) -> live map -> Update.liveEntries ([String: SignalHealthLiveEntry]?), the
                                  /signals/{id}/live `Record<name,{value,timestamp}>`.
  useSignalStats(id)           -> Update.statsAvailable (web `stats` truthiness) + status/conn
                                  (web statsLoading/statsError/isStale drive the shell freshness).
  STALE_THRESHOLD_MS = 5*60*1000 -> SignalHealthFormat.staleThresholdSeconds (300s, strict `>`).
  analysis.totalSignals        -> projection.totalSignals / totalSignalsText (fmtInt).
  analysis.activeCount/staleCount -> projection.activeCount/staleCount (+ coveredText "a/total").
  analysis.gapSignals + sort   -> projection.gapSignals (no-last-seen first by name, then oldest).
  analysis.freshnessAge        -> projection.freshnessAgeSeconds + freshnessText (formatAge).
  formatAge {{count}}s/m/h ago -> SignalHealthFormat.age (secAgo/minAgo/hrAgo + em-dash).
  formatRelative               -> SignalHealthFormat.relative (justNow/minAgo/hrAgo/dayAgo/"MMM d, yyyy").
  healthLevel green/amber/red/neutral -> SignalHealthAdapter.healthLevel (>=0.5 red, >0 amber, =0 green).
  healthColor / healthBadgeVariant -> SignalHealthLevel.tone + SignalHealthStatusBadge
                                  (Healthy/Degraded/Critical/Unknown).
  StatCard / Badge / EmptyState -> SignalHealthStatTile / SignalHealthCoverageBadge +
                                  SignalHealthStatusBadge / ContentUnavailableView.
  size.cols <= 1 (compact)     -> SignalHealthModel.isCompact (badge + total + "signals" + age).
  size.cols >= 3 (wide list)   -> SignalHealthModel.isWide (stale/gap list, slice(0,15)).
  Registry telemetry.ts "signal-health" -> SignalHealthWidget.registration (id signal-health,
                                  category telemetry, default 2x4, min 1x2, max 4x40) + clamp.
  Surface slug "SignalHealthWidget" -> view.opened telemetry (P1/S11).

