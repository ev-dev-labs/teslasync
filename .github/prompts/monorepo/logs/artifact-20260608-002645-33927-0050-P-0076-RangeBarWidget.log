 1. WEB SOURCE READ END-TO-END (parity contract)
--------------------------------------------------------------------------------
  Source: web/src/features/dashboard/widgets/RangeBarWidget.tsx (read in full).
  Data:   useVehicles -> id; useVehicleState(id) -> { state, isLoading, isFetching,
          isStale, isError, dataUpdatedAt, refetch }; useUnits -> unitPrefs.distance;
          convertDistanceFromSI(meters, unit); fmtNumber.
  Derived (reproduced VERBATIM in RangeBarWidget.Adapter.swift):
    rated     = state?.rated_range ?? 0
    ideal     = state?.ideal_range ?? 0
    hasData   = state != null && (rated > 0 || ideal > 0)
    maxRange  = Math.max(rated, ideal, 1)
    *Converted = convertDistanceFromSI(*, unitPrefs.distance)
    fill%     = Math.min((value / max) * 100, 100)              [MetricBar]
    epa       = ((ideal - rated) / rated) * 100, shown only when rated>0 && ideal>0,
                prefixed '+' when ideal >= rated
  Branches reproduced:
    WidgetShell chrome (title "Range" + Gauge icon when !compact; loading; updatedAt;
      isFetching/isStale/isError; onRefresh)
    isCompact = size.cols === 1 && size.rows === 1
      compact  -> big fmtNumber(ratedConverted,0) over "{unit} rated"
      standard -> MetricBar(rated, #22d3ee) + MetricBar(ideal, #a78bfa) + EPA variance line
    !hasData  -> EmptyState(Gauge, "No range data")
  i18n keys extracted: widget.rangeBar("Range"), widget.rated("rated"),
    widget.ratedRange("Rated Range"), widget.idealRange("Ideal Range"),
    widget.epaComparison("EPA variance"), widget.noRange("No range data"),
