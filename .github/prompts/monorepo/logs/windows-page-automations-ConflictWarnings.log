             feature-views/ConflictWarnings/ConflictWarnings.Model.cs; rendered ConflictWarnings.cs#BuildEmpty
             (TsEmptyState, Message=ConflictWarningsDisplay.EmptyMessage = translation.common.noData "No data
             available"); model factory ConflictWarningsModel.Empty; tests Empty_when_resolved_with_no_conflicts,
             Null_conflicts_list_collapses_to_empty, Empty_message_uses_the_shared_common_no_data_string,
             Empty_automation_name_is_the_empty_message.
[x] state  - error data state -> ConflictWarningsState.Error selected by SelectState (model.HasError; precedence
             over empty/ready, below loading) in ConflictWarnings.Model.cs; model flag ConflictWarningsModel.HasError
             + factory ConflictWarningsModel.Failed; rendered ConflictWarnings.cs#BuildError (TsQueryError
             InfoBar-equivalent + Retry, Title=ErrorTitle, Message=ErrorMessage, ActionText=RetryLabel,
             ActionInvoked -> ConflictWarnings.OnRetryInvoked -> RetryRequested event); copy from
             ConflictWarningsProjection.ErrorTitleKey/ErrorMessageKey/RetryKey (translation.error.network.title /
             .message + translation.error.retry); tests Error_when_resolved_with_failure,
             Error_takes_precedence_over_present_conflicts, Loading_takes_precedence_over_error,
             Error_title_uses_the_shared_network_error_string, Error_message_uses_the_shared_network_error_string,
             Error_retry_label_uses_the_shared_retry_string, Error_automation_name_is_the_error_title.

# Strings (1) — resolves from Strings/*.resw via ILocalizer with the web key name
[x] string - automations.builder.conflict -> ConflictWarningsProjection.ConflictTitleKey
             ("translation.automations.builder.conflict", fallback "Potential Conflict") resolved via
             ILocalizer.GetString in ConflictWarningsProjection.Project; applied as every banner's heading
             (ConflictBannerDisplay.Title) and surface-Narrator name in the ready branch, rendered as
             TsAlertBanner.Title in ConflictWarnings.cs#BuildReady; present in Strings/en/Resources.resw
             (name="translation.automations.builder.conflict"); tests Banner_title_uses_the_shared_conflict_string,
             Ready_automation_name_is_the_shared_conflict_heading,
             I18n_keys_use_the_resw_translation_catalog_form.

