### AppRouteParser - `/Users/atulgupta/Documents/repos/.teslasync-parallel/20260615-130844-89414/slot-3/apps/apple/Sources/App/AppRouteParser.swift:1-72`

```swift
public enum AppRouteParser {
  /// Static aliases dict mapping web paths → AppRoute cases
  static let aliases: [String: AppRoute] = [
    "/": .dashboard,
    "/battery": .energy,
    "/admin/system": .system,
    ...
  ]
  
  /// Parse URL path to route
  public static func parse(path rawPath: String) -> AppRoute? {
    let normalized = normalize(rawPath)
    if let alias = aliases[normalized] { return alias }
    let segment = firstSegment(of: normalized)
    return AppRoute.allCases.first { $0.pathSegment == segment }
  }
  
  /// Parse custom scheme or universal link
  public static func parse(url: URL) -> AppRoute? { ... }
}
```

### RouteHostRegistry - `/Users/atulgupta/Documents/repos/.teslasync-parallel/20260615-130844-89414/slot-3/apps/apple/Sources/App/RouteHostRegistry.swift:1-37`

