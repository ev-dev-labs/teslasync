### **2. KMP Shared Core Integration & Data Types**

#### Key Bridge: `StateHolderModel<T>` wraps Kotlin `StateFlow` → Swift observable

**File:** `/Users/atulgupta/Documents/repos/.teslasync-parallel/20260615-193947-52828/slot-8/apps/apple/Sources/SharedFacade/StateHolderModel.swift`

```swift
@MainActor
@Observable
public final class StateHolderModel<State> {
    public private(set) var state: State?

    @ObservationIgnored private let flow: Shared.Kotlinx_coroutines_coreStateFlow
    @ObservationIgnored private let transform: (Any) -> State?
    @ObservationIgnored private var task: Task<Void, Never>?

    public init(
        flow: Shared.Kotlinx_coroutines_coreStateFlow,
        transform: @escaping (Any) -> State?
    ) {
        self.flow = flow
        self.transform = transform
        if let initial = flow.value {
            state = transform(initial)
        }
    }

    public func start() {
        guard task == nil else { return }
        task = Task { [weak self, flow, transform] in
            do {
                for try await value in FlowBridge.stream(from: flow) {
                    if Task.isCancelled { break }
                    guard let mapped = transform(value) else { continue }
                    self?.state = mapped
                }
            } catch {
                // Terminal errors stop subscription
            }
        }
    }

    public func stop() {
        task?.cancel()
        task = nil
    }
}
```

**How it works:**
- Wraps KMP `Kotlinx_coroutines_coreStateFlow` (line 18)
- On `start()`, uses `FlowBridge` to collect emissions (line 41)
- Each Kotlin emission → transform → update `@Observable` state (line 44)
- SwiftUI automatically re-renders when `state` changes

#### Flow Bridge: Kotlin Flow → Swift AsyncThrowingStream

**File:** `/Users/atulgupta/Documents/repos/.teslasync-parallel/20260615-193947-52828/slot-8/apps/apple/Sources/SharedFacade/FlowBridge.swift` (lines 14-63)

```swift
public enum FlowBridge {
    public static func stream(
        from flow: Shared.Kotlinx_coroutines_coreFlow
    ) -> AsyncThrowingStream<Any, Swift.Error> {
        let flowBox = UncheckedSendable(flow)
        return AsyncThrowingStream { continuation in
            let task = Task {
                do {
                    let collector = YieldingCollector { value in
                        nonisolated(unsafe) let element = value
                        continuation.yield(element)
                    }
                    try await flowBox.value.collect(collector: collector)
                    continuation.finish()
                } catch {
                    continuation.finish(throwing: FacadeError.from(error))
                }
            }
            continuation.onTermination = { _ in task.cancel() }
        }
    }
}
```

#### LoadableState: Cache-then-network resource projection

**File:** `/Users/atulgupta/Documents/repos/.teslasync-parallel/20260615-193947-52828/slot-8/apps/apple/Sources/SharedFacade/LoadableState.swift` (lines 10-91)

```swift
public enum LoadableState<Value> {
    case idle
    case loading(cached: Value?, stale: Bool)
    case loaded(Value, stale: Bool)
    case empty(stale: Bool)
    case failed(FacadeError, cached: Value?, stale: Bool)

    public var value: Value? {
        switch self {
        case .idle, .empty: nil
        case let .loading(cached, _): cached
        case let .loaded(value, _): value
        case let .failed(_, cached, _): cached
        }
    }

    public var isStale: Bool {
        switch self {
        case .idle: false
        case let .loading(_, stale), let .loaded(_, stale),
             let .empty(stale), let .failed(_, _, stale):
            stale
        }
    }

    // Projects KMP Resource<T> into LoadableState
    static func from(
        _ resource: Shared.Resource,
        transform: (Any) -> Value?
    ) -> LoadableState {
        let stale = resource.stale
        switch resource {
        case let success as Shared.ResourceSuccess<AnyObject>:
            if let mapped = transform(success.data) {
                return .loaded(mapped, stale: stale)
            }
            return .empty(stale: stale)
        case let loading as Shared.ResourceLoading<AnyObject>:
            return .loading(cached: loading.cached.flatMap(transform), stale: stale)
        case let failure as Shared.ResourceError<AnyObject>:
            return .failed(
                FacadeError.from(failure.error),
                cached: failure.cached.flatMap(transform),
                stale: stale
            )
        default:
            return .idle
        }
    }
}
```

#### AppContainer wiring KMP → Swift

**File:** `/Users/atulgupta/Documents/repos/.teslasync-parallel/20260615-193947-52828/slot-8/apps/apple/Sources/SharedFacade/AppContainer.swift` (lines 1-61)

```swift
@MainActor
@Observable
public final class AppContainer {
    public var unitPreferences: UnitPreferences

    @ObservationIgnored public private(set) var auth: (any AuthTokenProviding & AuthChallengeHandling)?

    // Wraps holder `StateFlow` into `@Observable` model
    public func model<State>(
        from flow: Shared.Kotlinx_coroutines_coreStateFlow,
        transform: @escaping (Any) -> State?
    ) -> StateHolderModel<State> {
        StateHolderModel(flow: flow, transform: transform)
    }

    // Projects holder's `StateFlow<Resource<T>>` into observable `LoadableState`
    public func loadable<Value>(
        from flow: Shared.Kotlinx_coroutines_coreStateFlow,
        as _: Value.Type = Value.self,
        map: @escaping (Any) -> Value?
    ) -> StateHolderModel<LoadableState<Value>> {
        StateHolderModel(flow: flow) { raw in
            guard let resource = raw as? Shared.Resource else { return nil }
            return LoadableState.from(resource, transform: map)
        }
    }
}
```

