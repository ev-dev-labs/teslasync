### **1. @Observable View Model Pattern & Data Fetching**

#### Key Pattern: `@Observable` model + source seam + callback binding

**File:** `/Users/atulgupta/Documents/repos/.teslasync-parallel/20260615-193947-52828/slot-8/apps/apple/TeslaSync/feature-views/AlertStudioPage.Models.swift` (lines 15-62)

**Example - ASRulesModel:**
```swift
@MainActor
@Observable
public final class ASRulesModel {
    public private(set) var snapshot: ASListSnapshot<ASAlertRule>
    @ObservationIgnored private let source: any ASRulesSource
    @ObservationIgnored private var started = false

    public init(source: any ASRulesSource) {
        self.source = source
        snapshot = ASListSnapshot()
        source.onUpdate = { [weak self] snapshot in self?.snapshot = snapshot }
    }

    public var presentation: ASListPresentation<ASAlertRule> {
        .resolve(snapshot)
    }

    public var rules: [ASAlertRule] {
        snapshot.items
    }

    public func start() {
        guard !started else { return }
        started = true
        source.start()
    }

    public func stop() {
        started = false
        source.stop()
    }

    public func refresh() {
        source.refresh()
    }
}
```

**Pattern breakdown:**
- Model is `@MainActor` + `@Observable` (lines 20-21)
- Owns an `@ObservationIgnored` source protocol (line 24)
- **Callback binding**: source calls `onUpdate` closure (line 30) → triggers snapshot update → SwiftUI re-renders
- Derived `presentation` computed property transforms snapshot to render enum (line 40-42)
- **Lifecycle**: `start()`/`stop()` delegate to source (lines 48-61)

**File:** `/Users/atulgupta/Documents/repos/.teslasync-parallel/20260615-193947-52828/slot-8/apps/apple/Sources/Features/Battery/BatteryDegradationPageModel.swift` (lines 42-131)

Another example showing **async data loading pattern**:
```swift
@MainActor
@Observable
public final class BatteryDegradationPageModel {
    public private(set) var phase: BatteryDegradationPhase = .loading
    public private(set) var isRefreshing = false
    public private(set) var vehicles: [BatteryVehicle] = []
    public private(set) var selectedVehicleID: Int64?
    public private(set) var health: BatteryHealthData?
    public private(set) var detail: BatteryDegradationDetail?

    @ObservationIgnored private let dataSource: any BatteryDegradationDataSource

    public init(dataSource: any BatteryDegradationDataSource = SampleBatteryDegradationDataSource()) {
        self.dataSource = dataSource
    }

    public func load() async {
        phase = .loading
        await fetchAll()
    }

    private func fetchAll() async {
        vehicles = await (try? dataSource.loadVehicles()) ?? []
        if selectedVehicleID == nil || !vehicles.contains(where: { $0.id == selectedVehicleID }) {
            selectedVehicleID = vehicles.first?.id
        }
        await loadSelectedVehicle()
    }

    private func loadSelectedVehicle() async {
        guard let id = selectedVehicleID else {
            health = nil
            detail = nil
            phase = .empty
            return
        }

        do {
            let snapshot = try await dataSource.loadHealth(vehicleID: id)
            health = snapshot
            detail = await (try? dataSource.loadDegradation(vehicleID: id)) ?? nil
            phase = snapshot == nil ? .empty : .ready
        } catch {
            health = nil
            detail = nil
            phase = .error(error.localizedDescription)
        }
    }
}
```

