#### **Step 6: Create SwiftUI view**
Create `EnergyPage.swift`:
```swift
import SwiftUI

public struct EnergyPage: View {
    @State private var viewModel: EnergyPageViewModel

    public init(viewModel: EnergyPageViewModel) {
        _viewModel = State(initialValue: viewModel)
    }

    public var body: some View {
        ScrollView {
            VStack(alignment: .leading, spacing: 16) {
                energySection
                chargingSessionsSection
                telemetrySection
            }
            .padding()
        }
        .task { viewModel.start() }
        .onDisappear { viewModel.stop() }
    }

    private var energySection: some View {
        Group {
            switch viewModel.energyStatsModel.presentation {
            case .loading:
                ProgressView()
            case .content(let items, _, refreshing: _):
                ForEach(items) { stat in
                    Text("Distance: \(stat.totalDistanceM)m")
                    Text("Efficiency: \(stat.avgEfficiencyWhPerM) Wh/m")
                    Text("CO₂ Saved: \(stat.co2SavedKg) kg")
                }
            case .empty:
                Text("No energy data")
            case .offlineNoData:
                Text("Offline - no cached data")
            case .error(retryable: let retryable):
                Text(retryable ? "Error (retryable)" : "Error (non-retryable)")
            }
        }
    }

    private var chargingSessionsSection: some View {
        Group {
            switch viewModel.chargingSessionsModel.presentation {
            case .content(let sessions, _, _):
                ForEach(sessions) { session in
                    VStack {
                        Text("Energy: \(session.totalEnergyAddedWh) Wh")
                        Text("Cost: \(session.costDecimal)")
                        Text("Peak: \(session.peakPowerW) W")
                    }
                }
            default:
                Text("No charging sessions")
            }
        }
    }

    private var telemetrySection: some View {
        Group {
            switch viewModel.chargingTelemetryModel.state {
            case .loaded(let telemetry, stale: _):
                Text("Lifetime: \(telemetry.lifetimeEnergyUsed) Wh")
            default:
                Text("Loading telemetry...")
            }
        }
    }
}
```

