Parity reproduced exactly from the web source (cross-platform VALUE parity, not a "corrected"
version):
  value_kind  = formatValueKind(kind)  [0..10 → unknown/string/bool/int32/int64/float32/float64/
                enum/invalid/time/location · otherwise "kind {n}"]   (api/hooks/useIngestXRay.ts)
  samples     = fmtInt(sample_count) = fmtNumber(v,0) → toLocaleString('en-US', max0frac)
                ["12,345" grouping]                                   (lib/numberFormat.ts)
  last seen   = <TimeStamp format="relative"> → formatRelative()      (lib/dateFormat.ts)
                ["just now" <60s incl. future · "Nm ago" · "Nh ago" · "Nd ago" · else "MMM d, yyyy"
                 · "—" for unparseable]
  sort        = const sorted = [...rows].sort(switch sortKey) * dir   (the component body)
                [field localeCompare · sample_count numeric · last_seen_at Date.parse delta ·
                 value_kind numeric ; dir = asc?+1:-1 ; stable]
  sort state  = useSortToggle('sample_count','desc') [same column → flip dir; new column → desc]
  i18n keys   = admin.xray.fields.cols.field/count/lastSeen/kind, .loading, .empty,
                admin.xray.panels.fields (all from web source / i18n/en.json)

