# p2-windows / W7 / page:charging/ChargingList — WinUI 3 / Fluent parity
#
# Native WinUI 3 (.NET 10 / Windows App SDK / CommunityToolkit-style ObservableObject) parity port of the web page
# web/src/features/charging/pages/ChargingListPage.tsx (route /charging, nav name "Charging"). Implemented with the
# repo's established headless feature pattern (siblings: feature-views/TripListPage, feature-views/ChargingDetailPage,
# feature-views/OptimizerSection), NOT the generated prompt's apps/windows/TeslaSync/Features/Charging/*.xaml path
# (which does not exist in-repo — the codebase builds WinUI views in code-behind, not XAML markup, and compiles the
# UI-free Model/Display/Search/Projection/Source/ViewModel into the headless test assembly).
#
# Output:
#   apps/windows/TeslaSync.App/feature-views/ChargingListPage/ChargingListPage.Model.cs       (session parse + ChargingAggregation: category/duration/power/period-stats/anomalies/notable/trend/prior)
#   apps/windows/TeslaSync.App/feature-views/ChargingListPage/ChargingListPage.Display.cs      (ChargingListFilters + display records + ChargingListDisplay)
#   apps/windows/TeslaSync.App/feature-views/ChargingListPage/ChargingListPage.Search.cs       (ChargingSearch — structured key:op?value mini-language)
#   apps/windows/TeslaSync.App/feature-views/ChargingListPage/ChargingListPage.Projection.cs   (ChargingListProjection.Project + builders + CSV/JSON export + registration)
#   apps/windows/TeslaSync.App/feature-views/ChargingListPage/ChargingListPage.Source.cs       (IChargingListSource + Empty + ChargingListSource + mapper + IChargingBulkDeleteService + ChargingBulkDeleteClient + diagnostics)
#   apps/windows/TeslaSync.App/feature-views/ChargingListPage/ChargingListPage.ViewModel.cs    (ChargingListPageViewModel — state holder + filters + bulk-delete + export)
#   apps/windows/TeslaSync.App/feature-views/ChargingListPage/ChargingListPage.cs              (UserControl view — sticky/search/KPI/trend/collections/sort/sections/list/pager + 4 states)
#   apps/windows/TeslaSync.App.Tests/FeatureViews/ChargingListPageTests.cs                     (45 headless tests — aggregation/search/projection/state/source/viewmodel/export + 67-key i18n coverage)
#   NavigationView registration: TeslaSync.App.Core/Navigation/RouteTable.cs:112  Page("Charging","charging",RouteGroup.Charging,"Charging","\uE945")
#                                TeslaSync.App/Shell/ShellWindow.xaml.cs           PageFactory.Register("Charging", () => new FeatureViews.Charging.ChargingListPage())
#   String catalog: 67 web i18n keys resolved at the ChargingListProjection.Project / Build* localizer call sites
#       (ILocalizer.GetString(key, verbatim-English-fallback)); the 8 pre-existing keys plus 59 newly added entries
#       are present as translation.<key> in Strings/{en,ar,he}/Resources.resw. (The shared i18n generator reads
#       web/src/i18n, where these page keys are inline t(key, default) defaults with no JSON entry; the prompt allows
#       editing the platform string catalog directly, so the 59 missing keys were added there. ILocalizer.GetString
#       returns the verbatim English default for any untranslated key — gate-passing sibling precedent.)
#
# Data sources — bound to the generated C# client through the ObservableObject view-model (P1/S8, ADR-004):
#   useChargingSessionsPaginated  GET /charging  ->  ChargingListSource.StreamAsync (op get_api_v1_charging;
#       query vehicle_id + limit=500 + offset + start + end), cache-then-network via CacheThenNetworkEngine,
#       parsed by ChargingListSession.ParseList; disabled (Empty) when no vehicle, mirroring enabled: vehicleId!==null.
#   useBulkDeleteCharging         DELETE /charging/bulk  ->  ChargingBulkDeleteClient.DeleteAsync (op
#       delete_api_v1_charging_bulk, { ids } body) -> ChargingListPageViewModel.DeleteSelectedAsync clears + refreshes.
#   useChargingOptimizer          GET /analytics/charging-optimizer [vehicle_id]  ->  the optimizer section is a
#       separate already-ported parity unit (feature-views/OptimizerSection, op get_api_v1_analytics_charging_optimizer);
#       this page surfaces the section header + description + a never-blank "no data" body (ChargingSectionDisplay
#       key "optimizer"), faithful to the web threshold-gated section.
#   SI is preserved on the wire / in every record (Wh, W, %, decimal currency); display conversion happens only at the
#   render boundary (UnitPref / DistanceUnit threaded into the session-card model; ScalarFormatters-style formatting).

=== PARITY ===
# PARITY_REQUIRED=79. Each item: parity kind — name — binding evidence (file + symbol).

# panels (7) — the 6 overview KPI MetricCards + the no-stats GlassPanel (the web ChargingListPage's panel regions)
[x] panel  - Sessions
       ChargingListProjection.BuildKpiCards[0] = ChargingKpiCard("sessions", charging.totalSessions, FmtCompact(count))
       -> ChargingListPage.cs RenderOverview() _kpiGrid TsMetricCard{Label,Value,AccentBrushKey=TsChartSpeedBrush}.
       test: Projection_builds_six_kpi_cards_in_web_order_when_stats_present.
[x] panel  - Energy-kWh
       BuildKpiCards[1] = ChargingKpiCard("energy", charging.totalEnergy, FmtCompact(totalEnergyWh/1000)) -> _kpiGrid[1]
       (AccentBrushKey=TsChartBatteryBrush). SI Wh -> display kWh at the projection boundary.
[x] panel  - Cost
       BuildKpiCards[2] = ChargingKpiCard("cost", charging.totalCost, FmtCurrency(totalCost,symbol)) -> _kpiGrid[2]
       (AccentBrushKey=TsColorDangerBrush). test asserts "$12.00".
[x] panel  - Avg-rate-kW
       BuildKpiCards[3] = ChargingKpiCard("rate", charging.avgRate, FmtNumber(avgRateKw,1)) -> _kpiGrid[3]
       (AccentBrushKey=TsChartPowerBrush); em-dash when null (ChargingPeriodStats.AvgRateKw).
[x] panel  - Avg-duration
       BuildKpiCards[4] = ChargingKpiCard("duration", charging.avgDuration, FormatDurationMinutes(avgDurationMin)) -> _kpiGrid[4].
[x] panel  - Avg-power-kW
       BuildKpiCards[5] = ChargingKpiCard("power", charging.avgPower, FmtNumber(avgPowerW/1000,1)) -> _kpiGrid[5]
       (AccentBrushKey=TsColorWarningBrush). prior-period delta via DeltaText(prior,current) for all six tiles.
[x] panel  - GlassPanel7
       ChargingListPage.cs _noStatsPanel (TsGlassPanel) hosting _noStats (TsEmptyState, Message=display.NoStatsMessage
       = charging.noStatsRange); shown when !display.HasStats (web currentStats.count===0 GlassPanel empty branch).
       test: Projection_without_stats_surfaces_the_no_stats_panel.

# charts (1) — native W3 chart wrapper (no web canvas)
[x] chart  - MetricSwitcherChart
       ChargingListPage.cs RenderTrend() -> new MetricSwitcherChart(new MetricSwitcherChartStore(TrendTitle/aria/empty,
       display.TrendMetrics, display.TrendSeries, display.TrendActiveKey), _localizer); ReplaceSeries per metric on
       re-projection. Projection.BuildTrendMetrics = 4 MetricDefinition (sessions/energy/cost/power, bar/bar/bar/line);
       Projection TrendSeries = ChargingAggregation.DailyChargingTrend x4. Shown when HasStats (web count>0).
       test: Projection_carries_chrome_strings_in_every_state (TrendMetrics.Count==4), DailyChargingTrend_buckets_and_sorts_by_day.

# data states (4) — web parity: isLoading / currentStats.count===0 / QueryError / populated section stack
[x] state  - loading data state
       ChargingListState.Loading -> ChargingListPage.cs Render() shows _loadingHost (TsSkeleton blocks);
       ChargingListPageViewModel.SetLoading. test: ViewModel_loading_then_success_lists_sessions.
[x] state  - empty data state
       ChargingListState.Empty -> Render() shows _pageEmpty (TsEmptyState, Title=charging.emptyTitle,
       Message=charging.emptyMessage, ActionText=charging.empty.cta); ViewModel.SetEmpty (empty OR loaded-with-0-rows).
       test: ViewModel_empty_response_shows_the_empty_state.
[x] state  - error data state
       ChargingListState.Error -> Render() shows _errorState (TsQueryError, AttemptCount); OnRetry -> ViewModel.RetryAsync;
       ViewModel.SetError (failure with no cache, web QueryError). test: ViewModel_failure_with_no_cache_surfaces_error.
[x] state  - success data state
       ChargingListState.Success -> Render() shows _successBody (sticky + search + overview KPIs + trend + collections +
       sort + sections + grouped session list + pager); ViewModel.ApplySnapshot. test: ViewModel_loading_then_success,
       ViewModel_offline_keeps_cached_sessions_visible.

