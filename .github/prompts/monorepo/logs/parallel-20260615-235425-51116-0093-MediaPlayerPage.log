**Parser handles aliases (AppRouteParser.swift):**
```swift
public enum AppRouteParser {
    static let aliases: [String: AppRoute] = [
        "/": .dashboard,
        "/media-player": .mediaPlayer,  // ← ADD THIS
        // ... existing aliases
    ]
    
    public static func parse(path rawPath: String) -> AppRoute? {
        let normalized = normalize(rawPath)
        if let alias = aliases[normalized] { return alias }
        let segment = firstSegment(of: normalized)
        return AppRoute.allCases.first { $0.pathSegment == segment }
    }
}
```

**Registration pattern (e.g., NavigationRouteRegistration.swift):**
```swift
public enum MediaPlayerRouteRegistration {
    @MainActor
    public static func registry(
        base: AppRouteHostRegistry = AppRouteHostRegistry(),
        dataSource: any MediaPlayerDataSource = SampleMediaPlayerDataSource()
    ) -> AppRouteHostRegistry {
        var registry = base
        let model = MediaPlayerPageModel(dataSource: dataSource)
        registry.register(.mediaPlayer) {
            MediaPlayerPage(model: model)
        }
        return registry
    }
    
    @MainActor
    public static func make(
        dataSource: any MediaPlayerDataSource = SampleMediaPlayerDataSource()
    ) -> MediaPlayerPage {
        MediaPlayerPage(model: MediaPlayerPageModel(dataSource: dataSource))
    }
}
```

