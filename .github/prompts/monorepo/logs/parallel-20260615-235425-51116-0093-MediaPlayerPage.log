### **1. PAGE + @Observable MODEL PATTERN**

**Files & Pattern:**
- `/Users/atulgupta/Documents/repos/.teslasync-parallel/20260615-235425-51116/slot-93/apps/apple/TeslaSync/Features/System/SystemStatusPage.swift`
- `/Users/atulgupta/Documents/repos/.teslasync-parallel/20260615-235425-51116/slot-93/apps/apple/TeslaSync/Features/System/SystemStatusPageModel.swift`

**@Observable Model Declaration:**
```swift
@Observable
final class SystemStatusPageModel {
    // MARK: - State
    var health: SystemHealthData?
    var isLoading = false
    var error: String?
    
    // MARK: - Computed Properties
    var isEmpty: Bool {
        health == nil
    }
    
    // MARK: - Actions
    func load() async {
        isLoading = true
        error = nil
        do {
            // API call...
            isLoading = false
        } catch {
            self.error = error.localizedDescription
            isLoading = false
        }
    }
    
    func refresh() async {
        await load()
    }
}
```

**Page Structure:**
```swift
struct SystemStatusPage: View {
    @State private var model = SystemStatusPageModel()
    
    var body: some View {
        ScrollView {
            if model.isLoading {
                loadingView
            } else if let error = model.error {
                errorView(error)
            } else if model.isEmpty {
                emptyView
            } else {
                contentView
            }
        }
        .navigationTitle(String(localized: "System Status"))
        .task {
            await model.load()
        }
        .refreshable {
            await model.refresh()
        }
    }
}
```

**State Pattern (SearchPageModel example):**
```swift
@Observable
public final class SearchPageModel {
    public var query: String = ""
    public var state: DataState = .empty
    public var groupedHits: [GroupedSearchHits] = []
    
    public enum DataState {
        case loading
        case empty
        case error(String)
        case success
    }
}
```

**Key Points:**
- Use `@Observable` macro (Observation framework)
- `@State private var model` in the View
- Load data in `.task` modifier
- Support `.refreshable` with `refresh()` method
- Use computed properties (`isEmpty`, `maintenanceMode`, etc.)
- Error handling returns `String?` (shown in UI)

