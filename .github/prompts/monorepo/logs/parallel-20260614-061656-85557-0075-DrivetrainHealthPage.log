public enum DrivetrainTemperatureUnit: String, Equatable, Sendable {
    case celsius
    case fahrenheit
    
    public func convert(_ celsiusValue: Double) -> Double {
        switch self {
        case .celsius: celsiusValue
        case .fahrenheit: celsiusValue * 9 / 5 + 32
        }
    }
}
