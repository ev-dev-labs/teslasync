   useSelectedVehicle GET /vehicles  -> FetchVehiclesAsync (get_api_v1_vehicles)
   deferred history   GET /signals/{vehicleId}/{signal}/history -> FetchHistoryAsync
      (get_api_v1_signals_vehicleID_signalName_history, one request/signal, from/to/limit
      query pass-through, flattened newest-first — web useQuery + Promise.all).

