  + AuditLogWidget.Views.swift       connectivity banner + AuditFeed + AuditFeedRow +
                                     AuditLogEmptyState + AuditCompactBigNumber (web
                                     WidgetBigNumber).
  + AuditLogWidget.swift             AuditLogWidget(View): registration + header chrome
                                     (icon/title/freshness chip/refresh) + state switch
                                     (loading/empty/error/content) + compact-vs-feed.
  + AuditLogWidget.Previews.swift    8 #Preview states (content/wide/empty/loading/error/
                                     offline/stale/compact). DEBUG-only.
