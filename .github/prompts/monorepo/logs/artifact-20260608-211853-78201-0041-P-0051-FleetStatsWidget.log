PARITY MAP (web -> native), all conditional branches reproduced
--------------------------------------------------------------------------------------------
  useVehicles                       -> FleetStatsInput.vehicleCount / .onlineCount (state=='online')
  useFleetAnalytics(30)             -> FleetStatsInput.analytics (totalDistanceSI / totalEnergyKwh /
                                       avgEfficiencyWhKm) + Update.status/connection/refreshing/updatedAt
  useUnits().unitPrefs.distance     -> FleetStatsInput.unit (DistanceUnitPref km/mi/ft)
  useQuery(/drives?limit=5)         -> FleetStatsInput.recentDriveDistancesM (distance_m)
  useQuery(/charging?limit=5)       -> FleetStatsInput.recentChargeEnergiesWh (total_energy_added_wh)
  convertDistanceFromSI(v,unit)     -> FleetUnits.distanceFromSI (/1000 km · /1609.344 mi · /0.3048 ft)
  toEfficiencyDisplay (Wh/km×1.609) -> FleetUnits.efficiencyFromWhKm (× 1.609344 for mi, else identity)
  efficiencyUnit (Wh/mi | Wh/km)    -> FleetUnits.efficiencyLabel
  AnimatedNumber + fmtNumber        -> TSAnimatedNumber + FleetStatsFormat.number (group, round half-up)
  MiniChart(recentDrives reversed)  -> FleetStatsSparkline (Swift Charts LineMark, .linear, ≥2 pts)
  MiniChart(recentCharges reversed) -> FleetStatsSparkline (reversed series, drawn only for ≥2 points)
  WidgetShell noPadding + freshness -> FleetStatsWidget glass container + FleetStatsWidgetFreshnessChip
  WidgetShell updatedAt/isFetching/ -> FleetStatsWidgetFreshness.tone(connection, refreshing) →
    isStale/isError/onRefresh          live/fetching/stale/offline chip + tap-to-refetch
  five <GlassPanel> cards            -> FleetStatsProjection.cards (Size·Distance·Energy·Efficiency·Alerts)
  per-card text color (cyan/emerald  -> FleetStatAccent → brand token (accent/success/warning/danger),
    /amber/red|emerald)                 semantic ADR-006 parity (not a literal hex port)
  Registry analytics.ts "fleet-stats"-> FleetStatsWidget.registration (id fleet-stats, category
                                        analytics, default 4x2, min 2x2, max 4x40) + clamp honored.
  Surface slug "FleetStatsWidget"    -> view.opened telemetry (P1/S11), distinct from the bar slug.

  Pinned value parity (en_US, sample totalDistanceSI=1_234_000 / energy 312.5 kWh / eff 158 Wh/km /
  4 vehicles, 3 online, 2 alerts):
    km  -> Size "4" (+"3 online") · Distance "1,234 km" · Energy "312.5 kWh" · Eff "158 Wh/km" · Alerts "2"
    mi  -> Distance "767 mi" · Eff "254 Wh/mi"
    sparklines reversed: drives [47000,33000,51000,38000,42000] · charges [30000,55000,18000,42000]

