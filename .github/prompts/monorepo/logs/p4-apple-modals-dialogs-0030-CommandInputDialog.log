WEB PARITY MAP (CommandInputDialog.tsx -> native)
  Modal(open,onClose,size=sm)             -> HIG sheet content in TSGlassPanel + TSFadeIn
  def.icon / def.labelKey / ic.promptKey  -> CommandInputHeader (SF Symbol + title + prompt)
  ic.fields[] OR single ic.paramName      -> unified CommandInputSpec.fields (single field
                                             synthesised; label shown only when a sublabel
                                             fallback exists, web parity)
  buildInitialValues / getDefaultValue     -> CommandInputProjection.initialValues (default
                                             resolved upstream by the source)
  validateField(value,validation,min,max)  -> CommandInputProjection.validate (verbatim):
       '' -> Required
       pin    -> /^\d{4}$/                  -> isFourDigitPIN
       number -> parseInt + String(num)===s -> canonicalInteger (rejects 007/1.5/+5/-0/oversize)
       decimal-> parseFloat (lenient)       -> jsParseFloat (1.5abc->1.5, .5, 5., 1e3, Infinity)
       min/max-> `Minimum/Maximum: ${n}`    -> {{value}} substitution
  resolveInputType / resolveInputMode       -> CommandFieldEntryMode (secureNumeric/numeric/
                                             decimal/text) -> SwiftUI keyboardType + SecureField
  handleChange/handleBlur (touched gating)  -> model.updateValue / blurField (visibleError =
                                             touched ? errors[name] : nil)
  handleSubmit (validate all, mark touched) -> model.submit -> controller.submit(values) iff valid
  isValid() (Send disabled)                 -> model.isValid -> TSButton .disabled
  loading prop (Send spinner)               -> update.submitting -> TSButton isLoading
  onClose / Escape                          -> model.cancel -> controller.cancel (header "x")
  t('common.cancel'/'common.send')          -> CommandInputStrings (P1/S10)
  [native widening] loading/empty/error/    -> CommandInputPhase + freshness chip + banner so
   stale/offline                              no state is ever a blank box (prompt requirement)

