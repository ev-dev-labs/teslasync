                                                    + url(#speedGrad) → vertical gradient + 2pt stroke
  <Area dataKey="power" yAxisId="power" right>    → power series RESCALED onto the left scale (Swift Charts
                                                    has one y-scale/chart) + a TRAILING kW axis reading the
                                                    true kW back out; Color.TS.chartSeriesPower + url(#powerGrad)
  <YAxis label={speedUnit}> (left)                → .chartYAxisLabel(.leading) = speedUnit; ticks fmt(v,0)
  <YAxis label="kW" orientation="right">          → .chartYAxisLabel(.trailing) = "kW"; ticks inverse-rescaled
  <XAxis type=number tickFormatter `${fmt(v,0)}m`>→ AxisMarks(evenlySpacedValues) label "Nm"  (TripReplayFormat)
  <Tooltip labelFormatter `${fmt(v,1)} min`>      → TripReplayTimelineTooltip (minute header + Speed + Power rows)
  <ReferenceLine x={data[currentIndex].time}      → playhead RuleMark at cursorTime (web data[currentIndex]?.time)
    stroke="#00b4d8" strokeDasharray="4 2">         Color.TS.accent, dashed [4,2]
  onClick activeTooltipIndex → onSeekToIndex(      → .chartXSelection(value:) → onScrub → model.scrub(toTime:)
    data[idx].index) ; useSyncedCursor /             → nearestIndexByTime → onSeek(sample.originIndex),
    useSyncedReferenceLineX bridge → onSeekToIndex     de-duplicated (lastForwardedPosition == web lastForwardedRef)
  nearestIndexByTime(data, x) binary search       → TripReplayChartsProjection.nearestIndexByTime (line-for-line
    incl. `target-prev < next-target` tie-break)     port; tie → right sample; verified by audit test)
  data.length > 0 ? <chart> : <empty>             → TripReplayChartsProjection.hasTrace(≥1) → .content/.empty
  empty: <Activity/> "No telemetry data available"→ ContentUnavailableView(waveform.path.ecg) [replay.timeline.noData]
  <Area name="Speed"> / <Area name="Power">       → TripReplayChartsLegend + tooltip rows [replay.timeline.speed/power]
