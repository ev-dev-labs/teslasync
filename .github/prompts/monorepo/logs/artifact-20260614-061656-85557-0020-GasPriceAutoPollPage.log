  Sources/Features/Admin/GasPriceAutoPollPage.swift              (scaffold: page title + subtitle + embed GasPriceSettings)
  Sources/Features/Admin/GasPriceAutoPollRouteRegistration.swift (.gasPrice route registration + default model factory)
