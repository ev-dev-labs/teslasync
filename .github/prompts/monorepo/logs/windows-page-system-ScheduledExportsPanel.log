#   useDeleteScheduledExport DELETE /scheduled-exports/{id} -> ScheduledExportsClientFeed.DeleteAsync  (op delete_api_v1_scheduled_exports_id)
#   useRunScheduledExportNow POST  /scheduled-exports/{id}/run -> ScheduledExportsClientFeed.RunNowAsync (op post_api_v1_scheduled_exports_id_run)

