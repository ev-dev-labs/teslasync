# EditorConfig — https://editorconfig.org/
#
# Phase A2.1 of chore/repo-reorganization. Codifies the formatting
# conventions that have grown organically across the TeslaSync codebase
# so editors apply them automatically, without depending on per-language
# tooling (gofmt, prettier, etc.) running on save.
#
# This file is read by the editor BEFORE the file is opened, so it
# affects what gets COMMITTED, not just what gets rendered. Per-language
# tools (gofmt, eslint, etc.) still run as authoritative gates in CI;
# .editorconfig just stops mixed-CRLF / mixed-indent commits from being
# introduced in the first place.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go: gofmt uses tabs (width is editor preference; 4 is common)
[*.go]
indent_style = tab
indent_size = 4

# Go modules: tab-indented per `go mod tidy` output
[go.{mod,sum}]
indent_style = tab
indent_size = 4

# Makefiles: REQUIRE real tab indentation (recipe lines won't run otherwise)
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

# Shell scripts: 2-space convention used across scripts/ and pre-commit hooks
[*.{sh,bash}]
indent_style = space
indent_size = 2

# Python (pre-commit hooks, occasional tooling): PEP 8 = 4 spaces
[*.py]
indent_style = space
indent_size = 4

# YAML: 2 spaces, no tabs (yaml-spec compliant; CI configs assume this)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON / JSONC: 2 spaces, common across tsconfig.json + package.json
[*.{json,jsonc}]
indent_style = space
indent_size = 2

# TypeScript / JavaScript / JSX: ESLint formatter expects 2 spaces
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_style = space
indent_size = 2

# CSS / SCSS / HTML: 2 spaces
[*.{css,scss,html,vue}]
indent_style = space
indent_size = 2

# SQL: 2 spaces (migrations/ and db/seeds/ convention)
[*.sql]
indent_style = space
indent_size = 2

# Markdown: preserve trailing whitespace (used for hard line breaks)
[*.md]
trim_trailing_whitespace = false

# Vendored / generated / third-party — opt out of normalization to avoid
# spurious diffs against upstream.
[{web/node_modules,web/dist,bin,coverage,test-results,tmp}/**]
indent_style = unset
indent_size = unset
end_of_line = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[**/vendor/**]
indent_style = unset
indent_size = unset
end_of_line = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[internal/tesla/protomodel/**.go]
# Generated by `go generate ./internal/tesla/protomodel/...` from the
# vendored Tesla proto. Don't fight the generator's formatting.
trim_trailing_whitespace = false

[web/src/generated/**]
# Generated by `go run ./tools/aigen` (Phase-50 / 0001 — AI-Off Contract).
# Don't fight the generator.
trim_trailing_whitespace = false
